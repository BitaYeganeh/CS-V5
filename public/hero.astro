<!-- Hero Section - Big triangle on top, circle + small triangle below -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 min-h-screen flex items-center relative overflow-hidden">  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
    
    <!-- Mobile layout (stacked vertically) -->
    <div class="flex flex-col items-center justify-center gap-6 mb-8 md:hidden">
      
      <!-- Mobile: Big Triangle (top) -->
      <svg class="w-48 h-48" viewBox="0 0 200 200">
        <defs>
          <clipPath id="mobileBigTriangle">
            <polygon points="0,0 200,0 100,200" />
          </clipPath>
        </defs>
        <image href="/images/1.webp" x="0" y="0" width="200" height="200" clip-path="url(#mobileBigTriangle)" preserveAspectRatio="xMidYMid slice" />
      </svg>
      
      <!-- Mobile: Circle + Small Triangle (row) -->
      <div class="flex flex-row items-center justify-center gap-5">
        
        <!-- Circle (left) -->
        <svg class="w-32 h-32" viewBox="0 0 200 200">
          <defs>
            <clipPath id="mobileCircle">
              <circle cx="100" cy="100" r="100" />
            </clipPath>
          </defs>
          <image href="/images/1.webp" x="0" y="0" width="200" height="200" clip-path="url(#mobileCircle)" preserveAspectRatio="xMidYMid slice" />
        </svg>
        
        <!-- Small Triangle pointing UP (right) -->
        <svg class="w-32 h-32" viewBox="0 0 200 200">
          <defs>
            <clipPath id="mobileSmallTriangle">
              <polygon points="100,0 200,200 0,200" />
            </clipPath>
          </defs>
          <image href="/images/1.webp" x="0" y="0" width="200" height="200" clip-path="url(#mobileSmallTriangle)" preserveAspectRatio="xMidYMid slice" />
        </svg>
        
      </div>
      
    </div>
    
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Left Side: Content -->
      <div class="text-left">
        
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-6 leading-tight text-left">
          <div>Enterprise Cybersecurity</div>
          <div class="pl-4 sm:pl-10 md:pl-18 mt-1">
            <span class="text-3xl sm:text-4xl md:text-5xl">&</span>
          </div>
          <div class="mt-2">
            <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">Compliance Advisory</span>
          </div>
        </h1>

        <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-start mt-10 md:mt-14">
          <a href="/contact" class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#2563EB] text-white rounded-full hover:from-[#2563EB] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
            Request Consultation
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          
          <a href="/services" class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#2563EB] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
            Explore Services
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
        
      </div>
      
      <!-- Desktop: Optimized shapes with better alignment -->
      <div class="hidden md:flex flex-col items-center justify-center">
        
        <!-- Big Triangle (top) - pointing down -->
        <svg class="w-96 h-96 lg:w-[28rem] lg:h-[28rem] -translate-x-30 " viewBox="0 0 200 200">
          <defs>
            <clipPath id="desktopBigTriangle">
              <polygon points="0,0 200,0 100,200" />
            </clipPath>
          </defs>
          <image href="/images/1.webp" x="0" y="0" width="200" height="200" clip-path="url(#desktopBigTriangle)" preserveAspectRatio="xMidYMid slice" />
          <polygon points="0,0 200,0 100,200" fill="none" opacity="0.75" />
        </svg>
        
          
          <!-- Small Triangle pointing UP -->
        <svg class="w-96 h-96 lg:w-[28rem] lg:h-[28rem] -mt-120 translate-x-40" viewBox="0 0 200 200">
            <defs>
              <clipPath id="desktopSmallTriangle">
                <polygon points="100,0 200,200 0,200" />
              </clipPath>
            </defs>
            <image href="/images/1.webp" x="0" y="0" width="200" height="200" clip-path="url(#desktopSmallTriangle)" preserveAspectRatio="xMidYMid slice" />
            <polygon points="100,0 200,200 0,200" fill="none" opacity="0.5" />
          </svg>
          
        
      </div>
      
    </div>
  </div>
</section>

