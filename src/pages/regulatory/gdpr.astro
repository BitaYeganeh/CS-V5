---
import Layout from '@/layouts/Layout.astro';
import Icon from "@ui/icons/Icon.astro";
import Button from "@ui/Button.astro";
import Button from '@/components/ui/Button.astro';

const title = "GDPR and Privacy";
const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    title: "GDPR and Privacy",
    subtitle: "General Data Protection Regulation Compliance",
    description: "Navigate GDPR compliance requirements with expert guidance and proven implementation strategies for data protection and privacy.",
    whoFor: "For organizations that process personal data of EU residents and need to ensure GDPR compliance.",
    whatYouAchieve: "Full GDPR compliance with enhanced data protection and privacy capabilities.",
    
    gdprTitle: "What is GDPR?",
    gdprDescription: "The General Data Protection Regulation (GDPR) is a comprehensive EU data protection law that governs how organizations collect, process, store, and protect personal data of EU residents.",
    
    principlesTitle: "GDPR Key Principles",
    principlesSubtitle: "Seven fundamental principles of data protection",
    principles: [
      { title: "Lawfulness, Fairness & Transparency", description: "Process data lawfully, fairly, and transparently" },
      { title: "Purpose Limitation", description: "Collect data for specified, explicit, and legitimate purposes" },
      { title: "Data Minimization", description: "Collect only data that is adequate, relevant, and necessary" },
      { title: "Accuracy", description: "Ensure data is accurate and kept up to date" },
      { title: "Storage Limitation", description: "Retain data only for as long as necessary" },
      { title: "Integrity & Confidentiality", description: "Process data securely and protect against unauthorized access" },
      { title: "Accountability", description: "Demonstrate compliance with GDPR principles" }
    ],
    
    complianceTitle: "GDPR Compliance Requirements",
    complianceSubtitle: "Essential areas for achieving compliance",
    complianceAreas: [
      { title: "Data Mapping", description: "Identify and document all personal data processing activities" },
      { title: "Legal Basis", description: "Establish legal basis for data processing activities" },
      { title: "Consent Management", description: "Implement effective consent collection and management" },
      { title: "Data Subject Rights", description: "Enable data subjects to exercise their rights" },
      { title: "Data Protection Impact Assessment", description: "Conduct DPIAs for high-risk processing activities" },
      { title: "Breach Notification", description: "Establish data breach detection and notification procedures" }
    ],
    
    whyChooseTitle: "Why Choose Our GDPR Services?",
    whyChooseSubtitle: "Expert guidance for data protection compliance",
    whyChoosePoints: [
      "Deep understanding of GDPR requirements",
      "Experience with data protection implementation",
      "Proven compliance methodologies and frameworks",
      "Ongoing support and maintenance services",
      "Industry best practices and standards"
    ],
    
    benefitsTitle: "Benefits of GDPR Compliance",
    benefitsSubtitle: "Strategic advantages of achieving compliance",
    benefitsList: [
      "Enhanced data protection and privacy",
      "Improved customer trust and confidence",
      "Reduced regulatory and legal risks",
      "Better data governance and management",
      "Competitive advantage in the market"
    ],
    
    implementationTitle: "Implementation Steps",
    implementationSubtitle: "Systematic approach to GDPR compliance",
    steps: [
      { number: "01", title: "Data Audit", description: "Conduct comprehensive data audit and mapping exercise" },
      { number: "02", title: "Gap Analysis", description: "Assess current practices against GDPR requirements" },
      { number: "03", title: "Policy Development", description: "Develop and implement data protection policies" },
      { number: "04", title: "Process Implementation", description: "Implement required data protection processes" },
      { number: "05", title: "Training & Awareness", description: "Train staff on GDPR requirements and procedures" }
    ],
    
    ctaTitle: "Ready to Achieve GDPR Compliance?",
    ctaSubtitle: "Get expert guidance for data protection and privacy",
    ctaButton: "Start GDPR Assessment",
    ctaDescription: "Our GDPR experts will help you navigate the requirements and achieve compliance efficiently."
  },
  
  fi: {
    title: "GDPR ja yksityisyys",
    subtitle: "Yleisen tietosuoja-asetuksen yhteensopivuus",
    description: "Navigoi GDPR yhteensopivuusvaatimukset asiantuntevan ohjauksen ja todistettujen toteutusstrategioiden avulla tietojen suojelun ja yksityisyyden osalta.",
    whoFor: "Organisaatioille, jotka käsittelevät EU:n asukkaiden henkilötietoja ja tarvitsevat GDPR yhteensopivuuden.",
    whatYouAchieve: "Täysi GDPR yhteensopivuus parannetulla tietojen suojelulla ja yksityisyyskyvyillä.",
    
    gdprTitle: "Mikä on GDPR?",
    gdprDescription: "Yleinen tietosuoja-asetus (GDPR) on kattava EU:n tietosuoja-laki, joka säätelee miten organisaatiot keräävät, käsittelevät, säilyttävät ja suojaavat EU:n asukkaiden henkilötietoja.",
    
    principlesTitle: "GDPR:n keskeiset periaatteet",
    principlesSubtitle: "Tietojen suojelun seitsemän perusperiaatetta",
    principles: [
      { title: "Laillisuus, oikeudenmukaisuus ja läpinäkyvyys", description: "Käsittele tietoja laillisesti, oikeudenmukaisesti ja läpinäkyvästi" },
      { title: "Tarkoituksen rajoittaminen", description: "Kerää tietoja määritellyihin, selkeisiin ja oikeutettuihin tarkoituksiin" },
      { title: "Tietojen minimointi", description: "Kerää vain riittäviä, asiaankuuluvia ja tarpeellisia tietoja" },
      { title: "Tarkkuus", description: "Varmista että tiedot ovat tarkkoja ja ajan tasalla" },
      { title: "Säilytysajan rajoittaminen", description: "Säilytä tietoja vain niin kauan kuin tarpeen" },
      { title: "Eheys ja luottamuksellisuus", description: "Käsittele tietoja turvallisesti ja suojaa luvattomalta pääsyltä" },
      { title: "Vastuullisuus", description: "Näytä GDPR periaatteiden noudattaminen" }
    ],
    
    complianceTitle: "GDPR yhteensopivuusvaatimukset",
    complianceSubtitle: "Yhteensopivuuden saavuttamisen keskeiset alueet",
    complianceAreas: [
      { title: "Tietojen kartoitus", description: "Tunnista ja dokumentoi kaikki henkilötietojen käsittelytoiminnot" },
      { title: "Oikeusperusta", description: "Perusta oikeusperusta tietojen käsittelytoiminnoille" },
      { title: "Suostumuksen hallinta", description: "Toteuta tehokas suostumuksen keräys ja hallinta" },
      { title: "Tietojen subjektin oikeudet", description: "Mahdollista tietojen subjektien oikeuksien käyttö" },
      { title: "Tietojen suojelun vaikutusarviointi", description: "Suorita TSVA:t korkeariskisille käsittelytoiminnoille" },
      { title: "Tietoturvaloukkauksen ilmoittaminen", description: "Perusta tietoturvaloukkauksen tunnistus- ja ilmoitusproseduurit" }
    ],
    
    whyChooseTitle: "Miksi valita GDPR-palvelumme?",
    whyChooseSubtitle: "Asiantuntevaa ohjausta tietojen suojelun yhteensopivuudelle",
    whyChoosePoints: [
      "Syvä ymmärrys GDPR vaatimuksista",
      "Kokemus tietojen suojelun toteutuksesta",
      "Todistetut yhteensopivuusmetodologiat ja kehykset",
      "Jatkuva tuki ja ylläpito",
      "Toimialan parhaat käytännöt ja standardit"
    ],
    
    benefitsTitle: "GDPR yhteensopivuuden edut",
    benefitsSubtitle: "Yhteensopivuuden saavuttamisen strategiset edut",
    benefitsList: [
      "Parannettu tietojen suojelu ja yksityisyys",
      "Parannettu asiakkaiden luottamus ja varmuus",
      "Alennettu sääntely- ja oikeusriski",
      "Parempi tietojen hallinta ja johtaminen",
      "Kilpailuetu markkinoilla"
    ],
    
    implementationTitle: "Toteutusvaiheet",
    implementationSubtitle: "Systemaattinen lähestymistapa GDPR yhteensopivuuteen",
    steps: [
      { number: "01", title: "Tietojen auditointi", description: "Suorita kattava tietojen auditointi ja kartoitus" },
      { number: "02", title: "Aukkoanalyysi", description: "Arvioi nykyiset käytännöt GDPR vaatimuksia vastaan" },
      { number: "03", title: "Politiikkojen kehitys", description: "Kehitä ja toteuta tietojen suojelupolitiikat" },
      { number: "04", title: "Prosessien toteutus", description: "Toteuta vaaditut tietojen suojeluprosessit" },
      { number: "05", title: "Koulutus ja tietoisuus", description: "Kouluta henkilökuntaa GDPR vaatimuksista ja proseduureista" }
    ],
    
    ctaTitle: "Valmiina saavuttamaan GDPR yhteensopivuuden?",
    ctaSubtitle: "Saa asiantuntevaa ohjausta tietojen suojeluun ja yksityisyyteen",
    ctaButton: "Aloita GDPR arviointi",
    ctaDescription: "GDPR asiantuntijamme auttavat sinua navigoimaan vaatimukset ja saavuttamaan yhteensopivuuden tehokkaasti."
  }
};

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- Hero Section - Matching homepage -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="max-w-4xl">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#1E2A7A]">{currentContent.title}</span>
        </h1>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl leading-relaxed mb-6">
          {currentContent.description}
        </p>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 mt-6">
          <p class="text-sm text-slate-500 mb-3">{lang === 'fi' ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}</p>
          <p class="text-slate-700 font-medium mb-4">{currentContent.whoFor}</p>
          <p class="text-sm text-slate-500 mb-2">{lang === 'fi' ? 'Mitä saavutat?' : 'What will you achieve?'}</p>
          <p class="text-slate-700 font-medium">{currentContent.whatYouAchieve}</p>
        </div>
      </div>
      
    </div>
  </section>

  <!-- What is GDPR Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.gdprTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-4xl mx-auto leading-relaxed">
          {currentContent.gdprDescription}
        </p>
      </div>
      
      <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-8">
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-xl font-bold text-[#1E2A7A] mb-4">EU Regulation</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Comprehensive data protection law</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Applies to EU residents' data</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Enforceable since May 2018</span>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1E2A7A] mb-4">Key Objectives</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Protect personal data rights</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Ensure data processing transparency</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Strengthen data security</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Principles Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.principlesTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.principlesSubtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.principles.map((principle) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-md transition-all duration-300 group">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 mb-1">{principle.title}</h3>
                <p class="text-sm text-slate-500">{principle.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Requirements Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.complianceTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.complianceSubtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.complianceAreas.map((area) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-5 hover:border-blue-300 hover:bg-slate-50 transition-all duration-300">
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1">{area.title}</h3>
                <p class="text-xs text-slate-500">{area.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Steps Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.implementationTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.implementationSubtitle}
        </p>
      </div>
      
      <div class="space-y-4">
        {currentContent.steps.map((step, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-5 hover:border-blue-300 hover:bg-slate-50 transition-all duration-300">
            <div class="flex flex-col md:flex-row md:items-center gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-xl flex items-center justify-center text-lg font-bold">
                  {step.number}
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-slate-900 mb-1">{step.title}</h3>
                <p class="text-sm text-slate-500">{step.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.whyChooseTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.whyChooseSubtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-12">
        <div class="space-y-4">
          {currentContent.whyChoosePoints.map((point) => (
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-slate-600">{point}</p>
            </div>
          ))}
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6">
          <h3 class="text-xl font-bold text-[#1E2A7A] mb-4">Our Privacy Expertise</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">Data protection specialists</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">GDPR implementation experience</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">Proven methodologies</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">Ongoing support</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.benefitsTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefitsSubtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.benefitsList.map((benefit) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-4 hover:border-blue-300 transition-all duration-300">
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-sm text-slate-600">{benefit}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section - Matching homepage -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
          {currentContent.ctaTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-4 max-w-2xl mx-auto leading-relaxed">
          {currentContent.ctaSubtitle}
        </p>
        <p class="text-sm text-slate-500 mb-8 max-w-2xl mx-auto">
          {currentContent.ctaDescription}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={lang === 'fi' ? '/fi/contact?consultation=true' : '/contact?consultation=true'} class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            {lang === 'fi' ? 'Varaa konsultaatio' : 'Book Consultation'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={lang === 'fi' ? '/fi/contact?proposal=true' : '/contact?proposal=true'} class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base gap-2">
            {lang === 'fi' ? 'Pyydä tarjous' : 'Request Proposal'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>