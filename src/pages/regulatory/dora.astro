    requirementsSubtitle: "Five pillars of digital operational resilience",
    requirements: [
      { title: "ICT Risk Management", description: "Establish comprehensive ICT risk management framework" },
      { title: "Incident Reporting", description: "Implement incident detection, classification, and reporting" },
      { title: "Digital Resilience Testing", description: "Conduct regular digital resilience testing programs" },
      { title: "ICT Third-Party Risk", description: "Manage ICT third-party risk and concentration risk" },
      { title: "Information Sharing", description: "Participate in information sharing arrangements" }
    ],
    
    complianceTitle: "DORA Compliance Areas",
    complianceSubtitle: "Comprehensive coverage of digital operational resilience",
    complianceAreas: [
      { title: "Risk Assessment", description: "Identify and assess ICT risks across all business areas" },
      { title: "Business Continuity", description: "Develop ICT business continuity and disaster recovery plans" },
      { title: "Access Control", description: "Implement robust identity and access management controls" },
      { title: "Data Protection", description: "Ensure data security and privacy compliance" },
      { title: "Monitoring & Detection", description: "Establish continuous monitoring and threat detection" },
      { title: "Response & Recovery", description: "Develop incident response and recovery procedures" }
    ],
    
    whyChooseTitle: "Why Choose Our DORA Services?",
    whyChooseSubtitle: "Expert guidance for financial sector compliance",
    whyChoosePoints: [
      "Deep understanding of financial sector regulations",
      "Experience with DORA implementation requirements",
      "Proven compliance methodologies and frameworks",
      "Ongoing support and maintenance services",
      "Industry best practices and standards"
    ],
    
    benefitsTitle: "Benefits of DORA Compliance",
    benefitsSubtitle: "Strategic advantages of achieving compliance",
    benefitsList: [
      "Enhanced operational resilience and business continuity",
      "Improved customer and stakeholder confidence",
      "Reduced regulatory and reputational risks",
      "Better incident response and recovery capabilities",
      "Competitive advantage in the financial market"
    ],
    
    implementationTitle: "Implementation Steps",
    implementationSubtitle: "Systematic approach to DORA compliance",
    steps: [
      { number: "01", title: "Gap Analysis", description: "Assess current ICT resilience against DORA requirements" },
      { number: "02", title: "Framework Design", description: "Design comprehensive ICT risk management framework" },
      { number: "03", title: "Control Implementation", description: "Implement required ICT controls and processes" },
      { number: "04", title: "Testing & Validation", description: "Conduct digital resilience testing and validation" },
      { number: "05", title: "Monitoring & Reporting", description: "Establish ongoing monitoring and reporting capabilities" }
    ],
    
    ctaTitle: "Ready to Achieve DORA Compliance?",
    ctaSubtitle: "Get expert guidance for financial sector digital resilience",
    ctaButton: "Start DORA Assessment",
    ctaDescription: "Our DORA experts will help you navigate the requirements and achieve compliance efficiently."
  },
  
  fi: {
    title: "DORA rahoituspalveluille",
    subtitle: "Digitaalisen toiminnallisen kestävyyden asetuksen toteutus",
    description: "Navigoi DORA yhteensopivuusvaatimukset rahoituslaitoksille asiantuntevan ohjauksen ja todistettujen toteutusstrategioiden avulla.",
    whoFor: "EU:ssa toimiville rahoituslaitoksille, sijoitusyhtiöille ja rahoitusmarkkinoiden infrastruktuurin tarjoajille.",
    whatYouAchieve: "Täysi DORA yhteensopivuus parannetulla toiminnallisella kestävyydellä ja kyberturvallisuuskyvyillä.",
    
    doraTitle: "Mikä on DORA?",
    doraDescription: "Digitaalisen toiminnallisen kestävyyden asetus (DORA) on kattava EU-asetus, joka määrittää yhtenäiset vaatimukset rahoitussektorin digitaaliselle toiminnalliselle kestävyydelle.",
    
    requirementsTitle: "DORA:n keskeiset vaatimukset",
    requirementsSubtitle: "Digitaalisen toiminnallisen kestävyyden viisi pilaria",
    requirements: [
      { title: "ICT-riskinjohtaminen", description: "Perusta kattava ICT-riskinjohtamiskehys" },
      { title: "Tapahtumaraportointi", description: "Toteuta tapahtumien tunnistus, luokittelu ja raportointi" },
      { title: "Digitaalisen kestävyyden testaus", description: "Suorita säännöllisiä digitaalisen kestävyyden testausohjelmia" },
      { title: "ICT kolmannen osapuolen riski", description: "Hallitse ICT kolmannen osapuolen riskiä" },
      { title: "Tiedon jakaminen", description: "Osallistu tiedon jakamissopimuksiin" }
    ],
    
    complianceTitle: "DORA yhteensopivuusalueet",
    complianceSubtitle: "Kattava digitaalisen toiminnallisen kestävyyden kattavuus",
    complianceAreas: [
      { title: "Riskinarviointi", description: "Tunnista ja arvioi ICT-riskejä kaikilla liiketoiminta-alueilla" },
      { title: "Liiketoiminnan jatkuvuus", description: "Kehitä ICT liiketoiminnan jatkuvuussuunnitelmat" },
      { title: "Käyttöoikeuksien hallinta", description: "Toteuta vahvat identiteetti- ja käyttöoikeuksien hallintakontrollit" },
      { title: "Tietojen suojelu", description: "Varmista tietoturva ja yksityisyyden suojelu" },
      { title: "Seuranta ja tunnistus", description: "Perusta jatkuva seuranta ja uhkien tunnistus" },
      { title: "Vastaus ja palautuminen", description: "Kehitä tapahtumien vastaus- ja palautumisproseduurit" }
    ],
    
    whyChooseTitle: "Miksi valita DORA-palvelumme?",
    whyChooseSubtitle: "Asiantuntevaa ohjausta rahoitussektorin yhteensopivuudelle",
    whyChoosePoints: [
      "Syvä ymmärrys rahoitussektorin sääntelystä",
      "Kokemus DORA toteutusvaatimuksista",
      "Todistetut yhteensopivuusmetodologiat",
      "Jatkuva tuki ja ylläpito",
      "Toimialan parhaat käytännöt"
    ],
    
    benefitsTitle: "DORA yhteensopivuuden edut",
    benefitsSubtitle: "Yhteensopivuuden saavuttamisen strategiset edut",
    benefitsList: [
      "Parannettu toiminnallinen kestävyys",
      "Parannettu asiakkaiden luottamus",
      "Alennettu sääntelyriski",
      "Paremmat tapahtumien vastauskyvyt",
      "Kilpailuetu rahoitusmarkkinoilla"
    ],
    
    implementationTitle: "Toteutusvaiheet",
    implementationSubtitle: "Systemaattinen lähestymistapa DORA yhteensopivuuteen",
    steps: [
      { number: "01", title: "Aukkoanalyysi", description: "Arvioi nykyinen ICT-kestävyys DORA vaatimuksia vastaan" },
      { number: "02", title: "Kehyksen suunnittelu", description: "Suunnittele kattava ICT-riskinjohtamiskehys" },
      { number: "03", title: "Kontrollin toteutus", description: "Toteuta vaaditut ICT-kontrollit" },
      { number: "04", title: "Testaus ja validointi", description: "Suorita digitaalisen kestävyyden testaus" },
      { number: "05", title: "Seuranta ja raportointi", description: "Perusta jatkuva seuranta ja raportointikyvyt" }
    ],
    
    ctaTitle: "Valmiina saavuttamaan DORA yhteensopivuuden?",
    ctaSubtitle: "Saa asiantuntevaa ohjausta rahoitussektorin digitaaliseen kestävyyteen",
    ctaButton: "Aloita DORA arviointi",
    ctaDescription: "DORA asiantuntijamme auttavat sinua navigoimaan vaatimukset."
  }
};

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- Hero Section - Matching homepage -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="max-w-4xl">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#1E2A7A]">{currentContent.title}</span>
        </h1>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl leading-relaxed mb-6">
          {currentContent.description}
        </p>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 mt-6">
          <p class="text-sm text-slate-500 mb-3">{lang === 'fi' ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}</p>
          <p class="text-slate-700 font-medium mb-4">{currentContent.whoFor}</p>
          <p class="text-sm text-slate-500 mb-2">{lang === 'fi' ? 'Mitä saavutat?' : 'What will you achieve?'}</p>
          <p class="text-slate-700 font-medium">{currentContent.whatYouAchieve}</p>
        </div>
      </div>
      
    </div>
  </section>

  <!-- What is DORA Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.doraTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-4xl mx-auto leading-relaxed">
          {currentContent.doraDescription}
        </p>
      </div>
      
      <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-8">
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-xl font-bold text-[#1E2A7A] mb-4">EU Regulation</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Comprehensive ICT resilience requirements</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Financial sector specific</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Mandatory compliance by 2025</span>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1E2A7A] mb-4">Key Objectives</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Enhance operational resilience</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Strengthen ICT risk management</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Improve incident response</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Requirements Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.requirementsTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.requirementsSubtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.requirements.map((requirement, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-md transition-all duration-300 group">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 mb-1">{requirement.title}</h3>
                <p class="text-sm text-slate-500">{requirement.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Areas Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.complianceTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.complianceSubtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.complianceAreas.map((area, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-5 hover:border-blue-300 hover:bg-slate-50 transition-all duration-300">
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1">{area.title}</h3>
                <p class="text-xs text-slate-500">{area.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Steps Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.implementationTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.implementationSubtitle}
        </p>
      </div>
      
      <div class="space-y-4">
        {currentContent.steps.map((step, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-5 hover:border-blue-300 hover:bg-slate-50 transition-all duration-300">
            <div class="flex flex-col md:flex-row md:items-center gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-xl flex items-center justify-center text-lg font-bold">
                  {step.number}
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-slate-900 mb-1">{step.title}</h3>
                <p class="text-sm text-slate-500">{step.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.whyChooseTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.whyChooseSubtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-12">
        <div class="space-y-4">
          {currentContent.whyChoosePoints.map((point, index) => (
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-slate-600">{point}</p>
            </div>
          ))}
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6">
          <h3 class="text-xl font-bold text-[#1E2A7A] mb-4">Our Financial Expertise</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">Regulatory compliance specialists</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">Financial sector experience</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">Proven methodologies</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">Ongoing support</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.benefitsTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefitsSubtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.benefitsList.map((benefit, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-4 hover:border-blue-300 transition-all duration-300">
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-sm text-slate-600">{benefit}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section - Matching homepage -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
          {currentContent.ctaTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-4 max-w-2xl mx-auto leading-relaxed">
          {currentContent.ctaSubtitle}
        </p>
        <p class="text-sm text-slate-500 mb-8 max-w-2xl mx-auto">
          {currentContent.ctaDescription}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={lang === 'fi' ? '/fi/contact?consultation=true' : '/contact?consultation=true'} class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            {lang === 'fi' ? 'Varaa konsultaatio' : 'Book Consultation'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={lang === 'fi' ? '/fi/contact?proposal=true' : '/contact?proposal=true'} class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base gap-2">
            {lang === 'fi' ? 'Pyydä tarjous' : 'Request Proposal'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>