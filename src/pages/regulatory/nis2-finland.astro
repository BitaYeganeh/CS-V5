            </div>
            
            <div class="flex-1">
              <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300">
                {step.title}
              </h3>
              <p class="text-slate-500 leading-relaxed">
                {step.description}
              </p>
            </div>
            
            <div class="flex-shrink-0">
              <svg class="w-6 h-6 text-[#1E2A7A] group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
            
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

