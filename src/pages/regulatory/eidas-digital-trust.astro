---
import Layout from '@/layouts/Layout.astro';
import Icon from "@ui/icons/Icon.astro";
import Button from "@ui/Button.astro";

const title = "eIDAS and Digital Trust";
const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    title: "eIDAS and Digital Trust",
    subtitle: "Electronic Identification and Trust Services",
    description: "Navigate eIDAS compliance requirements with expert guidance and proven implementation strategies for digital identity and trust services.",
    whoFor: "For organizations providing digital identity services, trust services, or needing to integrate with eIDAS-compliant systems in the EU.",
    whatYouAchieve: "Full eIDAS compliance with enhanced digital identity and trust service capabilities.",
    
    eidasTitle: "What is eIDAS?",
    eidasDescription: "The Electronic Identification, Authentication and Trust Services (eIDAS) regulation is an EU framework that ensures secure and seamless electronic interactions between businesses, citizens, and public authorities across the European Union.",
    
    componentsTitle: "eIDAS Key Components",
    componentsSubtitle: "Three main pillars of digital trust",
    components: [
      { title: "Electronic Identification", description: "Secure digital identity verification and authentication" },
      { title: "Electronic Signatures", description: "Legally recognized digital signature services" },
      { title: "Trust Services", description: "Certified digital trust and security services" }
    ],
    
    complianceTitle: "eIDAS Compliance Requirements",
    complianceSubtitle: "Essential areas for achieving compliance",
    complianceAreas: [
      { title: "Identity Verification", description: "Implement secure electronic identification processes" },
      { title: "Signature Services", description: "Provide qualified electronic signature services" },
      { title: "Trust Infrastructure", description: "Establish secure trust service infrastructure" },
      { title: "Cross-Border Recognition", description: "Ensure cross-border service recognition" },
      { title: "Security Standards", description: "Meet EU security and privacy standards" },
      { title: "Audit & Certification", description: "Obtain necessary certifications and audits" }
    ],
    
    whyChooseTitle: "Why Choose Our eIDAS Services?",
    whyChooseSubtitle: "Expert guidance for digital trust compliance",
    whyChoosePoints: [
      "Deep understanding of eIDAS requirements",
      "Experience with digital identity implementation",
      "Proven compliance methodologies and frameworks",
      "Ongoing support and maintenance services",
      "Industry best practices and standards"
    ],
    
    benefitsTitle: "Benefits of eIDAS Compliance",
    benefitsSubtitle: "Strategic advantages of achieving compliance",
    benefitsList: [
      "Enhanced digital identity security",
      "Improved cross-border service recognition",
      "Reduced regulatory and legal risks",
      "Better customer trust and confidence",
      "Competitive advantage in EU market"
    ],
    
    implementationTitle: "Implementation Steps",
    implementationSubtitle: "Systematic approach to eIDAS compliance",
    steps: [
      { number: "01", title: "Assessment", description: "Assess current digital identity and trust services" },
      { number: "02", title: "Gap Analysis", description: "Identify gaps against eIDAS requirements" },
      { number: "03", title: "Architecture Design", description: "Design eIDAS-compliant service architecture" },
      { number: "04", title: "Implementation", description: "Implement required services and controls" },
      { number: "05", title: "Certification", description: "Obtain necessary certifications and validations" }
    ],
    
    ctaTitle: "Ready to Achieve eIDAS Compliance?",
    ctaSubtitle: "Get expert guidance for digital identity and trust services",
    ctaButton: "Start eIDAS Assessment",
    ctaDescription: "Our eIDAS experts will help you navigate the requirements and achieve compliance efficiently."
  },
  
  fi: {
    title: "eIDAS ja digitaalinen luottamus",
    subtitle: "Sähköinen tunnistaminen ja luottamuspalvelut",
    description: "Navigoi eIDAS yhteensopivuusvaatimukset asiantuntevan ohjauksen ja todistettujen toteutusstrategioiden avulla digitaaliseen identiteettiin ja luottamuspalveluihin.",
    whoFor: "Organisaatioille, jotka tarjoavat digitaalisia identiteettipalveluita, luottamuspalveluita tai tarvitsevat integraatiota eIDAS-yhteensopiviin järjestelmiin EU:ssa.",
    whatYouAchieve: "Täysi eIDAS yhteensopivuus parannetulla digitaalisen identiteetin ja luottamuspalvelun kyvyillä.",
    
    eidasTitle: "Mikä on eIDAS?",
    eidasDescription: "Sähköinen tunnistaminen, autentikointi ja luottamuspalvelut (eIDAS) -asetus on EU:n kehys, joka varmistaa turvalliset ja saumattomat sähköiset vuorovaikutukset yritysten, kansalaisten ja julkisten viranomaisten välillä koko Euroopan unionissa.",
    
    componentsTitle: "eIDAS:n keskeiset komponentit",
    componentsSubtitle: "Digitaalisen luottamuksen kolme pilaria",
    components: [
      { title: "Sähköinen tunnistaminen", description: "Turvallinen digitaalinen identiteetin vahvistus ja autentikointi" },
      { title: "Sähköiset allekirjoitukset", description: "Oikeudellisesti tunnustetut digitaaliset allekirjoituspalvelut" },
      { title: "Luottamuspalvelut", description: "Sertifioidut digitaaliset luottamus- ja turvallisuuspalvelut" }
    ],
    
    complianceTitle: "eIDAS yhteensopivuusvaatimukset",
    complianceSubtitle: "Yhteensopivuuden saavuttamisen keskeiset alueet",
    complianceAreas: [
      { title: "Identiteetin vahvistus", description: "Toteuta turvalliset sähköiset tunnistamisprosessit" },
      { title: "Allekirjoituspalvelut", description: "Tarjoa päteviä sähköisiä allekirjoituspalveluita" },
      { title: "Luottamusinfrastruktuuri", description: "Perusta turvallinen luottamuspalvelun infrastruktuuri" },
      { title: "Rajat ylittävä tunnustus", description: "Varmista rajat ylittävän palvelun tunnustus" },
      { title: "Turvallisuusstandardit", description: "Täytä EU:n turvallisuus- ja yksityisyysstandardit" },
      { title: "Auditointi ja sertifiointi", description: "Hanki tarvittavat sertifikaatit ja auditit" }
    ],
    
    whyChooseTitle: "Miksi valita eIDAS-palvelumme?",
    whyChooseSubtitle: "Asiantuntevaa ohjausta digitaaliseen luottamukseen",
    whyChoosePoints: [
      "Syvä ymmärrys eIDAS vaatimuksista",
      "Kokemus digitaalisen identiteetin toteutuksesta",
      "Todistetut yhteensopivuusmetodologiat ja kehykset",
      "Jatkuva tuki ja ylläpito",
      "Toimialan parhaat käytännöt ja standardit"
    ],
    
    benefitsTitle: "eIDAS yhteensopivuuden edut",
    benefitsSubtitle: "Yhteensopivuuden saavuttamisen strategiset edut",
    benefitsList: [
      "Parannettu digitaalisen identiteetin turvallisuus",
      "Parannettu rajat ylittävän palvelun tunnustus",
      "Alennettu sääntely- ja oikeusriski",
      "Parempi asiakkaiden luottamus ja varmuus",
      "Kilpailuetu EU-markkinoilla"
    ],
    
    implementationTitle: "Toteutusvaiheet",
    implementationSubtitle: "Systemaattinen lähestymistapa eIDAS yhteensopivuuteen",
    steps: [
      { number: "01", title: "Arviointi", description: "Arvioi nykyiset digitaaliset identiteetti- ja luottamuspalvelut" },
      { number: "02", title: "Aukkoanalyysi", description: "Tunnista aukot eIDAS vaatimuksia vastaan" },
      { number: "03", title: "Arkkitehtuurin suunnittelu", description: "Suunnittele eIDAS-yhteensopiva palveluarkkitehtuuri" },
      { number: "04", title: "Toteutus", description: "Toteuta vaaditut palvelut ja kontrollit" },
      { number: "05", title: "Sertifiointi", description: "Hanki tarvittavat sertifikaatit ja validoinnit" }
    ],
    
    ctaTitle: "Valmiina saavuttamaan eIDAS yhteensopivuuden?",
    ctaSubtitle: "Saa asiantuntevaa ohjausta digitaaliseen identiteettiin ja luottamuspalveluihin",
    ctaButton: "Aloita eIDAS arviointi",
    ctaDescription: "eIDAS asiantuntijamme auttavat sinua navigoimaan vaatimukset ja saavuttamaan yhteensopivuuden tehokkaasti."
  }
};

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- Hero Section - Matching homepage -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="max-w-4xl">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#1E2A7A]">{currentContent.title}</span>
        </h1>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl leading-relaxed mb-6">
          {currentContent.description}
        </p>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 mt-6">
          <p class="text-sm text-slate-500 mb-3">{lang === 'fi' ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}</p>
          <p class="text-slate-700 font-medium mb-4">{currentContent.whoFor}</p>
          <p class="text-sm text-slate-500 mb-2">{lang === 'fi' ? 'Mitä saavutat?' : 'What will you achieve?'}</p>
          <p class="text-slate-700 font-medium">{currentContent.whatYouAchieve}</p>
        </div>
      </div>
      
    </div>
  </section>

  <!-- What is eIDAS Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.eidasTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-4xl mx-auto leading-relaxed">
          {currentContent.eidasDescription}
        </p>
      </div>
      
      <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-8">
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-xl font-bold text-[#1E2A7A] mb-4">EU Regulation</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Digital identity framework</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Cross-border recognition</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Trust service standards</span>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1E2A7A] mb-4">Key Benefits</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Secure digital interactions</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">Legal recognition</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-blue-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-600">EU-wide acceptance</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Components Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.componentsTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.componentsSubtitle}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.components.map((component) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-md transition-all duration-300 group">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 mb-1">{component.title}</h3>
                <p class="text-sm text-slate-500">{component.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Requirements Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.complianceTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.complianceSubtitle}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.complianceAreas.map((area) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-5 hover:border-blue-300 hover:bg-slate-50 transition-all duration-300">
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 mb-1">{area.title}</h3>
                <p class="text-xs text-slate-500">{area.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Steps Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.implementationTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.implementationSubtitle}
        </p>
      </div>

      <div class="space-y-4">
        {currentContent.steps.map((step, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-5 hover:border-blue-300 hover:bg-slate-50 transition-all duration-300">
            <div class="flex flex-col md:flex-row md:items-center gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-xl flex items-center justify-center text-lg font-bold">
                  {step.number}
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-bold text-slate-900 mb-1">{step.title}</h3>
                <p class="text-sm text-slate-500">{step.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.whyChooseTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.whyChooseSubtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-12">
        <div class="space-y-4">
          {currentContent.whyChoosePoints.map((point) => (
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-slate-600">{point}</p>
            </div>
          ))}
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6">
          <h3 class="text-xl font-bold text-[#1E2A7A] mb-4">Our Digital Trust Expertise</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">Identity specialists</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">Trust service experience</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">EU compliance knowledge</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
              <span class="text-slate-600 text-sm">Ongoing support</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.benefitsTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefitsSubtitle}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.benefitsList.map((benefit) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-4 hover:border-blue-300 transition-all duration-300">
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-sm text-slate-600">{benefit}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section - Matching homepage -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
          {currentContent.ctaTitle}
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-4 max-w-2xl mx-auto leading-relaxed">
          {currentContent.ctaSubtitle}
        </p>
        <p class="text-sm text-slate-500 mb-8 max-w-2xl mx-auto">
          {currentContent.ctaDescription}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={lang === 'fi' ? '/fi/contact?consultation=true' : '/contact?consultation=true'} class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            {lang === 'fi' ? 'Varaa konsultaatio' : 'Book Consultation'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={lang === 'fi' ? '/fi/contact?proposal=true' : '/contact?proposal=true'} class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base gap-2">
            {lang === 'fi' ? 'Pyydä tarjous' : 'Request Proposal'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>