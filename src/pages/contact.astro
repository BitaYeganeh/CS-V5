---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = 'en'; // Explicitly set to English for this version

const contactInfo = {
  title: "Get in Touch",
  subtitle: "Ready to Transform Your Business?",
  description: "Connect with our team of cybersecurity experts and discover how we can help you achieve compliance, enhance security, and drive business growth.",
  contactMethods: [
    {
      title: "Phone",
      value: "+358 44 5040308",
      icon: "phone",
      description: "Mon-Fri, 9:00-17:00"
    },
    {
      title: "Email",
      value: "info@cybersecurity.fi",
      icon: "envelope",
      description: "We typically respond within 24 hours"
    },
    {
      title: "Location",
      value: "Helsinki, Finland",
      icon: "locationMarker",
      description: "Serving clients globally"
    }
  ],
  services: [
    {
      name: "ISO 27001",
      description: "Complete ISMS implementation in 90 days"
    },
    {
      name: "NIS2 Compliance",
      description: "Prepare for NIS2 directive requirements"
    },
    {
      name: "GDPR Compliance",
      description: "Data protection and privacy management"
    },
    {
      name: "DORA Compliance",
      description: "Digital operational resilience"
    },
    {
      name: "V-CISO Service",
      description: "Virtual CISO guidance"
    },
    {
      name: "V-DPO Service",
      description: "Virtual Data Protection Officer"
    }
  ]
};
---

<Layout
  title="Contact Us - Cyber Security Finland"
  description="Contact Cyber Security Finland's expert team. We offer ISO 27001, NIS2, GDPR, and DORA compliance services globally."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-slate-50 via-white to-slate-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6">
          {contactInfo.title}
        </h1>
        <p class="text-xl md:text-2xl text-slate-600 mb-4">
          {contactInfo.subtitle}
        </p>
        <p class="text-lg text-slate-500 max-w-3xl mx-auto">
          {contactInfo.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Methods -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Contact Information</h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">
          Reach out to us through any of these channels
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {contactInfo.contactMethods.map(method => (
          <div class="bg-gradient-to-br from-slate-50 to-white rounded-xl p-8 border border-slate-200 text-center hover:shadow-lg transition-shadow duration-300">
            <div class="w-16 h-16 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <Icon name={method.icon} class="w-8 h-8 text-teal-600" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">{method.title}</h3>
            <p class="text-slate-600 font-medium text-lg mb-2">{method.value}</p>
            <p class="text-slate-500">{method.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-6">Send Us a Message</h2>
          <p class="text-lg text-slate-600 mb-8">
            Fill out the form below and our experts will get back to you as soon as possible.
          </p>

          <form
            id="contact-form"
            action="https://formspree.io/f/xkoojeyo"
            method="POST"
            class="space-y-6"
          >
            <!-- Hidden field for language -->
            <input type="hidden" name="_language" value="en" />

            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="firstName" class="block text-sm font-medium text-slate-700 mb-2">First Name <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  required
                  class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                  placeholder="Enter your first name"
                />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium text-slate-700 mb-2">Last Name <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  required
                  class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                  placeholder="Enter your last name"
                />
              </div>
            </div>

            <div>
              <label for="company" class="block text-sm font-medium text-slate-700 mb-2">Company <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="company"
                name="company"
                required
                class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                placeholder="Enter your company name"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-slate-700 mb-2">Email <span class="text-red-500">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                placeholder="Enter your email address"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-slate-700 mb-2">Phone Number</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                placeholder="Enter your phone number"
              />
            </div>

            <div>
              <label for="service" class="block text-sm font-medium text-slate-700 mb-2">Service Interest <span class="text-red-500">*</span></label>
              <select
                id="service"
                name="service"
                required
                class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 bg-white"
              >
                <option value="">Select a service</option>
                <option value="iso-27001">ISO 27001 Certification</option>
                <option value="nis2">NIS2 Compliance</option>
                <option value="gdpr">GDPR & Privacy</option>
                <option value="dora">DORA Compliance</option>
                <option value="soc2">SOC 2 Readiness</option>
                <option value="vciso">CISO as a Service</option>
                <option value="vdpo">DPO as a Service</option>
                <option value="risk">Risk Assessment</option>
                <option value="other">Other / General Inquiry</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-slate-700 mb-2">Message <span class="text-red-500">*</span></label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                placeholder="Describe your needs or questions..."
              ></textarea>
            </div>

            <div>
              <button
                type="submit"
                id="submit-btn"
                class="w-full px-6 py-4 bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 hover:to-cyan-700 text-white font-semibold rounded-lg transition-all duration-200 flex items-center justify-center gap-2"
              >
                <span id="btn-text">Send Message</span>
                <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
            </div>

            <!-- Success/Error Messages -->
            <div id="form-success" class="hidden p-6 bg-green-50 border border-green-200 rounded-lg">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="text-green-800 font-semibold text-lg mb-1">Message Received!</h4>
                  <p class="text-green-700">Thank you for contacting us. We have received your request and our team will get back to you within 24 hours.</p>
                  <p class="text-green-600 text-sm mt-2">If you have an urgent matter, please call us at +358 44 5040308.</p>
                </div>
              </div>
            </div>
            <div id="form-error" class="hidden p-6 bg-red-50 border border-red-200 rounded-lg">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="text-red-800 font-semibold text-lg mb-1">Submission Failed</h4>
                  <p class="text-red-700">Something went wrong while sending your message. Please try again.</p>
                  <p class="text-red-600 text-sm mt-2">Or contact us directly at <a href="mailto:info@cybersecurity.fi" class="underline font-medium">info@cybersecurity.fi</a> or call +358 44 5040308.</p>
                </div>
              </div>
            </div>
          </form>
        </div>

        <div>
          <h3 class="text-2xl font-bold text-slate-900 mb-6">Our Services</h3>
          <p class="text-slate-600 mb-8">
            Need compliance services? We have the expertise across all areas of cybersecurity and regulatory compliance.
          </p>

          <div class="space-y-6">
            {contactInfo.services.map(service => (
              <div class="flex items-start">
                <div class="flex-shrink-0 mt-1">
                  <div class="w-6 h-6 rounded-full bg-teal-100 flex items-center justify-center">
                    <Icon name="check" class="w-4 h-4 text-teal-600" />
                  </div>
                </div>
                <div class="ml-4">
                  <h4 class="font-semibold text-slate-900">{service.name}</h4>
                  <p class="text-slate-600 text-sm">{service.description}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-12 bg-gradient-to-br from-teal-50 to-cyan-50 rounded-xl p-6 border border-teal-200">
            <h4 class="font-bold text-slate-900 mb-3 flex items-center">
              <Icon name="lightBulb" class="w-5 h-5 text-teal-600 mr-2" />
              Why Choose Us?
            </h4>
            <ul class="space-y-2">
              <li class="flex items-start">
                <Icon name="checkCircle" class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">Expert team based in Finland</span>
              </li>
              <li class="flex items-start">
                <Icon name="checkCircle" class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">Proven methodologies with 90-day implementation</span>
              </li>
              <li class="flex items-start">
                <Icon name="checkCircle" class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">Ongoing support and expertise</span>
              </li>
              <li class="flex items-start">
                <Icon name="checkCircle" class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">Industry-specific expertise</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-slate-900 via-teal-900 to-slate-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-4">Ready to Get Started?</h2>
      <p class="text-xl mb-8 opacity-90">
        Don't wait for a security incident or audit. Contact our experts today.
      </p>
      <Button href="/services" variant="white">
        Explore Our Services
      </Button>
    </div>
  </section>
</Layout>

<script is:inline>
  // Handle form submission with AJAX for better UX
  (function() {
    var form = document.getElementById('contact-form');
    var submitBtn = document.getElementById('submit-btn');
    var btnText = document.getElementById('btn-text');
    var btnSpinner = document.getElementById('btn-spinner');
    var successMsg = document.getElementById('form-success');
    var errorMsg = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        // Show loading state
        btnText.textContent = 'Sending...';
        btnSpinner.classList.remove('hidden');
        submitBtn.disabled = true;
        successMsg.classList.add('hidden');
        errorMsg.classList.add('hidden');

        // Submit via fetch
        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            'Accept': 'application/json'
          }
        })
        .then(function(response) {
          if (response.ok) {
            // Success
            form.reset();
            successMsg.classList.remove('hidden');
            btnText.textContent = 'Send Message';
          } else {
            throw new Error('Form submission failed');
          }
        })
        .catch(function(error) {
          // Error
          errorMsg.classList.remove('hidden');
          btnText.textContent = 'Send Message';
        })
        .finally(function() {
          btnSpinner.classList.add('hidden');
          submitBtn.disabled = false;
        });
      });
    }
  })();
</script>
