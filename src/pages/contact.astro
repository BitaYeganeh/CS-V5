---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = 'en';

const contactInfo = {
  title: "Get in Touch",
  subtitle: "Ready to Transform Your Business?",
  description: "Connect with our team of cybersecurity experts and discover how we can help you achieve compliance, enhance security, and drive business growth.",
  contactMethods: [
    {
      title: "Phone",
      value: "+358 44 5040308",
      icon: "phone",
      description: "Mon-Fri, 9:00-17:00"
    },
    {
      title: "Email",
      value: "info@cybersecurity.fi",
      icon: "envelope",
      description: "We typically respond within 24 hours"
    },
    {
      title: "Location",
      value: "Helsinki, Finland",
      icon: "locationMarker",
      description: "Serving clients globally"
    }
  ],
  services: [
    { name: "ISO 27001", description: "Complete ISMS implementation in 90 days" },
    { name: "NIS2 Compliance", description: "Prepare for NIS2 directive requirements" },
    { name: "GDPR Compliance", description: "Data protection and privacy management" },
    { name: "DORA Compliance", description: "Digital operational resilience" },
    { name: "V-CISO Service", description: "Virtual CISO guidance" },
    { name: "V-DPO Service", description: "Virtual Data Protection Officer" }
  ]
};
---

<Layout title="Contact Us - Cyber Security Finland" description="Contact Cyber Security Finland's expert team. We offer ISO 27001, NIS2, GDPR, and DORA compliance services globally.">

  <!-- Hero Section - With contact.avif image -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <!-- Mobile layout (stacked vertically) -->
      <div class="flex flex-col items-center justify-center gap-6 mb-8 md:hidden">
        <img 
          src="/images/contact.avif"
          alt="Contact Cyber Security Finland"
          class="w-full max-w-md object-cover rounded-2xl"
          loading="eager"
        />
      </div>
      
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        <!-- Left Side: Content -->
        <div class="text-center md:text-left">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4 leading-tight">
            <span class="text-[#1E2A7A]">Get in Touch</span>
          </h1>
          <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
            Ready to Transform Your Business?
          </p>
          <p class="text-base md:text-lg text-slate-500 max-w-2xl leading-relaxed">
            Connect with our team of cybersecurity experts and discover how we can help you achieve compliance, enhance security, and drive business growth.
          </p>
        </div>
        
        <!-- Right Side: contact.avif image (desktop only) -->
        <div class="hidden md:block">
          <img 
            src="/images/contact.avif"
            alt="Contact Cyber Security Finland"
            class="w-full max-w-2xl lg:max-w-3xl mx-auto object-cover rounded-2xl"
            loading="eager"
          />
        </div>
        
      </div>
    </div>
  </section>

  <!-- Contact Methods Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          Contact Information
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          Reach out to us through any of these channels
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {contactInfo.contactMethods.map(method => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-8 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <Icon name={method.icon} class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">{method.title}</h3>
            <p class="text-slate-600 font-medium text-lg mb-2">{method.value}</p>
            <p class="text-slate-500 text-sm">{method.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Rest of your contact form and CTA sections remain the same -->
  <!-- ... (keep your existing form and CTA code) ... -->

</Layout>