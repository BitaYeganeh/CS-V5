---
import Layout from '@/layouts/Layout.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

// SEO Configuration
const seoConfig = {
  title: lang === 'fi' 
    ? "Ota yhteyttä | Kyberturvallisuuden asiantuntijat"
    : "Contact Us | Cybersecurity Experts",
  description: lang === 'fi'
    ? "Ota yhteyttä kyberturvallisuuden asiantuntijoihimme. Ilmainen konsultaatio ISO 27001, NIS2, GDPR ja DORA -vaatimustenmukaisuudesta. Puh: +358 44 5040308"
    : "Contact our cybersecurity experts. Free consultation for ISO 27001, NIS2, GDPR, and DORA compliance. Phone: +358 44 5040308",
  keywords: lang === 'fi'
    ? "kyberturvallisuus yhteystiedot, ISO 27001 konsultaatio, NIS2 neuvonta, GDPR asiantuntija suomi"
    : "cybersecurity contact, ISO 27001 consultation, NIS2 advisory, GDPR expert finland, cybersecurity consulting contact",
  type: "website" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Cyber Security Finland",
    "description": "Get in touch with our cybersecurity and compliance experts for consultation and services.",
    "provider": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "telephone": "+358 44 5040308",
      "email": "info@cybersecurity.fi",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "telephone": "+358 44 5040308",
        "email": "info@cybersecurity.fi",
        "availableLanguage": ["English", "Finnish"],
        "areaServed": "Finland"
      }
    }
  }
};

const content = {
  en: {
    title: "Get in Touch",
    subtitle: "Ready to Transform Your Business?",
    heroDescription: "Connect with our team of cybersecurity experts and discover how we can help you achieve compliance, enhance security, and drive business growth.",
    contactInfo: {
      title: "Contact Information",
      description: "We're here to help you navigate the complex world of cybersecurity and compliance. Reach out to us through any of these channels:",
      phone: "Phone",
      email: "Email",
      hours: "Business Hours",
      response: "Response Time"
    },
    cta: {
      title: "Ready to Get Started?",
      subtitle: "Join hundreds of organizations that trust us with their cybersecurity and compliance needs.",
      button: "Schedule a Consultation",
      link: "/contact"
    }
  },
  fi: {
    title: "Ota yhteyttä",
    subtitle: "Valmiit muuttamaan liiketoimintasi?",
    heroDescription: "Yhdistä meidän kyberturvallisuusasiantuntijoiden tiimiin ja löydä, miten voimme auttaa sinua saavuttamaan yhteensopivuuden, parantamaan turvallisuutta ja edistämään liiketoiminnan kasvua.",
    contactInfo: {
      title: "Yhteystiedot",
      description: "Olemme täällä auttaaksemme sinua navigoimaan kyberturvallisuuden ja yhteensopivuuden monimutkaisessa maailmassa. Ota meihin yhteyttä millä tahansa näistä kanavista:",
      phone: "Puhelin",
      email: "Sähköposti",
      hours: "Aukioloajat",
      response: "Vastausaika"
    },
    cta: {
      title: "Valmiit aloittamaan?",
      subtitle: "Liity satoihin organisaatioihin, jotka luottavat meihin kyberturvallisuus- ja yhteensopivuustarpeidensa kanssa.",
      button: "Varaa konsultaatio",
      link: "/contact"
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-teal-50 via-white to-blue-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-6">
        {currentContent.title}
      </h1>
      <p class="text-2xl font-light text-slate-600 mb-8">
        {currentContent.subtitle}
      </p>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto">
        {currentContent.heroDescription}
      </p>
    </div>
  </section>

  <!-- Contact Information Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          {currentContent.contactInfo.title}
      </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">
          {currentContent.contactInfo.description}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">
            {currentContent.contactInfo.phone}
          </h3>
          <p class="text-slate-600">+358 44 5040308</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">
            {currentContent.contactInfo.email}
          </h3>
          <p class="text-slate-600">info@cybersecurity.fi</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-slate-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">
        {currentContent.cta.title}
      </h2>
      <p class="text-xl text-slate-300 mb-8">
        {currentContent.cta.subtitle}
      </p>
      <a
        href={currentContent.cta.link}
        class="bg-teal-600 hover:bg-teal-700 text-white font-semibold py-3 px-8 rounded-lg text-lg transition duration-300 inline-block"
      >
        {currentContent.cta.button}
      </a>
    </div>
  </section>
</Layout>
