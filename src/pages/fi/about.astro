---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "About Us";

const content = {
  en: {
    title: "About Us",
    subtitle: "Leading Cybersecurity Experts in Finland",
    heroDescription: "We are a specialized cybersecurity and regulatory compliance advisory firm helping Finnish organizations effectively manage cyber risks and regulatory requirements.",
    mission: {
      title: "Our Mission",
      content: "We help Finnish organizations build a strong cybersecurity culture and comply with regulatory requirements without security slowing down business. We believe cybersecurity is a business enabler, not a barrier."
    },
    values: {
      title: "Our Values",
      subtitle: "These values guide everything we do",
      items: [
        {
          title: "Expertise",
          description: "We combine academic knowledge with practical expertise to provide the best possible service to our clients.",
          icon: "academic-cap"
        },
        {
          title: "Trust",
          description: "We operate openly and honestly in all our interactions. Trust is the foundation of all our client relationships.",
          icon: "shield-check"
        },
        {
          title: "Innovation",
          description: "We stay up-to-date with the latest cybersecurity and regulatory trends to provide our clients with the most current knowledge.",
          icon: "light-bulb"
        },
        {
          title: "Collaboration",
          description: "We believe the best solutions come from collaboration. We work closely with our clients throughout all projects.",
          icon: "user-group"
        }
      ]
    },
    team: {
      title: "Our Team",
      subtitle: "Our team consists of internationally recognized cybersecurity experts with over 100 years of combined experience across various industries.",
      members: [
        {
          name: "Mikko Virtanen",
          role: "Founder & CEO",
          bio: "20+ years of experience in cybersecurity and compliance. Recognized expert in ISO 27001 and NIS2 domains."
        },
        {
          name: "Anna Lehtinen",
          role: "Chief Information Security Officer",
          bio: "Renowned GDPR and data protection expert. Former regulator and certification specialist."
        },
        {
          name: "Juha Mäkinen",
          role: "Technical Director",
          bio: "Cybersecurity architect specializing in ISO 27001 and SOC 2 implementations."
        }
      ]
    },
    certifications: {
      title: "Certifications & Accreditations",
      subtitle: "Recognized expertise in the field",
      items: [
        {
          name: "ISO 27001 Certified",
          description: "Recognized experts in information security management system certification",
          icon: "shield-check"
        },
        {
          name: "GDPR Compliance",
          description: "Recognized data protection experts in EU General Data Protection Regulation",
          icon: "lock-closed"
        },
        {
          name: "NIS2 Directive Expert",
          description: "Specialized expertise in Network and Information Security Directive implementation",
          icon: "globe-alt"
        },
        {
          name: "DORA Compliance",
          description: "Digital operational resilience experts for the financial sector",
          icon: "building-library"
        }
      ]
    }
  },
  fi: {
    title: "Meistä",
    subtitle: "Johtava kyberturvallisuuden asiantuntija Suomessa",
    heroDescription: "Olemme erikoistunut kyberturvallisuuden ja sääntelyvaatimusten noudattamisen asiantuntijayritys, joka auttaa suomalaisia yrityksiä hallitsemaan kyberturvallisuusriskien ja sääntelyvaatimusten noudattamista tehokkaasti.",
    mission: {
      title: "Tehtävämme",
      content: "Autamme suomalaisia yrityksiä rakentamaan vahvaa kyberturvallisuuskulttuuria ja noudattamaan sääntelyvaatimuksia ilman, että turvallisuus hidastaa liiketoimintaa. Uskomme, että kyberturvallisuus on liiketoiminnan mahdollistaja, ei este."
    },
    values: {
      title: "Arvomme",
      subtitle: "Nämä arvot ohjaavat kaikkea mitä teemme",
      items: [
        {
          title: "Asiantuntemus",
          description: "Yhdistämme akateemisen tietämyksen käytännön asiantuntemukseen, jotta voimme tarjota parasta mahdollista palvelua asiakkaillemme.",
          icon: "academic-cap"
        },
        {
          title: "Luotettavuus",
          description: "Toimimme avoimesti ja rehellisesti kaikissa vuorovaikutuksissamme. Luottamus on perusta kaikille asiakassuhteillemme.",
          icon: "shield-check"
        },
        {
          title: "Innovaatio",
          description: "Pysymme ajan tasalla uusimmista kyberturvallisuus- ja sääntelytrendeistä, jotta voimme tarjota asiakkaillemme ajankohtaisinta tietoa.",
          icon: "light-bulb"
        },
        {
          title: "Yhteistyö",
          description: "Uskomme, että parhaat ratkaisut syntyy yhteistyöstä. Työskentelemme tiiviisti asiakkaidemme kanssa kaikkien projektien aikana.",
          icon: "user-group"
        }
      ]
    },
    team: {
      title: "Tiimimme",
      subtitle: "Tiimimme koostuu kansainvälisesti tunnetuista kyberturvallisuuden asiantuntijoista, joilla on yli 100 vuoden yhteensä kokemusta eri toimialoilta.",
      members: [
        {
          name: "Mikko Virtanen",
          role: "Perustaja & CEO",
          bio: "20+ vuoden kokemus kyberturvallisuudesta ja sääntelystä. Tunnettu asiantuntija ISO 27001 ja NIS2 -aloilla."
        },
        {
          name: "Anna Lehtinen",
          role: "Chief Information Security Officer",
          bio: "Tunnettu GDPR- ja tietosuojan asiantuntija. Edellinen viranomainen ja sertifiointiasiantuntija."
        },
        {
          name: "Juha Mäkinen",
          role: "Tekninen johtaja",
          bio: "Kyberturvallisuusarkkitehti, erikoistunut ISO 27001 ja SOC 2 -implementointiin."
        }
      ]
    },
    certifications: {
      title: "Sertifioinnit & Hyväksynnät",
      subtitle: "Tunnistamme ja hyväksyntämme alan asiantuntijuudesta",
      items: [
        {
          name: "ISO 27001 Sertifioitu",
          description: "Tunnistettu informaation turvallisuuden hallintajärjestelmän sertifioinnin asiantuntijoina",
          icon: "shield-check"
        },
        {
          name: "GDPR Yhteensopivuus",
          description: "Tunnistettu tietosuojan asiantuntijana EU:n yleisessä tietosuoja-asetuksessa",
          icon: "lock-closed"
        },
        {
          name: "NIS2 Direktiivin asiantuntija",
          description: "Erityisasiantuntemus verkko- ja informaatioturvallisuuden direktiivin toteutuksessa",
          icon: "globe-alt"
        },
        {
          name: "DORA Yhteensopivuus",
          description: "Digitaalisen toiminnallisen resilierenssin asiantuntija rahoitussektorille",
          icon: "building-library"
        }
      ]
    }
  }
};

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- FULL PAGE WRAPPER WITH WHITE BACKGROUND -->
  <div class="min-h-screen bg-white">
    
    <!-- Hero Section -->
    <section class="pt-12 md:pt-16 pb-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">
            <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
              {currentContent.subtitle}
            </span>
          </h1>
          <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl">
            {currentContent.heroDescription}
          </p>
        </div>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <h2 class="text-2xl md:text-3xl font-bold text-[#3B82F6] mb-4">
            {currentContent.mission.title}
          </h2>
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 md:p-8">
            <p class="text-base md:text-lg text-slate-600 leading-relaxed">
              {currentContent.mission.content}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="py-12 md:py-16 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-left mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl font-bold text-[#3B82F6] mb-2">
            {currentContent.values.title}
          </h2>
          <p class="text-base text-[#1E2A7A] max-w-3xl leading-relaxed">
            {currentContent.values.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {currentContent.values.items.map((value) => (
            <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                        hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                        transition-all duration-300
                        flex flex-col p-5 md:p-6 group relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
              
              <div class="flex justify-start mb-3 relative z-10">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#3B82F6]
                            transition-all duration-300
                            group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={value.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              
              <h3 class="text-base md:text-lg font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
                {value.title}
              </h3>
              <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
                {value.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-left mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl font-bold text-[#3B82F6] mb-2">
            {currentContent.team.title}
          </h2>
          <p class="text-base text-[#1E2A7A] max-w-3xl leading-relaxed">
            {currentContent.team.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {currentContent.team.members.map((member) => (
            <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                        hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                        transition-all duration-300
                        flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
              
              <div class="flex justify-center mb-3 relative z-10">
                <div class="w-20 h-20 rounded-full bg-gradient-to-br from-slate-200 to-slate-300 flex items-center justify-center
                            border-2 border-[#3B82F6] group-hover:border-[#3bb1f6] transition-all duration-300">
                  <span class="text-slate-500 text-xs font-medium">{member.name.split(' ').map(n => n[0]).join('')}</span>
                </div>
              </div>
              
              <h3 class="text-base md:text-lg font-bold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
                {member.name}
              </h3>
              <p class="text-sm font-medium text-[#3B82F6] mb-2 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
                {member.role}
              </p>
              <p class="text-xs md:text-sm text-slate-500 leading-relaxed group-hover:text-slate-600 transition-colors duration-300 relative z-10">
                {member.bio}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Certifications Section -->
    <section class="py-12 md:py-16 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-left mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl font-bold text-[#3B82F6] mb-2">
            {currentContent.certifications.title}
          </h2>
          <p class="text-base text-[#1E2A7A] max-w-3xl leading-relaxed">
            {currentContent.certifications.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {currentContent.certifications.items.map((cert) => (
            <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                        hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                        transition-all duration-300
                        flex flex-col p-5 md:p-6 group relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
              
              <div class="flex justify-start mb-3 relative z-10">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#3B82F6]
                            transition-all duration-300
                            group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={cert.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              
              <h3 class="text-base md:text-lg font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
                {cert.name}
              </h3>
              <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
                {cert.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl border-2 border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 p-8 md:p-12 text-center relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6]"></div>
          
          <div class="flex items-center justify-center gap-4 mb-4">
            <div class="h-px w-10 bg-gradient-to-r from-transparent to-[#1E2A7A]"></div>
            <span class="text-[#1E2A7A] text-xl font-bold">✦</span>
            <div class="h-px w-10 bg-gradient-to-l from-transparent to-[#1E2A7A]"></div>
          </div>
          
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3 text-[#1E2A7A]">
            {lang === 'fi' ? 'Oletko valmis aloittamaan?' : 'Ready to Get Started?'}
          </h2>
          <p class="text-sm md:text-base text-[#1E2A7A] mb-6 max-w-2xl mx-auto leading-relaxed">
            {lang === 'fi' ? 'Ota yhteyttä asiantuntijatiimiimme ja kokeile ilmainen arviointi.' : 'Contact our expert team and try a free assessment.'}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href={lang === 'fi' ? '/fi/contact' : '/contact'} class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] text-white hover:from-[#3bb1f6] hover:to-[#3B82F6] transition-all duration-300 hover:shadow-lg font-medium text-sm gap-2 group">
              {lang === 'fi' ? 'Aloita ilmainen arviointi' : 'Start Free Assessment'}
              <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a href={lang === 'fi' ? '/fi/services' : '/services'} class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border-2 border-[#3B82F6] text-[#3B82F6] bg-white hover:bg-gradient-to-r hover:from-[#3bb1f6] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-2 group">
              {lang === 'fi' ? 'Tutustu palveluihimme' : 'Explore Our Services'}
              <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>

</Layout>