---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = 'fi'; // Explicitly set to Finnish for this version

const resourceCategories = [
	{
		title: "Resurssikirjasto",
		description: "Lataa oppaita, malleja ja tarkistuslistoja",
		icon: "folder-open",
		items: [
			{
				title: "ISO 27001 Pika-aloitusopas",
				description: "25-sivuinen toteutusroadmap",
				href: "/fi/resources/guides/iso-27001-quick-start",
				type: "Opas",
				date: "2024-01-15"
			},
			{
				title: "NIS2 Yhteensopivuus -tarkistuslista",
				description: "Täysi vaatimusanalyysityökalu",
				href: "/fi/resources/guides/nis2-compliance-checklist",
				type: "Tarkistuslista",
				date: "2024-02-20"
			},
			{
				title: "GDPR Tietosuoja-vaikutusten arviointi -malli",
				description: "Valmiiksi määritelty PIA-kehys",
				href: "/fi/resources/guides/gdpr-pia-template",
				type: "Malli",
				date: "2024-01-30"
			}
		]
	},
	{
		title: "Whitepaperit",
		description: "Syvälliset tutkimukset ja analyysit",
		icon: "document-text",
		items: [
			{
				title: "NIS2 Direktiivin vaikutusanalyysi",
				description: "Yksityiskohtainen analyysi NIS2:n vaikutuksista eri toimialoille",
				href: "/fi/resources/whitepapers/nis2-impact-analysis",
				type: "Whitepaper",
				date: "2024-03-10"
			},
			{
				title: "DORA Sääntelyn vaikutus rahoitussektoriin",
				description: "Digitaalisen toiminnallisen resilierenssin sääntelyvaikutukset",
				href: "/fi/resources/whitepapers/dora-financial-impact",
				type: "Whitepaper",
				date: "2024-03-05"
			}
		]
	},
	{
		title: "Työkalut & Mallit",
		description: "Käytännönläheiset työkalut ja dokumenttipohjat",
		icon: "wrench-screwdriver",
		items: [
			{
				title: "Riskienhallintamatriisi",
				description: "ISO 27005 -standardin mukainen riskienhallintatyökalu",
				href: "/fi/resources/tools/risk-matrix-template",
				type: "Malli",
				date: "2024-02-15"
			},
			{
				title: "Tietoturhaloukkausten hallintaprotokolla",
				description: "Tietoturhaloukkausten hallinta ja ilmoitusprotokolla",
				href: "/fi/resources/tools/incident-response-template",
				type: "Pohja",
				date: "2024-02-25"
			}
		]
	}
];

const featuredResources = [
	{
		title: "ISO 27001 Toteutusopas",
		description: "Täysi ISMS-toteutus 90 päivässä -vaiheittainen opas",
		category: "ISO 27001",
		href: "/fi/resources/guides/iso-27001-implementation-guide",
		type: "Opas"
	},
	{
		title: "GDPR Tietosuojakäytännöt -mallipohja",
		description: "Valmis tietosuojakäytäntöjen pohja organisaatiollesi",
		category: "GDPR",
		href: "/fi/resources/templates/gdpr-policy-template",
		type: "Malli"
	},
	{
		title: "NIS2 Vaatimustarkistus",
		description: "Täysi NIS2-direktiivin vaatimustarkistuslista",
		category: "NIS2",
		href: "/fi/resources/checklists/nis2-requirements-checklist",
		type: "Tarkistuslista"
	}
];
---

<Layout 
	title="Resurssit - Kyberturvallisuus & Yhteensopivuus | Cyber Security Finland" 
	description="Lataa oppaita, malleja ja tarkistuslistoja kyberturvallisuuden ja sääntelyvaatimusten noudattamiseksi. ISO 27001, NIS2, GDPR, DORA."
>
	<!-- Hero Section -->
	<section class="bg-gradient-to-br from-slate-50 via-white to-slate-100 py-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center">
				<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6">
					{lang === 'fi' ? 'Resurssikirjasto' : 'Resource Library'}
				</h1>
				<p class="text-xl md:text-2xl text-slate-600 mb-4">
					{lang === 'fi' ? 'Oppaita, malleja ja työkaluja kyberturvallisuuden ja sääntelyn noudattamiseksi' : 'Guides, templates, and tools for cybersecurity and compliance'}
				</p>
				<p class="text-lg text-slate-500 max-w-3xl mx-auto">
					{lang === 'fi' 
						? 'Lataa käytännönläheisiä resursseja, jotka auttavat sinua hallitsemaan kyberturvallisuutta ja noudattamaan sääntelyvaatimuksia.' 
						: 'Download practical resources to help you manage cybersecurity and meet regulatory requirements.'}
				</p>
			</div>
		</div>
	</section>

	<!-- Featured Resources -->
	<section class="py-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold text-slate-900 mb-4">
					{lang === 'fi' ? 'Esittelyssä resurssit' : 'Featured Resources'}
				</h2>
				<p class="text-xl text-slate-600 max-w-3xl mx-auto">
					{lang === 'fi' 
						? 'Nämä resurssit ovat suosituksiamme aloittajille ja organisaatioille jotka rakentavat kyberturvallisuusohjelmaansa.' 
						: 'These resources are our recommendations for beginners and organizations building their cybersecurity program.'}
				</p>
			</div>
      
			<div class="grid md:grid-cols-3 gap-8">
				{featuredResources.map(resource => (
					<div class="bg-gradient-to-br from-slate-50 to-white rounded-xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow duration-200" key={resource.title}>
						<div class="flex justify-between items-start mb-4">
							<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
								{resource.type}
							</span>
							<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
								{resource.category}
							</span>
						</div>
						<h3 class="text-xl font-bold text-slate-900 mb-2">{resource.title}</h3>
						<p class="text-slate-600 mb-4">{resource.description}</p>
						<a 
							href={resource.href} 
							class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium group"
						>
							{lang === 'fi' ? 'Lataa nyt' : 'Download Now'}
							<Icon name="arrowRight" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
						</a>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Resource Categories -->
	<section class="py-16 bg-slate-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="space-y-16">
				{resourceCategories.map(category => (
					<div class="bg-white rounded-xl shadow-sm p-8 border border-slate-200" key={category.title}>
						<div class="flex items-center mb-8">
							<div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
								<Icon name={category.icon} class="w-6 h-6 text-blue-600" />
							</div>
							<div>
								<h2 class="text-2xl font-bold text-slate-900">{category.title}</h2>
								<p class="text-slate-600">{category.description}</p>
							</div>
						</div>
            
						<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
							{category.items.map(item => (
								<div class="border border-slate-200 rounded-lg p-5 hover:shadow-md transition-shadow duration-200" key={item.title}>
									<div class="flex justify-between items-start mb-3">
										<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-100 text-teal-800">
											{item.type}
										</span>
										<span class="text-xs text-slate-500">{item.date}</span>
									</div>
									<h3 class="font-semibold text-slate-900 mb-2">{item.title}</h3>
									<p class="text-slate-600 text-sm mb-4">{item.description}</p>
									<a 
										href={item.href} 
										class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800 font-medium group"
									>
										{lang === 'fi' ? 'Lue lisää' : 'Learn more'}
										<Icon name="arrowRight" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
									</a>
								</div>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-20 bg-gradient-to-r from-slate-900 via-blue-900 to-slate-900 text-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="text-4xl font-bold mb-4">
				{lang === 'fi' ? 'Tarvitsetko apua resurssien käytössä?' : 'Need help using these resources?'}
			</h2>
			<p class="text-xl mb-8 opacity-90">
				{lang === 'fi' 
					? 'Asiantuntijatietoomme auttaa sinua hyödyntämään näitä resursseja tehokkaasti organisaatiossasi.' 
					: 'Our expertise can help you leverage these resources effectively in your organization.'}
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<Button href="/fi/contact" variant="white">
					{lang === 'fi' ? 'Ota yhteyttä asiantuntijoihimme' : 'Contact Our Experts'}
				</Button>
				<Button href="/fi/services" variant="outline-white">
					{lang === 'fi' ? 'Tutustu palveluihimme' : 'Explore Our Services'}
				</Button>
			</div>
		</div>
	</section>
</Layout>
