---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = 'fi'; // Explicitly set to Finnish for this version

const packages = [
	{
		title: "ISO 27001 Fast-Track",
		description: "Täysi ISMS-toteutus 90 päivässä sertifiointituelle",
		duration: "90-120 päivää",
		price: "Alkaen 19 900€",
		features: [
			"Täysi ISMS-toteutus",
			"Käytäntöpohjat (50+ dokumenttia)",
			"Henkilöstökoulutus ja tiedotus",
			"Sertifiointitarkastuksen tuki",
			"12 kuukauden jatkuva tuki"
		],
		href: "/fi/packages/iso-27001-fast-track",
		color: "blue"
	},
	{
		title: "NIS2 Sprint -ohjelma",
		description: "Valmistele NIS2-direktiivin vaatimuksia 60-90 päivässä",
		duration: "60-90 päivää",
		price: "Alkaen 14 900€",
		features: [
			"NIS2 aukkokohtaus ja yhteensopivuusroadmap",
			"Riskienhallintakehyksen toteutus",
			"Tietoturhaloukkausten hallintamenettelyt",
			"Toimittajaketjun turvatoimet",
			"Sääntelyviranomaisten raportointiasetus"
		],
		href: "/fi/packages/nis2-sprint",
		color: "cyan"
	},
	{
		title: "SOC 2 Valmius-12 viikkoa",
		description: "Type I ja Type II valmius 12 viikossa",
		duration: "84 päivää",
		price: "Alkaen 16 900€",
		features: [
			"Type I ja Type II valmius",
			"Ohjauksen toteutus ja testaus",
			"Todistuskeruun kehys",
			"Tarkastuksen valmistelu ja tuki",
			"Jatkuva valvonta asetus"
		],
		href: "/fi/packages/soc2-readiness-12-weeks",
		color: "teal"
	},
	{
		title: "DORA-ohjelma-laatikossa",
		description: "Digitaalinen toiminnallinen resilierenssi rahoituspalveluille",
		duration: "75-105 päivää",
		price: "Alkaen 24 900€",
		features: [
			"ICT-riskienhallintakehys",
			"Kolmannen osapuolen riskien valvontaojelma",
			"Operaattorisen resilierenssin testaus",
			"Tietoturhaloukkausten ilmoitusmekanismit",
			"Liiketoiminnan jatkuvuuden parantaminen"
		],
		href: "/fi/packages/dora-program-in-a-box",
		color: "indigo"
	}
];

const ctaSection = {
	title: lang === 'fi' 
		? 'Etkö löydä sopivaa pakettia?' 
		: 'Can\'t find the right package?',
	description: lang === 'fi' 
		? 'Ota yhteyttä asiantuntijoidemme tiimiin ja konsultoimme sinulle räätälöidyn ratkaisun organisaatiosi tarpeisiin.' 
		: 'Contact our expert team to consult a customized solution for your organization\'s specific needs.',
	primaryCTA: { 
		text: lang === 'fi' ? 'Aloita ilmainen arviointi' : 'Start Free Assessment', 
		href: "/fi/contact" 
	},
	secondaryCTA: { 
		text: lang === 'fi' ? 'Näytä kaikki palvelut' : 'View All Services', 
		href: "/fi/services" 
	}
};
---

<Layout 
	title="Paketit - Kyberturvallisuuspalvelut | Cyber Security Finland" 
	description="Nopean toteutuksen kyberturvallisuus- ja sääntelyvaatimustenmukaisuuspaketit. ISO 27001, NIS2, GDPR ja DORA -paketit nopealla aikataululla."
>
	<!-- Hero Section -->
	<section class="bg-gradient-to-br from-slate-50 via-white to-slate-100 py-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center">
				<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6">
					{lang === 'fi' ? 'Valmiit palvelupaketit' : 'Ready-Made Service Packages'}
				</h1>
				<p class="text-xl md:text-2xl text-slate-600 mb-4">
					{lang === 'fi' ? 'Nopea toteutus, asiantunteva tuki ja todistetut metodologiat' : 'Fast implementation, expert support, and proven methodologies'}
				</p>
				<p class="text-lg text-slate-500 max-w-3xl mx-auto">
					{lang === 'fi' 
						? 'Valmiit paketit, jotka nopeuttavat sääntelyvaatimustenmukaisuutta ja parantavat kyberturvallisuuttasi ilman pitkää kehitysaikaa.' 
						: 'Ready-made packages that accelerate compliance and improve your cybersecurity posture without lengthy development cycles.'}
				</p>
			</div>
		</div>
	</section>

	<!-- Packages Grid -->
	<section class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
				{packages.map(pkg => (
					<div class="bg-gradient-to-br from-white to-slate-50 rounded-xl border border-slate-200 shadow-sm hover:shadow-lg transition-shadow duration-300 overflow-hidden group" key={pkg.title}>
						<div class={`h-2 bg-${pkg.color}-500`}></div>
						<div class="p-6">
							<h3 class="text-xl font-bold text-slate-900 mb-2">{pkg.title}</h3>
							<p class="text-slate-600 mb-4">{pkg.description}</p>
              
							<div class="mb-4">
								<div class="flex justify-between text-sm text-slate-500 mb-1">
									<span>{lang === 'fi' ? 'Aikajana' : 'Timeline'}</span>
									<span class="font-medium">{pkg.duration}</span>
								</div>
								<div class="flex justify-between text-sm text-slate-500">
									<span>{lang === 'fi' ? 'Hinta' : 'Price'}</span>
									<span class="font-medium">{pkg.price}</span>
								</div>
							</div>
              
							<ul class="space-y-2 mb-6">
								{pkg.features.map(feature => (
									<li class="flex items-start" key={feature}>
										<Icon name="checkCircle" class={`w-4 h-4 text-${pkg.color}-500 mt-0.5 mr-2 flex-shrink-0`} />
										<span class="text-slate-700 text-sm">{feature}</span>
									</li>
								))}
							</ul>
              
							<Button 
								href={pkg.href} 
								variant="primary" 
								className={`w-full bg-gradient-to-r from-${pkg.color}-600 to-${pkg.color}-700 hover:from-${pkg.color}-700 hover:to-${pkg.color}-800`}
							>
								{lang === 'fi' ? 'Lue lisää' : 'Learn More'}
							</Button>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-20 bg-gradient-to-r from-slate-900 via-blue-900 to-slate-900 text-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h2 class="text-4xl font-bold mb-4">
				{ctaSection.title}
			</h2>
			<p class="text-xl mb-8 opacity-90">
				{ctaSection.description}
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<Button href={ctaSection.primaryCTA.href} variant="white">
					{ctaSection.primaryCTA.text}
				</Button>
				<Button href={ctaSection.secondaryCTA.href} variant="outline-white">
					{ctaSection.secondaryCTA.text}
				</Button>
			</div>
		</div>
	</section>
</Layout>
