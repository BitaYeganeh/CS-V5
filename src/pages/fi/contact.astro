---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = 'fi'; // Explicitly set to Finnish for this version

const contactInfo = {
  title: "Ota yhteyttä",
  subtitle: "Valmis muuttamaan liiketoimintaasi?",
  description: "Yhdistä asiantuntemuksemme ja teknologiamme parantaaksesi kyberturvallisuutta ja sääntelyvaatimusten noudattamista organisaatiossasi.",
  contactMethods: [
    {
      title: "Puhelin",
      value: "+358 44 5040308",
      icon: "phone",
      description: "Ma-Pe, 9:00-17:00"
    },
    {
      title: "Sähköposti",
      value: "info@cybersecurity.fi",
      icon: "envelope",
      description: "Vastaaamme yleensä 24 tunnin sisällä"
    },
    {
      title: "Osoite",
      value: "Helsinki, Suomi",
      icon: "locationMarker",
      description: "Palvelemme koko Suomea"
    }
  ],
  services: [
    {
      name: "ISO 27001",
      description: "Täysi ISMS-toteutus 90 päivässä"
    },
    {
      name: "NIS2 Yhteensopivuus",
      description: "Valmistele NIS2-direktiivin vaatimuksia"
    },
    {
      name: "GDPR Yhteensopivuus",
      description: "Tietosuojan hallinta ja yksityisyydensuoja"
    },
    {
      name: "DORA Yhteensopivuus",
      description: "Digitaalinen toiminnallinen resilierenssi"
    },
    {
      name: "V-CISO Palvelu",
      description: "Virtuaalinen CISO-ohjaus"
    },
    {
      name: "V-DPO Palvelu",
      description: "Virtuaalinen tietosuojavastaava"
    }
  ]
};
---

<Layout 
  title="Ota yhteyttä - Cyber Security Finland" 
  description="Ota yhteyttä Cyber Security Finlandin asiantuntijatiimiin. Tarjoamme ISO 27001, NIS2, GDPR ja DORA -yhteensopivuuspalveluita Suomessa."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-slate-50 via-white to-slate-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6">
          {contactInfo.title}
        </h1>
        <p class="text-xl md:text-2xl text-slate-600 mb-4">
          {contactInfo.subtitle}
        </p>
        <p class="text-lg text-slate-500 max-w-3xl mx-auto">
          {contactInfo.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Methods -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Yhteystiedot</h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">
          Ota meihin yhteyttä millä tahansa näistä tavoista
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {contactInfo.contactMethods.map(method => (
          <div class="bg-gradient-to-br from-slate-50 to-white rounded-xl p-8 border border-slate-200 text-center hover:shadow-lg transition-shadow duration-300" key={method.title}>
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <Icon name={method.icon} class="w-8 h-8 text-blue-600" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">{method.title}</h3>
            <p class="text-slate-600 font-medium text-lg mb-2">{method.value}</p>
            <p class="text-slate-500">{method.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-6">Lähetä viesti</h2>
          <p class="text-lg text-slate-600 mb-8">
            Täytä alla oleva lomake, ja asiantuntijamme ottavat sinuun yhteyttä mahdollisimman pian.
          </p>
          
          <form
            id="contact-form"
            action="https://formspree.io/f/xkoojeyo"
            method="POST"
            class="space-y-6"
          >
            <!-- Hidden field for language -->
            <input type="hidden" name="_language" value="fi" />

            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="firstName" class="block text-sm font-medium text-slate-700 mb-2">Etunimi <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  required
                  class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="Syötä etunimesi"
                />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium text-slate-700 mb-2">Sukunimi <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  required
                  class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="Syötä sukunimesi"
                />
              </div>
            </div>

            <div>
              <label for="company" class="block text-sm font-medium text-slate-700 mb-2">Yritys <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="company"
                name="company"
                required
                class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Syötä yrityksesi nimi"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-slate-700 mb-2">Sähköposti <span class="text-red-500">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Syötä sähköpostiosoitteesi"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-slate-700 mb-2">Puhelinnumero</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Syötä puhelinnumerosi"
              />
            </div>

            <div>
              <label for="service" class="block text-sm font-medium text-slate-700 mb-2">Kiinnostunut palveluista <span class="text-red-500">*</span></label>
              <select
                id="service"
                name="service"
                required
                class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white"
              >
                <option value="">Valitse palvelu</option>
                <option value="iso-27001">ISO 27001 -sertifiointi</option>
                <option value="nis2">NIS2-vaatimustenmukaisuus</option>
                <option value="gdpr">GDPR & Tietosuoja</option>
                <option value="dora">DORA-vaatimustenmukaisuus</option>
                <option value="soc2">SOC 2 -valmius</option>
                <option value="vciso">CISO-palveluna</option>
                <option value="vdpo">DPO-palveluna</option>
                <option value="risk">Riskien arviointi</option>
                <option value="other">Muu / Yleinen tiedustelu</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-slate-700 mb-2">Viesti <span class="text-red-500">*</span></label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full rounded-lg border border-slate-300 px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Kuvaile tarpeitasi tai kysymyksiäsi..."
              ></textarea>
            </div>

            <div>
              <button
                type="submit"
                id="submit-btn"
                class="w-full px-6 py-4 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-700 hover:to-cyan-700 text-white font-semibold rounded-lg transition-all duration-200 flex items-center justify-center gap-2"
              >
                <span id="btn-text">Lähetä viesti</span>
                <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
            </div>

            <!-- Success/Error Messages -->
            <div id="form-success" class="hidden p-6 bg-green-50 border border-green-200 rounded-lg">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="text-green-800 font-semibold text-lg mb-1">Viesti vastaanotettu!</h4>
                  <p class="text-green-700">Kiitos yhteydenotostasi. Olemme vastaanottaneet pyyntösi ja tiimimme ottaa sinuun yhteyttä 24 tunnin kuluessa.</p>
                  <p class="text-green-600 text-sm mt-2">Jos asiasi on kiireellinen, soita meille numeroon +358 44 5040308.</p>
                </div>
              </div>
            </div>
            <div id="form-error" class="hidden p-6 bg-red-50 border border-red-200 rounded-lg">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="text-red-800 font-semibold text-lg mb-1">Lähetys epäonnistui</h4>
                  <p class="text-red-700">Jokin meni pieleen viestiä lähetettäessä. Yritä uudelleen.</p>
                  <p class="text-red-600 text-sm mt-2">Tai ota meihin yhteyttä suoraan osoitteessa <a href="mailto:info@cybersecurity.fi" class="underline font-medium">info@cybersecurity.fi</a> tai soita +358 44 5040308.</p>
                </div>
              </div>
            </div>
          </form>
        </div>
        
        <div>
          <h3 class="text-2xl font-bold text-slate-900 mb-6">Palvelumme</h3>
          <p class="text-slate-600 mb-8">
            Tarvitsemme yhteensopivuuspalveluita? Meiltä löydät asiantuntemuksen kaikille kyberturvallisuuden ja sääntelyn noudattamisen aloille.
          </p>
          
          <div class="space-y-6">
            {contactInfo.services.map(service => (
              <div class="flex items-start" key={service.name}>
                <div class="flex-shrink-0 mt-1">
                  <div class="w-6 h-6 rounded-full bg-blue-100 flex items-center justify-center">
                    <Icon name="check" class="w-4 h-4 text-blue-600" />
                  </div>
                </div>
                <div class="ml-4">
                  <h4 class="font-semibold text-slate-900">{service.name}</h4>
                  <p class="text-slate-600 text-sm">{service.description}</p>
                </div>
              </div>
            ))}
          </div>
          
          <div class="mt-12 bg-gradient-to-br from-blue-50 to-cyan-50 rounded-xl p-6 border border-blue-200">
            <h4 class="font-bold text-slate-900 mb-3 flex items-center">
              <Icon name="lightBulb" class="w-5 h-5 text-blue-600 mr-2" />
              Miksi valita meidät?
            </h4>
            <ul class="space-y-2">
              <li class="flex items-start">
                <Icon name="checkCircle" class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">Asiantuntijoiden tiimi Suomessa</span>
              </li>
              <li class="flex items-start">
                <Icon name="checkCircle" class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">Todistetut metodologiat ja 90 päivän toteutus</span>
              </li>
              <li class="flex items-start">
                <Icon name="checkCircle" class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">Jatkuva tuki ja asiantuntemus</span>
              </li>
              <li class="flex items-start">
                <Icon name="checkCircle" class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">Toimialakohtainen asiantuntemus</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-slate-900 via-blue-900 to-slate-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold mb-4">Oletko valmis aloittamaan?</h2>
      <p class="text-xl mb-8 opacity-90">
        Älä odota tietoturvaloukkausta tai sääntelytarkastusta. Ota yhteyttä asiantuntijoihimme jo tänään.
      </p>
      <Button href="/fi/services" variant="white">
        Tutustu palveluihimme
      </Button>
    </div>
  </section>
</Layout>

<script is:inline>
  // Handle form submission with AJAX for better UX
  (function() {
    var form = document.getElementById('contact-form');
    var submitBtn = document.getElementById('submit-btn');
    var btnText = document.getElementById('btn-text');
    var btnSpinner = document.getElementById('btn-spinner');
    var successMsg = document.getElementById('form-success');
    var errorMsg = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        // Show loading state
        btnText.textContent = 'Lähetetään...';
        btnSpinner.classList.remove('hidden');
        submitBtn.disabled = true;
        successMsg.classList.add('hidden');
        errorMsg.classList.add('hidden');

        // Submit via fetch
        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            'Accept': 'application/json'
          }
        })
        .then(function(response) {
          if (response.ok) {
            // Success
            form.reset();
            successMsg.classList.remove('hidden');
            btnText.textContent = 'Lähetä viesti';
          } else {
            throw new Error('Form submission failed');
          }
        })
        .catch(function(error) {
          // Error
          errorMsg.classList.remove('hidden');
          btnText.textContent = 'Lähetä viesti';
        })
        .finally(function() {
          btnSpinner.classList.add('hidden');
          submitBtn.disabled = false;
        });
      });
    }
  })();
</script>