---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? "Ota yhteyttä" : "Contact",
  description: lang === 'fi'
    ? "Ota yhteyttä Cyber Security Finlandin kyberturvallisuusasiantuntijoihin."
    : "Contact Cyber Security Finland's cybersecurity experts.",
  type: "page" as const,
};

const content = {
  en: {
    title: "Contact",
    subtitle: "Get in Touch",
    description: "Connect with our team of cybersecurity experts. We're here to help you with your security challenges.",
    phone: "Phone",
    email: "Email",
    location: "Location",
    phoneValue: "+358 44 5040308",
    emailValue: "info@cybersecurity.fi",
    locationValue: "Helsinki, Finland",
    hours: "Mon-Fri, 9:00-17:00",
    responseTime: "We respond within 24h",
    global: "Serving clients globally",
    formTitle: "Send Us a Message",
    firstName: "First Name",
    lastName: "Last Name",
    company: "Company",
    emailLabel: "Email",
    phoneLabel: "Phone Number",
    serviceInterest: "Service Interest",
    messageLabel: "Message",
    send: "Send Message",
    selectService: "Select a service",
    servicesList: [
      { name: "ISO 27001", desc: "Complete ISMS implementation in 90 days" },
      { name: "NIS2 Compliance", desc: "Prepare for NIS2 directive requirements" },
      { name: "GDPR Compliance", desc: "Data protection and privacy management" },
      { name: "DORA Compliance", desc: "Digital operational resilience" },
      { name: "V-CISO Service", desc: "Virtual CISO guidance" },
      { name: "V-DPO Service", desc: "Virtual Data Protection Officer" }
    ],
    whyChoose: "Why Choose Us?",
    whyItems: [
      "Expert team based in Finland",
      "Proven methodologies with 90-day implementation",
      "Ongoing support and expertise",
      "Industry-specific expertise"
    ],
    success: "Message Received!",
    successDesc: "Thank you for contacting us. We have received your request and our team will get back to you within 24 hours.",
    successUrgent: "If your matter is urgent, please call us at +358 44 5040308.",
    error: "Submission Failed",
    errorDesc: "Something went wrong while sending your message. Please try again.",
    errorContact: "Or contact us directly at info@cybersecurity.fi or call +358 44 5040308.",
    sending: "Sending...",
    backToHome: "Back to Home"
  },
  fi: {
    title: "Ota yhteyttä",
    subtitle: "Ota yhteyttä",
    description: "Yhdistä asiantuntemuksemme ja teknologiamme parantaaksesi kyberturvallisuutta ja sääntelyvaatimusten noudattamista organisaatiossasi.",
    phone: "Puhelin",
    email: "Sähköposti",
    location: "Osoite",
    phoneValue: "+358 44 5040308",
    emailValue: "info@cybersecurity.fi",
    locationValue: "Helsinki, Suomi",
    hours: "Ma-Pe, 9:00-17:00",
    responseTime: "Vastaamme 24 tunnin sisällä",
    global: "Palvelemme asiakkaita maailmanlaajuisesti",
    formTitle: "Lähetä viesti",
    firstName: "Etunimi",
    lastName: "Sukunimi",
    company: "Yritys",
    emailLabel: "Sähköposti",
    phoneLabel: "Puhelinnumero",
    serviceInterest: "Kiinnostuksen kohde",
    messageLabel: "Viesti",
    send: "Lähetä viesti",
    selectService: "Valitse palvelu",
    servicesList: [
      { name: "ISO 27001", desc: "Täysi ISMS-toteutus 90 päivässä" },
      { name: "NIS2 Yhteensopivuus", desc: "Valmistaudu NIS2-direktiivin vaatimuksiin" },
      { name: "GDPR Yhteensopivuus", desc: "Tietosuojan hallinta ja yksityisyydensuoja" },
      { name: "DORA Yhteensopivuus", desc: "Digitaalinen operatiivinen resilienssi" },
      { name: "V-CISO Palvelu", desc: "Virtuaalinen CISO-ohjaus" },
      { name: "V-DPO Palvelu", desc: "Virtuaalinen tietosuojavastaava" }
    ],
    whyChoose: "Miksi valita meidät?",
    whyItems: [
      "Asiantuntijatiimi Suomessa",
      "Todistetut menetelmät 90 päivän toteutuksella",
      "Jatkuva tuki ja asiantuntemus",
      "Toimialakohtainen asiantuntemus"
    ],
    success: "Viesti vastaanotettu!",
    successDesc: "Kiitos yhteydenotostasi. Olemme vastaanottaneet pyyntösi ja tiimimme ottaa sinuun yhteyttä 24 tunnin kuluessa.",
    successUrgent: "Jos asiasi on kiireellinen, soita meille numeroon +358 44 5040308.",
    error: "Lähetys epäonnistui",
    errorDesc: "Jokin meni pieleen viestiä lähetettäessä. Yritä uudelleen.",
    errorContact: "Tai ota meihin yhteyttä suoraan osoitteessa info@cybersecurity.fi tai soita +358 44 5040308.",
    sending: "Lähetetään...",
    backToHome: "Takaisin etusivulle"
  }
};

const c = content[lang] || content.fi;
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {c.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {c.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Information Cards -->
  <section class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Phone -->
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 text-center hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 group">
          <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center mx-auto mb-3 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
            <Icon name="phone" class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
          </div>
          <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300">{c.phone}</h3>
          <p class="text-sm text-slate-500">{c.phoneValue}</p>
          <p class="text-xs text-slate-400 mt-1">{c.hours}</p>
        </div>

        <!-- Email -->
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 text-center hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 group">
          <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center mx-auto mb-3 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
            <Icon name="mail" class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
          </div>
          <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300">{c.email}</h3>
          <p class="text-sm text-slate-500">{c.emailValue}</p>
          <p class="text-xs text-slate-400 mt-1">{c.responseTime}</p>
        </div>

        <!-- Location -->
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 text-center hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 group">
          <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center mx-auto mb-3 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
            <Icon name="map-pin" class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
          </div>
          <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300">{c.location}</h3>
          <p class="text-sm text-slate-500">{c.locationValue}</p>
          <p class="text-xs text-slate-400 mt-1">{c.global}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <h2 class="text-2xl md:text-3xl font-bold text-[#3B82F6] mb-6">{c.formTitle}</h2>
          <form id="contact-form" action="https://formspree.io/f/xkoojeyo" method="POST" class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 md:p-8">
            <input type="hidden" name="_language" value={isFi ? 'fi' : 'en'} />
            
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{c.firstName} <span class="text-red-500">*</span></label>
                <input type="text" id="firstName" name="firstName" required aria-required="true" autocomplete="given-name" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna etunimesi' : 'Enter your first name'} />
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{c.lastName} <span class="text-red-500">*</span></label>
                <input type="text" id="lastName" name="lastName" required aria-required="true" autocomplete="family-name" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna sukunimesi' : 'Enter your last name'} />
              </div>
            </div>
            
            <div class="mt-6">
              <label class="block text-sm font-medium text-slate-700 mb-2">{c.company} <span class="text-red-500">*</span></label>
              <input type="text" id="company" name="company" required aria-required="true" autocomplete="organization" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Syötä yrityksesi nimi' : 'Enter your company name'} />
            </div>

            <div class="grid md:grid-cols-2 gap-6 mt-6">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{c.emailLabel} <span class="text-red-500">*</span></label>
                <input type="email" id="email" name="email" required aria-required="true" autocomplete="email" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna sähköpostiosoitteesi' : 'Enter your email address'} />
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{c.phoneLabel}</label>
                <input type="tel" id="phone" name="phone" autocomplete="tel" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna puhelinnumerosi' : 'Enter your phone number'} />
              </div>
            </div>

            <div class="mt-6">
              <label class="block text-sm font-medium text-slate-700 mb-2">{c.serviceInterest} <span class="text-red-500">*</span></label>
              <select id="service" name="service" required aria-required="true" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white">
                <option value="">{c.selectService}</option>
                <option value="iso-27001">ISO 27001 Certification</option>
                <option value="nis2">NIS2 Compliance</option>
                <option value="gdpr">GDPR & Privacy</option>
                <option value="dora">DORA Compliance</option>
                <option value="soc2">SOC2 Readiness</option>
                <option value="ciso">CISO as a Service</option>
                <option value="dpo">DPO as a Service</option>
                <option value="risk">Risk Assessment</option>
                <option value="other">{isFi ? 'Muu / Yleinen tiedustelu' : 'Other/General Inquiry'}</option>
              </select>
            </div>

            <div class="mt-6">
              <label class="block text-sm font-medium text-slate-700 mb-2">{c.messageLabel} <span class="text-red-500">*</span></label>
              <textarea id="message" name="message" required aria-required="true" rows="5" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Kuvaile tarpeitasi tai kysymyksiäsi...' : 'Describe your needs or questions...'}></textarea>
            </div>

            <div class="mt-6">
              <button type="submit" id="submit-btn" class="w-full md:w-auto inline-flex items-center justify-center px-8 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm">
                <span id="btn-text">{c.send}</span>
                <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin ml-2" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
            </div>

            <!-- Success Message -->
            <div id="form-success" class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-xl">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h4 class="text-green-800 font-semibold">{c.success}</h4>
                  <p class="text-green-700 text-sm">{c.successDesc}</p>
                  <p class="text-green-600 text-sm mt-1">{c.successUrgent}</p>
                </div>
              </div>
            </div>

            <!-- Error Message -->
            <div id="form-error" class="hidden mt-6 p-4 bg-red-50 border border-red-200 rounded-xl">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h4 class="text-red-800 font-semibold">{c.error}</h4>
                  <p class="text-red-700 text-sm">{c.errorDesc}</p>
                  <p class="text-red-600 text-sm mt-1">{c.errorContact}</p>
                </div>
              </div>
            </div>
          </form>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300">
            <h3 class="text-base font-bold text-[#1E40AF] mb-3">{isFi ? 'Palvelumme' : 'Our Services'}</h3>
            <ul class="space-y-3">
              {c.servicesList.map((service) => (
                <li class="flex items-start gap-2 text-sm text-slate-600" key={service.name}>
                  <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  <span><span class="font-semibold text-slate-700">{service.name}</span> — {service.desc}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300">
            <h3 class="text-base font-bold text-[#1E40AF] mb-3">{c.whyChoose}</h3>
            <ul class="space-y-3">
              {c.whyItems.map((item) => (
                <li class="flex items-start gap-2 text-sm text-slate-600" key={item}>
                  <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <a href="/" class="inline-flex items-center justify-center w-full px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-2">
            {c.backToHome}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  (function() {
    var form = document.getElementById('contact-form');
    var submitBtn = document.getElementById('submit-btn');
    var btnText = document.getElementById('btn-text');
    var btnSpinner = document.getElementById('btn-spinner');
    var successMsg = document.getElementById('form-success');
    var errorMsg = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        btnText.textContent = 'Sending...';
        btnSpinner.classList.remove('hidden');
        submitBtn.disabled = true;
        successMsg.classList.add('hidden');
        errorMsg.classList.add('hidden');

        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            'Accept': 'application/json'
          }
        })
        .then(function(response) {
          if (response.ok) {
            form.reset();
            successMsg.classList.remove('hidden');
            btnText.textContent = 'Send Message';
          } else {
            throw new Error('Form submission failed');
          }
        })
        .catch(function(error) {
          errorMsg.classList.remove('hidden');
          btnText.textContent = 'Send Message';
        })
        .finally(function() {
          btnSpinner.classList.add('hidden');
          submitBtn.disabled = false;
        });
      });
    }
  })();
</script>