---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import CybersecurityAssessment from '@/components/interactive/CybersecurityAssessment.astro';

// SEO Configuration
const seoConfig = {
  title: "Cyber Security Finland | Kyberturvallisuuden ja sääntelyn asiantuntijapalvelut Suomessa",
  description: "Johtavat kyberturvallisuuden asiantuntijat Suomessa. Erityistä ISO 27001, NIS2, GDPR ja DORA -yhteensopivuutta. Nopea toteutus 90 päivässä asiantuntijan ohjauksella.",
  keywords: "kyberturvallisuus suomi, ISO 27001 yhteensopivuus, NIS2 direktiivi, GDPR asiantuntija, DORA toteutus, tietoturva konsultointi, kyberturvallisuus palvelut suomi, sääntely konsultointi, riskienhallinta palvelut",
  type: "website" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Cyber Security Finland",
    "url": "https://cybersecurity.fi",
    "description": "Asiantuntijakyberturvallisuus- ja sääntelypalvelut suomalaisille yrityksille. ISO 27001, NIS2, GDPR ja DORA -toteutus todistetuilla metodologioilla.",
    "publisher": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "logo": {
        "@type": "ImageObject",
        "url": "https://cybersecurity.fi/logo-2025.jpg",
        "width": 300,
        "height": 300
      }
    },
    "potentialAction": {
      "@type": "ContactAction",
      "target": "https://cybersecurity.fi/fi/contact",
      "name": "Ota yhteyttä"
    }
  }
};

const currentPath = Astro.url.pathname;
const lang = 'fi'; // Explicitly set to Finnish for this version

const content = {
  fi: {
    hero: {
      title: "Kyberturvallisuuden yhteensopivuus tehty helpoksi suomalaisille yrityksille",
      subtitle: "Nopeuta ISO 27001, NIS2 ja GDPR -vaatimustenmukaisuutta todistetuin 90 päivän ohjelmin. Asiantunteva ohjaus, täydellinen dokumentointi ja jatkuva tuki mukana.",
      primaryCTA: { text: "Hanki ilmainen vaatimustenmukaisuusarviointi", href: "/fi/contact" },
      secondaryCTA: { text: "Lisätietoja palveluistamme", href: "/fi/services" }
    },
    services: {
      title: "Keskeiset palvelumme",
      description: "Kattavat kyberturvallisuuden ja sääntelyn noudattamisen ratkaisut liiketoimintaasi varten",
      items: [
        {
          title: "ISO 27001 Fast-Track",
          description: "Täysi ISMS-toteutus 90 päivässä sertifiointituelle",
          icon: "shield-check",
          href: "/fi/packages/iso-27001-fast-track"
        },
        {
          title: "NIS2 Yhteensopivuus",
          description: "Valmistele NIS2-direktiivin vaatimuksia asiantuntijan ohjauksella",
          icon: "globe-alt",
          href: "/fi/services/nis2-compliance"
        },
        {
          title: "GDPR & Tietosuoja",
          description: "Tietosuojan noudattaminen ja yksityisyyden hallintaratkaisut",
          icon: "lock-closed",
          href: "/fi/services/gdpr-privacy"
        },
        {
          title: "DORA Toteutus",
          description: "Digitaalinen toiminnallinen resilierenssi rahoituspalveluille",
          icon: "building-library",
          href: "/fi/services/dora-compliance"
        }
      ]
    },
    cta: {
      title: "Oletko valmis suojaamaan liiketoimintaasi?",
      subtitle: "Liity satojen suomalaisten yritysten joukkoon, jotka luottavat meihin kyberturvallisuuteen ja vaatimustenmukaisuuteen.",
      primaryCTA: { text: "Aloita ilmainen arviointi", href: "/fi/contact" },
      secondaryCTA: { text: "Näytä kaikki palvelut", href: "/fi/services" }
    }
  }
};

const currentContent = content[lang];

const keyServices = [
  {
    title: "Yhteensopivuuskehykset",
    description: "Muunna sääntelyvaatimukset kilpailueduksi. Asiantunteva ISO 27001, SOC 2, GDPR, NIS2 ja DORA -kehyksien toteutus todistettujen nopean toteutuksen metodologioiden avulla.",
    icon: "shield-check",
    href: "/fi/services"
  },
  {
    title: "Riskienhallinta",
    description: "Tunnista, arvioi ja lievitä kyberturvallisuusriskit tehokkaasti. Kattavat riskien arvioinnit, kolmannen osapuolen riskienhallinta ja liiketoiminnan jatkuvuuden suunnittelu organisaatiollesi räätälöitynä.",
    icon: "chart-line",
    href: "/fi/services"
  },
  {
    title: "Hallinto & Strategia",
    description: "Rakenna vahvoja kyberturvallisuuden hallintorakenteita. Strageinen politiikan kehitys, CISO-palveluna ja hallituksen tason riskiraportointi varmistaaksesi organisaation turvallisuuden kypsyyden.",
    icon: "building-library",
    href: "/fi/services"
  },
  {
    title: "Erikoispalvelut",
    description: "Asiantuntijapalvelut ainutlaatuisiin kyberturvallisuuden haasteisiin. Petostorjuntapalvelut, digitaalisen luottamuksen ratkaisut, tarkastuksen valmistelu ja erikoisvaatimustenmukaisuustuki monimutkaisiin vaatimuksiin.",
    icon: "star",
    href: "/fi/services"
  }
];

const complianceFrameworks = [
  {
    title: "ISO 27001",
    description: "Tietoturvan hallintajärjestelmä - kansainvälinen standardi kyberturvallisuuden hallinnolle.",
    icon: "shield-check",
    href: "/fi/frameworks/iso-27001"
  },
  {
    title: "NIS2 Direktiivi",
    description: "Verkko- ja tietoturvalaki - EU:n kyberturvallisuuslainsäädäntö keskeisille ja tärkeille toimijoille.",
    icon: "globe-alt",
    href: "/fi/regulatory/nis2"
  },
  {
    title: "GDPR",
    description: "Yleinen tietosuoja-asetus - EU:n tietosuojalainsäädäntö henkilötietojen suojelulle ja yksityisyydelle.",
    icon: "lock-closed",
    href: "/fi/regulatory/gdpr"
  },
  {
    title: "DORA",
    description: "Digitaalisen toiminnan resilierenssilaki - EU:n laki digitaalisen toiminnan resilierenssistä rahoituspalveluissa.",
    icon: "building-library",
    href: "/fi/regulatory/dora"
  },
  {
    title: "SOC 2",
    description: "Service Organization Control 2 - tarkastusmenettely, joka varmistaa palveluntarjoajien hallitsevan tietojen turvallisuuden.",
    icon: "document-check",
    href: "/fi/frameworks/soc-2"
  },
  {
    title: "Yhteiset kriteerit",
    description: "Kansainvälinen standardi tietoturvan sertifiointiin - arviointikriteerit IT-turvallisuustuotteille.",
    icon: "star",
    href: "/fi/frameworks/common-criteria"
  }
];

const industries = [
  { 
    name: "Rahoituspalvelut & Fintech", 
    icon: "bank", 
    href: "/fi/industries/financial-services-fintech",
    image: "/images/industries/financial-services.svg",
    description: "Erikoistunut DORA, PCI DSS ja toiminnan resilierenssin asiantuntemus pankeille, maksunkäsittelyyrityksille ja fintech-yrityksille."
  },
  { 
    name: "SaaS & Teknologia", 
    icon: "code", 
    href: "/fi/industries/saas-technology",
    image: "/images/industries/saas-technology.svg",
    description: "ISO 27001, SOC 2 ja pilvitietoturvan kehykset räätälöitynä ohjelmisto- ja teknologiayrityksille."
  },
  { 
    name: "Terveys & Elintarviketeollisuus", 
    icon: "heart", 
    href: "/fi/industries/healthcare-life-sciences",
    image: "/images/industries/healthcare.svg",
    description: "GDPR, Virtuaalinen DPO (V-DPO), lääketieteellisten laitteiden sääntely ja potilastietojen suojaus yhteensopivuus terveydenhuollon organisaatioille ja elintarviketeollisuuden yrityksille."
  },
  { 
    name: "Kriittinen infrastruktuuri", 
    icon: "bolt", 
    href: "/fi/industries/critical-infrastructure-energy",
    image: "/images/industries/critical-infrastructure.svg",
    description: "NIS2-direktiivin toteutus, operaatioteknologian turvallisuus ja resilierenssin suunnittelu oleellisille palveluntarjoajille."
  },
  { 
    name: "Julkinen sektori", 
    icon: "building", 
    href: "/fi/industries/public-sector-finland",
    image: "/images/industries/public-sector.svg",
    description: "Hallituksen erityiset sääntelykehykset, julkiset hankinnat ja kansalaisten tietosuojan standardit."
  },
  { 
    name: "Valmistava teollisuus", 
    icon: "cog", 
    href: "/fi/industries/manufacturing-industrial",
    image: "/images/industries/manufacturing.svg",
    description: "Teollisuuden IoT-tietoturva, toimittajaketjun suojaus ja operaatioiden jatkuvuus valmistaville ja teollisille organisaatioille."
  }
];

const latestResources = [
  {
    title: "ISO 27001 Pika-aloitusopas",
    excerpt: "25-sivuinen toteutusroadmap",
    href: "/fi/resources/guides/iso-27001-quick-start",
    category: "Opas"
  },
  {
    title: "NIS2 Yhteensopivuus Tarkistuslista",
    excerpt: "Täysi vaatimusanalyysityökalu",
    href: "/fi/resources/guides/nis2-compliance-checklist",
    category: "Tarkistuslista"
  },
  {
    title: "GDPR Tietosuoja-vaikutusten Arviointi Malli",
    excerpt: "Valmiiksi määritelty PIA-kehys",
    href: "/fi/resources/guides/gdpr-pia-template",
    category: "Malli"
  }
];
---

<Layout {...seoConfig}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-slate-100 via-white to-slate-100 text-slate-900 py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
          {currentContent.hero.title}
        </h1>
        <p class="text-xl text-slate-600 mb-10 max-w-4xl mx-auto">
          {currentContent.hero.subtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href={currentContent.hero.primaryCTA.href} variant="primary" class="bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-700 hover:to-cyan-700">
            {currentContent.hero.primaryCTA.text}
          </Button>
          <Button href={currentContent.hero.secondaryCTA.href} variant="secondary">
            {currentContent.hero.secondaryCTA.text}
          </Button>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Key Services Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          {currentContent.services.title}
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">
          {currentContent.services.description}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {currentContent.services.items.map((service, index) => (
          <div key={index} class="bg-white rounded-xl shadow-sm p-6 border border-slate-200 hover:shadow-md transition-shadow duration-200">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
              <Icon name={service.icon} class="w-6 h-6 text-blue-600" />
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">{service.title}</h3>
            <p class="text-slate-600 mb-4">{service.description}</p>
            <a
              href={service.href}
              class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium group"
            >
              Lue lisää
              <Icon name="arrowRight" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
    
  <!-- Industries We Serve Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Toimialat joita palvelemme
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">
          Asiantuntemuksemme kattaa useita toimialoja ja tarjoaa toimialakohtaisia ratkaisuja kullekin sektorille.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {industries.map((industry, index) => (
          <div key={index} class="bg-gradient-to-br from-slate-50 to-white rounded-xl p-6 border border-slate-200 hover:shadow-lg transition-all duration-300">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-6">
              <Icon name={industry.icon} class="w-8 h-8 text-blue-600" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{industry.name}</h3>
            <p class="text-slate-600 mb-4">{industry.description}</p>
            <a
              href={industry.href}
              class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium group"
            >
              Tutustu palveluihimme
              <Icon name="arrowRight" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Compliance Frameworks Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Yhteensopivuuskehykset
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">
          Täysi yhteensopivuus keskeisten sääntelyvaatimusten kanssa.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {complianceFrameworks.map((framework, index) => (
          <div key={index} class="bg-white rounded-xl shadow-sm p-6 border border-slate-200 hover:shadow-md transition-shadow duration-200">
            <div class="flex items-start">
              <div class="flex-shrink-0 mt-1">
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                  <Icon name={framework.icon} class="w-6 h-6 text-blue-600" />
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-slate-900 mb-2">{framework.title}</h3>
                <p class="text-slate-600 text-sm">{framework.description}</p>
              </div>
            </div>
            <div class="mt-4">
              <a
                href={framework.href}
                class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800 font-medium group"
              >
                Lue lisää
                <Icon name="arrowRight" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Services Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          Keskeiset palvelualamme
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">
          Tarjoamme kattavat kyberturvallisuus- ja vaatimustenmukaisuuspalvelut pienyrityksille ja keskisuurille yrityksille, jotka kohtaavat resurssirajoituksia ja vaatimustenmukaisuushaasteita.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {keyServices.map((service, index) => (
          <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200 hover:shadow-md transition-shadow duration-200">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
              <Icon name={service.icon} class="w-6 h-6 text-blue-600" />
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">{service.title}</h3>
            <p class="text-slate-600 text-sm mb-4">{service.description}</p>
            <a
              href={service.href}
              class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium group"
            >
              Lue lisää
              <Icon name="arrowRight" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Assessment Section -->
  <section class="py-20 bg-gradient-to-br from-slate-50 to-blue-50 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-slate-900 mb-6">Arvioi kyberturvallisuusasemaasi</h2>
        <p class="text-xl text-slate-600 max-w-4xl mx-auto">
          Ota nopea arviointi ymmärtääksesi organisaatiosi riskitaso ja saadaksesi personoituneita suosituksia.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <CybersecurityAssessment />
      </div>
    </div>
  </section>

  <!-- Featured Packages Section -->
  <section class="py-20 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-slate-900 mb-6">Esittelyssä Fast-Track Paketit</h2>
        <p class="text-xl text-slate-600 max-w-4xl mx-auto">
          Saavuta yhteensopivuus nopeammin todistetuilla ohjelmillamme
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="group bg-white p-8 rounded-xl border border-slate-200 hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-200 transition-colors duration-300">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-blue-600 transition-colors duration-300">ISO 27001 Fast-Track</h3>
          <p class="text-slate-600 mb-4 leading-relaxed">Aikajana: 90-120 päivää</p>
          <ul class="text-sm text-slate-600 space-y-2 mb-6">
            <li>• Täysi ISMS-toteutus</li>
            <li>• Käytäntöpohjat (50+ dokumenttia)</li>
            <li>• Henkilöstökoulutus ja tiedotus</li>
            <li>• Sertifiointitarkastuksen tuki</li>
            <li>• 12 kuukauden jatkuva tuki</li>
          </ul>
          <a href="/fi/packages/iso-27001-fast-track" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-semibold group/link transition-colors duration-300">
            Lue lisää 
            <svg class="w-4 h-4 ml-2 transform group-hover/link:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
        
        <div class="group bg-white p-8 rounded-xl border border-slate-200 hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-200 transition-colors duration-300">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-blue-600 transition-colors duration-300">NIS2 Sprint -ohjelma</h3>
          <p class="text-slate-600 mb-4 leading-relaxed">Aikajana: 60-90 päivää</p>
          <ul class="text-sm text-slate-600 space-y-2 mb-6">
            <li>• NIS2 aukkokohtaus ja yhteensopivuusroadmap</li>
            <li>• Riskienhallintakehyksen toteutus</li>
            <li>• Incidenttien hallintamenettelyt</li>
            <li>• Toimittajaketjun turvatoimet</li>
            <li>• Sääntelyviranomaisten raportointiasetus</li>
          </ul>
          <a href="/fi/packages/nis2-sprint" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-semibold group/link transition-colors duration-300">
            Lue lisää 
            <svg class="w-4 h-4 ml-2 transform group-hover/link:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
        
        <div class="group bg-white p-8 rounded-xl border border-slate-200 hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
          <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-6 group-hover:bg-blue-200 transition-colors duration-300">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-blue-600 transition-colors duration-300">SOC 2 Valmius-12 viikkoa</h3>
          <p class="text-slate-600 mb-4 leading-relaxed">Aikajana: 84 päivää</p>
          <ul class="text-sm text-slate-600 space-y-2 mb-6">
            <li>• Type I ja Type II valmius</li>
            <li>• Ohjauksen toteutus ja testaus</li>
            <li>• Todistuskeruun kehys</li>
            <li>• Tarkastuksen valmistelu ja tuki</li>
            <li>• Jatkuva valvonta asetus</li>
          </ul>
          <a href="/fi/packages/soc2-readiness-12-weeks" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-semibold group/link transition-colors duration-300">
            Lue lisää 
            <svg class="w-4 h-4 ml-2 transform group-hover/link:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
