---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Common Criteria Security Evaluation and Certification",
  description: "Achieve international security certification with our specialized Common Criteria implementation methodology for Finnish organizations.",
  keywords: "Common Criteria, security certification, IT product security, security evaluation, CC certification",
  type: "framework" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Common Criteria",
      subtitle: "Security Evaluation and Certification",
      description: "Achieve international security certification with our specialized Common Criteria implementation methodology for Finnish organizations. We help Finnish organizations implement Common Criteria requirements, building robust security evaluation frameworks that meet international standards for IT product security.",
      primaryCTA: { text: "Start Common Criteria Evaluation", href: "/contact?service=common-criteria" },
      secondaryCTA: { text: "Learn More", href: "/services" }
    },
    benefits: {
      title: "Why Choose Our Common Criteria Services",
      subtitle: "We deliver Common Criteria compliance with international security expertise, ensuring your organization can achieve globally recognized security certification.",
      items: [
        { title: "International Recognition", description: "Achieve globally recognized security certification accepted by 30+ countries worldwide.", icon: "globe" },
        { title: "Finnish Market Expertise", description: "Deep understanding of Finnish security requirements and international Common Criteria standards.", icon: "flag" },
        { title: "Security Evaluation", description: "Comprehensive security evaluation and testing aligned with international standards.", icon: "shield-check" },
        { title: "Market Access", description: "Enable access to government and enterprise markets requiring Common Criteria certification.", icon: "building-library" }
      ]
    },
    requirements: {
      title: "Common Criteria Compliance Requirements",
      subtitle: "Our Common Criteria implementation covers all key requirements, ensuring comprehensive compliance with international security evaluation standards.",
      items: [
        { title: "Security Target Development", description: "Develop comprehensive security target documentation defining security requirements", icon: "document-text", controls: ["Security Objectives", "Threat Analysis", "Security Requirements", "Assurance Requirements"] },
        { title: "Security Evaluation", description: "Conduct thorough security evaluation of IT products and systems", icon: "search", controls: ["Vulnerability Analysis", "Penetration Testing", "Security Testing", "Evaluation Reports"] },
        { title: "Assurance Evaluation", description: "Assess security assurance levels and implementation quality", icon: "check-circle", controls: ["Development Process", "Documentation Review", "Testing Procedures", "Quality Assurance"] },
        { title: "Certification Process", description: "Navigate the formal certification process with accredited laboratories", icon: "badge-check", controls: ["Laboratory Selection", "Evaluation Coordination", "Certification Submission", "Ongoing Compliance"] },
        { title: "Maintenance and Updates", description: "Maintain certification through product updates and security patches", icon: "refresh-cw", controls: ["Change Management", "Security Updates", "Re-evaluation", "Continuous Monitoring"] }
      ]
    },
    phases: {
      title: "48-Week Implementation Roadmap",
      subtitle: "Structured approach ensuring successful Common Criteria compliance within 48 weeks while maintaining business operations.",
      items: [
        { phase: "Phase 1: Assessment & Planning", duration: "Weeks 1-8", activities: ["Gap Analysis", "Scope Definition", "Security Target Planning", "Resource Planning"], deliverables: ["Gap Analysis Report", "Project Charter", "Security Target Outline", "Resource Plan"] },
        { phase: "Phase 2: Security Target Development", duration: "Weeks 9-20", activities: ["Security Objectives", "Threat Analysis", "Security Requirements", "Assurance Requirements"], deliverables: ["Security Target Document", "Threat Model", "Security Requirements", "Assurance Plan"] },
        { phase: "Phase 3: Implementation & Testing", duration: "Weeks 21-36", activities: ["Security Implementation", "Testing Procedures", "Documentation", "Quality Assurance"], deliverables: ["Security Implementation", "Test Results", "Documentation Suite", "Quality Reports"] },
        { phase: "Phase 4: Evaluation & Certification", duration: "Weeks 37-48", activities: ["Laboratory Evaluation", "Certification Process", "Final Documentation", "Certification"], deliverables: ["Evaluation Report", "Common Criteria Certificate", "Final Documentation", "Operational Procedures"] }
      ]
    },
    industries: {
      title: "Industry-Specific Success Stories",
      subtitle: "See how we've helped organizations across different industries achieve Common Criteria certification.",
      items: [
        { industry: "Cybersecurity Products", challenge: "Achieving Common Criteria certification for enterprise security solutions", solution: "Comprehensive security evaluation framework with rigorous testing procedures", outcome: "Common Criteria EAL4+ certification with enhanced market credibility" },
        { industry: "Government Systems", challenge: "Meeting security requirements for government IT infrastructure", solution: "Security target development aligned with government security standards", outcome: "Common Criteria certification enabling government market access" },
        { industry: "Financial Technology", challenge: "Implementing Common Criteria for fintech security products", solution: "Security evaluation framework addressing financial sector requirements", outcome: "Common Criteria certification with international market recognition" }
      ]
    },
    related: {
      title: "Related Services",
      subtitle: "Enhance your security evaluation posture with our complementary services and frameworks.",
      items: [
        { title: "ISO 27001 Implementation", description: "Information security management", href: "/frameworks/iso-27001" },
        { title: "Security Testing", description: "Comprehensive security evaluation", href: "/services/security-testing" },
        { title: "Product Security", description: "IT product security assessment", href: "/services/product-security" },
        { title: "Certification Support", description: "Certification process guidance", href: "/services/certification-support" }
      ]
    },
    cta: {
      title: "Ready to Achieve Common Criteria Certification?",
      subtitle: "Join Finnish organizations that have successfully implemented Common Criteria with our expert guidance. Let's discuss how we can help you achieve international security certification.",
      primaryCTA: { text: "Start Your Common Criteria Journey", href: "/contact" },
      secondaryCTA: { text: "Learn More", href: "/services" }
    }
  },
  fi: {
    hero: {
      title: "Common Criteria",
      subtitle: "Turvallisuusarviointi ja sertifiointi",
      description: "Saavuta kansainvälinen turvallisuussertifiointi erikoistuneella Common Criteria -toteutusmetodologiallamme suomalaisille organisaatioille. Autamme suomalaisia organisaatioita toteuttamaan Common Criteria -vaatimukset, rakentaen vankkoja turvallisuusarviointikehyksiä, jotka täyttävät kansainväliset IT-tuotteiden turvallisuusstandardit.",
      primaryCTA: { text: "Aloita Common Criteria -arviointi", href: "/contact?service=common-criteria" },
      secondaryCTA: { text: "Lue lisää", href: "/services" }
    },
    benefits: {
      title: "Miksi valita Common Criteria -palvelumme",
      subtitle: "Tarjoamme Common Criteria -vaatimustenmukaisuuden kansainvälisellä tietoturva-asiantuntemuksella varmistaen, että organisaatiosi voi saavuttaa maailmanlaajuisesti tunnustetun turvallisuussertifioinnin.",
      items: [
        { title: "Kansainvälinen tunnustus", description: "Saavuta maailmanlaajuisesti tunnustettu turvallisuussertifiointi, joka hyväksytään 30+ maassa maailmanlaajuisesti.", icon: "globe" },
        { title: "Suomalainen markkinaosaaminen", description: "Syvä ymmärrys Suomen turvallisuusvaatimuksista ja kansainvälisistä Common Criteria -standardeista.", icon: "flag" },
        { title: "Turvallisuusarviointi", description: "Kattava turvallisuusarviointi ja testaus kansainvälisten standardien mukaisesti.", icon: "shield-check" },
        { title: "Markkinoille pääsy", description: "Mahdollista pääsy julkishallinnon ja yritysmarkkinoille, jotka edellyttävät Common Criteria -sertifiointia.", icon: "building-library" }
      ]
    },
    requirements: {
      title: "Common Criteria -vaatimustenmukaisuusvaatimukset",
      subtitle: "Common Criteria -toteutuksemme kattaa kaikki keskeiset vaatimukset varmistaen kattavan vaatimustenmukaisuuden kansainvälisten turvallisuusarviointistandardien kanssa.",
      items: [
        { title: "Turvallisuustavoitteen kehitys", description: "Kehitä kattava turvallisuustavoitedokumentaatio, joka määrittelee turvallisuusvaatimukset", icon: "document-text", controls: ["Turvallisuustavoitteet", "Uhka-analyysi", "Turvallisuusvaatimukset", "Varmuustasovaatimukset"] },
        { title: "Turvallisuusarviointi", description: "Suorita perusteellinen IT-tuotteiden ja -järjestelmien turvallisuusarviointi", icon: "search", controls: ["Haavoittuvuusanalyysi", "Penetraatiotestaus", "Turvallisuustestaus", "Arviointiraportit"] },
        { title: "Varmuustason arviointi", description: "Arvioi turvallisuuden varmuustasot ja toteutuksen laatu", icon: "check-circle", controls: ["Kehitysprosessi", "Dokumentoinnin tarkastelu", "Testausmenettelyt", "Laadunvarmistus"] },
        { title: "Sertifiointiprosessi", description: "Navigoi muodollista sertifiointiprosessia akkreditoitujen laboratorioiden kanssa", icon: "badge-check", controls: ["Laboratoriovalinta", "Arvioinnin koordinointi", "Sertifioinnin toimittaminen", "Jatkuva vaatimustenmukaisuus"] },
        { title: "Ylläpito ja päivitykset", description: "Ylläpidä sertifiointia tuotepäivitysten ja tietoturvakorjausten avulla", icon: "refresh-cw", controls: ["Muutosten hallinta", "Tietoturvapäivitykset", "Uudelleenarviointi", "Jatkuva seuranta"] }
      ]
    },
    phases: {
      title: "48 viikon toteutussuunnitelma",
      subtitle: "Rakenteinen lähestymistapa varmistaa onnistuneen Common Criteria -vaatimustenmukaisuuden 48 viikon kuluessa samalla kun liiketoiminta säilyy.",
      items: [
        { phase: "Vaihe 1: Arviointi ja suunnittelu", duration: "Viikot 1-8", activities: ["Aukkoanalyysi", "Laajuuden määrittely", "Turvallisuustavoitteen suunnittelu", "Resurssien suunnittelu"], deliverables: ["Aukkoanalyysiraportti", "Projektisuunnitelma", "Turvallisuustavoitteen runko", "Resurssisuunnitelma"] },
        { phase: "Vaihe 2: Turvallisuustavoitteen kehitys", duration: "Viikot 9-20", activities: ["Turvallisuustavoitteet", "Uhka-analyysi", "Turvallisuusvaatimukset", "Varmuustasovaatimukset"], deliverables: ["Turvallisuustavoitedokumentti", "Uhkamalli", "Turvallisuusvaatimukset", "Varmuustasosuunnitelma"] },
        { phase: "Vaihe 3: Toteutus ja testaus", duration: "Viikot 21-36", activities: ["Turvallisuuden toteutus", "Testausmenettelyt", "Dokumentointi", "Laadunvarmistus"], deliverables: ["Turvallisuuden toteutus", "Testitulokset", "Dokumentaatio", "Laaturaportit"] },
        { phase: "Vaihe 4: Arviointi ja sertifiointi", duration: "Viikot 37-48", activities: ["Laboratorioarviointi", "Sertifiointiprosessi", "Lopullinen dokumentointi", "Sertifiointi"], deliverables: ["Arviointiraportti", "Common Criteria -sertifikaatti", "Lopullinen dokumentointi", "Operatiiviset menettelyt"] }
      ]
    },
    industries: {
      title: "Toimialakohtaiset menestystarinat",
      subtitle: "Katso, kuinka olemme auttaneet organisaatioita eri toimialoilla saavuttamaan Common Criteria -sertifioinnin.",
      items: [
        { industry: "Kyberturvallisuustuotteet", challenge: "Common Criteria -sertifioinnin saavuttaminen yritysturvallisuusratkaisuille", solution: "Kattava turvallisuusarviointikehys tiukoilla testausmenettelyillä", outcome: "Common Criteria EAL4+ -sertifiointi parannetulla markkinoiden uskottavuudella" },
        { industry: "Julkishallinnon järjestelmät", challenge: "Turvallisuusvaatimusten täyttäminen julkishallinnon IT-infrastruktuurille", solution: "Turvallisuustavoitteen kehitys julkishallinnon turvallisuusstandardien mukaisesti", outcome: "Common Criteria -sertifiointi mahdollistaa pääsyn julkishallinnon markkinoille" },
        { industry: "Rahoitusteknologia", challenge: "Common Criterian toteuttaminen fintech-turvallisuustuotteille", solution: "Turvallisuusarviointikehys, joka vastaa rahoitusalan vaatimuksia", outcome: "Common Criteria -sertifiointi kansainvälisellä markkinatunnustuksella" }
      ]
    },
    related: {
      title: "Aiheeseen liittyvät palvelut",
      subtitle: "Paranna turvallisuusarviointiasemaasi täydentävillä palveluillamme ja kehyksillämme.",
      items: [
        { title: "ISO 27001 -toteutus", description: "Tietoturvallisuuden hallinta", href: "/frameworks/iso-27001" },
        { title: "Turvallisuustestaus", description: "Kattava turvallisuusarviointi", href: "/services/security-testing" },
        { title: "Tuoteturvallisuus", description: "IT-tuotteen turvallisuusarviointi", href: "/services/product-security" },
        { title: "Sertifiointituki", description: "Sertifiointiprosessin ohjaus", href: "/services/certification-support" }
      ]
    },
    cta: {
      title: "Valmis saavuttamaan Common Criteria -sertifioinnin?",
      subtitle: "Liity suomalaisten organisaatioiden joukkoon, jotka ovat onnistuneesti toteuttaneet Common Criterian asiantuntijaohjauksellamme. Keskustellaan, kuinka voimme auttaa sinua saavuttamaan kansainvälisen turvallisuussertifioinnin.",
      primaryCTA: { text: "Aloita Common Criteria -matkasi", href: "/contact" },
      secondaryCTA: { text: "Lue lisää", href: "/services" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Key Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.benefits.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.benefits.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Compliance Requirements Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.requirements.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.requirements.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.requirements.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {item.description}
          </p>
          
          <div class="mt-auto">
            <h4 class="font-semibold text-slate-800 text-sm mb-2">Key Controls:</h4>
            <ul class="space-y-1.5">
              {item.controls.map((control) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {control}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Implementation Phases Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.phases.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.phases.subtitle}
      </p>
    </div>
    
    <div class="space-y-6">
      {currentContent.phases.items.map((phase, index) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-lg transition-all duration-300
                    group">
          
          <div class="flex flex-col md:flex-row gap-6">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold text-lg">
                {index + 1}
              </div>
            </div>
            
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-700 transition-colors duration-300">
                  {phase.phase}
                </h3>
                <span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-700">
                  {phase.duration}
                </span>
              </div>
              
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <h4 class="font-semibold text-slate-800 text-sm mb-2">Key Activities</h4>
                  <ul class="space-y-1.5">
                    {phase.activities.map((activity) => (
                      <li class="flex items-start text-xs text-slate-500">
                        <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        {activity}
                      </li>
                    ))}
                  </ul>
                </div>
                
                <div>
                  <h4 class="font-semibold text-slate-800 text-sm mb-2">Deliverables</h4>
                  <ul class="space-y-1.5">
                    {phase.deliverables.map((deliverable) => (
                      <li class="flex items-start text-xs text-slate-500">
                        <svg class="w-3 h-3 text-blue-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        {deliverable}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Industry Examples Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.industries.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.industries.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.industries.items.map((example) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="mb-4">
            <span class="inline-block bg-blue-100 text-blue-700 text-xs font-medium px-3 py-1 rounded-full group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:text-white transition-all duration-300">
              {example.industry}
            </span>
          </div>
          
          <h4 class="font-semibold text-slate-800 text-sm mb-2">Challenge:</h4>
          <p class="text-slate-500 text-xs mb-4">{example.challenge}</p>
          
          <h4 class="font-semibold text-slate-800 text-sm mb-2">Our Solution:</h4>
          <p class="text-slate-500 text-xs mb-4">{example.solution}</p>
          
          <h4 class="font-semibold text-slate-800 text-sm mb-2">Outcome:</h4>
          <p class="text-slate-500 text-xs">{example.outcome}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Related Services Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.related.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.related.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-4 gap-6">
      {currentContent.related.items.map((service) => (
        <a href={service.href} class="bg-slate-50/50 rounded-xl border border-slate-100 p-5 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    group block">
          
          <h3 class="text-base font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {service.title}
          </h3>
          <p class="text-slate-500 text-xs">{service.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>