---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "ISO 27001 Services | Information Security Management System Certification",
  description: "Achieve comprehensive information security governance with internationally recognized standards. Expert ISO 27001 implementation and certification for Finnish organizations.",
  keywords: "ISO 27001, information security, ISMS, certification, security management, Finland",
  type: "framework" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "ISO 27001 - Information Security Management System",
      subtitle: "Achieve comprehensive information security governance with internationally recognized standards",
      description: "Cybersecurity.fi specializes in ISO 27001 implementation and certification, providing Finnish organizations with expert guidance to establish robust Information Security Management Systems (ISMS) that protect critical assets, ensure business continuity, and demonstrate commitment to security excellence.",
      primaryCTA: { text: "Start ISO 27001 Implementation", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services/iso-27001" }
    },
    benefits: {
      title: "Why Choose Cybersecurity.fi for ISO 27001",
      subtitle: "Our comprehensive approach to ISO 27001 implementation ensures your organization achieves certification while building lasting security capabilities that drive business value and competitive advantage.",
      items: [
        { title: "Strategic Security Governance", description: "Establish a comprehensive ISMS that aligns with business objectives, ensuring security becomes an integral part of organizational strategy and decision-making processes.", icon: "target" },
        { title: "Legal & Regulatory Compliance", description: "Meet Finnish and EU regulatory requirements including GDPR, NIS2, and sector-specific regulations while achieving internationally recognized certification status.", icon: "scale" },
        { title: "Risk-Based Security Framework", description: "Implement systematic risk management processes aligned with ISO 27005, ensuring threats are identified, assessed, and mitigated effectively across all business areas.", icon: "shield" },
        { title: "Continuous Improvement Culture", description: "Establish ongoing monitoring, measurement, and improvement processes that ensure your ISMS evolves with changing threats and business requirements.", icon: "chart" },
        { title: "Business Continuity Integration", description: "Align information security controls with business continuity planning, ensuring critical operations remain protected and recoverable during incidents.", icon: "building" },
        { title: "Stakeholder Confidence", description: "Demonstrate commitment to information security excellence, building trust with customers, partners, and regulators through internationally recognized certification.", icon: "handshake" }
      ]
    },
    steps: {
      title: "Our Proven ISO 27001 Implementation Methodology",
      subtitle: "Structured 28-week approach ensuring successful ISO 27001 certification while building sustainable security capabilities and maintaining business continuity throughout the implementation process.",
      items: [
        {
          phase: "Phase 1: Foundation & Planning",
          duration: "Weeks 1-6",
          activities: ["Comprehensive gap analysis against ISO 27001 requirements", "ISMS scope definition and boundary establishment", "Information asset inventory and classification", "Stakeholder engagement and commitment securing", "Project team formation and training", "Risk assessment methodology selection"],
          deliverables: ["Gap Analysis Report with prioritized recommendations", "ISMS Scope Statement and Charter", "Information Asset Register", "Project Plan with resource allocation", "Risk Assessment Framework"]
        },
        {
          phase: "Phase 2: Risk Management & Control Design",
          duration: "Weeks 7-14",
          activities: ["Comprehensive risk identification and assessment", "Threat modeling and vulnerability analysis", "Control objective mapping and selection", "Statement of Applicability (SoA) development", "Risk treatment plan creation", "Security policy framework development"],
          deliverables: ["Risk Assessment Report", "Risk Treatment Plan", "Statement of Applicability", "Information Security Policy Suite", "Control Implementation Roadmap"]
        },
        {
          phase: "Phase 3: Implementation & Documentation",
          duration: "Weeks 15-22",
          activities: ["Security control implementation across all domains", "Process documentation and procedure creation", "Staff training and awareness programs", "Incident response capability establishment", "Access control and identity management setup", "Monitoring and measurement system deployment"],
          deliverables: ["Implemented Security Controls", "Process Documentation Library", "Training Materials and Records", "Incident Response Procedures", "Monitoring and Measurement Framework"]
        },
        {
          phase: "Phase 4: Testing & Certification Preparation",
          duration: "Weeks 23-28",
          activities: ["Internal audit program execution", "Management review and decision-making", "Corrective action implementation", "Pre-certification readiness assessment", "External audit coordination", "Continuous improvement planning"],
          deliverables: ["Internal Audit Reports", "Management Review Minutes", "Corrective Action Plans", "ISO 27001 Certificate", "Continuous Improvement Program"]
        }
      ]
    },
    industries: {
      title: "Industry-Specific Success Stories",
      subtitle: "See how we've helped organizations across different industries achieve ISO 27001 certification while addressing their unique challenges.",
      items: [
        {
          industry: "Financial Services",
          challenge: "Meeting Finnish Financial Supervisory Authority (FIN-FSA) requirements while implementing comprehensive information security governance that addresses both traditional banking risks and emerging fintech challenges.",
          solution: "Integrated ISMS implementation combining ISO 27001 with sector-specific controls for payment processing, customer data protection, and regulatory reporting. Included specialized modules for digital banking security and cryptocurrency handling.",
          outcome: "Achieved ISO 27001 certification in 6 months with full FIN-FSA compliance. Reduced security incidents by 78% and improved regulatory examination outcomes. Enhanced customer trust leading to 23% increase in digital service adoption."
        },
        {
          industry: "Healthcare & MedTech",
          challenge: "Protecting sensitive patient data under GDPR while ensuring medical device security and maintaining interoperability with existing healthcare systems across multiple facilities.",
          solution: "Privacy-by-design ISMS implementation with healthcare-specific controls addressing medical device cybersecurity, patient data flows, and clinical research data protection. Integrated with existing quality management systems (ISO 13485).",
          outcome: "Full GDPR compliance achieved alongside ISO 27001 certification. Zero patient data breaches in 18 months post-implementation. 34% reduction in cybersecurity-related downtime for critical medical systems."
        },
        {
          industry: "Manufacturing & Industrial",
          challenge: "Securing industrial control systems (ICS) and operational technology (OT) while maintaining production efficiency and protecting intellectual property in globally distributed manufacturing operations.",
          solution: "Comprehensive ISMS covering both IT and OT environments with specialized controls for industrial networks, supply chain security, and intellectual property protection. Implemented zero-trust architecture for critical production systems.",
          outcome: "End-to-end security framework protecting critical manufacturing processes. 89% reduction in OT security incidents and improved supply chain resilience. ISO 27001 certification facilitated expansion into regulated markets."
        }
      ]
    },
    related: {
      title: "Related Services",
      subtitle: "Enhance your cybersecurity posture with our complementary services and frameworks.",
      items: [
        { title: "NIS2 Directive Compliance", description: "EU cybersecurity directive implementation", href: "/frameworks/nis2" },
        { title: "Risk Assessment Services", description: "Comprehensive risk management", href: "/services/risk-assessments" },
        { title: "Security Policy Development", description: "Strategic governance framework", href: "/services/policy-development" },
        { title: "Security Audit Preparation", description: "Certification readiness support", href: "/services/audit-preparation" },
        { title: "SOC 2 Type II Readiness", description: "Service organization control framework", href: "/packages/soc2-readiness" },
        { title: "GDPR Compliance Integration", description: "Privacy management alignment", href: "/packages/gdpr-accelerator" }
      ]
    },
    cta: {
      title: "Ready to Achieve ISO 27001 Certification?",
      subtitle: "Join hundreds of Finnish organizations that have successfully implemented ISO 27001 with our expert guidance. Let's discuss how we can help you build a robust information security management system.",
      primaryCTA: { text: "Start Your ISO 27001 Journey", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services/iso-27001" }
    }
  },
  fi: {
    hero: {
      title: "ISO 27001 - Tietoturvallisuuden hallintajärjestelmä",
      subtitle: "Saavuta kattava tietoturvallisuuden hallinta kansainvälisesti tunnustetuilla standardeilla",
      description: "Cybersecurity.fi on erikoistunut ISO 27001 -toteutukseen ja sertifiointiin tarjoten suomalaisille organisaatioille asiantuntevaa ohjausta vankkojen tietoturvallisuuden hallintajärjestelmien (ISMS) rakentamiseen, jotka suojaavat kriittisiä resursseja, varmistavat liiketoiminnan jatkuvuuden ja osoittavat sitoutumisen turvallisuuden huippuosaamiseen.",
      primaryCTA: { text: "Aloita ISO 27001 -toteutus", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services/iso-27001" }
    },
    benefits: {
      title: "Miksi valita Cybersecurity.fi ISO 27001 -toteutukseen",
      subtitle: "Kattava lähestymistapamme ISO 27001 -toteutukseen varmistaa, että organisaatiosi saavuttaa sertifioinnin samalla kun rakennat pysyviä turvallisuuskyvykkyyksiä, jotka luovat liiketoiminta-arvoa ja kilpailuetua.",
      items: [
        { title: "Strateginen turvallisuushallinta", description: "Perusta kattava ISMS, joka on linjassa liiketoimintatavoitteiden kanssa varmistaen, että turvallisuudesta tulee olennainen osa organisaation strategiaa ja päätöksentekoprosesseja.", icon: "target" },
        { title: "Lainsäädännön vaatimustenmukaisuus", description: "Täytä Suomen ja EU:n sääntelyvaatimukset, mukaan lukien GDPR, NIS2 ja toimialakohtaiset säännökset samalla kun saavutat kansainvälisesti tunnustetun sertifiointiaseman.", icon: "scale" },
        { title: "Riskipohjainen turvallisuuskehys", description: "Toteuta systemaattiset riskienhallintaprosessit ISO 27005 -standardin mukaisesti varmistaen, että uhat tunnistetaan, arvioidaan ja hallitaan tehokkaasti kaikilla liiketoiminta-alueilla.", icon: "shield" },
        { title: "Jatkuvan parantamisen kulttuuri", description: "Perusta jatkuvat seuranta-, mittaus- ja parantamisprosessit, jotka varmistavat ISMS:n kehittymisen muuttuvien uhkien ja liiketoimintavaatimusten mukana.", icon: "chart" },
        { title: "Liiketoiminnan jatkuvuuden integrointi", description: "Yhdenmukaista tietoturvakontrollit liiketoiminnan jatkuvuussuunnittelun kanssa varmistaen, että kriittiset toiminnot pysyvät suojattuina ja palautettavissa tapahtumien aikana.", icon: "building" },
        { title: "Sidosryhmien luottamus", description: "Osoita sitoutumisesi tietoturvallisuuden huippuosaamiseen rakentaen luottamusta asiakkaiden, kumppaneiden ja sääntelyviranomaisten kanssa kansainvälisesti tunnustetun sertifioinnin avulla.", icon: "handshake" }
      ]
    },
    steps: {
      title: "Todistettu ISO 27001 -toteutusmetodologiamme",
      subtitle: "Rakenteinen 28 viikon lähestymistapa varmistaa onnistuneen ISO 27001 -sertifioinnin samalla kun rakennetaan kestäviä turvallisuuskyvykkyyksiä ja ylläpidetään liiketoiminnan jatkuvuutta koko toteutusprosessin ajan.",
      items: [
        {
          phase: "Vaihe 1: Perusta ja suunnittelu",
          duration: "Viikot 1-6",
          activities: ["Kattava aukkoanalyysi ISO 27001 -vaatimuksia vastaan", "ISMS-laajuuden määrittely ja rajaaminen", "Tieto-omaisuuden inventointi ja luokittelu", "Sidosryhmien osallistaminen ja sitoutumisen varmistaminen", "Projektitiimin muodostaminen ja koulutus", "Riskinarviointimenetelmän valinta"],
          deliverables: ["Aukkoanalyysiraportti priorisoiduilla suosituksilla", "ISMS-laajuusselvitys ja peruskirja", "Tieto-omaisuusrekisteri", "Projektisuunnitelma resurssien allokoinnilla", "Riskinarviointikehys"]
        },
        {
          phase: "Vaihe 2: Riskienhallinta & kontrollien suunnittelu",
          duration: "Viikot 7-14",
          activities: ["Kattava riskien tunnistaminen ja arviointi", "Uhkien mallinnus ja haavoittuvuusanalyysi", "Kontrollitavoitteiden kartoitus ja valinta", "Soveltuvuuslausuman (SoA) kehitys", "Riskien käsittelysuunnitelman luominen", "Tietoturvapolitiikkakehyksen kehitys"],
          deliverables: ["Riskinarviointiraportti", "Riskien käsittelysuunnitelma", "Soveltuvuuslausuma", "Tietoturvapolitiikkakokonaisuus", "Kontrollien toteutuksen tiekartta"]
        },
        {
          phase: "Vaihe 3: Toteutus ja dokumentointi",
          duration: "Viikot 15-22",
          activities: ["Tietoturvakontrollien toteutus kaikilla osa-alueilla", "Prosessidokumentointi ja menettelytapojen luominen", "Henkilöstön koulutus- ja tietoisuusohjelmat", "Tapahtumien hallintakyvyn perustaminen", "Käyttöoikeuksien ja identiteetinhallinnan asennus", "Seuranta- ja mittausjärjestelmän käyttöönotto"],
          deliverables: ["Toteutetut turvallisuuskontrollit", "Prosessidokumentaatiokirjasto", "Koulutusmateriaalit ja -tiedot", "Tapahtumien hallintamenettelyt", "Seuranta- ja mittauskehys"]
        },
        {
          phase: "Vaihe 4: Testaus ja sertifiointivalmistelu",
          duration: "Viikot 23-28",
          activities: ["Sisäisen auditointiohjelman toteutus", "Johdon katselmus ja päätöksenteko", "Korjaavien toimenpiteiden toteutus", "Esisertifioinnin valmiusarviointi", "Ulkoisen auditoinnin koordinointi", "Jatkuvan parantamisen suunnittelu"],
          deliverables: ["Sisäiset auditointiraportit", "Johdon katselmuspöytäkirjat", "Korjaavien toimenpiteiden suunnitelmat", "ISO 27001 -sertifikaatti", "Jatkuvan parantamisen ohjelma"]
        }
      ]
    },
    industries: {
      title: "Toimialakohtaiset menestystarinat",
      subtitle: "Katso, kuinka olemme auttaneet organisaatioita eri toimialoilla saavuttamaan ISO 27001 -sertifioinnin samalla kun käsittelemme heidän ainutlaatuisia haasteitaan.",
      items: [
        {
          industry: "Rahoituspalvelut",
          challenge: "Finanssivalvonnan (FIN-FSA) vaatimusten täyttäminen samalla kun toteutetaan kattavaa tietoturvallisuuden hallintaa, joka kattaa sekä perinteiset pankkitoiminnan riskit että nousevat fintech-haasteet.",
          solution: "Integroitu ISMS-toteutus, joka yhdistää ISO 27001:n toimialakohtaisiin kontrolleihin maksujen käsittelyssä, asiakastietojen suojauksessa ja sääntelyraportoinnissa. Sisälsi erikoistuneet moduulit digitaalisen pankkitoiminnan turvallisuudelle ja kryptovaluuttojen käsittelylle.",
          outcome: "Saavutettiin ISO 27001 -sertifiointi 6 kuukaudessa täydellisellä FIN-FSA-vaatimustenmukaisuudella. Turvallisuuspoikkeamat vähenivät 78% ja sääntelytarkastusten tulokset paranivat. Asiakasluottamus parani, mikä johti 23%:n kasvuun digitaalisten palveluiden käytössä."
        },
        {
          industry: "Terveydenhuolto & MedTech",
          challenge: "Arkaluonteisten potilastietojen suojaaminen GDPR:n mukaisesti samalla kun varmistetaan lääkinnällisten laitteiden turvallisuus ja ylläpidetään yhteentoimivuutta olemassa olevien terveydenhuoltojärjestelmien kanssa useissa toimipisteissä.",
          solution: "Tietosuoja-by-design -ISMS-toteutus terveydenhuollon erityiskontrolleilla, jotka kattavat lääkinnällisten laitteiden kyberturvallisuuden, potilastietovirrat ja kliinisen tutkimusdatan suojauksen. Integrointi olemassa oleviin laatujärjestelmiin (ISO 13485).",
          outcome: "Täysi GDPR-vaatimustenmukaisuus saavutettiin yhdessä ISO 27001 -sertifioinnin kanssa. Ei yhtään potilastietoturvaloukkausta 18 kuukauden aikana toteutuksen jälkeen. 34% vähennys kyberturvallisuuteen liittyvässä kriittisten lääketieteellisten järjestelmien seisokkiajassa."
        },
        {
          industry: "Teollisuus & Valmistus",
          challenge: "Teollisuuden ohjausjärjestelmien (ICS) ja operatiivisen teknologian (OT) turvaaminen samalla kun ylläpidetään tuotannon tehokkuutta ja suojataan immateriaalioikeuksia maailmanlaajuisesti hajautetuissa valmistustoiminnoissa.",
          solution: "Kattava ISMS, joka kattaa sekä IT- että OT-ympäristöt erikoiskontrolleilla teollisuusverkoille, toimitusketjun turvallisuudelle ja immateriaalioikeuksien suojaukselle. Nollaluottamusarkkitehtuurin käyttöönotto kriittisille tuotantojärjestelmille.",
          outcome: "Päästä päähän -turvallisuuskehys suojaa kriittisiä valmistusprosesseja. 89% vähennys OT-turvallisuuspoikkeamissa ja parantunut toimitusketjun kestävyys. ISO 27001 -sertifiointi mahdollisti laajentumisen säännellyille markkinoille."
        }
      ]
    },
    related: {
      title: "Aiheeseen liittyvät palvelut",
      subtitle: "Paranna kyberturvallisuusasemaasi täydentävillä palveluillamme ja kehyksillämme.",
      items: [
        { title: "NIS2-direktiivin vaatimustenmukaisuus", description: "EU:n kyberturvallisuusdirektiivin toteutus", href: "/frameworks/nis2" },
        { title: "Riskiarviointipalvelut", description: "Kattava riskienhallinta", href: "/services/risk-assessments" },
        { title: "Turvallisuuspolitiikkojen kehitys", description: "Strateginen hallintakehys", href: "/services/policy-development" },
        { title: "Turvallisuusauditointiin valmistautuminen", description: "Sertifiointivalmiuden tuki", href: "/services/audit-preparation" },
        { title: "SOC 2 Type II -valmius", description: "Palveluorganisaation kontrollikehys", href: "/packages/soc2-readiness" },
        { title: "GDPR-vaatimustenmukaisuuden integrointi", description: "Tietosuojajärjestelmän yhdenmukaistaminen", href: "/packages/gdpr-accelerator" }
      ]
    },
    cta: {
      title: "Valmis saavuttamaan ISO 27001 -sertifioinnin?",
      subtitle: "Liity satojen suomalaisten organisaatioiden joukkoon, jotka ovat onnistuneesti toteuttaneet ISO 27001 -standardin asiantuntijaohjauksellamme. Keskustellaan, kuinka voimme auttaa sinua rakentamaan vankan tietoturvallisuuden hallintajärjestelmän.",
      primaryCTA: { text: "Aloita ISO 27001 -matkasi", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services/iso-27001" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="award" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Key Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.benefits.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.benefits.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Implementation Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.steps.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.steps.subtitle}
      </p>
    </div>
    
    <div class="space-y-6">
      {currentContent.steps.items.map((step, index) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-lg transition-all duration-300
                    group">
          
          <div class="flex flex-col md:flex-row gap-6">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold text-lg">
                {index + 1}
              </div>
            </div>
            
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-700 transition-colors duration-300">
                  {step.phase}
                </h3>
                <span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-700">
                  {step.duration}
                </span>
              </div>
              
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <h4 class="font-semibold text-slate-800 text-sm mb-2">Key Activities</h4>
                  <ul class="space-y-1.5">
                    {step.activities.slice(0, 5).map((activity) => (
                      <li class="flex items-start text-xs text-slate-500">
                        <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        {activity}
                      </li>
                    ))}
                  </ul>
                </div>
                
                <div>
                  <h4 class="font-semibold text-slate-800 text-sm mb-2">Deliverables</h4>
                  <ul class="space-y-1.5">
                    {step.deliverables.slice(0, 4).map((deliverable) => (
                      <li class="flex items-start text-xs text-slate-500">
                        <svg class="w-3 h-3 text-blue-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        {deliverable}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Industry Examples Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.industries.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.industries.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.industries.items.map((example) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="mb-4">
            <span class="inline-block bg-blue-100 text-blue-700 text-xs font-medium px-3 py-1 rounded-full group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:text-white transition-all duration-300">
              {example.industry}
            </span>
          </div>
          
          <h4 class="font-semibold text-slate-800 text-sm mb-2">Challenge:</h4>
          <p class="text-slate-500 text-xs mb-3">{example.challenge.substring(0, 150)}...</p>
          
          <h4 class="font-semibold text-slate-800 text-sm mb-2">Our Solution:</h4>
          <p class="text-slate-500 text-xs mb-3">{example.solution.substring(0, 150)}...</p>
          
          <h4 class="font-semibold text-slate-800 text-sm mb-2">Outcome:</h4>
          <p class="text-slate-500 text-xs">{example.outcome.substring(0, 120)}...</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Related Services Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.related.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.related.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {currentContent.related.items.map((service) => (
        <a href={service.href} class="bg-slate-50/50 rounded-xl border border-slate-100 p-5
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    group block">
          
          <h3 class="text-base font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {service.title}
          </h3>
          <p class="text-slate-500 text-xs">{service.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>