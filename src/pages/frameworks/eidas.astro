---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "eIDAS Digital Identity and Trust Services | EU Digital Identity Compliance",
  description: "Achieve EU digital identity compliance with our specialized eIDAS implementation methodology for Finnish organizations. Build robust digital identity and trust service frameworks.",
  keywords: "eIDAS, digital identity, trust services, electronic signatures, EU digital identity, qualified trust services",
  type: "framework" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "eIDAS Digital Identity and Trust Services",
      subtitle: "EU Digital Identity Compliance",
      description: "We help Finnish organizations implement eIDAS requirements, building robust digital identity and trust service frameworks that enable secure cross-border digital transactions.",
      primaryCTA: { text: "Start eIDAS Compliance", href: "/contact?service=eidas" },
      secondaryCTA: { text: "Learn More", href: "/services/eidas-digital-trust" }
    },
    benefits: {
      title: "Why Choose Our eIDAS Services",
      subtitle: "We deliver eIDAS compliance with digital identity expertise, ensuring your organization can provide secure cross-border digital services.",
      items: [
        { title: "Cross-Border Compliance", description: "Meet EU eIDAS requirements for seamless digital identity across European markets.", icon: "globe" },
        { title: "Finnish Market Expertise", description: "Deep understanding of Finnish digital identity requirements and EU eIDAS integration.", icon: "flag" },
        { title: "Trust Service Provider", description: "Implement qualified trust services for electronic signatures, seals, and certificates.", icon: "shield-check" },
        { title: "Digital Transformation", description: "Enable secure digital business processes and cross-border transactions.", icon: "arrow-path" }
      ]
    },
    requirements: {
      title: "eIDAS Compliance Requirements",
      subtitle: "Our eIDAS implementation covers all key requirements, ensuring comprehensive compliance with EU digital identity standards.",
      items: [
        { title: "Digital Identity Management", description: "Implement secure digital identity systems compliant with eIDAS standards", icon: "user", controls: ["Identity Verification", "Authentication Methods", "Identity Federation", "Privacy Protection"] },
        { title: "Trust Services", description: "Provide qualified trust services for electronic transactions", icon: "shield-check", controls: ["Electronic Signatures", "Electronic Seals", "Time Stamps", "Certificate Services"] },
        { title: "Cross-Border Recognition", description: "Ensure digital identities and trust services are recognized across EU member states", icon: "globe", controls: ["Standards Compliance", "Interoperability", "Mutual Recognition", "Compliance Monitoring"] },
        { title: "Security and Privacy", description: "Implement robust security measures and privacy protection for digital identity systems", icon: "lock-closed", controls: ["Encryption", "Access Controls", "Audit Logging", "Data Protection"] },
        { title: "Compliance Monitoring", description: "Establish ongoing monitoring and compliance verification for eIDAS requirements", icon: "chart-line", controls: ["Regular Audits", "Compliance Reporting", "Risk Assessment", "Continuous Improvement"] }
      ]
    },
    phases: {
      title: "30-Week Implementation Roadmap",
      subtitle: "Structured approach ensuring successful eIDAS compliance within 30 weeks while maintaining business operations.",
      items: [
        { phase: "Phase 1: Assessment & Planning", duration: "Weeks 1-6", activities: ["Gap Analysis", "Scope Definition", "Stakeholder Engagement", "Resource Planning"], deliverables: ["Gap Analysis Report", "Project Charter", "Stakeholder Map", "Resource Plan"] },
        { phase: "Phase 2: Architecture Design", duration: "Weeks 7-12", activities: ["System Architecture", "Security Design", "Integration Planning", "Compliance Framework"], deliverables: ["Architecture Document", "Security Framework", "Integration Plan", "Compliance Matrix"] },
        { phase: "Phase 3: Implementation", duration: "Weeks 13-24", activities: ["System Development", "Security Implementation", "Testing", "Documentation"], deliverables: ["Digital Identity System", "Trust Services", "Test Results", "Compliance Documentation"] },
        { phase: "Phase 4: Validation & Certification", duration: "Weeks 25-30", activities: ["Compliance Testing", "Security Validation", "Certification Preparation", "Go-Live"], deliverables: ["Compliance Certificate", "Security Validation Report", "Production System", "Operational Procedures"] }
      ]
    },
    industries: {
      title: "Industry-Specific Success Stories",
      subtitle: "See how we've helped organizations across different industries achieve eIDAS compliance.",
      items: [
        { industry: "Financial Services", challenge: "Implementing eIDAS for secure cross-border financial transactions", solution: "Integrated digital identity framework with qualified trust services", outcome: "eIDAS compliance with enhanced cross-border transaction security" },
        { industry: "Public Sector", challenge: "Providing secure digital services to citizens across EU member states", solution: "Federated identity system with eIDAS-compliant trust services", outcome: "Seamless cross-border digital service delivery" },
        { industry: "E-commerce", challenge: "Enabling secure customer authentication for EU market expansion", solution: "eIDAS-compliant customer identity and access management", outcome: "Secure customer authentication across European markets" }
      ]
    },
    related: {
      title: "Related Services",
      subtitle: "Enhance your digital identity posture with our complementary services and frameworks.",
      items: [
        { title: "ISO 27001 Implementation", description: "Information security management", href: "/frameworks/iso-27001" },
        { title: "GDPR Compliance", description: "Data protection compliance", href: "/frameworks/gdpr" },
        { title: "Digital Identity Management", description: "Identity and access management", href: "/frameworks/digital-identity" },
        { title: "Trust Service Provider", description: "Qualified trust services", href: "/frameworks/trust-services" }
      ]
    },
    cta: {
      title: "Ready to Achieve eIDAS Compliance?",
      subtitle: "Join Finnish organizations that have successfully implemented eIDAS with our expert guidance. Let's discuss how we can help you provide secure cross-border digital services.",
      primaryCTA: { text: "Start Your eIDAS Journey", href: "/contact" },
      secondaryCTA: { text: "Learn More", href: "/services/eidas-digital-trust" }
    }
  },
  fi: {
    hero: {
      title: "eIDAS-digitaalinen identiteetti ja luottamuspalvelut",
      subtitle: "EU:n digitaalisen identiteetin vaatimustenmukaisuus",
      description: "Autamme suomalaisia organisaatioita toteuttamaan eIDAS-vaatimukset, rakentaen vankkoja digitaalisen identiteetin ja luottamuspalvelukehyksiä, jotka mahdollistavat turvalliset rajat ylittävät digitaaliset tapahtumat.",
      primaryCTA: { text: "Aloita eIDAS-vaatimustenmukaisuus", href: "/contact?service=eidas" },
      secondaryCTA: { text: "Lue lisää", href: "/services/eidas-digital-trust" }
    },
    benefits: {
      title: "Miksi valita eIDAS-palvelumme",
      subtitle: "Tarjoamme eIDAS-vaatimustenmukaisuuden digitaalisen identiteetin asiantuntemuksella varmistaen, että organisaatiosi voi tarjota turvallisia rajat ylittäviä digitaalisia palveluita.",
      items: [
        { title: "Rajat ylittävä vaatimustenmukaisuus", description: "Täytä EU:n eIDAS-vaatimukset saumattomalle digitaaliselle identiteetille Euroopan markkinoilla.", icon: "globe" },
        { title: "Suomalainen markkinaosaaminen", description: "Syvä ymmärrys Suomen digitaalisen identiteetin vaatimuksista ja EU:n eIDAS-integraatiosta.", icon: "flag" },
        { title: "Luottamuspalveluntarjoaja", description: "Toteuta laatuvarmenteiset luottamuspalvelut sähköisille allekirjoituksille, sineteille ja varmenteille.", icon: "shield-check" },
        { title: "Digitaalinen muutos", description: "Mahdollista turvalliset digitaaliset liiketoimintaprosessit ja rajat ylittävät tapahtumat.", icon: "arrow-path" }
      ]
    },
    requirements: {
      title: "eIDAS-vaatimustenmukaisuusvaatimukset",
      subtitle: "eIDAS-toteutuksemme kattaa kaikki keskeiset vaatimukset varmistaen kattavan vaatimustenmukaisuuden EU:n digitaalisen identiteetin standardien kanssa.",
      items: [
        { title: "Digitaalisen identiteetin hallinta", description: "Toteuta turvalliset digitaalisen identiteetin järjestelmät eIDAS-standardien mukaisesti", icon: "user", controls: ["Identiteetin varmennus", "Todennusmenetelmät", "Identiteetin federaatio", "Tietosuojan suojaus"] },
        { title: "Luottamuspalvelut", description: "Tarjoa laatuvarmenteiset luottamuspalvelut sähköisille tapahtumille", icon: "shield-check", controls: ["Sähköiset allekirjoitukset", "Sähköiset sinetit", "Aikaleimat", "Varmentepalvelut"] },
        { title: "Rajat ylittävä tunnustaminen", description: "Varmista, että digitaaliset identiteetit ja luottamuspalvelut tunnustetaan EU:n jäsenvaltioissa", icon: "globe", controls: ["Standardien vaatimustenmukaisuus", "Yhteentoimivuus", "Molemminpuolinen tunnustaminen", "Vaatimustenmukaisuuden seuranta"] },
        { title: "Turvallisuus ja tietosuoja", description: "Toteuta vankat turvatoimet ja tietosuojaus digitaalisen identiteetin järjestelmille", icon: "lock-closed", controls: ["Salaus", "Käyttöoikeuksien hallinta", "Auditointilokit", "Tietosuoja"] },
        { title: "Vaatimustenmukaisuuden seuranta", description: "Perusta jatkuva seuranta ja vaatimustenmukaisuuden varmennus eIDAS-vaatimuksille", icon: "chart-line", controls: ["Säännölliset auditoinnit", "Vaatimustenmukaisuusraportointi", "Riskinarviointi", "Jatkuva parantaminen"] }
      ]
    },
    phases: {
      title: "30 viikon toteutussuunnitelma",
      subtitle: "Rakenteinen lähestymistapa varmistaa onnistuneen eIDAS-vaatimustenmukaisuuden 30 viikon kuluessa samalla kun liiketoiminta säilyy.",
      items: [
        { phase: "Vaihe 1: Arviointi ja suunnittelu", duration: "Viikot 1-6", activities: ["Aukkoanalyysi", "Laajuuden määrittely", "Sidosryhmien osallistuminen", "Resurssien suunnittelu"], deliverables: ["Aukkoanalyysiraportti", "Projektisuunnitelma", "Sidosryhmäkartta", "Resurssisuunnitelma"] },
        { phase: "Vaihe 2: Arkkitehtuurin suunnittelu", duration: "Viikot 7-12", activities: ["Järjestelmäarkkitehtuuri", "Turvallisuussuunnittelu", "Integroinnin suunnittelu", "Vaatimustenmukaisuuskehys"], deliverables: ["Arkkitehtuuridokumentti", "Turvallisuuskehys", "Integrointisuunnitelma", "Vaatimustenmukaisuusmatriisi"] },
        { phase: "Vaihe 3: Toteutus", duration: "Viikot 13-24", activities: ["Järjestelmäkehitys", "Turvallisuuden toteutus", "Testaus", "Dokumentointi"], deliverables: ["Digitaalisen identiteetin järjestelmä", "Luottamuspalvelut", "Testitulokset", "Vaatimustenmukaisuusdokumentaatio"] },
        { phase: "Vaihe 4: Validointi ja sertifiointi", duration: "Viikot 25-30", activities: ["Vaatimustenmukaisuustestaus", "Turvallisuusvalidointi", "Sertifiointivalmistelu", "Käyttöönotto"], deliverables: ["Vaatimustenmukaisuussertifikaatti", "Turvallisuusvalidointiraportti", "Tuotantojärjestelmä", "Operatiiviset menettelyt"] }
      ]
    },
    industries: {
      title: "Toimialakohtaiset menestystarinat",
      subtitle: "Katso, kuinka olemme auttaneet organisaatioita eri toimialoilla saavuttamaan eIDAS-vaatimustenmukaisuuden.",
      items: [
        { industry: "Rahoituspalvelut", challenge: "eIDASin toteuttaminen turvallisille rajat ylittäville rahoitustapahtumille", solution: "Integroitu digitaalisen identiteetin kehys laatuvarmenteisilla luottamuspalveluilla", outcome: "eIDAS-vaatimustenmukaisuus parannetulla rajat ylittävän tapahtuman turvallisuudella" },
        { industry: "Julkinen sektori", challenge: "Turvallisten digitaalisten palveluiden tarjoaminen kansalaisille EU:n jäsenvaltioissa", solution: "Federoitu identiteettijärjestelmä eIDAS-yhteensopivilla luottamuspalveluilla", outcome: "Saumaton rajat ylittävä digitaalisten palveluiden toimitus" },
        { industry: "Verkkokauppa", challenge: "Turvallisen asiakastodennuksen mahdollistaminen EU-markkinoiden laajentumiselle", solution: "eIDAS-yhteensopiva asiakasidentiteetin ja pääsynhallinta", outcome: "Turvallinen asiakastodennus Euroopan markkinoilla" }
      ]
    },
    related: {
      title: "Aiheeseen liittyvät palvelut",
      subtitle: "Paranna digitaalisen identiteetin asemaasi täydentävillä palveluillamme ja kehyksillämme.",
      items: [
        { title: "ISO 27001 -toteutus", description: "Tietoturvallisuuden hallinta", href: "/frameworks/iso-27001" },
        { title: "GDPR-vaatimustenmukaisuus", description: "Tietosuojan vaatimustenmukaisuus", href: "/frameworks/gdpr" },
        { title: "Digitaalisen identiteetin hallinta", description: "Identiteetin ja pääsyn hallinta", href: "/frameworks/digital-identity" },
        { title: "Luottamuspalveluntarjoaja", description: "Laatuvarmenteiset luottamuspalvelut", href: "/frameworks/trust-services" }
      ]
    },
    cta: {
      title: "Valmis saavuttamaan eIDAS-vaatimustenmukaisuuden?",
      subtitle: "Liity suomalaisten organisaatioiden joukkoon, jotka ovat onnistuneesti toteuttaneet eIDASin asiantuntijaohjauksellamme. Keskustellaan, kuinka voimme auttaa sinua tarjoamaan turvallisia rajat ylittäviä digitaalisia palveluita.",
      primaryCTA: { text: "Aloita eIDAS-matkasi", href: "/contact" },
      secondaryCTA: { text: "Lue lisää", href: "/services/eidas-digital-trust" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Key Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.benefits.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.benefits.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- eIDAS Requirements Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.requirements.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.requirements.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.requirements.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {item.description}
          </p>
          
          <div class="mt-auto">
            <h4 class="font-semibold text-slate-800 text-sm mb-2">Key Controls:</h4>
            <ul class="space-y-1.5">
              {item.controls.map((control) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {control}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Implementation Phases Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.phases.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.phases.subtitle}
      </p>
    </div>
    
    <div class="space-y-6">
      {currentContent.phases.items.map((phase, index) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-lg transition-all duration-300
                    group">
          
          <div class="flex flex-col md:flex-row gap-6">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold text-lg">
                {index + 1}
              </div>
            </div>
            
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-700 transition-colors duration-300">
                  {phase.phase}
                </h3>
                <span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-700">
                  {phase.duration}
                </span>
              </div>
              
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <h4 class="font-semibold text-slate-800 text-sm mb-2">Key Activities</h4>
                  <ul class="space-y-1.5">
                    {phase.activities.map((activity) => (
                      <li class="flex items-start text-xs text-slate-500">
                        <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        {activity}
                      </li>
                    ))}
                  </ul>
                </div>
                
                <div>
                  <h4 class="font-semibold text-slate-800 text-sm mb-2">Deliverables</h4>
                  <ul class="space-y-1.5">
                    {phase.deliverables.map((deliverable) => (
                      <li class="flex items-start text-xs text-slate-500">
                        <svg class="w-3 h-3 text-blue-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        {deliverable}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Industry Examples Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.industries.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.industries.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.industries.items.map((example) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="mb-4">
            <span class="inline-block bg-blue-100 text-blue-700 text-xs font-medium px-3 py-1 rounded-full group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:text-white transition-all duration-300">
              {example.industry}
            </span>
          </div>
          
          <h4 class="font-semibold text-slate-800 text-sm mb-2">Challenge:</h4>
          <p class="text-slate-500 text-xs mb-4">{example.challenge}</p>
          
          <h4 class="font-semibold text-slate-800 text-sm mb-2">Our Solution:</h4>
          <p class="text-slate-500 text-xs mb-4">{example.solution}</p>
          
          <h4 class="font-semibold text-slate-800 text-sm mb-2">Outcome:</h4>
          <p class="text-slate-500 text-xs">{example.outcome}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Related Services Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.related.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.related.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-4 gap-6">
      {currentContent.related.items.map((service) => (
        <a href={service.href} class="bg-slate-50/50 rounded-xl border border-slate-100 p-5 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    group block">
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {service.title}
          </h3>
          <p class="text-slate-500 text-xs">{service.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>