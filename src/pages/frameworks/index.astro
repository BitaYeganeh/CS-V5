---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Regulatory Frameworks | Cybersecurity Regulations & Standards",
  description: "Comprehensive collection of key cybersecurity regulations and standards. Detailed guides for implementation and compliance. NIS2, DORA, GDPR, eIDAS, ISO 27001, SOC 2.",
  keywords: "regulatory frameworks, NIS2, DORA, GDPR, eIDAS, ISO 27001, SOC 2, cybersecurity compliance",
  type: "framework" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Cybersecurity Regulatory Frameworks",
      subtitle: "Comprehensive collection of key cybersecurity regulations and standards",
      description: "Detailed implementation guides and compliance support for all major cybersecurity regulations and standards.",
      primaryCTA: { text: "Browse Regulations", href: "#frameworks" },
      secondaryCTA: { text: "Get Expert Help", href: "/contact" }
    },
    stats: [
      { value: "6+", label: "Major regulations" },
      { value: "100+", label: "Requirements covered" },
      { value: "25+", label: "Industries supported" },
      { value: "98%", label: "Compliance success rate" }
    ],
    process: {
      title: "Implementation Process",
      subtitle: "Five-phase methodology for successful implementation of regulations and standards",
      steps: [
        { step: "1", title: "Current state assessment", icon: "search" },
        { step: "2", title: "Requirements analysis", icon: "list" },
        { step: "3", title: "Implementation planning", icon: "map" },
        { step: "4", title: "Practical implementation", icon: "tool" },
        { step: "5", title: "Audit and certification", icon: "award" }
      ]
    },
    frameworks: {
      title: "Supported Regulatory Frameworks",
      subtitle: "Comprehensive support for key cybersecurity regulations and standards",
      items: [
        {
          title: "NIS2 Directive",
          description: "European Union Network and Information Security Directive v2",
          icon: "shield",
          scope: "EU",
          deadline: "2024-10-17",
          sectors: ["Energy", "Transport", "Banking", "Health", "Digital Infrastructure"],
          href: "/frameworks/nis2",
          requirements: ["Cybersecurity risk management", "Incident reporting", "Supply chain security", "Staff training"]
        },
        {
          title: "DORA Regulation",
          description: "Digital Operational Resilience Act for financial sector",
          icon: "building",
          scope: "EU",
          deadline: "2025-01-17",
          sectors: ["Banking", "Insurance", "Investment", "Payment Services"],
          href: "/frameworks/dora",
          requirements: ["ICT risk management", "Third-party risk management", "Digital operational resilience", "Testing and exercises"]
        },
        {
          title: "GDPR Regulation",
          description: "General Data Protection Regulation for personal data processing",
          icon: "user-check",
          scope: "EU + Global",
          deadline: "2018-05-25",
          sectors: ["All sectors processing personal data"],
          href: "/frameworks/gdpr",
          requirements: ["Data protection impact assessments", "Personal data protection", "Data breach notification", "Individual rights"]
        },
        {
          title: "eIDAS Regulation",
          description: "Electronic identification and trust services",
          icon: "key",
          scope: "EU",
          deadline: "2016-07-01",
          sectors: ["Digital Services", "Public Services", "E-commerce"],
          href: "/frameworks/eidas",
          requirements: ["Electronic signatures", "Electronic sealed documents", "Time stamping", "Authentication services"]
        },
        {
          title: "ISO 27001",
          description: "International information security management system standard",
          icon: "award",
          scope: "Global",
          deadline: "Ongoing",
          sectors: ["All sectors"],
          href: "/frameworks/iso-27001",
          requirements: ["Information security policy", "Risk assessment process", "Security controls", "Continuous improvement"]
        },
        {
          title: "SOC 2",
          description: "Service organization control auditing",
          icon: "check-circle",
          scope: "Global",
          deadline: "Ongoing",
          sectors: ["SaaS", "Cloud Services", "Data Centers"],
          href: "/frameworks/soc-2",
          requirements: ["Security", "Availability", "Processing Integrity", "Confidentiality"]
        }
      ]
    },
    cta: {
      title: "Start Your Compliance Journey",
      subtitle: "Contact our experts and get a tailored implementation plan.",
      primaryCTA: { text: "Contact Us", href: "/contact" },
      secondaryCTA: { text: "Book Demo", href: "/demo" }
    }
  },
  fi: {
    hero: {
      title: "Kyberturvallisuuden säädöskehikot",
      subtitle: "Kattava kokoelma tärkeimmistä kyberturvallisuuden säädöksistä ja standardeista",
      description: "Yksityiskohtaiset toteutusoppaat ja compliance-tuet kaikille keskeisille kyberturvallisuuden säädöksille ja standardeille.",
      primaryCTA: { text: "Selaa säädöksiä", href: "#frameworks" },
      secondaryCTA: { text: "Pyydä asiantuntija-apua", href: "/contact" }
    },
    stats: [
      { value: "6+", label: "Tärkeintä säädöstä" },
      { value: "100+", label: "Vaatimusta katettu" },
      { value: "25+", label: "Toimialaa tuettu" },
      { value: "98%", label: "Compliance-onnistuminen" }
    ],
    process: {
      title: "Toteutusprosessi",
      subtitle: "Viiden vaiheen metodologia säädösten ja standardien onnistuneeseen toteutukseen",
      steps: [
        { step: "1", title: "Nykytilanteen kartoitus", icon: "search" },
        { step: "2", title: "Vaatimusten analysointi", icon: "list" },
        { step: "3", title: "Toteutussuunnitelman laadinta", icon: "map" },
        { step: "4", title: "Käytännön toteutus", icon: "tool" },
        { step: "5", title: "Auditointi ja sertifiointi", icon: "award" }
      ]
    },
    frameworks: {
      title: "Tuetut säädöskehikot",
      subtitle: "Kattava tuki tärkeimmille kyberturvallisuuden säädöksille ja standardeille",
      items: [
        {
          title: "NIS2-direktiivi",
          description: "EU:n verkko- ja tietoturvadirektiivin toinen versio",
          icon: "shield",
          scope: "EU",
          deadline: "2024-10-17",
          sectors: ["Energia", "Liikenne", "Pankkitoiminta", "Terveys", "Digitaalinen infrastruktuuri"],
          href: "/frameworks/nis2",
          requirements: ["Kyberturvallisuusriskien hallinta", "Incidenttien raportointi", "Toimitusketjun turvallisuus", "Henkilöstön koulutus"]
        },
        {
          title: "DORA-asetus",
          description: "Digitaalinen operatiivinen resilienssisääntely rahoitusalalla",
          icon: "building",
          scope: "EU",
          deadline: "2025-01-17",
          sectors: ["Pankkitoiminta", "Vakuutus", "Sijoituspalvelut", "Maksupalvelut"],
          href: "/frameworks/dora",
          requirements: ["ICT-riskinhallinta", "Kolmannen osapuolen riskien hallinta", "Digitaalinen operatiivinen kestävyys", "Testaus ja harjoitukset"]
        },
        {
          title: "GDPR-asetus",
          description: "Yleinen tietosuoja-asetus henkilötietojen käsittelyyn",
          icon: "user-check",
          scope: "EU + Global",
          deadline: "2018-05-25",
          sectors: ["Kaikki henkilötietoja käsittelevät toimialat"],
          href: "/frameworks/gdpr",
          requirements: ["Tietosuojan vaikutusarvioinnit", "Henkilötietojen suoja", "Tietomurtojen ilmoittaminen", "Henkilöiden oikeudet"]
        },
        {
          title: "eIDAS-asetus",
          description: "Sähköinen tunnistaminen ja luottamuspalvelut",
          icon: "key",
          scope: "EU",
          deadline: "2016-07-01",
          sectors: ["Digitaaliset palvelut", "Julkiset palvelut", "Verkkokauppa"],
          href: "/frameworks/eidas",
          requirements: ["Sähköiset allekirjoitukset", "Sähköiset sinetatut asiakirjat", "Aikaleimaus", "Tunnistautumispalvelut"]
        },
        {
          title: "ISO 27001",
          description: "Kansainvälinen tietoturvallisuuden hallintajärjestelmästandardi",
          icon: "award",
          scope: "Global",
          deadline: "Jatkuva",
          sectors: ["Kaikki toimialat"],
          href: "/frameworks/iso-27001",
          requirements: ["Tietoturvallisuuspolitiikka", "Riskinarviointiprosessi", "Turvallisuuskontrollit", "Jatkuva parantaminen"]
        },
        {
          title: "SOC 2",
          description: "Palvelujärjestelmien kontrolliauditointi",
          icon: "check-circle",
          scope: "Global",
          deadline: "Jatkuva",
          sectors: ["SaaS", "Pilvipalvelut", "Datakeskukset"],
          href: "/frameworks/soc-2",
          requirements: ["Turvallisuus (Security)", "Käytettävyys (Availability)", "Käsittelyn eheys (Processing Integrity)", "Luottamuksellisuus (Confidentiality)"]
        }
      ]
    },
    cta: {
      title: "Aloita compliance-matka",
      subtitle: "Ota yhteyttä asiantuntijoihimme ja saa räätälöity toteutussuunnitelma.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa demo", href: "/demo" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="book" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Stats Section -->
<section class="py-12 bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {currentContent.stats.map((stat) => (
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-[#1E2A7A] mb-2">
            {stat.value}
          </div>
          <div class="text-slate-500 text-sm">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Implementation Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-5 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <div class="flex justify-center mb-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6]">
              <Icon name={step.icon} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-sm font-semibold text-slate-800 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Frameworks Grid Section -->
<section id="frameworks" class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.frameworks.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.frameworks.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {currentContent.frameworks.items.map((framework) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-between items-start mb-4">
            <div class="flex justify-end">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
                <Icon name={framework.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <div class="text-right">
              <div class="text-xs font-medium text-blue-600 mb-1">{framework.scope}</div>
              <div class="text-xs text-slate-400">Active: {framework.deadline}</div>
            </div>
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {framework.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {framework.description}
          </p>
          
          <div class="mb-4">
            <h4 class="font-semibold text-slate-800 text-xs mb-2 uppercase tracking-wide">
              Key Requirements:
            </h4>
            <ul class="space-y-1.5">
              {framework.requirements.map((req) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {req}
                </li>
              ))}
            </ul>
          </div>
          
          <div class="mb-5">
            <div class="text-xs font-semibold text-slate-700 mb-2">Sectors:</div>
            <div class="flex flex-wrap gap-1.5">
              {framework.sectors.map((sector) => (
                <span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-xs">
                  {sector}
                </span>
              ))}
            </div>
          </div>
          
          <a href={framework.href} class="mt-auto inline-flex items-center justify-center w-full px-4 py-2.5 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5">
            {lang === 'fi' ? 'Lue lisää' : 'Learn More'}
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>