---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "ISO 27001 Services | Information Security Management System",
  description: "Professional ISO 27001 Information Security Management System certification and consulting services. We help organizations build a strong cybersecurity foundation.",
  keywords: "ISO 27001, ISMS, information security, certification, security management, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "ISO 27001 Services",
      subtitle: "Information Security Management System",
      description: "Professional ISO 27001 Information Security Management System certification and consulting services. We help organizations build a strong cybersecurity foundation. Build a strong cybersecurity foundation according to ISO 27001 standard. We help organizations achieve international information security standard.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    services: {
      title: "Our ISO 27001 Services",
      subtitle: "Comprehensive services for ISO 27001 certification that support your organization's cybersecurity development.",
      items: [
        { title: "Gap Analysis", description: "Assess current security posture and identify gaps against ISO 27001 requirements", icon: "chart", features: ["Security risk assessment", "Requirements compliance check", "Improvement recommendations"] },
        { title: "ISMS Design", description: "Design and implement information security management system according to ISO 27001 standard", icon: "shield", features: ["Security policies", "Process definitions", "Role and responsibility clarification"] },
        { title: "Certification", description: "Prepare for and pass ISO 27001 certification audit", icon: "certificate", features: ["Internal auditing", "Certification audit preparation", "Continuous maintenance"] }
      ]
    },
    benefits: {
      title: "ISO 27001 Benefits",
      subtitle: "Achieve concrete benefits with ISO 27001 certification.",
      items: [
        "Strengthen customer trust",
        "Protect business secrets",
        "Meet regulatory requirements",
        "Improve risk management",
        "Reduce security risks"
      ]
    },
    process: {
      title: "Certification Process",
      subtitle: "Clear and structured process for ISO 27001 certification.",
      steps: [
        { step: "1", title: "Initial Assessment", description: "Assess current security posture and define objectives" },
        { step: "2", title: "ISMS Design", description: "Design security management system and define processes" },
        { step: "3", title: "Implementation", description: "Implement planned security measures" },
        { step: "4", title: "Internal Audit", description: "Conduct internal audit and fix gaps" },
        { step: "5", title: "Certification", description: "Pass certification audit and achieve ISO 27001" }
      ]
    },
    cta: {
      title: "Ready to start your ISO 27001 journey?",
      subtitle: "Contact us and let's start your ISO 27001 certification process.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "ISO 27001 Palvelut",
      subtitle: "Tietoturvajärjestelmän Hallinta",
      description: "Ammattimaiset ISO 27001 tietoturvajärjestelmän sertifiointi- ja konsultointipalvelut. Autamme organisaatioita rakentamaan vahvan tietoturvan perustan. Rakenna vahva tietoturvan perusta ISO 27001 standardin mukaisesti. Autamme organisaatioita saavuttamaan kansainvälisen tietoturvastandardin.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    services: {
      title: "ISO 27001 Palvelumme",
      subtitle: "Kattavat palvelut ISO 27001 sertifiointiin, joka tukee organisaatiosi tietoturvan kehitystä.",
      items: [
        { title: "Gap Analysis", description: "Arvioi nykyisen tietoturvatason ja ISO 27001 vaatimusten väliset erot", icon: "chart", features: ["Tietoturvariskien arviointi", "Vaatimusten vastaavuus", "Suositukset parannuksista"] },
        { title: "ISMS Suunnittelu", description: "Suunnittele ja toteuta tietoturvajärjestelmä ISO 27001 standardin mukaisesti", icon: "shield", features: ["Tietoturvapolitiikat", "Prosessien määrittely", "Roolien ja vastuiden selvennys"] },
        { title: "Sertifiointi", description: "Valmistaudu ja läpäise ISO 27001 sertifiointi auditti", icon: "certificate", features: ["Sisäinen auditointi", "Sertifiointiauditoinnin valmistelu", "Jatkuva ylläpito"] }
      ]
    },
    benefits: {
      title: "ISO 27001 Edut",
      subtitle: "Saavuta konkreettisia hyötyjä ISO 27001 sertifioinnin avulla.",
      items: [
        "Vahvista asiakkaiden luottamusta",
        "Suojaa liikesalaisuudet",
        "Täytä sääntelyvaatimukset",
        "Paranna riskienhallintaa",
        "Vähennä tietoturvariskejä"
      ]
    },
    process: {
      title: "Sertifiointiprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi ISO 27001 sertifiointiin.",
      steps: [
        { step: "1", title: "Alustava arviointi", description: "Arvioidaan nykyinen tietoturvataso ja määritellään tavoitteet" },
        { step: "2", title: "ISMS Suunnittelu", description: "Suunnitellaan tietoturvajärjestelmä ja määritellään prosessit" },
        { step: "3", title: "Toteutus", description: "Toteutetaan suunnitellut tietoturvatoimenpiteet" },
        { step: "4", title: "Sisäinen auditointi", description: "Suoritetaan sisäinen auditointi ja korjataan puutteet" },
        { step: "5", title: "Sertifiointi", description: "Läpäistään sertifiointiauditointi ja saavutetaan ISO 27001" }
      ]
    },
    cta: {
      title: "Valmiit aloittamaan ISO 27001 matkanne?",
      subtitle: "Ota yhteyttä meihin ja aloitetaan ISO 27001 sertifiointiprosessi.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Services Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.services.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.services.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.services.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {item.description}
          </p>
          
          <div class="mt-auto">
            <ul class="space-y-1.5">
              {item.features.map((feature) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.benefits.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6">
      {currentContent.benefits.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-6 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    flex items-center justify-center">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <span class="text-slate-700 text-sm font-medium">{item}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>