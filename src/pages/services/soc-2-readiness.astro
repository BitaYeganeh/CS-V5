---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "SOC 2 Readiness | Trust Service Criteria Certification",
  description: "Professional SOC 2 Type II certification services. We help SaaS and technology companies achieve trust and security standards.",
  keywords: "SOC 2, SOC 2 readiness, trust service criteria, Type II certification, SaaS security, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "SOC 2 Readiness",
      subtitle: "Trust Service Criteria Certification",
      description: "Professional SOC 2 Type II certification services. We help SaaS and technology companies achieve trust and security standards. Achieve SOC 2 Type II certification and strengthen customer trust. We help SaaS and technology companies build a strong cybersecurity foundation.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    trustServices: {
      title: "Trust Service Criteria",
      subtitle: "SOC 2 is based on five trust service criteria that define security standards.",
      items: [
        { title: "Security", description: "Protect systems and data from unauthorized access", icon: "shield", criteria: ["User access management", "Encryption and security", "Security monitoring"] },
        { title: "Availability", description: "Ensure continuous service availability and performance", icon: "clock", criteria: ["Planned maintenance", "Incident management", "Performance monitoring"] },
        { title: "Processing", description: "Ensure accurate data processing and integrity", icon: "check", criteria: ["Data validation", "Error handling", "Data backup"] },
        { title: "Confidentiality", description: "Protect sensitive information from unauthorized disclosure", icon: "lock", criteria: ["Data classification", "Non-disclosure agreements", "Data encryption"] },
        { title: "Privacy", description: "Comply with privacy and personal data processing", icon: "user", criteria: ["GDPR compliance", "Personal data management", "Privacy protection"] }
      ]
    },
    process: {
      title: "Readiness Process",
      subtitle: "Clear and structured process for SOC 2 certification.",
      steps: [
        { step: "1", title: "Initial Assessment", description: "Assess current security posture against SOC 2 requirements" },
        { step: "2", title: "Gap Analysis", description: "Identify gaps and plan remediation measures" },
        { step: "3", title: "Implementation", description: "Implement required security measures" },
        { step: "4", title: "Internal Audit", description: "Conduct internal audit and fix gaps" },
        { step: "5", title: "External Audit", description: "Pass external SOC 2 audit" }
      ]
    },
    benefits: {
      title: "SOC 2 Benefits",
      subtitle: "Achieve concrete benefits with SOC 2 certification.",
      items: [
        "Strengthen customer trust",
        "Differentiate from competitors",
        "Meet regulatory requirements",
        "Improve security posture",
        "Accelerate sales process"
      ]
    },
    cta: {
      title: "Ready to start your SOC 2 journey?",
      subtitle: "Contact us and let's start your SOC 2 readiness process.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "SOC 2 Valmistelu",
      subtitle: "Luottamuspalvelukriteerien Sertifiointi",
      description: "Ammattimaiset SOC 2 Type II sertifiointipalvelut. Autamme SaaS- ja teknologiayrityksiä saavuttamaan luotettavuus- ja tietoturvastandardit. Saavuta SOC 2 Type II sertifiointi ja vahvista asiakkaiden luottamus. Autamme SaaS- ja teknologiayrityksiä rakentamaan vahvan tietoturvan perustan.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    trustServices: {
      title: "Luottamuspalvelukriteerit",
      subtitle: "SOC 2 perustuu viiteen luottamuspalvelukriteeriin, jotka määrittelevät tietoturvan standardit.",
      items: [
        { title: "Tietoturva", description: "Suojaa järjestelmiä ja tietoja luvattomalta käytöltä", icon: "shield", criteria: ["Käyttäjien hallinta", "Salaus ja tietoturva", "Tietoturvavalvonta"] },
        { title: "Saatavuus", description: "Varmista palvelun jatkuva saatavuus ja suorituskyky", icon: "clock", criteria: ["Suunnitelmallinen ylläpito", "Vikatilanteiden hallinta", "Suorituskyvyn seuranta"] },
        { title: "Käsittely", description: "Varmista tietojen oikeellinen käsittely ja eheys", icon: "check", criteria: ["Tietojen validointi", "Virheiden käsittely", "Tietojen varmuuskopiointi"] },
        { title: "Luottamuksellisuus", description: "Suojaa arkaluontoista tietoa luvattomalta paljastumiselta", icon: "lock", criteria: ["Tietojen luokittelu", "Salassapitosopimukset", "Tietojen salaus"] },
        { title: "Yksityisyys", description: "Noudata tietosuojaa ja henkilötietojen käsittelyä", icon: "user", criteria: ["GDPR yhteensopivuus", "Henkilötietojen hallinta", "Yksityisyyden suoja"] }
      ]
    },
    process: {
      title: "Valmisteluprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi SOC 2 sertifiointiin.",
      steps: [
        { step: "1", title: "Alustava arviointi", description: "Arvioidaan nykyinen tietoturvataso SOC 2 vaatimusten suhteen" },
        { step: "2", title: "Gap Analysis", description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot" },
        { step: "3", title: "Toteutus", description: "Toteutetaan tarvittavat tietoturvatoimenpiteet" },
        { step: "4", title: "Sisäinen auditointi", description: "Suoritetaan sisäinen auditointi ja korjataan puutteet" },
        { step: "5", title: "Ulkoinen auditointi", description: "Läpäistään ulkoinen SOC 2 auditointi" }
      ]
    },
    benefits: {
      title: "SOC 2 Edut",
      subtitle: "Saavuta konkreettisia hyötyjä SOC 2 sertifioinnin avulla.",
      items: [
        "Vahvista asiakkaiden luottamusta",
        "Erota kilpailijoista",
        "Täytä sääntelyvaatimukset",
        "Paranna tietoturvaa",
        "Nopeuta myyntiprosessia"
      ]
    },
    cta: {
      title: "Valmiit aloittamaan SOC 2 matkanne?",
      subtitle: "Ota yhteyttä meihin ja aloitetaan SOC 2 valmisteluprosessi.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Trust Services Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.trustServices.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.trustServices.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.trustServices.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {item.description}
          </p>
          
          <div class="mt-auto">
            <ul class="space-y-1.5">
              {item.criteria.map((criterion) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {criterion}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.benefits.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6">
      {currentContent.benefits.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-6 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    flex items-center justify-center">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <span class="text-slate-700 text-sm font-medium">{item}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>