---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Risk Assessments | Technical & Organizational Security Risk Analysis",
  description: "Perform balanced technical and organizational risk assessments with clear, prioritized outcomes. Comprehensive risk assessments across all organizational areas.",
  keywords: "risk assessment, security risk analysis, risk management, technical risk assessment, organizational risk assessment",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Risk Assessments",
      subtitle: "Technical & Organizational Security Risk Analysis",
      description: "Perform balanced technical and organizational risk assessments with clear, prioritized outcomes. A clear view of your organization's risks and a prioritized action plan to address them. Assessments based on industry best practices with practical outcomes.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    assessmentTypes: {
      title: "Assessment Types",
      subtitle: "Comprehensive risk assessments across all organizational areas.",
      items: [
        { title: "Technical Risk Assessments", description: "Security risks in systems, networks and applications", icon: "computer" },
        { title: "Organizational Assessments", description: "Risk assessments of processes, personnel and operations", icon: "users" },
        { title: "Vendor Assessments", description: "Third-party services and vendor assessments", icon: "building" },
        { title: "Security Audits", description: "Comprehensive information security compliance assessments", icon: "shield" }
      ]
    },
    methodologies: {
      title: "Used Methodologies",
      subtitle: "We utilize industry-leading and internationally recognized risk assessment methodologies.",
      items: [
        { title: "ISO 27005", description: "International standard for information security risk management", icon: "target" },
        { title: "NIST Framework", description: "NIST Cybersecurity Framework-based assessment", icon: "shield-check" },
        { title: "FAIR Model", description: "Factor Analysis of Information Risk methodology", icon: "book-open" },
        { title: "OCTAVE", description: "Operationally Critical Threat, Asset, and Vulnerability Evaluation", icon: "database" }
      ]
    },
    assessmentScope: {
      title: "Assessment Scope",
      subtitle: "Three-dimensional approach to comprehensive risk assessment.",
      items: [
        { title: "Technical Assessment", items: ["Vulnerability scans", "Penetration testing", "Configuration reviews", "Network security"] },
        { title: "Process Assessment", items: ["Policy review", "Process documentation", "Control testing", "Compliance assessment"] },
        { title: "Personnel Assessment", items: ["Training needs assessment", "Awareness testing", "Access rights review", "Social engineering"] }
      ]
    },
    deliverables: {
      title: "Deliverables",
      subtitle: "You receive practical and actionable results that guide your security investments.",
      items: [
        { title: "Risk Assessment Report", description: "Comprehensive report of identified risks and recommendations", icon: "file-text" },
        { title: "Risk Prioritization", description: "Risks prioritized by impact and likelihood", icon: "trending-up" },
        { title: "Remediation Plan", description: "Detailed plan for risk treatment", icon: "tool" },
        { title: "Timeline and Tracking", description: "Implementation timeline and progress tracking model", icon: "clock" }
      ]
    },
    process: {
      title: "Assessment Process",
      subtitle: "Systematic and documented approach to effective risk assessment.",
      steps: [
        { step: "01", title: "Scope Definition", description: "Assessment target and boundary definition" },
        { step: "02", title: "Data Collection", description: "Systems, processes and documentation mapping" },
        { step: "03", title: "Risk Identification", description: "Threat, vulnerability and risk identification" },
        { step: "04", title: "Risk Analysis", description: "Risk probability and impact assessment" },
        { step: "05", title: "Reporting", description: "Results reporting and recommendations" }
      ]
    },
    cta: {
      title: "Need a risk assessment?",
      subtitle: "Let's discuss your assessment needs and plan an appropriate approach.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "Riskiarvioinnit",
      subtitle: "Tekniset & organisatoriset tietoturvariskianalyysit",
      description: "Suorita tasapainoisia teknisiä ja organisatorisia riskiarviointeja selkeillä, priorisoitavilla tuloksilla. Selkeän kuvan organisaatiosi riskeistä ja priorisoidun toimintasuunnitelman niiden käsittelyyn. Arvioinnit perustuvat alan parhaimpiin menetelmiin ja antavat käytännöllisiä tuloksia.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    assessmentTypes: {
      title: "Arviointityypit",
      subtitle: "Kattavat riskiarvioinnit kaikilla organisaation osa-alueilla.",
      items: [
        { title: "Tekniset riskiarvioinnit", description: "Järjestelmien, verkkojen ja sovellusten turvallisuusriskit", icon: "computer" },
        { title: "Organisatoriset arvioinnit", description: "Prosessien, henkilöstön ja toimintojen riskiarvioinnit", icon: "users" },
        { title: "Toimittaja-arvioinnit", description: "Kolmannen osapuolen palveluiden ja toimittajien arviointi", icon: "building" },
        { title: "Tietoturva-auditit", description: "Kattavat tietoturvallisuuden compliance-arvioinnit", icon: "shield" }
      ]
    },
    methodologies: {
      title: "Käytetyt menetelmät",
      subtitle: "Hyödynnämme alan parhaita ja kansainvälisesti tunnustettuja riskiarviointimenetelmiä.",
      items: [
        { title: "ISO 27005", description: "Kansainvälinen standardi tietoturvariskien hallintaan", icon: "target" },
        { title: "NIST Framework", description: "NIST Cybersecurity Framework -pohjainen arviointi", icon: "shield-check" },
        { title: "FAIR Model", description: "Factor Analysis of Information Risk -menetelmä", icon: "book-open" },
        { title: "OCTAVE", description: "Operationally Critical Threat, Asset, and Vulnerability Evaluation", icon: "database" }
      ]
    },
    assessmentScope: {
      title: "Arvioinnin laajuus",
      subtitle: "Kolmiulotteinen lähestymistapa kattavaan riskiarviointiin.",
      items: [
        { title: "Tekninen arviointi", items: ["Haavoittuvuusskannaukset", "Penetraatiotestaukset", "Konfiguraation tarkastukset", "Verkkoturvallisuus"] },
        { title: "Prosessiarviointi", items: ["Politiikkojen tarkastelu", "Prosessien dokumentointi", "Kontrollien testaus", "Compliance-arviointi"] },
        { title: "Henkilöstöarviointi", items: ["Koulutustarpeiden kartoitus", "Tietoisuuden testaus", "Käyttöoikeuksien tarkastelu", "Sosiaalinen manipulointi"] }
      ]
    },
    deliverables: {
      title: "Toimitukset",
      subtitle: "Saat käytännölliset ja toiminnalliset tulokset, jotka ohjaavat tietoturvainvestointejasi.",
      items: [
        { title: "Riskiarviointiraportti", description: "Kattava raportti tunnistetuista riskeistä ja suosituksista", icon: "file-text" },
        { title: "Riskipriorisointi", description: "Riskit prioriteettijärjestyksessä vaikutuksen ja todennäköisyyden mukaan", icon: "trending-up" },
        { title: "Korjaustoimenpiteet", description: "Yksityiskohtainen suunnitelma riskien käsittelyyn", icon: "tool" },
        { title: "Aikataulu ja seuranta", description: "Toteutusaikataulu ja edistymisen seurantamalli", icon: "clock" }
      ]
    },
    process: {
      title: "Arviointiprosessi",
      subtitle: "Systemaattinen ja dokumentoitu lähestymistapa tehokkaaseen riskiarviointiin.",
      steps: [
        { step: "01", title: "Laajuuden määrittely", description: "Arvioinnin kohteen ja rajauksen määrittely" },
        { step: "02", title: "Tiedonkeruu", description: "Järjestelmien, prosessien ja dokumenttien kartoitus" },
        { step: "03", title: "Riskien tunnistus", description: "Uhkien, haavoittuvuuksien ja riskien tunnistaminen" },
        { step: "04", title: "Riskianalyysi", description: "Riskien todennäköisyyden ja vaikutuksen arviointi" },
        { step: "05", title: "Raportointi", description: "Tulosten raportointi ja suositukset" }
      ]
    },
    cta: {
      title: "Tarvitsetko riskiarvioinnin?",
      subtitle: "Keskustellaan arviointitarpeistanne ja suunnitellaan sopiva lähestymistapa.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-tight">
      <div>{currentContent.hero.title}</div>
      <div class="mt-2">
        <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">{currentContent.hero.subtitle}</span>
      </div>
    </h1>
    
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Assessment Types Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.assessmentTypes.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.assessmentTypes.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.assessmentTypes.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Methodologies Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.methodologies.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.methodologies.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.methodologies.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-5 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
                <Icon name={item.icon} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-blue-700 transition-colors duration-300">
                {item.title}
              </h3>
              <p class="text-slate-500 text-xs leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Assessment Scope Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.assessmentScope.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.assessmentScope.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.assessmentScope.items.map((scope, index) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-10 h-10 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-lg flex items-center justify-center text-white font-bold mb-4">
            {index + 1}
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors duration-300">
            {scope.title}
          </h3>
          
          <ul class="space-y-2">
            {scope.items.map((item) => (
              <li class="flex items-start text-sm text-slate-600">
                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.deliverables.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.deliverables.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.deliverables.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-6 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="flex justify-center mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-base font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Assessment Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-1 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>