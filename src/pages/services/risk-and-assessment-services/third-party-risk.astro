---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Third-Party Risk Management | TPRM Lifecycle & Vendor Risk",
  description: "Implement a complete TPRM lifecycle: onboarding, due diligence, contractual controls, and continuous monitoring. Comprehensive vendor risk management system.",
  keywords: "third-party risk, TPRM, vendor risk management, supplier risk, due diligence, vendor onboarding",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Third-Party Risk",
      subtitle: "Complete TPRM Lifecycle & Vendor Risk Management",
      description: "Implement a complete TPRM lifecycle: onboarding, due diligence, contractual controls, and continuous monitoring. A comprehensive TPRM system that manages vendor risks throughout the entire lifecycle - from onboarding to continuous monitoring and potential termination.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    components: {
      title: "TPRM Components",
      subtitle: "Comprehensive approach to third-party risk management.",
      items: [
        { title: "Vendor Onboarding", description: "Structured process for evaluating and approving new vendors", icon: "user-plus" },
        { title: "Due Diligence", description: "Thorough background research and risk assessment", icon: "search" },
        { title: "Contractual Controls", description: "Security requirements and clauses in contracts", icon: "file-text" },
        { title: "Continuous Monitoring", description: "Regular assessment of vendor risk profiles", icon: "activity" }
      ]
    },
    riskCategories: {
      title: "Risk Categories",
      subtitle: "Key risk areas in third-party services.",
      items: [
        { title: "Cybersecurity Risks", description: "Vendor cybersecurity risks and vulnerabilities", icon: "shield" },
        { title: "Data Processing", description: "Personal data and confidential information processing", icon: "database" },
        { title: "Regulatory Risks", description: "Compliance requirements and legal adherence", icon: "globe" },
        { title: "Operational Risks", description: "Service availability and business continuity", icon: "trending-down" }
      ]
    },
    lifecycle: {
      title: "TPRM Lifecycle",
      subtitle: "Structured process for managing vendor risks throughout the entire partnership.",
      steps: [
        { title: "Identification & Classification", items: ["Vendor inventory", "Criticality classification", "Risk level definition", "Service category mapping"] },
        { title: "Assessment & Approval", items: ["Due diligence process", "Security assessment", "Reference checks", "Approval process"] },
        { title: "Contract Management", items: ["Security clauses", "SLA requirements", "Audit rights", "Termination conditions"] },
        { title: "Ongoing Management", items: ["Regular assessments", "KRI monitoring", "Incident management", "Performance monitoring"] }
      ]
    },
    criteria: {
      title: "Assessment Criteria",
      subtitle: "Key factors in vendor risk assessment.",
      items: [
        { title: "Security Level", description: "ISO 27001, SOC 2, and other certifications", icon: "shield-check" },
        { title: "Geographic Location", description: "Data location and jurisdictional risks", icon: "map" },
        { title: "Organizational Maturity", description: "Governance models and process maturity", icon: "users" },
        { title: "Financial Stability", description: "Creditworthiness and financial situation", icon: "trending-up" }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Step-by-step approach to building a TPRM system.",
      steps: [
        { step: "01", title: "Inventory", description: "Vendor mapping and classification" },
        { step: "02", title: "Risk Assessment", description: "Vendor-specific risk analysis" },
        { step: "03", title: "Due Diligence", description: "Thorough background investigation" },
        { step: "04", title: "Contract Negotiation", description: "Security requirements inclusion" },
        { step: "05", title: "Ongoing Monitoring", description: "Regular risk profile updates" }
      ]
    },
    cta: {
      title: "Ready to build a TPRM system?",
      subtitle: "Let's discuss your vendor risk needs and design an effective management model.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "Kolmannen osapuolen riskit",
      subtitle: "Koko TPRM-elinkaari & toimittajariskien hallinta",
      description: "Toteuta täydellinen TPRM-elinkaari: perehdyttäminen, due diligence, sopimusvalvonta ja jatkuva seuranta. Kattava TPRM-järjestelmä, joka hallitsee toimittajariskejä koko elinkaaren ajan - perehdytyksestä jatkuvaan seurantaan ja mahdolliseen irtisanomiseen.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    components: {
      title: "TPRM-komponentit",
      subtitle: "Kokonaisvaltainen lähestymistapa kolmannen osapuolen riskien hallintaan.",
      items: [
        { title: "Toimittajan perehdytys", description: "Strukturoitu prosessi uusien toimittajien arviointiin ja hyväksyntään", icon: "user-plus" },
        { title: "Due Diligence", description: "Perusteellinen taustatutkimus ja riskiarviointi", icon: "search" },
        { title: "Sopimusvalvonta", description: "Turvallisuusvaatimukset ja -klausuulit sopimuksissa", icon: "file-text" },
        { title: "Jatkuva seuranta", description: "Toimittajien riskiprofiilin säännöllinen arviointi", icon: "activity" }
      ]
    },
    riskCategories: {
      title: "Riskikategoriat",
      subtitle: "Keskeiset riskialueet kolmannen osapuolen palveluissa.",
      items: [
        { title: "Kyberturvariskit", description: "Toimittajien tietoturvariskit ja haavoittuvuudet", icon: "shield" },
        { title: "Tietojen käsittely", description: "Henkilötietojen ja liikesalaisuuksien käsittely", icon: "database" },
        { title: "Sääntelyriskit", description: "Compliance-vaatimukset ja lakien noudattaminen", icon: "globe" },
        { title: "Operatiiviset riskit", description: "Palvelun saatavuus ja liiketoiminnan jatkuvuus", icon: "trending-down" }
      ]
    },
    lifecycle: {
      title: "TPRM-elinkaari",
      subtitle: "Strukturoitu prosessi toimittajariskien hallintaan koko yhteistyön ajan.",
      steps: [
        { title: "Tunnistaminen ja luokittelu", items: ["Toimittajainventaario", "Kriittisyysluokittelu", "Riskitasojen määrittely", "Palvelukategorioiden mapping"] },
        { title: "Arviointi ja hyväksyntä", items: ["Due diligence -prosessi", "Turvallisuusarviointi", "Referenssien tarkistus", "Hyväksyntäprosessi"] },
        { title: "Sopimushallinta", items: ["Turvallisuusklausuulit", "SLA-vaatimukset", "Audit-oikeudet", "Irtisanomisehdot"] },
        { title: "Jatkuva hallinta", items: ["Säännölliset arvioinnit", "KRI-seuranta", "Incident-hallinta", "Suorituskyvyn seuranta"] }
      ]
    },
    criteria: {
      title: "Arviointikriteerit",
      subtitle: "Keskeisimmät tekijät toimittajien riskiarvioinnissa.",
      items: [
        { title: "Tietoturvataso", description: "ISO 27001, SOC 2, ja muut sertifikaatit", icon: "shield-check" },
        { title: "Maantieteellinen sijainti", description: "Tietojen sijainti ja lainsäädäntöriskit", icon: "map" },
        { title: "Organisaation kypsyys", description: "Hallintamallit ja prosessien kypsyys", icon: "users" },
        { title: "Taloudellinen vakaus", description: "Luottokelpoisuus ja taloudellinen tilanne", icon: "trending-up" }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Vaiheittainen lähestymistapa TPRM-järjestelmän rakentamiseen.",
      steps: [
        { step: "01", title: "Inventaario", description: "Toimittajien kartoitus ja luokittelu" },
        { step: "02", title: "Riskiarviointi", description: "Toimittajakohtainen riskianalyysi" },
        { step: "03", title: "Due Diligence", description: "Perusteellinen taustatutkimus" },
        { step: "04", title: "Sopimusneuvottelut", description: "Turvallisuusvaatimusten sisällyttäminen" },
        { step: "05", title: "Jatkuva seuranta", description: "Säännöllinen riskiprofiilin päivitys" }
      ]
    },
    cta: {
      title: "Rakennetaanko TPRM-järjestelmä?",
      subtitle: "Keskustellaan toimittajariskitarpeistanne ja suunnitellaan tehokas hallintamalli.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-tight">
      <div>{currentContent.hero.title}</div>
      <div class="mt-2">
        <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">{currentContent.hero.subtitle}</span>
      </div>
    </h1>
    
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- TPRM Components Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.components.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.components.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.components.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Risk Categories Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.riskCategories.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.riskCategories.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.riskCategories.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-5 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
                <Icon name={item.icon} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-blue-700 transition-colors duration-300">
                {item.title}
              </h3>
              <p class="text-slate-500 text-xs leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TPRM Lifecycle Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.lifecycle.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.lifecycle.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.lifecycle.steps.map((step, index) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-10 h-10 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-lg flex items-center justify-center text-white font-bold mb-4">
            {index + 1}
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <ul class="space-y-2">
            {step.items.map((item) => (
              <li class="flex items-start text-sm text-slate-600">
                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Assessment Criteria Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.criteria.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.criteria.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.criteria.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-6 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="flex justify-center mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-base font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Implementation Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-1 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>