---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const title = 'Standards & Certifications';
const tagline = 'Achieve industry-recognized security standards';
const description = 'Industry-recognized security standards and certifications tailored to your organization\'s needs.';

const items = [
  {
    title: 'ISO 27001 Services',
    href: '/services/standards-and-certifications/iso-27001-services',
    description: 'Gap analysis, ISMS build, internal audit, and end-to-end certification readiness support.'
  },
  {
    title: 'ISO 27701 (PIMS)',
    href: '/services/standards-and-certifications/iso-27701-pims',
    description: 'Extend ISMS to privacy; GDPR-aligned certification readiness.'
  },
  {
    title: 'ISO 27017/27018',
    href: '/services/standards-and-certifications/iso-27017-27018',
    description: 'Cloud security and PII protection controls for CSPs/customers.'
  },
  {
    title: 'ISO 22301',
    href: '/services/standards-and-certifications/iso-22301',
    description: 'Business continuity management, exercises, and certification readiness.'
  },
  {
    title: 'ISO/IEC 20000-1',
    href: '/services/standards-and-certifications/iso-iec-20000-1',
    description: 'IT service management alignment for MSSP processes and SLAs.'
  },
  {
    title: 'SOC 2 Readiness',
    href: '/services/standards-and-certifications/soc-2-readiness',
    description: 'Map controls to Trust Services Criteria, collect evidence, and prepare for Type I/II audits.'
  },
  {
    title: 'CSA STAR (Levels 1–3)',
    href: '/services/standards-and-certifications/csa-star',
    description: 'Self-assessment, ISO 27001 integration, continuous assurance.'
  },
  {
    title: 'Common Criteria',
    href: '/services/standards-and-certifications/common-criteria',
    description: 'Security Targets, Protection Profiles, and evaluation guidance for Common Criteria certification.'
  },
  {
    title: 'SOC 1 / ISAE 3402',
    href: '/services/standards-and-certifications/soc-1-isae-3402',
    description: 'Controls for financial reporting; evidence and auditor support.'
  },
  {
    title: 'ISAE 3000 Assurance',
    href: '/services/standards-and-certifications/isae-3000-assurance',
    description: 'Independent attestation over security/privacy control suites.'
  },
  {
    title: 'TISAX (Automotive)',
    href: '/services/standards-and-certifications/tisax-automotive',
    description: 'Scope definition, assessment support, and label attainment.'
  },
  {
    title: 'BSI C5 (Cloud)',
    href: '/services/standards-and-certifications/bsi-c5-cloud',
    description: 'Control mapping, testing, and attestation reporting.'
  },
  {
    title: 'IEC 62443 (OT/ICS)',
    href: '/services/standards-and-certifications/iec-62443-ot-ics',
    description: 'Maturity assessments and remediation for industrial systems.'
  },
  {
    title: 'Cyber Essentials / Plus',
    href: '/services/standards-and-certifications/cyber-essentials-plus',
    description: 'Rapid hardening, testing, and certification preparation.'
  },
  {
    title: 'CMMC / NIST 800-171',
    href: '/services/standards-and-certifications/cmmc-nist-800-171',
    description: 'Gap analysis, SPRS scoring, POA&M, enclave strategies.'
  },
  {
    title: 'HITRUST CSF',
    href: '/services/standards-and-certifications/hitrust-csf',
    description: 'Readiness, control mapping, and validated assessment support.'
  },
  {
    title: 'DPO/Privacy Office-as-a-Service',
    href: '/services/standards-and-certifications/dpo-privacy-office',
    description: 'Outsourced DPO; DPIAs, RoPAs, privacy governance, and breach liaison.'
  },
  {
    title: 'Virtual DPO (V-DPO)',
    href: '/services/virtual-dpo',
    description: 'Virtual Data Protection Officer services for GDPR compliance and privacy governance.'
  },
  {
    title: 'CISO-as-a-Service',
    href: '/services/standards-and-certifications/ciso-as-a-service',
    description: 'Virtual CISO; strategy, roadmap, metrics, stakeholder reporting.'
  },
  {
    title: 'Virtual CISO (V-CISO)',
    href: '/services/virtual-ciso',
    description: 'Virtual Chief Information Security Officer services for strategic security leadership.'
  },
  {
    title: 'Compliance-as-a-Service',
    href: '/services/standards-and-certifications/compliance-as-a-service',
    description: 'Compliance Manager; ISMS/BCMS operation, evidence, audits, attestations.'
  },
  {
    title: 'GRC Platform Managed Service',
    href: '/services/standards-and-certifications/grc-platform-managed-service',
    description: 'GRC Platform Admin; workflows, integrations, reporting, user support.'
  },
  {
    title: 'ISO 27001 Implementation & Auditing',
    href: '/services/standards-and-certifications/iso-27001-implementation-auditing',
    description: 'ISMS Manager/Internal Auditor; scope and risk, SoA, control implementation, evidence, internal audits, certification support.'
  },
  {
    title: 'Anti-Fraud Services',
    href: '/services/standards-and-certifications/anti-fraud-services',
    description: 'Head of Fraud/Risk; BEC/invoice controls, detection, response.'
  }
];

// Group items by category for better organization
const certifiedStandards = items.filter(item => 
  item.title.includes('ISO') || 
  item.title.includes('SOC') || 
  item.title.includes('CSA') || 
  item.title.includes('Common Criteria') ||
  item.title.includes('TISAX') ||
  item.title.includes('BSI') ||
  item.title.includes('IEC') ||
  item.title.includes('Cyber Essentials') ||
  item.title.includes('CMMC') ||
  item.title.includes('HITRUST')
);

const serviceOfferings = items.filter(item =>
  item.title.includes('DPO') ||
  item.title.includes('Virtual DPO') ||
  item.title.includes('CISO') ||
  item.title.includes('Virtual CISO') ||
  item.title.includes('Compliance-as-a-Service') ||
  item.title.includes('GRC') ||
  item.title.includes('Implementation') ||
  item.title.includes('Anti-Fraud')
);
---

<Layout 
  title={title} 
  description={description}
  seoConfig={{
    title: `Cyber Security Finland | ${title}`,
    description: tagline,
    type: 'website'
  }}
>

<!-- Hero Section - Matches homepage -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 flex items-center relative overflow-hidden">
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-16 md:py-20">
    
    <div class="text-center max-w-4xl mx-auto">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight leading-tight mb-6">
        <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">
          {title}
        </span>
      </h1>
      <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
        {tagline}
      </p>
    </div>
    
  </div>
</section>

<!-- Certified Standards Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        Certified Standards
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        Industry-recognized certification frameworks and compliance standards
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {certifiedStandards.map((item) => (
        <a 
          href={item.href} 
          class="group bg-slate-50/50 rounded-xl border border-slate-100 p-6
                 hover:border-blue-300 hover:bg-slate-50 
                 hover:shadow-xl hover:-translate-y-2
                 transition-all duration-300
                 block"
        >
          <div class="flex justify-end mb-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name="shield-check" class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed">
            {item.description}
          </p>
          
          <div class="mt-4 pt-3 border-t border-slate-100">
            <span class="inline-flex items-center text-[#1E40AF] group-hover:text-[#3B82F6] font-medium text-sm gap-1 transition-all duration-300">
              Learn more
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Service Offerings Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        Managed Services
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        Strategic security and compliance service offerings
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {serviceOfferings.map((item) => (
        <a 
          href={item.href} 
          class="group bg-slate-50/50 rounded-xl border border-slate-100 p-6
                 hover:border-blue-300 hover:bg-slate-50 
                 hover:shadow-xl hover:-translate-y-2
                 transition-all duration-300
                 block"
        >
          <div class="flex justify-end mb-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name="star" class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed">
            {item.description}
          </p>
          
          <div class="mt-4 pt-3 border-t border-slate-100">
            <span class="inline-flex items-center text-[#1E40AF] group-hover:text-[#3B82F6] font-medium text-sm gap-1 transition-all duration-300">
              Learn more
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section - Matches homepage -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        Ready to Achieve <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] bg-clip-text text-transparent">Certification</span>?
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        Let's discuss which standards and certifications align with your business goals.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          Request Consultation
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href="/services" class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          View All Services
        </a>
      </div>

    </div>
  </div>
</section>

<!-- Simplified fade-in animation -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('section');
    sections.forEach((section, index) => {
      section.style.opacity = '0';
      section.style.transform = 'translateY(20px)';
      section.style.transition = 'all 0.6s ease-out';
      
      setTimeout(() => {
        section.style.opacity = '1';
        section.style.transform = 'translateY(0)';
      }, index * 100);
    });
  });
</script>

</Layout>