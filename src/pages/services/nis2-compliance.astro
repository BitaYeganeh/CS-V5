---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "NIS2 Compliance | EU Cybersecurity Directive Services",
  description: "Professional NIS2 compliance services. We help organizations meet EU Digital Operational Resilience Act requirements.",
  keywords: "NIS2, cybersecurity directive, critical infrastructure, compliance, risk management, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "NIS2 Compliance",
      subtitle: "EU Cybersecurity Directive",
      description: "Professional NIS2 compliance services. We help organizations meet EU Digital Operational Resilience Act requirements. Meet NIS2 requirements and strengthen your organization's cybersecurity resilience. We help critical infrastructure organizations achieve EU regulatory requirements.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "NIS2 Readiness Check", href: "/contact?assessment=true" }
    },
    requirements: {
      title: "NIS2 Requirements",
      subtitle: "NIS2 sets comprehensive requirements for cybersecurity and risk management.",
      items: [
        { title: "Risk Management", description: "Comprehensive cybersecurity risk management system", icon: "chart", requirements: ["Risk identification and assessment", "Risk management strategies", "Continuous monitoring"] },
        { title: "Security Monitoring", description: "24/7 security monitoring and threat detection", icon: "eye", requirements: ["SIEM systems", "Threat detection", "Incident response"] },
        { title: "Security Training", description: "Developing staff cybersecurity expertise", icon: "user", requirements: ["Regular training", "Security awareness", "Testing and simulation"] },
        { title: "Vendor Management", description: "Third-party risk management", icon: "network", requirements: ["Vendor assessment", "Contract management", "Continuous monitoring"] }
      ]
    },
    sectors: {
      title: "Affected Sectors",
      subtitle: "NIS2 applies to organizations in critical infrastructure sectors.",
      items: ["Financial Services", "Energy", "Transport", "Healthcare", "Water and Wastewater", "Digital Infrastructure"]
    },
    process: {
      title: "Compliance Process",
      subtitle: "Clear and structured process for NIS2 compliance.",
      steps: [
        { step: "1", title: "NIS2 Assessment", description: "Assess current security posture against NIS2 requirements" },
        { step: "2", title: "Gap Analysis", description: "Identify gaps and plan remediation measures" },
        { step: "3", title: "Planning", description: "Plan NIS2 compliance program" },
        { step: "4", title: "Implementation", description: "Implement required security measures" },
        { step: "5", title: "Monitoring", description: "Continuous compliance monitoring and reporting" }
      ]
    },
    benefits: {
      title: "NIS2 Compliance Benefits",
      subtitle: "Achieve concrete benefits with NIS2 compliance.",
      items: [
        "Meet EU regulatory requirements",
        "Strengthen cybersecurity resilience",
        "Reduce regulatory risks",
        "Improve customer trust",
        "Competitive advantage in markets"
      ]
    },
    cta: {
      title: "Ready to start your NIS2 compliance?",
      subtitle: "Contact us and let's start your NIS2 compliance process.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "NIS2 Readiness Check", href: "/contact?assessment=true" }
    }
  },
  fi: {
    hero: {
      title: "NIS2 Yhteensopivuus",
      subtitle: "EU:n Kyberturvallisuusdirektiivi",
      description: "Ammattimaiset NIS2 yhteensopivuuspalvelut. Autamme organisaatioita täyttämään EU:n digitaalisen operatiivisen resilienssin lain vaatimukset. Täytä NIS2 vaatimukset ja vahvista organisaatiosi kyberturvan kestävyys. Autamme kriittisten infrastruktuurien organisaatioita saavuttamaan EU:n sääntelyvaatimukset.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "NIS2 Valmistelutarkistus", href: "/contact?assessment=true" }
    },
    requirements: {
      title: "NIS2 Vaatimukset",
      subtitle: "NIS2 asettaa kattavat vaatimukset kyberturvalle ja riskienhallinalle.",
      items: [
        { title: "Riskienhallinta", description: "Kattava kyberturvariskien hallintajärjestelmä", icon: "chart", requirements: ["Riskien tunnistus ja arviointi", "Riskien hallintastrategiat", "Jatkuva seuranta"] },
        { title: "Tietoturvavalvonta", description: "24/7 tietoturvavalvonta ja uhkien tunnistus", icon: "eye", requirements: ["SIEM järjestelmät", "Uhkien tunnistus", "Vikatilanteiden vastaus"] },
        { title: "Tietoturvakoulutus", description: "Henkilöstön tietoturvaosaamisen kehittäminen", icon: "user", requirements: ["Säännöllinen koulutus", "Tietoturvatietoisuus", "Testaus ja simulointi"] },
        { title: "Toimittajien hallinta", description: "Kolmannen osapuolen riskien hallinta", icon: "network", requirements: ["Toimittajien arviointi", "Sopimusten hallinta", "Jatkuva seuranta"] }
      ]
    },
    sectors: {
      title: "Koskevat Sektorit",
      subtitle: "NIS2 koskee organisaatioita kriittisissä infrastruktuurisektoreissa.",
      items: ["Rahoituspalvelut", "Energia", "Liikenne", "Terveydenhuolto", "Vesi ja jätevesi", "Digitaalinen infrastruktuuri"]
    },
    process: {
      title: "Yhteensopivuusprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi NIS2 yhteensopivuuteen.",
      steps: [
        { step: "1", title: "NIS2 Arviointi", description: "Arvioidaan nykyinen tietoturvataso NIS2 vaatimusten suhteen" },
        { step: "2", title: "Gap Analysis", description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot" },
        { step: "3", title: "Suunnittelu", description: "Suunnitellaan NIS2 yhteensopivuusohjelma" },
        { step: "4", title: "Toteutus", description: "Toteutetaan tarvittavat tietoturvatoimenpiteet" },
        { step: "5", title: "Valvonta", description: "Jatkuva yhteensopivuuden valvonta ja raportointi" }
      ]
    },
    benefits: {
      title: "NIS2 Yhteensopivuuden Edut",
      subtitle: "Saavuta konkreettisia hyötyjä NIS2 yhteensopivuuden avulla.",
      items: [
        "Täytä EU sääntelyvaatimukset",
        "Vahvista kyberturvan kestävyyttä",
        "Vähennä sääntelyriskejä",
        "Paranna asiakkaiden luottamusta",
        "Kilpailuetu markkinoilla"
      ]
    },
    cta: {
      title: "Valmiit aloittamaan NIS2 yhteensopivuuden?",
      subtitle: "Ota yhteyttä meihin ja aloitetaan NIS2 yhteensopivuusprosessi.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "NIS2 Valmistelutarkistus", href: "/contact?assessment=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Requirements Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.requirements.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.requirements.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {currentContent.requirements.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {item.description}
          </p>
          
          <div class="mt-auto">
            <ul class="space-y-1.5">
              {item.requirements.map((req) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {req}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Sectors Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.sectors.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.sectors.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {currentContent.sectors.items.map((sector) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    flex items-center justify-center gap-2">
          <Icon name="building" class="w-4 h-4 text-blue-500" />
          <span class="text-slate-700 text-sm font-medium">{sector}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.benefits.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6">
      {currentContent.benefits.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-6 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    flex items-center justify-center">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <span class="text-slate-700 text-sm font-medium">{item}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>