---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Policy Governance Services | Security Policy Management & Compliance",
  description: "Create a clear, owned, and maintained security policy architecture mapped to compliance requirements. Expert policy framework development for ISO 27001, GDPR, SOC 2, and more.",
  keywords: "policy governance, security policies, policy management, compliance mapping, ISO 27001 policies, GDPR policies, policy framework",
  type: "service" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Policy Governance Services",
    "provider": {
      "@type": "Organization",
      "name": "Cyber Security Finland"
    },
    "description": "Create a clear, owned, and maintained security policy architecture mapped to compliance requirements.",
    "serviceType": "Policy Management"
  }
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Policy Governance",
      subtitle: "Security Policy Management & Compliance",
      description: "Create a clear, owned, and maintained security policy architecture mapped to compliance requirements. A comprehensive policy framework where every policy is clearly owned, regularly updated, and linked to compliance requirements.",
      primaryCTA: { text: "Start Building", href: "/contact" },
      secondaryCTA: { text: "Download Policy Template", href: "/resources/guides/policy-template" }
    },
    
    framework: {
      title: "Policy Framework Foundations",
      subtitle: "We build a policy management system that supports your organizational objectives and meets regulatory requirements.",
      items: [
        { title: "Policy Architecture", description: "Hierarchical policy structure from standards to procedures", icon: "document" },
        { title: "Ownership Model", description: "Clear roles and responsibilities in policy management", icon: "users" },
        { title: "Lifecycle Management", description: "Policy creation, update and retirement processes", icon: "refresh-cw" },
        { title: "Compliance Mapping", description: "Policy mapping to regulations and standards", icon: "shield-check" }
      ]
    },
    
    categories: {
      title: "Policy Categories",
      subtitle: "We organize policies into clear categories that cover all organizational areas.",
      types: [
        {
          title: "Organizational Policies",
          description: "High-level strategic policies and principles",
          icon: "building",
          examples: ["Information Security Policy", "Risk Management Policy", "Personnel Security"]
        },
        {
          title: "Operational Policies",
          description: "Policies guiding practical operations",
          icon: "cog",
          examples: ["Access Control Policy", "Backup Policy", "Change Management"]
        },
        {
          title: "Technical Policies",
          description: "Policies defining technical requirements for IT systems",
          icon: "tool",
          examples: ["Encryption Policy", "Network Security Policy", "Cloud Policy"]
        }
      ]
    },
    
    process: {
      title: "Governance Process",
      subtitle: "Structured approach to managing the entire policy lifecycle.",
      steps: [
        { title: "Planning", items: ["Policy architecture planning", "Ownership definition", "Scheduling and resourcing", "Stakeholder analysis"] },
        { title: "Development", items: ["Policy drafting", "Stakeholder consultation", "Legal expert consultation", "Internal review"] },
        { title: "Approval", items: ["Management review", "Formal approval", "Publication process", "Communication"] },
        { title: "Maintenance", items: ["Regular reviews", "Update needs assessment", "Version control", "Archiving"] }
      ]
    },
    
    mapping: {
      title: "Compliance Mapping",
      subtitle: "We link policies directly to regulations and standards for easy compliance tracking.",
      items: [
        { title: "ISO 27001", description: "Annex A controls mapping to policies", icon: "shield" },
        { title: "GDPR", description: "Meeting data protection article requirements", icon: "globe" },
        { title: "SOC 2", description: "Meeting Trust Services Criteria requirements", icon: "building-2" },
        { title: "NIS2/DORA", description: "Meeting EU regulation requirements", icon: "flag" }
      ]
    },
    
    implementation: {
      title: "Implementation Process",
      subtitle: "Step-by-step approach to building a policy management system.",
      steps: [
        { step: "01", title: "Architecture Design", description: "Policy hierarchy and category definition" },
        { step: "02", title: "Ownership Assignment", description: "Responsible persons and role assignment" },
        { step: "03", title: "Content Development", description: "Policy drafting and review" },
        { step: "04", title: "Approval Process", description: "Formal approval and publication" },
        { step: "05", title: "Maintenance Model", description: "Ongoing maintenance process implementation" }
      ]
    },
    
    cta: {
      title: "Ready to build a policy framework?",
      subtitle: "Let's discuss your policy needs and design a sustainable governance model.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  
  fi: {
    hero: {
      title: "Politiikkahallinta",
      subtitle: "Tietoturvapolitiikkojen hallinta & vaatimustenmukaisuus",
      description: "Luo selkeä, omistettu ja ylläpidetty tietoturvapolitiikka-arkkitehtuuri, joka on kartoitettu compliance-vaatimuksiin. Kattava politiikkakehikko, jossa jokainen politiikka on selkeästi omistettu, säännöllisesti päivitetty ja linkitetty compliance-vaatimuksiin.",
      primaryCTA: { text: "Aloita rakentaminen", href: "/contact" },
      secondaryCTA: { text: "Lataa politiikkapohja", href: "/resources/guides/policy-template" }
    },
    
    framework: {
      title: "Politiikkakehikon perusteet",
      subtitle: "Rakennamme politiikkahallintajärjestelmän, joka tukee organisaatiosi tavoitteita ja täyttää säädösvaatimukset.",
      items: [
        { title: "Politiikka-arkkitehtuuri", description: "Hierarkkinen politiikkarakenne standardeista prosesseihin", icon: "document" },
        { title: "Omistajuusmalli", description: "Selkeät roolit ja vastuut politiikkojen hallinnassa", icon: "users" },
        { title: "Elinkaaren hallinta", description: "Politiikkojen luonti, päivitys ja poistamisprosessit", icon: "refresh-cw" },
        { title: "Compliance-kartoitus", description: "Politiikkojen linkitys säädöksiin ja standardeihin", icon: "shield-check" }
      ]
    },
    
    categories: {
      title: "Politiikkakategoriat",
      subtitle: "Järjestämme politiikat selkeisiin kategorioihin, jotka kattavat kaikki organisaation toiminta-alueet.",
      types: [
        {
          title: "Organisaatiotason politiikat",
          description: "Ylätason strategiset politiikat ja periaatteet",
          icon: "building",
          examples: ["Tietoturvapolitiikka", "Riskienhallintapolitiikka", "Henkilöstöturvallisuus"]
        },
        {
          title: "Operatiiviset politiikat",
          description: "Käytännön toimintaa ohjaavat politiikat",
          icon: "cog",
          examples: ["Käyttöoikeuspolitiikka", "Varmuuskopiointipolitiikka", "Muutoshallinta"]
        },
        {
          title: "Tekniset politiikat",
          description: "IT-järjestelmien teknisiä vaatimuksia määrittävät politiikat",
          icon: "tool",
          examples: ["Salauspolitiikka", "Verkkoturvapolitiikka", "Pilvipolitiikka"]
        }
      ]
    },
    
    process: {
      title: "Hallintaprosessi",
      subtitle: "Strukturoitu lähestymistapa politiikkojen koko elinkaaren hallintaan.",
      steps: [
        { title: "Suunnittelu", items: ["Politiikka-arkkitehtuurin suunnittelu", "Omistajuuksien määrittely", "Aikataulutus ja resursointi", "Stakeholder-analyysi"] },
        { title: "Kehittäminen", items: ["Politiikkojen laatiminen", "Stakeholder-kuuleminen", "Lakiasiantuntijoiden konsultointi", "Sisäinen arviointi"] },
        { title: "Hyväksyntä", items: ["Johdon katselmointi", "Muodollinen hyväksyntä", "Julkaisuprosessi", "Kommunikaatio"] },
        { title: "Ylläpito", items: ["Säännölliset katselmukset", "Päivitystarpeiden arviointi", "Versioiden hallinta", "Arkistointi"] }
      ]
    },
    
    mapping: {
      title: "Compliance-kartoitus",
      subtitle: "Linkitämme politiikat suoraan säädöksiin ja standardeihin, jotta compliance on helppoa seurata.",
      items: [
        { title: "ISO 27001", description: "Liite A kontrollien kartoitus politiikkoihin", icon: "shield" },
        { title: "GDPR", description: "Tietosuoja-artiklojen vaatimusten täyttäminen", icon: "globe" },
        { title: "SOC 2", description: "Trust Services Criteria -vaatimusten täyttäminen", icon: "building-2" },
        { title: "NIS2/DORA", description: "EU-säädösten vaatimusten täyttäminen", icon: "flag" }
      ]
    },
    
    implementation: {
      title: "Toteutusprosessi",
      subtitle: "Vaiheittainen lähestymistapa politiikkahallintajärjestelmän rakentamiseen.",
      steps: [
        { step: "01", title: "Arkkitehtuurin suunnittelu", description: "Politiikkahierarkian ja -kategorioiden määrittely" },
        { step: "02", title: "Omistajuuksien määrittely", description: "Vastuuhenkilöiden ja roolien määrittäminen" },
        { step: "03", title: "Sisällön kehittäminen", description: "Politiikkojen laatiminen ja tarkastelu" },
        { step: "04", title: "Hyväksyntäprosessi", description: "Muodollinen hyväksyntä ja julkaisu" },
        { step: "05", title: "Ylläpitomalli", description: "Jatkuvan ylläpidon prosessien käyttöönotto" }
      ]
    },
    
    cta: {
      title: "Rakennetaanko politiikkakehikko?",
      subtitle: "Keskustellaan politiikkatarpeistanne ja suunnitellaan kestävä hallintamalli.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered without image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28 relative overflow-hidden">
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-tight">
      <div>{currentContent.hero.title}</div>
      <div class="mt-2">
        <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">{currentContent.hero.subtitle}</span>
      </div>
    </h1>
    
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Trust Bar -->
<section class="py-8 bg-gradient-to-b from-blue-50/30 to-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid md:grid-cols-2 gap-8 items-center">
      
      <!-- Left Side: Text -->
      <div class="text-center md:text-left">
        <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight leading-tight text-slate-800">
          Policy governance<br/>for 
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">compliance success</span>.
        </p>
        <p class="text-sm md:text-base text-blue-600 font-medium mt-4">
          Clear ownership and lifecycle management
        </p>
      </div>
      
      <!-- Right Side: Key stats -->
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">4</div>
          <div class="text-sm text-slate-500">Framework Levels</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">100%</div>
          <div class="text-sm text-slate-500">Compliance Mapping</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">5</div>
          <div class="text-sm text-slate-500">Implementation Phases</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">24/7</div>
          <div class="text-sm text-slate-500">Policy Access</div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<!-- Policy Framework Foundations Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.framework.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.framework.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.framework.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Policy Categories Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.categories.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.categories.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.categories.types.map((type) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
                <Icon name={type.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <div class="flex-1">
              <h3 class="text-md font-semibold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
                {type.title}
              </h3>
              <p class="text-slate-500 text-sm leading-relaxed mb-3">
                {type.description}
              </p>
              <ul class="space-y-1">
                {type.examples.map((example) => (
                  <li class="flex items-center text-xs text-slate-500">
                    <svg class="w-3 h-3 text-green-500 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {example}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Governance Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {currentContent.process.steps.map((step, index) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="p-6">
            <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mb-4">
              {index + 1}
            </div>
            
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300">
              {step.title}
            </h3>
            
            <ul class="space-y-1.5">
              {step.items.map((item) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Compliance Mapping Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.mapping.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.mapping.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.mapping.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="flex justify-center mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Implementation Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.implementation.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.implementation.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-5 gap-6">
      {currentContent.implementation.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-4">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-gradient-to-br from-blue-50 to-white rounded-2xl border border-blue-200 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

