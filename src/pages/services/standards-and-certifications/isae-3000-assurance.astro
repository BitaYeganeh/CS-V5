---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "ISAE 3000 Assurance | Independent Attestation Services",
  description: "Independent attestation over security/privacy control suites. Comprehensive support for ISAE 3000 assurance engagements including control design, evidence management, and auditor coordination.",
  keywords: "ISAE 3000, assurance services, independent attestation, control suites, security controls, privacy controls, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "ISAE 3000 Assurance",
      subtitle: "Independent Attestation Services",
      description: "Independent attestation over security/privacy control suites. Get expert guidance and accelerate your compliance timeline with comprehensive support for ISAE 3000 assurance engagements.",
      primaryCTA: { text: "Get ISAE 3000 Assurance Support", href: "/contact" },
      secondaryCTA: { text: "Learn More", href: "#services" }
    },
    services: {
      title: "Our ISAE 3000 Services",
      subtitle: "Comprehensive support for every stage of your ISAE 3000 attestation journey",
      items: [
        {
          title: "Control Suite Design",
          description: "Design and document control suites for ISAE 3000 assurance engagements.",
          icon: "shield",
          features: ["Control framework mapping", "Policy and procedure development", "Documentation and training", "Evidence preparation"]
        },
        {
          title: "Evidence Management",
          description: "Prepare and manage evidence for independent attestation.",
          icon: "clipboard-check",
          features: ["Evidence collection guidance", "Documentation review", "Remediation support", "Audit readiness assessment"]
        },
        {
          title: "Auditor Coordination",
          description: "Coordinate with independent auditors for successful attestation.",
          icon: "certificate",
          features: ["Audit liaison", "Remediation planning", "Certification preparation", "Stakeholder communication"]
        }
      ]
    },
    benefits: {
      title: "Why Choose Our ISAE 3000 Services?",
      items: [
        "Independent attestation for security/privacy controls",
        "Comprehensive documentation",
        "Accelerated audit readiness",
        "Expert guidance throughout the process",
        "Ongoing compliance support"
      ]
    },
    cta: {
      title: "Ready for ISAE 3000 Attestation?",
      subtitle: "Get expert guidance and accelerate your compliance timeline",
      primaryCTA: { text: "Contact Our Experts", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "ISAE 3000 -varmennus",
      subtitle: "Riippumattomat varmennuspalvelut",
      description: "Riippumaton varmennus turvallisuus-/tietosuojakontrollikokonaisuuksista. Hanki asiantuntijaohjausta ja nopeuta vaatimustenmukaisuusaikatauluasi kattavalla tuella ISAE 3000 -varmennusprosesseihin.",
      primaryCTA: { text: "Pyydä ISAE 3000 -varmennustukea", href: "/contact" },
      secondaryCTA: { text: "Lue lisää", href: "#services" }
    },
    services: {
      title: "ISAE 3000 -palvelumme",
      subtitle: "Kattava tuki jokaiseen ISAE 3000 -varmennusprosessin vaiheeseen",
      items: [
        {
          title: "Kontrollikokonaisuuksien suunnittelu",
          description: "Suunnittele ja dokumentoi kontrollikokonaisuuksia ISAE 3000 -varmennustoimeksiantoja varten.",
          icon: "shield",
          features: ["Kontrollikehyksen kartoitus", "Politiikkojen ja menettelyjen kehittäminen", "Dokumentointi ja koulutus", "Todisteiden valmistelu"]
        },
        {
          title: "Todisteiden hallinta",
          description: "Valmistele ja hallitse todisteita riippumatonta varmennusta varten.",
          icon: "clipboard-check",
          features: ["Todisteiden keruun ohjaus", "Dokumentoinnin tarkistus", "Korjaustoimien tuki", "Auditointivalmiuden arviointi"]
        },
        {
          title: "Auditorien koordinointi",
          description: "Tee yhteistyötä riippumattomien auditorien kanssa onnistuneen varmennuksen saavuttamiseksi.",
          icon: "certificate",
          features: ["Auditointiyhteistyö", "Korjaustoimien suunnittelu", "Sertifiointivalmistelu", "Sidosryhmäviestintä"]
        }
      ]
    },
    benefits: {
      title: "Miksi valita ISAE 3000 -palvelumme?",
      items: [
        "Riippumaton varmennus turvallisuus-/tietosuojakontrolleille",
        "Kattava dokumentointi",
        "Nopeutettu auditointivalmius",
        "Asiantuntijaohjaus koko prosessin ajan",
        "Jatkuva vaatimustenmukaisuustuki"
      ]
    },
    cta: {
      title: "Valmis ISAE 3000 -varmennukseen?",
      subtitle: "Hanki asiantuntijaohjausta ja nopeuta vaatimustenmukaisuusaikatauluasi",
      primaryCTA: { text: "Ota yhteyttä asiantuntijoihimme", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Services Section -->
<section id="services" class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.services.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.services.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.services.items.map((service) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={service.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {service.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {service.description}
          </p>
          
          <div class="mt-auto">
            <ul class="space-y-1.5">
              {service.features.map((feature) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {currentContent.benefits.items.map((benefit) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    flex items-center gap-3">
          <Icon name="check-circle" class="w-5 h-5 text-green-500 flex-shrink-0" />
          <span class="text-slate-700 text-sm">{benefit}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>