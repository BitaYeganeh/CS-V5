---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Cyber Essentials / Plus Certification | UK Government Cyber Security Scheme",
  description: "Rapid hardening, testing, and certification preparation for UK Cyber Essentials and Cyber Essentials Plus schemes. Fast-track certification in 30-60 days.",
  keywords: "Cyber Essentials, Cyber Essentials Plus, UK cybersecurity, certification, rapid hardening, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Cyber Essentials / Plus Certification",
      subtitle: "UK Government Cyber Security Scheme",
      description: "Fast-track UK Cyber Essentials certification with expert rapid hardening, testing, and certification preparation services. Cyber Essentials and Cyber Essentials Plus are UK government-backed cybersecurity schemes that demonstrate your organization has secure defenses against the most common cyber attacks. Our rapid implementation approach gets you certified quickly.",
      primaryCTA: { text: "Get Certified Fast", href: "/contact?service=cyber-essentials" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Overview",
      description: "Cyber Essentials is a UK government-backed certification scheme that helps organizations demonstrate they have implemented basic cybersecurity controls. The scheme covers five key technical controls that protect against the most common cyber attacks.",
      highlight: "Our rapid implementation methodology gets organizations from assessment to certification in just 30-60 days, with minimal business disruption and maximum efficiency."
    },
    certificationTypes: {
      title: "Certification Options",
      subtitle: "Choose the level of certification that meets your requirements",
      items: [
        { type: "Cyber Essentials", description: "Self-assessment questionnaire demonstrating basic controls", timeframe: "30-45 days", testing: "Self-declaration" },
        { type: "Cyber Essentials Plus", description: "Independent technical verification of implemented controls", timeframe: "45-60 days", testing: "External testing" }
      ]
    },
    controls: {
      title: "Five Essential Controls",
      subtitle: "The core security controls covered by Cyber Essentials certification",
      items: [
        "Firewalls and Gateway Protection",
        "Secure Configuration",
        "User Access Control",
        "Malware Protection",
        "Software Security Updates"
      ]
    },
    features: {
      title: "Our Cyber Essentials Services",
      subtitle: "Comprehensive certification services for rapid Cyber Essentials compliance",
      items: [
        { title: "Rapid Hardening & Implementation", description: "Fast-track implementation of Cyber Essentials controls with minimal business disruption", icon: "shield" },
        { title: "Pre-Assessment Testing", description: "Comprehensive testing and validation of controls before formal certification assessment", icon: "clipboard" },
        { title: "Certification Preparation", description: "Complete preparation for both Cyber Essentials and Cyber Essentials Plus assessments", icon: "award" },
        { title: "Gap Analysis & Remediation", description: "Detailed gap analysis with prioritized remediation plans for quick compliance", icon: "wrench" },
        { title: "Documentation & Evidence", description: "Comprehensive documentation and evidence collection for certification requirements", icon: "document" },
        { title: "Ongoing Compliance", description: "Annual renewal support and continuous compliance monitoring", icon: "monitor" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Cyber Essentials readiness assessment",
        "Control implementation and hardening",
        "Pre-assessment testing and validation",
        "Certification application support",
        "Evidence documentation package",
        "Staff training and awareness materials",
        "Annual renewal preparation",
        "Continuous monitoring procedures"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Meet UK government contract requirements",
        "Demonstrate basic cybersecurity competence",
        "Reduce cyber insurance premiums",
        "Competitive advantage in UK markets",
        "Fast-track certification in 30-60 days"
      ]
    },
    cta: {
      title: "Get Cyber Essentials Certified Fast",
      subtitle: "Contact us today to start your rapid certification journey",
      primaryCTA: { text: "Get Started", href: "/contact?service=cyber-essentials" },
      secondaryCTA: { text: "Schedule Assessment", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "Cyber Essentials / Plus -sertifiointi",
      subtitle: "Ison-Britannian hallituksen kyberturvallisuusohjelma",
      description: "Nopea Ison-Britannian Cyber Essentials -sertifiointi asiantuntevalla nopealla kovetuksella, testauksella ja sertifiointivalmistelulla. Cyber Essentials ja Cyber Essentials Plus ovat Ison-Britannian hallituksen tukemia kyberturvallisuusohjelmia, jotka osoittavat, että organisaatiollasi on turvalliset puolustusmekanismit yleisimpiä kyberhyökkäyksiä vastaan. Nopea toteutuslähestymistapamme saa sinut sertifioiduksi nopeasti.",
      primaryCTA: { text: "Sertifioidu nopeasti", href: "/contact?service=cyber-essentials" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Yleiskatsaus",
      description: "Cyber Essentials on Ison-Britannian hallituksen tukema sertifiointiohjelma, joka auttaa organisaatioita osoittamaan toteuttaneensa perustason kyberturvallisuuskontrollit. Ohjelma kattaa viisi keskeistä teknistä kontrollia, jotka suojaavat yleisimmiltä kyberhyökkäyksiltä.",
      highlight: "Nopea toteutusmetodologiamme vie organisaatiot arvioinnista sertifiointiin vain 30-60 päivässä minimaalisilla liiketoimintahäiriöillä ja maksimaalisella tehokkuudella."
    },
    certificationTypes: {
      title: "Sertifiointivaihtoehdot",
      subtitle: "Valitse tarpeitasi vastaava sertifiointitaso",
      items: [
        { type: "Cyber Essentials", description: "Peruskontrollit osoittava oma-arviointikysely", timeframe: "30-45 päivää", testing: "Oma-arviointi" },
        { type: "Cyber Essentials Plus", description: "Toteutettujen kontrollien riippumaton tekninen varmentaminen", timeframe: "45-60 päivää", testing: "Ulkoinen testaus" }
      ]
    },
    controls: {
      title: "Viisi olennaista kontrollia",
      subtitle: "Cyber Essentials -sertifioinnin kattamat keskeiset turvallisuuskontrollit",
      items: [
        "Palomuurit ja yhdyskäytävän suojaus",
        "Turvallinen konfigurointi",
        "Käyttäjien käyttöoikeuksien hallinta",
        "Haittaohjelmasuojaus",
        "Ohjelmistojen tietoturvapäivitykset"
      ]
    },
    features: {
      title: "Cyber Essentials -palvelumme",
      subtitle: "Kattavat sertifiointipalvelut nopeaan Cyber Essentials -vaatimustenmukaisuuteen",
      items: [
        { title: "Nopea kovetus ja toteutus", description: "Cyber Essentials -kontrollien nopea toteutus minimaalisilla liiketoimintahäiriöillä", icon: "shield" },
        { title: "Esisertifiointitestaus", description: "Kontrollien kattava testaus ja validointi ennen muodollista sertifiointiarviointia", icon: "clipboard" },
        { title: "Sertifiointivalmistelu", description: "Täydellinen valmistautuminen sekä Cyber Essentials- että Cyber Essentials Plus -arviointeihin", icon: "award" },
        { title: "Aukkoanalyysi ja korjaus", description: "Yksityiskohtainen aukkoanalyysi priorisoiduilla korjaussuunnitelmilla nopeaa vaatimustenmukaisuutta varten", icon: "wrench" },
        { title: "Dokumentointi ja todisteet", description: "Kattava dokumentointi ja todisteiden keruu sertifiointivaatimuksia varten", icon: "document" },
        { title: "Jatkuva vaatimustenmukaisuus", description: "Vuotuinen uusimistuki ja jatkuva vaatimustenmukaisuuden seuranta", icon: "monitor" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Cyber Essentials -valmiusarviointi",
        "Kontrollien toteutus ja kovetus",
        "Esisertifiointitestaus ja validointi",
        "Sertifiointihakemuksen tuki",
        "Todisteiden dokumentointipaketti",
        "Henkilöstön koulutus- ja tietoisuusmateriaalit",
        "Vuotuinen uusimisvalmistelu",
        "Jatkuvan seurannan menettelyt"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Täytä Ison-Britannian hallituksen sopimusvaatimukset",
        "Osoita perustason kyberturvallisuusosaaminen",
        "Vähennä kybervakuutusmaksuja",
        "Kilpailuetu Ison-Britannian markkinoilla",
        "Nopea sertifiointi 30-60 päivässä"
      ]
    },
    cta: {
      title: "Saa Cyber Essentials -sertifiointi nopeasti",
      subtitle: "Ota yhteyttä jo tänään aloittaaksesi nopean sertifiointimatkasi",
      primaryCTA: { text: "Aloita nyt", href: "/contact?service=cyber-essentials" },
      secondaryCTA: { text: "Varaa arviointi", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Overview Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-slate-50/50 rounded-2xl p-8 border border-slate-100">
      <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-4">{currentContent.overview.title}</h2>
      <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
      <p class="text-slate-600 leading-relaxed font-semibold text-blue-600">{currentContent.overview.highlight}</p>
    </div>
  </div>
</section>

<!-- Certification Types Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.certificationTypes.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.certificationTypes.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 gap-8">
      {currentContent.certificationTypes.items.map((cert) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-lg transition-all duration-300">
          <h3 class="text-xl font-bold text-slate-900 mb-2">{cert.type}</h3>
          <p class="text-slate-500 text-sm mb-4">{cert.description}</p>
          <div class="space-y-2 text-sm border-t border-slate-100 pt-4">
            <div class="flex justify-between">
              <span class="text-slate-500">Timeframe:</span>
              <span class="font-medium text-slate-700">{cert.timeframe}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Testing:</span>
              <span class="font-medium text-slate-700">{cert.testing}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Controls Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.controls.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.controls.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {currentContent.controls.items.map((control) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300">
          <p class="text-sm font-medium text-slate-700">{control}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.features.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.features.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.features.items.map((feature) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={feature.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {feature.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables & Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12">
      
      <!-- Deliverables -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.deliverables.title}</h2>
        <ul class="space-y-3">
          {currentContent.deliverables.items.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Benefits -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.benefits.title}</h2>
        <ul class="space-y-3">
          {currentContent.benefits.items.map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="star" class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" />
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>