---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "DPO/Privacy Office-as-a-Service | Outsourced Data Protection Officer",
  description: "Expert outsourced Data Protection Officer services including DPIAs, RoPAs, privacy governance, and breach management for GDPR compliance.",
  keywords: "DPO as a service, outsourced DPO, data protection officer, privacy office, GDPR compliance, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "DPO/Privacy Office-as-a-Service",
      subtitle: "Outsourced Data Protection Officer",
      description: "Expert outsourced Data Protection Officer services providing comprehensive privacy governance, GDPR compliance, and regulatory liaison. Our qualified DPO-as-a-Service provides organizations with expert privacy leadership without the cost of a full-time executive. We handle all aspects of data protection compliance from DPIAs to breach management.",
      primaryCTA: { text: "Get DPO Support", href: "/contact?service=dpo" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Overview",
      description: "Under GDPR Article 37, many organizations are required to appoint a Data Protection Officer. Our DPO-as-a-Service provides qualified, experienced privacy professionals who can serve as your organization's DPO, ensuring compliance while providing strategic privacy guidance.",
      highlight: "We offer flexible engagement models from virtual DPO services to on-site support, tailored to your organization's specific privacy needs and regulatory requirements."
    },
    engagementTypes: {
      title: "Service Models",
      subtitle: "Flexible DPO services tailored to your organization's needs",
      items: [
        { type: "Virtual DPO", commitment: "Part-time", description: "Remote DPO services with regular check-ins and oversight" },
        { type: "On-site DPO", commitment: "Flexible", description: "Regular on-site presence for complex organizations" },
        { type: "Project-based", commitment: "As needed", description: "Specific privacy projects and assessments" }
      ]
    },
    gdprServices: {
      title: "GDPR Article Compliance",
      subtitle: "Comprehensive coverage of key GDPR requirements",
      items: [
        "Article 30 RoPA Creation",
        "Article 35 DPIA Execution",
        "Article 37 DPO Appointment",
        "Article 33/34 Breach Notification",
        "Article 13/14 Privacy Notices",
        "Article 7 Consent Management"
      ]
    },
    features: {
      title: "Our DPO Services",
      subtitle: "Comprehensive privacy services covering all aspects of data protection compliance",
      items: [
        { title: "Outsourced DPO Services", description: "Qualified Data Protection Officer providing expert privacy oversight and regulatory compliance", icon: "users" },
        { title: "Data Protection Impact Assessments", description: "Comprehensive DPIAs for high-risk processing activities and new projects", icon: "clipboard" },
        { title: "Records of Processing Activities", description: "Creation and maintenance of detailed RoPAs for GDPR Article 30 compliance", icon: "document" },
        { title: "Privacy Governance & Policies", description: "Development of privacy frameworks, policies, and governance structures", icon: "shield" },
        { title: "Breach Management & Response", description: "Incident response, breach assessment, and regulatory notification support", icon: "alert" },
        { title: "Regulatory Liaison", description: "Direct communication with supervisory authorities and regulatory representation", icon: "network" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Qualified DPO appointment and services",
        "Privacy program assessment and roadmap",
        "Data Protection Impact Assessments (DPIAs)",
        "Records of Processing Activities (RoPAs)",
        "Privacy policies and procedures framework",
        "Data breach response procedures",
        "Staff privacy training programs",
        "Regulatory correspondence and liaison"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Meet GDPR DPO appointment requirements",
        "Expert privacy guidance without full-time costs",
        "Reduced regulatory risk and potential fines",
        "Professional breach response capabilities",
        "Enhanced customer and stakeholder trust"
      ]
    },
    cta: {
      title: "Need Expert Privacy Leadership?",
      subtitle: "Contact us today to discuss your DPO and privacy compliance requirements",
      primaryCTA: { text: "Get Started", href: "/contact?service=dpo" },
      secondaryCTA: { text: "Schedule Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "DPO/tietosuojatoimisto palveluna",
      subtitle: "Ulkoistettu tietosuojavastaava",
      description: "Asiantuntevat ulkoistetut tietosuojavastaavapalvelut, jotka tarjoavat kattavaa tietosuojahallintaa, GDPR-vaatimustenmukaisuutta ja sääntely-yhteistyötä. Laadukas DPO-palveluna tarjoaa organisaatioille asiantuntevaa tietosuojajohtamista ilman kokopäiväisen toimitusjohtajan kustannuksia. Hoidamme kaikki tietosuojan vaatimustenmukaisuuden näkökohdat DPIAn käsittelystä tietoturvaloukkausten hallintaan.",
      primaryCTA: { text: "Pyydä DPO-tukea", href: "/contact?service=dpo" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Yleiskatsaus",
      description: "GDPR:n 37 artiklan mukaan monien organisaatioiden on nimettävä tietosuojavastaava. DPO-palveluna tarjoaa päteviä, kokeneita tietosuoja-ammattilaisia, jotka voivat toimia organisaatiosi tietosuojavastaavana varmistaen vaatimustenmukaisuuden samalla kun tarjoavat strategista tietosuojaohjausta.",
      highlight: "Tarjoamme joustavia toimintamalleja virtuaalisista DPO-palveluista paikan päällä tapahtuvaan tukeen, räätälöitynä organisaatiosi erityisiin tietosuojatarpeisiin ja sääntelyvaatimuksiin."
    },
    engagementTypes: {
      title: "Palvelumallit",
      subtitle: "Joustavat DPO-palvelut räätälöitynä organisaatiosi tarpeisiin",
      items: [
        { type: "Virtuaalinen DPO", commitment: "Osa-aikainen", description: "Etä-DPO-palvelut säännöllisillä tarkistuksilla ja valvonnalla" },
        { type: "Paikan päällä oleva DPO", commitment: "Joustava", description: "Säännöllinen paikan päällä läsnäolo monimutkaisille organisaatioille" },
        { type: "Projektipohjainen", commitment: "Tarpeen mukaan", description: "Erityiset tietosuojaprojektit ja arvioinnit" }
      ]
    },
    gdprServices: {
      title: "GDPR-artiklan vaatimustenmukaisuus",
      subtitle: "Kattava kattavuus keskeisistä GDPR-vaatimuksista",
      items: [
        "Artikla 30 RoPA -luominen",
        "Artikla 35 DPIA -toteutus",
        "Artikla 37 DPO -nimitys",
        "Artikloiden 33/34 tietoturvaloukkauksesta ilmoittaminen",
        "Artikloiden 13/14 tietosuojaselosteet",
        "Artikla 7 suostumushallinta"
      ]
    },
    features: {
      title: "DPO-palvelumme",
      subtitle: "Kattavat tietosuojapalvelut, jotka kattavat kaikki tietosuojan vaatimustenmukaisuuden näkökohdat",
      items: [
        { title: "Ulkoistetut DPO-palvelut", description: "Pätevä tietosuojavastaava, joka tarjoaa asiantuntevaa tietosuojavalvontaa ja sääntelyn vaatimustenmukaisuutta", icon: "users" },
        { title: "Tietosuojan vaikutusten arvioinnit", description: "Kattavat DPIAt riskialttiille tietojenkäsittelytoimille ja uusille hankkeille", icon: "clipboard" },
        { title: "Kirjanpito käsittelytoimista", description: "Yksityiskohtaisten RoPA:iden luominen ja ylläpito GDPR:n 30 artiklan vaatimustenmukaisuutta varten", icon: "document" },
        { title: "Tietosuojahallinta ja -käytännöt", description: "Tietosuojakehysten, -käytäntöjen ja -hallintorakenteiden kehittäminen", icon: "shield" },
        { title: "Tietoturvaloukkausten hallinta ja reagointi", description: "Tapahtumien hallinta, loukkausten arviointi ja sääntelyilmoitustuki", icon: "alert" },
        { title: "Sääntely-yhteistyö", description: "Suora viestintä valvontaviranomaisten kanssa ja sääntelyedustus", icon: "network" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Pätevän DPO:n nimitys ja palvelut",
        "Tietosuojaohjelman arviointi ja tiekartta",
        "Tietosuojan vaikutusten arvioinnit (DPIAt)",
        "Kirjanpito käsittelytoimista (RoPAt)",
        "Tietosuojakäytäntöjen ja -menettelyjen kehys",
        "Tietoturvaloukkauksen hallintamenettelyt",
        "Henkilöstön tietosuojakoulutusohjelmat",
        "Sääntelykirjeenvaihto ja -yhteistyö"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Täytä GDPR:n tietosuojavastaavan nimittämisvaatimukset",
        "Asiantuntevaa tietosuojaohjausta ilman kokoaikaisia kustannuksia",
        "Vähennetyt sääntelyriskit ja mahdolliset sakot",
        "Ammattimaiset tietoturvaloukkauksen hallintakyvykkyydet",
        "Parannettu asiakkaiden ja sidosryhmien luottamus"
      ]
    },
    cta: {
      title: "Tarvitsetko asiantuntevaa tietosuojajohtamista?",
      subtitle: "Ota yhteyttä jo tänään keskustellaksesi DPO- ja tietosuojavaatimustenmukaisuusvaatimuksistasi",
      primaryCTA: { text: "Aloita nyt", href: "/contact?service=dpo" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Overview Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-slate-50/50 rounded-2xl p-8 border border-slate-100">
      <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-4">{currentContent.overview.title}</h2>
      <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
      <p class="text-slate-600 leading-relaxed font-semibold text-blue-600">{currentContent.overview.highlight}</p>
    </div>
  </div>
</section>

<!-- Engagement Types Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.engagementTypes.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.engagementTypes.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6">
      {currentContent.engagementTypes.items.map((engagement) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-bold text-slate-900 mb-2">{engagement.type}</h3>
          <p class="text-sm text-blue-600 font-medium mb-3">{engagement.commitment}</p>
          <p class="text-slate-600 text-sm">{engagement.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- GDPR Services Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.gdprServices.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.gdprServices.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {currentContent.gdprServices.items.map((service) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300">
          <p class="text-sm font-medium text-slate-700">{service}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.features.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.features.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.features.items.map((feature) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={feature.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {feature.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables & Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12">
      
      <!-- Deliverables -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.deliverables.title}</h2>
        <ul class="space-y-3">
          {currentContent.deliverables.items.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Benefits -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.benefits.title}</h2>
        <ul class="space-y-3">
          {currentContent.benefits.items.map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="star" class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" />
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>