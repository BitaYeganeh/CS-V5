---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "ISO/IEC 20000-1 | IT Service Management for MSSPs",
  description: "IT service management alignment for MSSP processes and SLAs. Comprehensive service management solutions for managed security service providers.",
  keywords: "ISO 20000, IT service management, MSSP, SLA management, service management, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "ISO/IEC 20000-1",
      subtitle: "IT Service Management for MSSPs",
      description: "IT service management alignment for MSSP processes and SLAs. Comprehensive service management solutions for managed security service providers.",
      primaryCTA: { text: "Start ITSM Alignment", href: "/contact" },
      secondaryCTA: { text: "Learn More", href: "#services" }
    },
    services: {
      title: "MSSP Service Management Solutions",
      subtitle: "Comprehensive IT service management alignment for managed security service providers",
      items: [
        {
          title: "MSSP Process Alignment",
          description: "Align your managed security service provider processes with ISO/IEC 20000-1 standards",
          icon: "cog",
          features: ["Security operations center (SOC) process optimization", "Incident response workflow standardization", "Threat monitoring service alignment", "Security event management processes"]
        },
        {
          title: "SLA Framework Development",
          description: "Develop comprehensive service level agreements that meet ISO/IEC 20000-1 requirements",
          icon: "document",
          features: ["Security service level objectives (SLOs)", "Response time guarantees", "Availability and uptime commitments", "Performance measurement frameworks"]
        },
        {
          title: "Service Management Implementation",
          description: "Complete IT service management system implementation for security services",
          icon: "shield",
          features: ["Service catalog development", "Change management processes", "Configuration management database (CMDB)", "Problem and incident management"]
        },
        {
          title: "Continuous Improvement",
          description: "Establish continuous service improvement processes for managed security services",
          icon: "refresh-cw",
          features: ["Service performance monitoring", "Customer satisfaction measurement", "Process optimization initiatives", "Regular service reviews and updates"]
        }
      ]
    },
    processes: {
      title: "ISO/IEC 20000-1 Key Processes",
      subtitle: "Comprehensive coverage of all required service management processes",
      items: [
        "Service Level Management",
        "Availability Management",
        "Capacity Management",
        "Information Security Management",
        "Incident Management",
        "Problem Management",
        "Change Management",
        "Release Management",
        "Configuration Management",
        "Supplier Management",
        "Service Continuity Management",
        "Service Reporting"
      ]
    },
    benefits: {
      title: "Benefits for MSSPs",
      subtitle: "Why ISO/IEC 20000-1 certification is essential for managed security service providers",
      items: [
        { title: "Enhanced Service Quality", description: "Standardized processes ensure consistent, high-quality security service delivery", icon: "shield-check" },
        { title: "Improved SLA Compliance", description: "Meet and exceed service level agreements with structured management processes", icon: "document-check" },
        { title: "Better Risk Management", description: "Integrated risk management across all IT and security service operations", icon: "chart-line" },
        { title: "Customer Confidence", description: "Demonstrate commitment to service excellence through international certification", icon: "users" }
      ]
    },
    approach: {
      title: "Our Implementation Approach",
      steps: [
        { step: "1", title: "Assessment & Gap Analysis", description: "Evaluate current MSSP processes against ISO/IEC 20000-1 requirements" },
        { step: "2", title: "Process Design & Documentation", description: "Design and document service management processes tailored for security services" },
        { step: "3", title: "SLA Development & Integration", description: "Create comprehensive SLAs that align with service management objectives" },
        { step: "4", title: "Implementation & Training", description: "Deploy processes, train staff, and establish monitoring mechanisms" },
        { step: "5", title: "Certification & Continuous Improvement", description: "Support certification process and establish ongoing improvement cycles" }
      ]
    },
    whyChoose: {
      title: "Why Choose ISO/IEC 20000-1?",
      subtitle: "Transform your IT service delivery with internationally recognized IT Service Management standards and proven best practices.",
      items: [
        { title: "Service Quality", description: "Deliver consistent, high-quality IT services that meet business requirements.", icon: "shield-check" },
        { title: "Operational Efficiency", description: "Streamline IT processes, reduce waste, and improve resource utilization.", icon: "trending-up" },
        { title: "Cost Optimization", description: "Reduce IT costs through better service management and strategic allocation.", icon: "chart-line" },
        { title: "Customer Satisfaction", description: "Improve customer satisfaction through reliable service delivery.", icon: "users" },
        { title: "Risk Management", description: "Identify and manage IT service risks with structured approaches.", icon: "alert-triangle" },
        { title: "Compliance & Governance", description: "Meet regulatory requirements and establish strong IT governance.", icon: "document-check" }
      ]
    },
    cta: {
      title: "Transform Your IT Service Delivery",
      subtitle: "Implement ISO/IEC 20000-1 to achieve service management excellence and deliver value to your business.",
      primaryCTA: { text: "Start ITSM Transformation", href: "/contact" },
      secondaryCTA: { text: "Learn More About Us", href: "/about" }
    }
  },
  fi: {
    hero: {
      title: "ISO/IEC 20000-1",
      subtitle: "IT-palveluhallinta MSSP:ille",
      description: "IT-palveluhallinnan yhdenmukaistaminen MSSP-prosesseille ja SLA:ille. Kattavat palveluhallintaratkaisut hallituille tietoturvapalveluntarjoajille.",
      primaryCTA: { text: "Aloita ITSM-yhdenmukaistaminen", href: "/contact" },
      secondaryCTA: { text: "Lue lisää", href: "#services" }
    },
    services: {
      title: "MSSP-palveluhallintaratkaisut",
      subtitle: "Kattava IT-palveluhallinnan yhdenmukaistaminen hallituille tietoturvapalveluntarjoajille",
      items: [
        {
          title: "MSSP-prosessien yhdenmukaistaminen",
          description: "Yhdenmukaista hallitut tietoturvapalveluntarjoajaprosessisi ISO/IEC 20000-1 -standardien kanssa",
          icon: "cog",
          features: ["Tietoturvaoperaatioiden (SOC) prosessien optimointi", "Tapahtumien hallinnan työnkulkujen standardointi", "Uhkien valvontapalvelun yhdenmukaistaminen", "Tietoturvatapahtumien hallintaprosessit"]
        },
        {
          title: "SLA-kehyksen kehitys",
          description: "Kehitä kattavat palvelutasosopimukset, jotka täyttävät ISO/IEC 20000-1 -vaatimukset",
          icon: "document",
          features: ["Turvallisuuspalvelun tavoitetasot (SLO)", "Vasteaikatakuut", "Saatavuus- ja käyttöaikasitoumukset", "Suorituskyvyn mittauskehykset"]
        },
        {
          title: "Palveluhallinnan toteutus",
          description: "Täydellinen IT-palveluhallintajärjestelmän toteutus tietoturvapalveluille",
          icon: "shield",
          features: ["Palveluluettelon kehitys", "Muutosten hallintaprosessit", "Konfiguraatiohallintatietokanta (CMDB)", "Ongelma- ja tapahtumahallinta"]
        },
        {
          title: "Jatkuva parantaminen",
          description: "Perusta jatkuvat palvelunparannusprosessit hallituille tietoturvapalveluille",
          icon: "refresh-cw",
          features: ["Palvelun suorituskyvyn seuranta", "Asiakastyytyväisyyden mittaus", "Prosessien optimointihankkeet", "Säännölliset palvelukatselmukset ja päivitykset"]
        }
      ]
    },
    processes: {
      title: "ISO/IEC 20000-1 -keskeiset prosessit",
      subtitle: "Kattava kattavuus kaikista vaadituista palveluhallintaprosesseista",
      items: [
        "Palvelutason hallinta",
        "Saatavuuden hallinta",
        "Kapasiteetin hallinta",
        "Tietoturvallisuuden hallinta",
        "Tapahtumien hallinta",
        "Ongelmaiden hallinta",
        "Muutosten hallinta",
        "Käyttöönottoprosessit",
        "Konfiguraatioiden hallinta",
        "Toimittajahallinta",
        "Palvelujen jatkuvuuden hallinta",
        "Palveluraportointi"
      ]
    },
    benefits: {
      title: "Edut MSSP:ille",
      subtitle: "Miksi ISO/IEC 20000-1 -sertifiointi on välttämätöntä hallituille tietoturvapalveluntarjoajille",
      items: [
        { title: "Parannettu palvelun laatu", description: "Standardoidut prosessit varmistavat johdonmukaisen, korkealaatuisen tietoturvapalvelun toimituksen", icon: "shield-check" },
        { title: "Parannettu SLA-vaatimustenmukaisuus", description: "Täytä ja ylitä palvelutasosopimukset rakenteellisilla hallintaprosesseilla", icon: "document-check" },
        { title: "Parempi riskienhallinta", description: "Integroitu riskienhallinta kaikissa IT- ja tietoturvapalveluoperaatioissa", icon: "chart-line" },
        { title: "Asiakasluottamus", description: "Osoita sitoutuminen palvelun huippuosaamiseen kansainvälisen sertifioinnin avulla", icon: "users" }
      ]
    },
    approach: {
      title: "Toteutuslähestymistapamme",
      steps: [
        { step: "1", title: "Arviointi ja aukkoanalyysi", description: "Arvioi nykyiset MSSP-prosessit ISO/IEC 20000-1 -vaatimuksia vastaan" },
        { step: "2", title: "Prosessien suunnittelu ja dokumentointi", description: "Suunnittele ja dokumentoi tietoturvapalveluille räätälöidyt palveluhallintaprosessit" },
        { step: "3", title: "SLA-kehitys ja integrointi", description: "Luo kattavat SLA:t, jotka vastaavat palveluhallinnan tavoitteita" },
        { step: "4", title: "Toteutus ja koulutus", description: "Ota prosessit käyttöön, kouluta henkilöstö ja perusta seurantamekanismit" },
        { step: "5", title: "Sertifiointi ja jatkuva parantaminen", description: "Tukee sertifiointiprosessia ja perusta jatkuvat parannussykli" }
      ]
    },
    whyChoose: {
      title: "Miksi valita ISO/IEC 20000-1?",
      subtitle: "Muuta IT-palvelutoimituksesi kansainvälisesti tunnustetuilla IT-palveluhallintastandardeilla ja todistetuilla parhailla käytännöillä.",
      items: [
        { title: "Palvelun laatu", description: "Tarjoa johdonmukaisia, korkealaatuisia IT-palveluita, jotka täyttävät liiketoimintavaatimukset.", icon: "shield-check" },
        { title: "Operatiivinen tehokkuus", description: "Tehosta IT-prosesseja, vähennä hukkaa ja paranna resurssien käyttöä.", icon: "trending-up" },
        { title: "Kustannusoptimointi", description: "Vähennä IT-kustannuksia paremmalla palveluhallinnalla ja strategisella allokoinnilla.", icon: "chart-line" },
        { title: "Asiakastyytyväisyys", description: "Paranna asiakastyytyväisyyttä luotettavalla palvelutoimituksella.", icon: "users" },
        { title: "Riskienhallinta", description: "Tunnista ja hallitse IT-palveluriskejä rakenteellisilla lähestymistavoilla.", icon: "alert-triangle" },
        { title: "Vaatimustenmukaisuus ja hallinta", description: "Täytä sääntelyvaatimukset ja perusta vahva IT-hallinta.", icon: "document-check" }
      ]
    },
    cta: {
      title: "Muuta IT-palvelutoimituksesi",
      subtitle: "Toteuta ISO/IEC 20000-1 saavuttaaksesi palveluhallinnan huippuosaamisen ja tuottaaksesi arvoa liiketoiminnallesi.",
      primaryCTA: { text: "Aloita ITSM-muutos", href: "/contact" },
      secondaryCTA: { text: "Tutustu meihin paremmin", href: "/about" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Services Section -->
<section id="services" class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.services.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.services.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {currentContent.services.items.map((service) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={service.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {service.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {service.description}
          </p>
          
          <div class="mt-auto">
            <ul class="space-y-1.5">
              {service.features.map((feature) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Key Processes Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.processes.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.processes.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-3">
      {currentContent.processes.items.map((process) => (
        <div class="bg-slate-50/50 rounded-lg p-3 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-sm transition-all duration-300
                    flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span class="text-slate-700 text-xs font-medium">{process}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.benefits.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-4 gap-6">
      {currentContent.benefits.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    group">
          
          <div class="flex justify-center mb-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6]">
              <Icon name={item.icon} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-1 group-hover:text-blue-700 transition-colors duration-300">
            {item.title}
          </h3>
          <p class="text-slate-500 text-xs">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Implementation Approach Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.approach.title}
      </h2>
    </div>
    
    <div class="grid md:grid-cols-5 gap-4">
      {currentContent.approach.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-4 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    group">
          
          <div class="w-10 h-10 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-2">
            {step.step}
          </div>
          
          <h3 class="text-xs font-bold text-slate-800 mb-1 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          <p class="text-slate-500 text-xs">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Why Choose Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.whyChoose.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.whyChoose.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {currentContent.whyChoose.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-5 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    flex items-center gap-3">
          <Icon name={item.icon} class="w-5 h-5 text-blue-600 flex-shrink-0" />
          <div>
            <h3 class="text-sm font-bold text-slate-800">{item.title}</h3>
            <p class="text-slate-500 text-xs">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>