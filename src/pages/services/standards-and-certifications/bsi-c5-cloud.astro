---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "BSI C5 (Cloud) Attestation | German Cloud Security Compliance",
  description: "Achieve BSI C5 compliance for cloud services with expert control mapping, testing, and attestation reporting to meet German cloud security standards.",
  keywords: "BSI C5, cloud compliance, German cloud security, cloud attestation, C5 attestation, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "BSI C5 (Cloud) Attestation",
      subtitle: "German Cloud Security Compliance",
      description: "Expert BSI C5 compliance services to help cloud service providers meet German security standards and demonstrate trustworthy cloud operations. BSI C5 (Cloud Computing Compliance Controls Catalogue) is the German federal security standard for cloud service providers.",
      primaryCTA: { text: "Get BSI C5 Assessment", href: "/contact?service=bsi-c5" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Overview",
      description: "BSI C5 is a German cloud security standard developed by the Federal Office for Information Security (BSI) for attestation of cloud service providers. It establishes comprehensive security requirements for cloud computing services operating in Germany and the European Union.",
      highlight: "Our expert team provides end-to-end support for BSI C5 compliance, from initial control mapping and gap analysis through testing, evidence collection, and attestation reporting to help you demonstrate compliance and build customer trust."
    },
    features: {
      title: "Our BSI C5 Services",
      subtitle: "Comprehensive cloud security compliance services covering all aspects of BSI C5 requirements",
      items: [
        { title: "Control Mapping & Gap Analysis", description: "Comprehensive mapping of BSI C5 controls to your cloud infrastructure and identification of compliance gaps", icon: "map" },
        { title: "Testing & Evidence Collection", description: "Systematic testing of security controls and collection of evidence for attestation requirements", icon: "clipboard" },
        { title: "Attestation Reporting", description: "Professional attestation reports and documentation supporting BSI C5 compliance demonstration", icon: "document" },
        { title: "Auditor Support", description: "Expert liaison with auditors and support throughout the attestation process", icon: "users" },
        { title: "Remediation Planning", description: "Detailed remediation plans to address identified gaps and improve security posture", icon: "wrench" },
        { title: "Ongoing Compliance", description: "Continuous monitoring and maintenance of BSI C5 compliance requirements", icon: "monitor" }
      ]
    },
    cloudServices: {
      title: "Cloud Service Types",
      subtitle: "BSI C5 compliance support for all types of cloud service offerings",
      items: [
        "Infrastructure as a Service (IaaS)",
        "Platform as a Service (PaaS)",
        "Software as a Service (SaaS)",
        "Cloud Storage Services",
        "Hybrid Cloud Environments",
        "Multi-Cloud Architectures"
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "BSI C5 compliance assessment report",
        "Control mapping and gap analysis",
        "Security testing and validation results",
        "Attestation documentation package",
        "Remediation roadmap and implementation plan",
        "Auditor preparation and support materials",
        "Continuous monitoring procedures",
        "Annual compliance maintenance program"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Meet German cloud security regulatory requirements",
        "Demonstrate security to European customers",
        "Enhance trust in cloud service offerings",
        "Competitive advantage in German/EU markets",
        "Streamlined audit and attestation processes"
      ]
    },
    cta: {
      title: "Ready for BSI C5 Compliance?",
      subtitle: "Contact us today to start your BSI C5 cloud compliance journey",
      primaryCTA: { text: "Get Started", href: "/contact?service=bsi-c5" },
      secondaryCTA: { text: "Schedule Assessment", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "BSI C5 (Pilvi) -sertifiointi",
      subtitle: "Saksalainen pilvipalveluiden turvallisuusstandardin mukaisuus",
      description: "Asiantuntevat BSI C5 -vaatimustenmukaisuuspalvelut auttavat pilvipalveluntarjoajia täyttämään Saksan turvallisuusstandardit ja osoittamaan luotettavan pilvitoiminnan. BSI C5 (Cloud Computing Compliance Controls Catalogue) on Saksan liittovaltion tietoturvaviraston pilvipalveluntarjoajille kehittämä turvallisuusstandardi.",
      primaryCTA: { text: "Pyydä BSI C5 -arviointi", href: "/contact?service=bsi-c5" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Yleiskatsaus",
      description: "BSI C5 on saksalainen pilvipalveluiden turvallisuusstandardi, jonka on kehittänyt Saksan liittovaltion tietoturvavirasto (BSI) pilvipalveluntarjoajien sertifiointiin. Se asettaa kattavat turvallisuusvaatimuksille Saksassa ja Euroopan unionissa toimiville pilvipalveluille.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa tukea BSI C5 -vaatimustenmukaisuuteen alkuperäisestä kontrollikartoituksesta ja aukkoanalyysistä testaukseen, todisteiden keruuseen ja sertifiointiraportointiin auttaaksemme sinua osoittamaan vaatimustenmukaisuuden ja rakentamaan asiakasluottamusta."
    },
    features: {
      title: "BSI C5 -palvelumme",
      subtitle: "Kattavat pilvipalveluiden turvallisuuspalvelut, jotka kattavat kaikki BSI C5 -vaatimusten näkökohdat",
      items: [
        { title: "Kontrollikartoitus ja aukkoanalyysi", description: "Kattava BSI C5 -kontrollien kartoitus pilvi-infrastruktuuriisi ja vaatimustenmukaisuuspuutteiden tunnistaminen", icon: "map" },
        { title: "Testaus ja todisteiden keruu", description: "Systemaattinen tietoturvakontrollien testaus ja todisteiden keruu sertifiointivaatimuksia varten", icon: "clipboard" },
        { title: "Sertifiointiraportointi", description: "Ammattimaiset sertifiointiraportit ja dokumentaatio BSI C5 -vaatimustenmukaisuuden osoittamiseksi", icon: "document" },
        { title: "Auditorituki", description: "Asiantunteva yhteistyö auditorien kanssa ja tuki koko sertifiointiprosessin ajan", icon: "users" },
        { title: "Korjausten suunnittelu", description: "Yksityiskohtaiset korjaussuunnitelmat tunnistettujen puutteiden korjaamiseksi ja turvallisuustason parantamiseksi", icon: "wrench" },
        { title: "Jatkuva vaatimustenmukaisuus", description: "BSI C5 -vaatimustenmukaisuusvaatimusten jatkuva seuranta ja ylläpito", icon: "monitor" }
      ]
    },
    cloudServices: {
      title: "Pilvipalvelutyypit",
      subtitle: "BSI C5 -vaatimustenmukaisuustuki kaikentyyppisille pilvipalvelutarjonnalle",
      items: [
        "Infrastruktuuri palveluna (IaaS)",
        "Alusta palveluna (PaaS)",
        "Ohjelmisto palveluna (SaaS)",
        "Pilvitallennuspalvelut",
        "Hybridipilviympäristöt",
        "Monipilviarkkitehtuurit"
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "BSI C5 -vaatimustenmukaisuusarviointiraportti",
        "Kontrollikartoitus ja aukkoanalyysi",
        "Turvallisuustestaus- ja validointitulokset",
        "Sertifiointidokumentaatiopaketti",
        "Korjausten tiekartta ja toteutussuunnitelma",
        "Auditorien valmistelu- ja tukimateriaalit",
        "Jatkuvan seurannan menettelyt",
        "Vuosittainen vaatimustenmukaisuuden ylläpito-ohjelma"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Täytä Saksan pilvipalveluiden sääntelyvaatimukset",
        "Osoita turvallisuus eurooppalaisille asiakkaille",
        "Lisää luottamusta pilvipalvelutarjontaan",
        "Kilpailuetu Saksan ja EU:n markkinoilla",
        "Virtaviivaistetut auditointi- ja sertifiointiprosessit"
      ]
    },
    cta: {
      title: "Valmis BSI C5 -vaatimustenmukaisuuteen?",
      subtitle: "Ota yhteyttä jo tänään aloittaaksesi BSI C5 -pilvipalveluvaatimustenmukaisuusmatkasi",
      primaryCTA: { text: "Aloita nyt", href: "/contact?service=bsi-c5" },
      secondaryCTA: { text: "Varaa arviointi", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="cloud" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Overview Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-slate-50/50 rounded-2xl p-8 border border-slate-100">
      <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-4">{currentContent.overview.title}</h2>
      <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
      <p class="text-slate-600 leading-relaxed font-semibold text-blue-600">{currentContent.overview.highlight}</p>
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.features.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.features.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.features.items.map((feature) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={feature.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {feature.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Cloud Services Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.cloudServices.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.cloudServices.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {currentContent.cloudServices.items.map((service) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300">
          <p class="text-sm font-medium text-slate-700">{service}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables & Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12">
      
      <!-- Deliverables -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.deliverables.title}</h2>
        <ul class="space-y-3">
          {currentContent.deliverables.items.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Benefits -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.benefits.title}</h2>
        <ul class="space-y-3">
          {currentContent.benefits.items.map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="star" class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" />
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>