---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Anti-Fraud Services | BEC & Invoice Fraud Protection",
  description: "Expert fraud risk management including BEC/invoice controls, detection systems, and incident response to protect against business email compromise and payment fraud.",
  keywords: "anti-fraud, BEC protection, invoice fraud, payment fraud, fraud detection, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Anti-Fraud Services",
      subtitle: "Protect Against BEC & Invoice Fraud",
      description: "Expert fraud risk management services to protect your organization against business email compromise, invoice fraud, and payment scams. Our Anti-Fraud Services provide comprehensive protection against increasingly sophisticated fraud attacks, with expert controls, detection systems, and rapid response capabilities to safeguard your finances and reputation.",
      primaryCTA: { text: "Protect Against Fraud", href: "/contact?service=anti-fraud" },
      secondaryCTA: { text: "Book Assessment", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Overview",
      description: "Business email compromise (BEC) and invoice fraud are among the most costly cyber threats facing organizations today, with losses exceeding billions of dollars annually. These sophisticated attacks target finance and procurement processes to redirect payments to fraudulent accounts.",
      highlight: "Our Anti-Fraud Services provide comprehensive protection through advanced controls, detection systems, staff training, and rapid incident response to prevent financial losses and protect your organization's reputation."
    },
    fraudTypes: {
      title: "Fraud Threats We Address",
      subtitle: "Comprehensive protection against all major fraud attack vectors",
      items: [
        "Business Email Compromise (BEC)",
        "Invoice Fraud & Manipulation",
        "Payment Redirection Fraud",
        "Vendor Impersonation",
        "CEO/Executive Fraud",
        "Wire Transfer Fraud",
        "Procurement Fraud",
        "Social Engineering Attacks"
      ]
    },
    controls: {
      title: "Multi-Layer Fraud Controls",
      subtitle: "Comprehensive defense-in-depth approach to fraud prevention",
      items: [
        { control: "Email Security", description: "Advanced email filtering, DMARC, and anti-phishing controls" },
        { control: "Payment Verification", description: "Multi-factor authentication and out-of-band verification for payments" },
        { control: "Vendor Management", description: "Secure vendor onboarding and change management processes" },
        { control: "User Training", description: "Regular phishing simulations and fraud awareness training" }
      ]
    },
    industries: {
      title: "Industries We Protect",
      subtitle: "Specialized fraud protection across high-risk sectors",
      items: [
        "Financial Services",
        "Manufacturing",
        "Healthcare",
        "Professional Services",
        "Technology",
        "Retail & E-commerce",
        "Real Estate",
        "Government & Public Sector"
      ]
    },
    features: {
      title: "Our Anti-Fraud Services",
      subtitle: "Comprehensive fraud prevention and response services to protect your organization",
      items: [
        { title: "BEC & Invoice Fraud Controls", description: "Comprehensive controls to prevent business email compromise and invoice fraud attacks", icon: "shield" },
        { title: "Fraud Detection & Monitoring", description: "Advanced detection systems and monitoring capabilities to identify fraudulent activities", icon: "eye" },
        { title: "Incident Response & Investigation", description: "Rapid response and thorough investigation of fraud incidents and security breaches", icon: "alert" },
        { title: "Payment Controls & Verification", description: "Multi-layer payment approval processes and vendor verification systems", icon: "check" },
        { title: "Security Awareness Training", description: "Comprehensive training programs to educate staff on fraud prevention and recognition", icon: "users" },
        { title: "Risk Assessment & Monitoring", description: "Ongoing fraud risk assessments and continuous monitoring of threat landscape", icon: "chart" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Fraud risk assessment and gap analysis",
        "BEC and invoice fraud control framework",
        "Payment verification and approval processes",
        "Fraud detection and monitoring systems",
        "Incident response procedures and playbooks",
        "Staff training and awareness programs",
        "Vendor verification and due diligence processes",
        "Ongoing fraud risk monitoring and reporting"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Prevent costly business email compromise attacks",
        "Protect against invoice and payment fraud",
        "Reduce financial losses and reputational damage",
        "Improve staff awareness and fraud detection",
        "Ensure rapid response to fraud incidents"
      ]
    },
    cta: {
      title: "Protect Your Organization from Fraud",
      subtitle: "Contact us today to strengthen your fraud defenses and response capabilities",
      primaryCTA: { text: "Get Protected", href: "/contact?service=anti-fraud" },
      secondaryCTA: { text: "Schedule Assessment", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "Petostentorjuntapalvelut",
      subtitle: "Suojaa BEC- ja laskupetoksilta",
      description: "Asiantuntevat petostentorjuntapalvelut suojaamaan organisaatiotasi yrityssähköpostihuijauksilta, laskupetoksilta ja maksuhuijauksilta. Petostentorjuntapalvelumme tarjoavat kattavan suojan yhä kehittyneempiä petoshyökkäyksiä vastaan asiantuntevilla kontrolleilla, havainnointijärjestelmillä ja nopeilla reagointikyvykkyyksillä suojellaksesi talouttasi ja mainettasi.",
      primaryCTA: { text: "Suojaa petoksilta", href: "/contact?service=anti-fraud" },
      secondaryCTA: { text: "Varaa arviointi", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Yleiskatsaus",
      description: "Yrityssähköpostihuijaukset (BEC) ja laskupetokset ovat yksiä kalleimmista kyberuhkista, joita organisaatiot kohtaavat nykyään, ja niiden tappiot nousevat vuosittain miljardeihin dollareihin. Nämä kehittyneet hyökkäykset kohdistuvat talous- ja hankintaprosesseihin ohjatakseen maksut petollisille tileille.",
      highlight: "Petostentorjuntapalvelumme tarjoavat kattavan suojan edistyneiden kontrollien, havainnointijärjestelmien, henkilöstökoulutuksen ja nopean tapahtumien hallinnan avulla estääkseen taloudellisia tappioita ja suojellakseen organisaatiosi mainetta."
    },
    fraudTypes: {
      title: "Petosuhkat joihin vastaamme",
      subtitle: "Kattava suoja kaikkia merkittäviä petoshyökkäysvektoreita vastaan",
      items: [
        "Yrityssähköpostihuijaukset (BEC)",
        "Laskupetokset ja manipulaatio",
        "Maksujen uudelleenohjauspetokset",
        "Toimittajien jäljittely",
        "Toimitusjohtaja/johdon petokset",
        "Tilisiirtopetokset",
        "Hankintapetokset",
        "Sosiaalisen manipuloinnin hyökkäykset"
      ]
    },
    controls: {
      title: "Monikerroksiset petoskontrollit",
      subtitle: "Kattava puolustus syvyydessä -lähestymistapa petosten estämiseen",
      items: [
        { control: "Sähköpostiturvallisuus", description: "Edistynyt sähköpostisuodatus, DMARC ja tietojenkalastelukontrollit" },
        { control: "Maksujen varmennus", description: "Monivaiheinen tunnistautuminen ja kanavan ulkopuolinen varmennus maksuille" },
        { control: "Toimittajahallinta", description: "Turvallinen toimittajien käyttöönotto ja muutostenhallintaprosessit" },
        { control: "Käyttäjäkoulutus", description: "Säännölliset tietojenkalastelusimulaatiot ja petostietoisuuskoulutus" }
      ]
    },
    industries: {
      title: "Toimialat joita suojaamme",
      subtitle: "Erikoistunut petossuoja riskialttiilla sektoreilla",
      items: [
        "Rahoituspalvelut",
        "Teollisuus",
        "Terveydenhuolto",
        "Asiantuntijapalvelut",
        "Teknologia",
        "Vähittäiskauppa ja verkkokauppa",
        "Kiinteistöala",
        "Julkinen sektori"
      ]
    },
    features: {
      title: "Petostentorjuntapalvelumme",
      subtitle: "Kattavat petosten estämis- ja reagointipalvelut suojaamaan organisaatiotasi",
      items: [
        { title: "BEC- ja laskupetoskontrollit", description: "Kattavat kontrollit yrityssähköpostihuijausten ja laskupetosten estämiseksi", icon: "shield" },
        { title: "Petosten havaitseminen ja seuranta", description: "Edistyneet havainnointijärjestelmät ja seurantakyvykkyydet petollisten toimien tunnistamiseksi", icon: "eye" },
        { title: "Tapahtumien hallinta ja tutkinta", description: "Nopea reagointi ja perusteellinen tutkinta petostapauksista ja tietoturvaloukkauksista", icon: "alert" },
        { title: "Maksukontrollit ja varmennus", description: "Monikerroksiset maksujen hyväksymisprosessit ja toimittajien varmennusjärjestelmät", icon: "check" },
        { title: "Tietoturvatietoisuuskoulutus", description: "Kattavat koulutusohjelmat henkilöstön kouluttamiseksi petosten estämiseen ja tunnistamiseen", icon: "users" },
        { title: "Riskinarviointi ja seuranta", description: "Jatkuvat petosriskien arvioinnit ja uhkakentän jatkuva seuranta", icon: "chart" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Petosriskin arviointi ja aukkoanalyysi",
        "BEC- ja laskupetoskontrollikehys",
        "Maksujen varmennus- ja hyväksymisprosessit",
        "Petosten havaitsemis- ja seurantajärjestelmät",
        "Tapahtumien hallintamenettelyt ja toimintasuunnitelmat",
        "Henkilöstön koulutus- ja tietoisuusohjelmat",
        "Toimittajien varmennus- ja due diligence -prosessit",
        "Jatkuva petosriskien seuranta ja raportointi"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Estä kalliit yrityssähköpostihuijaushyökkäykset",
        "Suojaa lasku- ja maksupetoksilta",
        "Vähennä taloudellisia tappioita ja mainehaittoja",
        "Paranna henkilöstön tietoisuutta ja petosten havaitsemista",
        "Varmista nopea reagointi petostapauksiin"
      ]
    },
    cta: {
      title: "Suojaa organisaatiosi petoksilta",
      subtitle: "Ota yhteyttä jo tänään vahvistaaksesi petossuojaus- ja reagointikyvykkyyksiäsi",
      primaryCTA: { text: "Suojaa nyt", href: "/contact?service=anti-fraud" },
      secondaryCTA: { text: "Varaa arviointi", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Overview Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-slate-50/50 rounded-2xl p-8 border border-slate-100">
      <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-4">{currentContent.overview.title}</h2>
      <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
      <p class="text-slate-600 leading-relaxed font-semibold text-blue-600">{currentContent.overview.highlight}</p>
    </div>
  </div>
</section>

<!-- Fraud Types Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.fraudTypes.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.fraudTypes.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {currentContent.fraudTypes.items.map((fraud) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300">
          <p class="text-sm font-medium text-slate-700">{fraud}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Controls Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.controls.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.controls.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 gap-6">
      {currentContent.controls.items.map((control) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300">
          <h3 class="text-lg font-bold text-slate-900 mb-2">{control.control}</h3>
          <p class="text-slate-600 text-sm">{control.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Industries Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.industries.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.industries.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {currentContent.industries.items.map((industry) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300">
          <p class="text-sm font-medium text-slate-700">{industry}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.features.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.features.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.features.items.map((feature) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={feature.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {feature.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables & Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12">
      
      <!-- Deliverables -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.deliverables.title}</h2>
        <ul class="space-y-3">
          {currentContent.deliverables.items.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Benefits -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.benefits.title}</h2>
        <ul class="space-y-3">
          {currentContent.benefits.items.map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="star" class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" />
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>