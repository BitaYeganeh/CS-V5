---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "ISO 27001 Implementation & Auditing | ISMS Certification Services",
  description: "Comprehensive ISO 27001 ISMS implementation and internal auditing services including scope definition, risk assessment, control implementation, and certification support.",
  keywords: "ISO 27001, ISMS implementation, internal auditing, certification support, risk assessment, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "ISO 27001 Implementation & Auditing",
      subtitle: "ISMS Certification Services",
      description: "Comprehensive ISO 27001 ISMS implementation and internal auditing services to achieve certification and maintain robust information security. Our expert team serves as your ISMS Manager and Internal Auditor, providing end-to-end support from initial scope definition through certification and ongoing compliance maintenance.",
      primaryCTA: { text: "Start Implementation", href: "/contact?service=iso-27001-implementation" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Overview",
      description: "ISO 27001 is the international standard for Information Security Management Systems (ISMS). Achieving certification requires systematic implementation of security controls, comprehensive documentation, and ongoing management of information security risks.",
      highlight: "Our comprehensive implementation and auditing service provides dedicated ISMS expertise to guide your organization through every step of the certification journey, ensuring efficient implementation and successful audit outcomes."
    },
    phases: {
      title: "Implementation Process",
      subtitle: "Structured approach to ISO 27001 implementation and certification",
      items: [
        { phase: "Phase 1: Planning & Scoping", duration: "2-3 weeks", activities: ["ISMS scope definition", "Context and stakeholder analysis", "Initial risk assessment"] },
        { phase: "Phase 2: Risk Assessment & SoA", duration: "3-4 weeks", activities: ["Detailed risk assessment", "Risk treatment planning", "Statement of Applicability development"] },
        { phase: "Phase 3: Implementation", duration: "8-12 weeks", activities: ["Control implementation", "Policy and procedure development", "Evidence collection and documentation"] },
        { phase: "Phase 4: Internal Audit & Certification", duration: "3-4 weeks", activities: ["Internal audit execution", "Management review", "Certification audit preparation"] }
      ]
    },
    isoControls: {
      title: "ISO 27001 Annex A Controls",
      subtitle: "Comprehensive implementation of all 14 security control categories",
      items: [
        "Information Security Policies",
        "Organization of Information Security",
        "Human Resource Security",
        "Asset Management",
        "Access Control",
        "Cryptography",
        "Physical and Environmental Security",
        "Operations Security",
        "Communications Security",
        "System Acquisition & Development",
        "Supplier Relationships",
        "Information Security Incident Management",
        "Business Continuity Management",
        "Compliance"
      ]
    },
    features: {
      title: "Our Implementation Services",
      subtitle: "Comprehensive ISO 27001 services covering all aspects of ISMS implementation and auditing",
      items: [
        { title: "ISMS Scope & Risk Assessment", description: "Define ISMS scope, conduct comprehensive risk assessments, and establish risk treatment plans", icon: "map" },
        { title: "Statement of Applicability (SoA)", description: "Develop comprehensive SoA documenting applicable controls and justifications", icon: "document" },
        { title: "Control Implementation", description: "Implement ISO 27001 Annex A controls with detailed procedures and evidence collection", icon: "cog" },
        { title: "Internal Audit Program", description: "Design and execute comprehensive internal audit programs for ISMS compliance", icon: "clipboard" },
        { title: "Evidence Management", description: "Systematic collection and organization of evidence for compliance demonstration", icon: "folder" },
        { title: "Certification Support", description: "Complete preparation and support for external certification audits", icon: "award" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "ISMS scope definition and context analysis",
        "Comprehensive risk assessment and treatment plan",
        "Statement of Applicability (SoA)",
        "Security policies and procedures library",
        "Control implementation roadmap",
        "Evidence repository and documentation",
        "Internal audit program and reports",
        "Certification audit preparation and support"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Achieve ISO 27001 certification efficiently",
        "Demonstrate security to customers and partners",
        "Reduce information security risks",
        "Meet regulatory and contractual requirements",
        "Competitive advantage through certification"
      ]
    },
    cta: {
      title: "Ready for ISO 27001 Certification?",
      subtitle: "Contact us today to start your ISO 27001 implementation journey",
      primaryCTA: { text: "Get Started", href: "/contact?service=iso-27001-implementation" },
      secondaryCTA: { text: "Schedule Assessment", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "ISO 27001 -toteutus ja auditointi",
      subtitle: "ISMS-sertifiointipalvelut",
      description: "Kattavat ISO 27001 ISMS -toteutus- ja sisäiset auditointipalvelut sertifioinnin saavuttamiseksi ja vahvan tietoturvallisuuden ylläpitämiseksi. Asiantuntijatiimimme toimii ISMS-päällikkönäsi ja sisäisenä auditoijana tarjoten päästä päähän -tukea alkuperäisestä laajuuden määrittelystä sertifiointiin ja jatkuvaan vaatimustenmukaisuuden ylläpitoon.",
      primaryCTA: { text: "Aloita toteutus", href: "/contact?service=iso-27001-implementation" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Yleiskatsaus",
      description: "ISO 27001 on kansainvälinen standardi tietoturvallisuuden hallintajärjestelmille (ISMS). Sertifioinnin saavuttaminen vaatii turvallisuuskontrollien systemaattista käyttöönottoa, kattavaa dokumentointia ja tietoturvariskien jatkuvaa hallintaa.",
      highlight: "Kattava toteutus- ja auditointipalvelumme tarjoaa omistautunutta ISMS-asiantuntemusta ohjatakseen organisaatiosi jokaisen sertifiointimatkan vaiheen läpi varmistaen tehokkaan toteutuksen ja onnistuneet auditointitulokset."
    },
    phases: {
      title: "Toteutusprosessi",
      subtitle: "Rakenteinen lähestymistapa ISO 27001 -toteutukseen ja sertifiointiin",
      items: [
        { phase: "Vaihe 1: Suunnittelu ja laajuuden määrittely", duration: "2-3 viikkoa", activities: ["ISMS-laajuuden määrittely", "Toimintaympäristön ja sidosryhmien analyysi", "Alustava riskinarviointi"] },
        { phase: "Vaihe 2: Riskinarviointi ja SoA", duration: "3-4 viikkoa", activities: ["Yksityiskohtainen riskinarviointi", "Riskien käsittelyn suunnittelu", "Soveltuvuuslausuman kehittäminen"] },
        { phase: "Vaihe 3: Toteutus", duration: "8-12 viikkoa", activities: ["Kontrollien toteutus", "Käytäntöjen ja menettelyjen kehittäminen", "Todisteiden keruu ja dokumentointi"] },
        { phase: "Vaihe 4: Sisäinen auditointi ja sertifiointi", duration: "3-4 viikkoa", activities: ["Sisäisen auditoinnin toteutus", "Johdon katselmus", "Sertifiointiauditoinnin valmistelu"] }
      ]
    },
    isoControls: {
      title: "ISO 27001 -liitteen A kontrollit",
      subtitle: "Kaikkien 14 turvallisuuskontrollikategorian kattava toteutus",
      items: [
        "Tietoturvapolitiikat",
        "Tietoturvallisuuden organisointi",
        "Henkilöstöturvallisuus",
        "Resurssien hallinta",
        "Käyttöoikeuksien hallinta",
        "Kryptografia",
        "Fyysinen ja ympäristöturvallisuus",
        "Toiminnan turvallisuus",
        "Viestinnän turvallisuus",
        "Järjestelmien hankinta ja kehitys",
        "Toimittajasuhteet",
        "Tietoturvapoikkeamien hallinta",
        "Liiketoiminnan jatkuvuuden hallinta",
        "Vaatimustenmukaisuus"
      ]
    },
    features: {
      title: "Toteutuspalvelumme",
      subtitle: "Kattavat ISO 27001 -palvelut, jotka kattavat kaikki ISMS-toteutuksen ja auditoinnin näkökohdat",
      items: [
        { title: "ISMS-laajuus ja riskinarviointi", description: "Määrittele ISMS-laajuus, suorita kattavat riskinarvioinnit ja perusta riskien käsittelysuunnitelmat", icon: "map" },
        { title: "Soveltuvuuslausuma (SoA)", description: "Kehitä kattava SoA, joka dokumentoi sovellettavat kontrollit ja perustelut", icon: "document" },
        { title: "Kontrollien toteutus", description: "Toteuta ISO 27001 -liitteen A kontrollit yksityiskohtaisilla menettelyillä ja todisteiden keruulla", icon: "cog" },
        { title: "Sisäinen auditointiohjelma", description: "Suunnittele ja toteuta kattavat sisäiset auditointiohjelmat ISMS-vaatimustenmukaisuudelle", icon: "clipboard" },
        { title: "Todisteiden hallinta", description: "Systemaattinen todisteiden keruu ja järjestäminen vaatimustenmukaisuuden osoittamiseksi", icon: "folder" },
        { title: "Sertifiointituki", description: "Täydellinen valmistelu ja tuki ulkoisia sertifiointiauditointia varten", icon: "award" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "ISMS-laajuuden määrittely ja toimintaympäristöanalyysi",
        "Kattava riskinarviointi ja käsittelysuunnitelma",
        "Soveltuvuuslausuma (SoA)",
        "Tietoturvakäytäntöjen ja -menettelyjen kirjasto",
        "Kontrollien toteutuksen tiekartta",
        "Todisteiden arkisto ja dokumentointi",
        "Sisäinen auditointiohjelma ja raportit",
        "Sertifiointiauditoinnin valmistelu ja tuki"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Saavuta ISO 27001 -sertifiointi tehokkaasti",
        "Osoita turvallisuus asiakkaille ja kumppaneille",
        "Vähennä tietoturvariskejä",
        "Täytä sääntely- ja sopimusvaatimukset",
        "Kilpailuetu sertifioinnin avulla"
      ]
    },
    cta: {
      title: "Valmis ISO 27001 -sertifiointiin?",
      subtitle: "Ota yhteyttä jo tänään aloittaaksesi ISO 27001 -toteutusmatkasi",
      primaryCTA: { text: "Aloita nyt", href: "/contact?service=iso-27001-implementation" },
      secondaryCTA: { text: "Varaa arviointi", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Overview Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-slate-50/50 rounded-2xl p-8 border border-slate-100">
      <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-4">{currentContent.overview.title}</h2>
      <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
      <p class="text-slate-600 leading-relaxed font-semibold text-blue-600">{currentContent.overview.highlight}</p>
    </div>
  </div>
</section>

<!-- Implementation Phases Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.phases.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.phases.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 gap-6">
      {currentContent.phases.items.map((phase) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-lg transition-all duration-300">
          
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold text-slate-900">{phase.phase}</h3>
            <span class="text-xs font-medium text-blue-600 bg-blue-100 px-2 py-1 rounded-full">{phase.duration}</span>
          </div>
          
          <ul class="space-y-2">
            {phase.activities.map((activity) => (
              <li class="flex items-start text-sm text-slate-600">
                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {activity}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ISO Controls Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.isoControls.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.isoControls.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
      {currentContent.isoControls.items.map((control) => (
        <div class="bg-slate-50/50 rounded-lg p-3 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-sm transition-all duration-300">
          <p class="text-xs font-medium text-slate-700">{control}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.features.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.features.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.features.items.map((feature) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={feature.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {feature.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables & Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12">
      
      <!-- Deliverables -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.deliverables.title}</h2>
        <ul class="space-y-3">
          {currentContent.deliverables.items.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Benefits -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.benefits.title}</h2>
        <ul class="space-y-3">
          {currentContent.benefits.items.map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="star" class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" />
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>