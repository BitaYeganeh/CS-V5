---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Compliance-as-a-Service | Dedicated Compliance Manager",
  description: "Dedicated Compliance Manager services for ISMS/BCMS operation, evidence management, audit support, and attestation coordination. Continuous compliance and audit readiness.",
  keywords: "compliance as a service, compliance manager, ISMS operation, BCMS, audit support, evidence management, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Compliance-as-a-Service",
      subtitle: "Dedicated Compliance Manager",
      description: "Dedicated Compliance Manager services providing ongoing ISMS/BCMS operation, evidence management, and audit support for sustained compliance. Our Compliance-as-a-Service provides organizations with dedicated compliance management expertise to operate security and business continuity management systems, ensuring continuous compliance and audit readiness.",
      primaryCTA: { text: "Get Compliance Support", href: "/contact?service=compliance" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Overview",
      description: "Maintaining compliance certifications requires continuous effort, evidence collection, and operational management. Our Compliance-as-a-Service provides dedicated compliance management expertise to handle the day-to-day operations of your compliance programs.",
      highlight: "We serve as your organization's Compliance Manager, handling everything from ISMS operation to audit coordination, allowing your internal teams to focus on core business activities while ensuring sustained compliance."
    },
    serviceModels: {
      title: "Service Models",
      subtitle: "Flexible compliance support tailored to your organization's needs",
      items: [
        { type: "Dedicated Compliance Manager", commitment: "Part-time/Full-time", description: "Dedicated resource managing your compliance program" },
        { type: "Compliance Operations Support", commitment: "As needed", description: "Operational support for specific compliance activities" },
        { type: "Audit Season Support", commitment: "Project-based", description: "Intensive support during audit and certification periods" }
      ]
    },
    frameworks: {
      title: "Supported Frameworks",
      subtitle: "Comprehensive compliance management across multiple standards and frameworks",
      items: [
        "ISO 27001 ISMS",
        "ISO 22301 BCMS",
        "ISO 9001 QMS",
        "SOC 2 Type II",
        "HITRUST CSF",
        "PCI DSS",
        "GDPR/Privacy",
        "Industry Frameworks"
      ]
    },
    features: {
      title: "Our Compliance Services",
      subtitle: "Comprehensive compliance management covering all aspects of certification maintenance",
      items: [
        { title: "ISMS/BCMS Operation", description: "Full operational management of Information Security and Business Continuity Management Systems", icon: "cog" },
        { title: "Evidence Collection & Management", description: "Systematic collection, organization, and maintenance of compliance evidence", icon: "folder" },
        { title: "Audit Support & Coordination", description: "Comprehensive support for internal and external audits, including preparation and follow-up", icon: "clipboard" },
        { title: "Attestation Management", description: "Coordination of compliance attestations and certification maintenance activities", icon: "award" },
        { title: "Compliance Monitoring", description: "Continuous monitoring of compliance status and early identification of issues", icon: "monitor" },
        { title: "Reporting & Dashboards", description: "Regular compliance reporting and executive dashboards for stakeholder communication", icon: "chart" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Compliance program operation and management",
        "Evidence repository and documentation system",
        "Internal audit programs and execution",
        "External audit coordination and support",
        "Compliance monitoring and tracking system",
        "Monthly compliance reports and dashboards",
        "Certification maintenance and renewal support",
        "Continuous improvement recommendations"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Dedicated compliance expertise without full-time costs",
        "Reduced compliance burden on internal teams",
        "Consistent audit readiness and preparation",
        "Improved compliance efficiency and effectiveness",
        "Reduced risk of certification lapses"
      ]
    },
    cta: {
      title: "Streamline Your Compliance Operations",
      subtitle: "Contact us today to discuss your compliance management needs",
      primaryCTA: { text: "Get Started", href: "/contact?service=compliance" },
      secondaryCTA: { text: "Schedule Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "Vaatimustenmukaisuus-palveluna",
      subtitle: "Dedikoitu vaatimustenmukaisuuspäällikkö",
      description: "Dedikoidut vaatimustenmukaisuuspäällikköpalvelut, jotka tarjoavat jatkuvaa ISMS/BCMS-toimintaa, todisteiden hallintaa ja auditointitukea kestävään vaatimustenmukaisuuteen. Vaatimustenmukaisuus-palveluna tarjoaa organisaatioille dedikoitua vaatimustenmukaisuuden hallintaosaamista tietoturva- ja liiketoiminnan jatkuvuuden hallintajärjestelmien operointiin varmistaen jatkuvan vaatimustenmukaisuuden ja auditointivalmiuden.",
      primaryCTA: { text: "Pyydä vaatimustenmukaisuustukea", href: "/contact?service=compliance" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Yleiskatsaus",
      description: "Vaatimustenmukaisuussertifikaattien ylläpito vaatii jatkuvaa työtä, todisteiden keruuta ja operatiivista hallintaa. Vaatimustenmukaisuus-palveluna tarjoaa dedikoitua vaatimustenmukaisuuden hallintaosaamista hoitamaan vaatimustenmukaisuusohjelmiesi päivittäisiä toimintoja.",
      highlight: "Toimimme organisaatiosi vaatimustenmukaisuuspäällikkönä hoitaen kaiken ISMS-toiminnasta auditointikoordinointiin, jolloin sisäiset tiimisi voivat keskittyä ydintoimintoihin samalla kun varmistamme jatkuvan vaatimustenmukaisuuden."
    },
    serviceModels: {
      title: "Palvelumallit",
      subtitle: "Joustava vaatimustenmukaisuustuki organisaatiosi tarpeisiin",
      items: [
        { type: "Dedikoitu vaatimustenmukaisuuspäällikkö", commitment: "Osa-aikainen/Kokoaikainen", description: "Dedikoitu resurssi vaatimustenmukaisuusohjelmasi hallintaan" },
        { type: "Vaatimustenmukaisuusoperaatioiden tuki", commitment: "Tarpeen mukaan", description: "Operatiivinen tuki erityisiin vaatimustenmukaisuustoimintoihin" },
        { type: "Auditointikauden tuki", commitment: "Projektipohjainen", description: "Tehostettu tuki auditointi- ja sertifiointijaksojen aikana" }
      ]
    },
    frameworks: {
      title: "Tuetut kehykset",
      subtitle: "Kattava vaatimustenmukaisuuden hallinta useiden standardien ja kehysten välillä",
      items: [
        "ISO 27001 ISMS",
        "ISO 22301 BCMS",
        "ISO 9001 QMS",
        "SOC 2 Type II",
        "HITRUST CSF",
        "PCI DSS",
        "GDPR/Tietosuoja",
        "Toimialakehykset"
      ]
    },
    features: {
      title: "Vaatimustenmukaisuuspalvelumme",
      subtitle: "Kattava vaatimustenmukaisuuden hallinta, joka kattaa kaikki sertifioinnin ylläpidon osa-alueet",
      items: [
        { title: "ISMS/BCMS-toiminta", description: "Tietoturva- ja liiketoiminnan jatkuvuuden hallintajärjestelmien täysi operatiivinen hallinta", icon: "cog" },
        { title: "Todisteiden keruu ja hallinta", description: "Systemaattinen vaatimustenmukaisuustodisteiden keruu, järjestäminen ja ylläpito", icon: "folder" },
        { title: "Auditointituki ja koordinointi", description: "Kattava tuki sisäisille ja ulkoisille auditoinneille, mukaan lukien valmistelu ja seuranta", icon: "clipboard" },
        { title: "Sertifiointien hallinta", description: "Vaatimustenmukaisuussertifiointien ja sertifiointien ylläpitotoimien koordinointi", icon: "award" },
        { title: "Vaatimustenmukaisuuden seuranta", description: "Vaatimustenmukaisuusaseman jatkuva seuranta ja ongelmien varhainen tunnistaminen", icon: "monitor" },
        { title: "Raportointi ja hallintapaneelit", description: "Säännöllinen vaatimustenmukaisuusraportointi ja johdon hallintapaneelit sidosryhmäviestintää varten", icon: "chart" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Vaatimustenmukaisuusohjelman operointi ja hallinta",
        "Todisteiden arkisto ja dokumentointijärjestelmä",
        "Sisäiset auditointiohjelmat ja toteutus",
        "Ulkoisten auditointien koordinointi ja tuki",
        "Vaatimustenmukaisuuden seuranta- ja seurantajärjestelmä",
        "Kuukausittaiset vaatimustenmukaisuusraportit ja hallintapaneelit",
        "Sertifioinnin ylläpito- ja uusimistuki",
        "Jatkuvan parantamisen suositukset"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Dedikoitu vaatimustenmukaisuusosaaminen ilman kokoaikaisia kustannuksia",
        "Vähentynyt vaatimustenmukaisuustaakka sisäisille tiimeille",
        "Johdonmukainen auditointivalmius ja valmistautuminen",
        "Parantunut vaatimustenmukaisuuden tehokkuus ja vaikuttavuus",
        "Vähentynyt sertifiointien umpeutumisen riski"
      ]
    },
    cta: {
      title: "Tehosta vaatimustenmukaisuustoimintaasi",
      subtitle: "Ota yhteyttä jo tänään keskustellaksesi vaatimustenmukaisuuden hallintatarpeistasi",
      primaryCTA: { text: "Aloita nyt", href: "/contact?service=compliance" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Overview Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-slate-50/50 rounded-2xl p-8 border border-slate-100">
      <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-4">{currentContent.overview.title}</h2>
      <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
      <p class="text-slate-600 leading-relaxed font-semibold text-blue-600">{currentContent.overview.highlight}</p>
    </div>
  </div>
</section>

<!-- Service Models Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.serviceModels.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.serviceModels.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6">
      {currentContent.serviceModels.items.map((model) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-bold text-slate-900 mb-2">{model.type}</h3>
          <p class="text-sm text-blue-600 font-medium mb-3">{model.commitment}</p>
          <p class="text-slate-600 text-sm">{model.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Frameworks Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.frameworks.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.frameworks.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {currentContent.frameworks.items.map((framework) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300">
          <p class="text-sm font-medium text-slate-700">{framework}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.features.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.features.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.features.items.map((feature) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={feature.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {feature.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables & Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12">
      
      <!-- Deliverables -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.deliverables.title}</h2>
        <ul class="space-y-3">
          {currentContent.deliverables.items.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Benefits -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.benefits.title}</h2>
        <ul class="space-y-3">
          {currentContent.benefits.items.map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="star" class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" />
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>