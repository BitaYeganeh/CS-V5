---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "GRC Platform Managed Service | Platform Administration & Optimization",
  description: "Expert GRC Platform Administration including workflow design, integrations, reporting, and user support for maximum platform ROI.",
  keywords: "GRC platform, managed service, platform administration, workflow design, integrations, compliance reporting, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "GRC Platform Managed Service",
      subtitle: "Platform Administration & Optimization",
      description: "Expert GRC Platform Administration services to maximize your platform investment with professional workflow design, integrations, and user support. Our GRC Platform Managed Service provides comprehensive administration of your Governance, Risk, and Compliance platforms, ensuring optimal configuration, user adoption, and business value delivery.",
      primaryCTA: { text: "Get Platform Support", href: "/contact?service=grc-platform" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Overview",
      description: "GRC platforms are powerful tools for managing governance, risk, and compliance, but they require expert configuration and ongoing administration to deliver value. Many organizations struggle with platform complexity, low user adoption, and suboptimal configurations.",
      highlight: "Our GRC Platform Managed Service provides dedicated platform expertise to handle administration, optimization, and user support, ensuring your investment delivers maximum business value and compliance effectiveness."
    },
    serviceAreas: {
      title: "GRC Service Areas",
      subtitle: "Comprehensive platform administration across all GRC domains",
      items: [
        { area: "Risk Management", description: "Risk register, assessments, treatment plans, monitoring" },
        { area: "Compliance Management", description: "Compliance frameworks, assessments, evidence collection" },
        { area: "Audit Management", description: "Audit planning, execution, findings tracking, remediation" },
        { area: "Policy Management", description: "Policy lifecycle, approval workflows, attestation tracking" }
      ]
    },
    platforms: {
      title: "Supported Platforms",
      subtitle: "Expert administration across leading GRC platforms and custom solutions",
      items: [
        "ServiceNow GRC",
        "RSA Archer",
        "MetricStream",
        "LogicGate",
        "Resolver",
        "SAP GRC",
        "Thomson Reuters",
        "Custom Solutions"
      ]
    },
    features: {
      title: "Our Platform Services",
      subtitle: "Comprehensive GRC platform management covering all aspects of administration and optimization",
      items: [
        { title: "Workflow Design & Management", description: "Custom workflow creation and optimization for risk assessments, audits, and compliance processes", icon: "flow" },
        { title: "System Integrations", description: "Integration with business systems, security tools, and third-party applications", icon: "network" },
        { title: "Reporting & Dashboards", description: "Executive dashboards, compliance reports, and risk analytics configuration", icon: "chart" },
        { title: "User Support & Training", description: "Comprehensive user support, training programs, and adoption facilitation", icon: "users" },
        { title: "Platform Optimization", description: "Continuous platform optimization and performance improvement initiatives", icon: "cog" },
        { title: "Data Management", description: "Data quality management, migration support, and backup strategies", icon: "database" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Platform configuration and setup",
        "Custom workflow development",
        "Integration architecture and implementation",
        "Executive dashboard and reporting suite",
        "User training and documentation",
        "Ongoing platform administration",
        "Performance monitoring and optimization",
        "Regular platform updates and maintenance"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Maximum ROI from GRC platform investment",
        "Expert configuration and optimization",
        "Reduced internal administration overhead",
        "Improved user adoption and satisfaction",
        "Enhanced compliance and reporting capabilities"
      ]
    },
    cta: {
      title: "Maximize Your GRC Platform ROI",
      subtitle: "Contact us today to optimize your GRC platform performance",
      primaryCTA: { text: "Get Started", href: "/contact?service=grc-platform" },
      secondaryCTA: { text: "Schedule Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "GRC-alustan hallintapalvelu",
      subtitle: "Alustan hallinta ja optimointi",
      description: "Asiantuntevat GRC-alustan hallintapalvelut maksimoidaksesi alustainvestoinnin ammattimaisella työnkulkusuunnittelulla, integraatioilla ja käyttäjä-tuella. GRC-alustan hallintapalvelumme tarjoaa kattavaa Governance-, Risk- ja Compliance-alustojesi hallintaa varmistaen optimaalisen konfiguroinnin, käyttäjien omaksumisen ja liiketoiminta-arvon toimituksen.",
      primaryCTA: { text: "Pyydä alustatukea", href: "/contact?service=grc-platform" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    overview: {
      title: "Yleiskatsaus",
      description: "GRC-alustat ovat tehokkaita työkaluja hallinnan, riskien ja vaatimustenmukaisuuden hallintaan, mutta ne vaativat asiantuntevaa konfigurointia ja jatkuvaa hallintaa tuottaakseen arvoa. Monet organisaatiot kamppailevat alustan monimutkaisuuden, alhaisen käyttäjien omaksumisen ja epäoptimaalisten konfigurointien kanssa.",
      highlight: "GRC-alustan hallintapalvelumme tarjoaa omistautunutta alustaosaamista hallintaan, optimointiin ja käyttäjätukeen varmistaen, että investointisi tuottaa maksimaalista liiketoiminta-arvoa ja vaatimustenmukaisuuden tehokkuutta."
    },
    serviceAreas: {
      title: "GRC-palvelualueet",
      subtitle: "Kattava alustahallinta kaikilla GRC-alueilla",
      items: [
        { area: "Riskienhallinta", description: "Riskirekisteri, arvioinnit, käsittelysuunnitelmat, seuranta" },
        { area: "Vaatimustenmukaisuuden hallinta", description: "Vaatimustenmukaisuuskehykset, arvioinnit, todisteiden keruu" },
        { area: "Auditointihallinta", description: "Auditoinnin suunnittelu, toteutus, havaintojen seuranta, korjaaminen" },
        { area: "Politiikkahallinta", description: "Politiikan elinkaari, hyväksyntätyönkulut, sitoutumisen seuranta" }
      ]
    },
    platforms: {
      title: "Tuetut alustat",
      subtitle: "Asiantunteva hallinta johtavien GRC-alustojen ja mukautettujen ratkaisujen parissa",
      items: [
        "ServiceNow GRC",
        "RSA Archer",
        "MetricStream",
        "LogicGate",
        "Resolver",
        "SAP GRC",
        "Thomson Reuters",
        "Mukautetut ratkaisut"
      ]
    },
    features: {
      title: "Alustapalvelumme",
      subtitle: "Kattava GRC-alustan hallinta, joka kattaa kaikki hallinnon ja optimoinnin näkökohdat",
      items: [
        { title: "Työnkulkujen suunnittelu ja hallinta", description: "Mukautettu työnkulkujen luominen ja optimointi riskiarviointeja, auditointeja ja vaatimustenmukaisuusprosesseja varten", icon: "flow" },
        { title: "Järjestelmäintegraatiot", description: "Integrointi liiketoimintajärjestelmiin, tietoturvatyökaluihin ja kolmannen osapuolen sovelluksiin", icon: "network" },
        { title: "Raportointi ja hallintapaneelit", description: "Johdon hallintapaneelit, vaatimustenmukaisuusraportit ja riskianalytiikan konfigurointi", icon: "chart" },
        { title: "Käyttäjätuki ja koulutus", description: "Kattava käyttäjätuki, koulutusohjelmat ja käyttöönoton helpottaminen", icon: "users" },
        { title: "Alustan optimointi", description: "Jatkuva alustan optimointi ja suorituskyvyn parantamishankkeet", icon: "cog" },
        { title: "Tietojen hallinta", description: "Tietojen laadun hallinta, siirtotuki ja varmuuskopiointistrategiat", icon: "database" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Alustan konfigurointi ja asennus",
        "Mukautettu työnkulkukehitys",
        "Integraatioarkkitehtuuri ja toteutus",
        "Johdon hallintapaneeli ja raportointikokonaisuus",
        "Käyttäjäkoulutus ja dokumentaatio",
        "Jatkuva alustan hallinta",
        "Suorituskyvyn seuranta ja optimointi",
        "Säännölliset alustan päivitykset ja ylläpito"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Maksimaalinen sijoitetun pääoman tuotto GRC-alustasta",
        "Asiantunteva konfigurointi ja optimointi",
        "Vähentynyt sisäinen hallintotyö",
        "Parantunut käyttäjien omaksuminen ja tyytyväisyys",
        "Tehostetut vaatimustenmukaisuus- ja raportointikyvykkyydet"
      ]
    },
    cta: {
      title: "Maksimoi GRC-alustasi sijoitetun pääoman tuotto",
      subtitle: "Ota yhteyttä jo tänään optimoidaksesi GRC-alustasi suorituskyvyn",
      primaryCTA: { text: "Aloita nyt", href: "/contact?service=grc-platform" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Overview Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-slate-50/50 rounded-2xl p-8 border border-slate-100">
      <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-4">{currentContent.overview.title}</h2>
      <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
      <p class="text-slate-600 leading-relaxed font-semibold text-blue-600">{currentContent.overview.highlight}</p>
    </div>
  </div>
</section>

<!-- Service Areas Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.serviceAreas.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.serviceAreas.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 gap-6">
      {currentContent.serviceAreas.items.map((area) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-bold text-slate-900 mb-2">{area.area}</h3>
          <p class="text-slate-500 text-sm">{area.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Platforms Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.platforms.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.platforms.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {currentContent.platforms.items.map((platform) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300">
          <p class="text-sm font-medium text-slate-700">{platform}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.features.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.features.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.features.items.map((feature) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={feature.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {feature.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables & Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12">
      
      <!-- Deliverables -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.deliverables.title}</h2>
        <ul class="space-y-3">
          {currentContent.deliverables.items.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Benefits -->
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">{currentContent.benefits.title}</h2>
        <ul class="space-y-3">
          {currentContent.benefits.items.map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="star" class="w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0" />
              <span class="text-slate-600 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>