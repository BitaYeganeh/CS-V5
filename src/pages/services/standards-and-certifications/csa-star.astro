---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "CSA STAR Cloud Security Certification | Cloud Security Assurance",
  description: "Comprehensive CSA STAR certification for cloud security assurance. Demonstrate cloud security excellence with Level 1, 2, and 3 CSA STAR certification programs.",
  keywords: "CSA STAR, cloud security certification, cloud security assurance, CCM, CAIQ, cloud compliance, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "CSA STAR Cloud Security Certification",
      subtitle: "Cloud Security Assurance",
      description: "Cloud security assurance through CSA STAR certification levels 1-3. Demonstrate comprehensive cloud security excellence and build customer trust with globally recognized cloud security certification.",
      primaryCTA: { text: "Achieve CSA STAR Certification", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services" }
    },
    levels: {
      title: "CSA STAR Certification Levels",
      subtitle: "Progressive certification levels that demonstrate increasing maturity and assurance in cloud security management.",
      items: [
        {
          level: "1",
          title: "CSA STAR Level 1",
          subtitle: "Self-Assessment",
          description: "Open self-assessment based on Cloud Controls Matrix (CCM) and Consensus Assessments Initiative Questionnaire (CAIQ).",
          features: ["Free registration and assessment", "Public registry listing", "CCM-based control documentation", "CAIQ questionnaire completion"],
          color: "green"
        },
        {
          level: "2",
          title: "CSA STAR Level 2",
          subtitle: "Third-Party Assessment",
          description: "Independent third-party assessment based on ISO/IEC 27001 or SOC 2 frameworks with CCM integration.",
          features: ["Independent auditor assessment", "ISO 27001 or SOC 2 based", "CCM controls mapping", "Annual recertification"],
          color: "blue"
        },
        {
          level: "3",
          title: "CSA STAR Level 3",
          subtitle: "Continuous Monitoring",
          description: "Continuous monitoring-based assessment demonstrating real-time security posture and maturity.",
          features: ["Continuous monitoring program", "Real-time security metrics", "Maturity model assessment", "Enhanced public disclosure"],
          color: "purple"
        }
      ]
    },
    benefits: {
      title: "Why Choose CSA STAR Certification?",
      subtitle: "Demonstrate cloud security excellence and build customer confidence with globally recognized cloud security certification.",
      items: [
        { title: "Industry Recognition", description: "Globally recognized certification that demonstrates cloud security leadership and best practices.", icon: "shield-check" },
        { title: "Customer Confidence", description: "Build customer trust through transparent security assessments and public registry listings.", icon: "users" },
        { title: "Competitive Advantage", description: "Differentiate your cloud services with verified security capabilities and transparent reporting.", icon: "trending-up" },
        { title: "Security Maturity", description: "Progressive certification levels demonstrate continuous improvement in cloud security maturity.", icon: "chart-line" },
        { title: "Compliance Alignment", description: "Align with regulatory requirements and industry standards through comprehensive security frameworks.", icon: "document-check" },
        { title: "Cloud-Native Focus", description: "Purpose-built for cloud environments with controls specifically designed for cloud security challenges.", icon: "cloud" }
      ]
    },
    process: {
      title: "CSA STAR Implementation Process",
      subtitle: "Structured approach to achieving CSA STAR certification across all levels.",
      steps: [
        { step: "1", title: "Current State Assessment", description: "Evaluate existing cloud security controls against CCM framework and identify gaps." },
        { step: "2", title: "Level Strategy Planning", description: "Determine appropriate CSA STAR level and develop implementation roadmap." },
        { step: "3", title: "Controls Implementation", description: "Implement required security controls and documentation aligned with CCM requirements." },
        { step: "4", title: "Certification & Maintenance", description: "Complete certification process and establish ongoing maintenance and monitoring programs." }
      ]
    },
    services: {
      title: "Comprehensive CSA STAR Services",
      items: [
        {
          title: "Assessment & Certification Support",
          icon: "clipboard",
          features: ["CCM controls gap analysis", "CAIQ questionnaire completion", "Level 2 third-party assessment coordination", "Level 3 continuous monitoring design", "Registry submission support"]
        },
        {
          title: "Ongoing Maintenance & Improvement",
          icon: "refresh-cw",
          features: ["Annual recertification support", "Security metrics monitoring", "CCM updates implementation", "Maturity progression planning", "Customer communication support"]
        }
      ]
    },
    frameworks: {
      title: "Framework Integration",
      subtitle: "CSA STAR integrates seamlessly with existing security frameworks and standards.",
      items: [
        { title: "ISO 27001", icon: "shield" },
        { title: "SOC 2", icon: "document" },
        { title: "NIST Framework", icon: "target" },
        { title: "GDPR Compliance", icon: "lock-closed" }
      ]
    },
    cta: {
      title: "Achieve CSA STAR Cloud Security Excellence",
      subtitle: "Demonstrate comprehensive cloud security capabilities and build customer trust with CSA STAR certification.",
      primaryCTA: { text: "Start CSA STAR Journey", href: "/contact" },
      secondaryCTA: { text: "Learn More About Us", href: "/about" }
    }
  },
  fi: {
    hero: {
      title: "CSA STAR Pilvipalveluiden turvallisuussertifiointi",
      subtitle: "Pilvipalveluiden turvallisuusvarmennus",
      description: "Pilvipalveluiden turvallisuusvarmennus CSA STAR -sertifiointitasojen 1-3 kautta. Osoita kattavaa pilvipalveluiden turvallisuuden huippuosaamista ja rakenna asiakasluottamusta maailmanlaajuisesti tunnetulla pilvipalveluiden turvallisuussertifioinnilla.",
      primaryCTA: { text: "Saavuta CSA STAR -sertifiointi", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services" }
    },
    levels: {
      title: "CSA STAR -sertifiointitasot",
      subtitle: "Progressiiviset sertifiointitasot, jotka osoittavat kasvavaa kypsyyttä ja varmuutta pilvipalveluiden turvallisuuden hallinnassa.",
      items: [
        {
          level: "1",
          title: "CSA STAR -taso 1",
          subtitle: "Oma-arviointi",
          description: "Avoin oma-arviointi, joka perustuu Cloud Controls Matrix (CCM) -menetelmään ja Consensus Assessments Initiative Questionnaire (CAIQ) -kyselyyn.",
          features: ["Ilmainen rekisteröinti ja arviointi", "Julkinen rekisterilistaus", "CCM-pohjainen kontrollidokumentaatio", "CAIQ-kyselylomakkeen täyttö"],
          color: "green"
        },
        {
          level: "2",
          title: "CSA STAR -taso 2",
          subtitle: "Kolmannen osapuolen arviointi",
          description: "Riippumaton kolmannen osapuolen arviointi, joka perustuu ISO/IEC 27001 tai SOC 2 -kehyksiin CCM-integraatiolla.",
          features: ["Riippumaton auditoijan arviointi", "ISO 27001 tai SOC 2 -pohjainen", "CCM-kontrollien kartoitus", "Vuotuinen uudelleensertifiointi"],
          color: "blue"
        },
        {
          level: "3",
          title: "CSA STAR -taso 3",
          subtitle: "Jatkuva seuranta",
          description: "Jatkuvaan seurantaan perustuva arviointi, joka osoittaa reaaliaikaista turvallisuustilaa ja kypsyyttä.",
          features: ["Jatkuva seurantaohjelma", "Reaaliaikaiset turvallisuusmittarit", "Kypsyysmallin arviointi", "Tehostettu julkinen tiedottaminen"],
          color: "purple"
        }
      ]
    },
    benefits: {
      title: "Miksi valita CSA STAR -sertifiointi?",
      subtitle: "Osoita pilvipalveluiden turvallisuuden huippuosaamista ja rakenna asiakasluottamusta maailmanlaajuisesti tunnetulla pilvipalveluiden turvallisuussertifioinnilla.",
      items: [
        { title: "Toimialan tunnustus", description: "Globaalisti tunnustettu sertifiointi, joka osoittaa pilvipalveluiden turvallisuuden johtajuutta ja parhaita käytäntöjä.", icon: "shield-check" },
        { title: "Asiakasluottamus", description: "Rakenna asiakasluottamusta läpinäkyvien turvallisuusarviointien ja julkisten rekisterilistausten avulla.", icon: "users" },
        { title: "Kilpailuetu", description: "Erota pilvipalvelusi varmennetuilla turvallisuuskyvykkyyksillä ja läpinäkyvällä raportoinnilla.", icon: "trending-up" },
        { title: "Turvallisuuden kypsyys", description: "Progressiiviset sertifiointitasot osoittavat jatkuvaa parannusta pilvipalveluiden turvallisuuden kypsyydessä.", icon: "chart-line" },
        { title: "Vaatimustenmukaisuuden yhdenmukaistaminen", description: "Yhdenmukaista sääntelyvaatimusten ja toimialastandardien kanssa kattavien turvallisuuskehysten avulla.", icon: "document-check" },
        { title: "Pilvipalvelulähtöinen fokus", description: "Erityisesti pilviympäristöjä varten suunniteltu kontrolleilla, jotka on suunniteltu erityisesti pilvipalveluiden turvallisuushaasteisiin.", icon: "cloud" }
      ]
    },
    process: {
      title: "CSA STAR -toteutusprosessi",
      subtitle: "Rakenteinen lähestymistapa CSA STAR -sertifioinnin saavuttamiseksi kaikilla tasoilla.",
      steps: [
        { step: "1", title: "Nykytilan arviointi", description: "Arvioi olemassa olevat pilvipalveluiden turvallisuuskontrollit CCM-kehystä vastaan ja tunnista puutteet." },
        { step: "2", title: "Tasostrategian suunnittelu", description: "Määritä sopiva CSA STAR -taso ja kehitä toteutuksen tiekartta." },
        { step: "3", title: "Kontrollien toteutus", description: "Toteuta vaaditut turvallisuuskontrollit ja dokumentaatio CCM-vaatimusten mukaisesti." },
        { step: "4", title: "Sertifiointi ja ylläpito", description: "Suorita sertifiointiprosessi ja perusta jatkuvat ylläpito- ja seurantaohjelmat." }
      ]
    },
    services: {
      title: "Kattavat CSA STAR -palvelut",
      items: [
        {
          title: "Arviointi- ja sertifiointituki",
          icon: "clipboard",
          features: ["CCM-kontrollien aukkoanalyysi", "CAIQ-kyselylomakkeen täyttö", "Tason 2 kolmannen osapuolen arvioinnin koordinointi", "Tason 3 jatkuvan seurannan suunnittelu", "Rekisteriin ilmoittamisen tuki"]
        },
        {
          title: "Jatkuva ylläpito ja parantaminen",
          icon: "refresh-cw",
          features: ["Vuotuinen uudelleensertifioinnin tuki", "Turvallisuusmittareiden seuranta", "CCM-päivitysten toteutus", "Kypsyyden kehityssuunnittelu", "Asiakasviestinnän tuki"]
        }
      ]
    },
    frameworks: {
      title: "Kehysintegraatio",
      subtitle: "CSA STAR integroituu saumattomasti olemassa oleviin turvallisuuskehyksiin ja -standardeihin.",
      items: [
        { title: "ISO 27001", icon: "shield" },
        { title: "SOC 2", icon: "document" },
        { title: "NIST Framework", icon: "target" },
        { title: "GDPR-vaatimustenmukaisuus", icon: "lock-closed" }
      ]
    },
    cta: {
      title: "Saavuta CSA STAR -pilvipalveluiden turvallisuuden huippuosaaminen",
      subtitle: "Osoita kattavat pilvipalveluiden turvallisuuskyvykkyydet ja rakenna asiakasluottamusta CSA STAR -sertifioinnilla.",
      primaryCTA: { text: "Aloita CSA STAR -matka", href: "/contact" },
      secondaryCTA: { text: "Tutustu meihin paremmin", href: "/about" }
    }
  }
};

const currentContent = content[lang];

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="cloud" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- CSA STAR Levels Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.levels.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.levels.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.levels.items.map((level) => (
        <div class={`bg-slate-50/50 rounded-xl border border-slate-100 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 ${getLevelColor(level.color)} p-6 group`}>
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <span class={`text-xl font-bold ${getIconColor(level.color)} group-hover:text-white transition-colors duration-300`}>
                {level.level}
              </span>
            </div>
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 mb-1 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {level.title}
          </h3>
          <p class={`text-sm font-semibold ${getIconColor(level.color)} mb-3 text-left`}>{level.subtitle}</p>
          <p class="text-slate-500 text-sm leading-relaxed mb-4 text-left">{level.description}</p>
          
          <ul class="space-y-1.5">
            {level.features.map((feature) => (
              <li class="flex items-start text-xs text-slate-500">
                <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.benefits.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.benefits.items.map((benefit) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={benefit.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {benefit.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {benefit.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Implementation Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-4 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Services Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.services.title}
      </h2>
    </div>
    
    <div class="grid md:grid-cols-2 gap-8">
      {currentContent.services.items.map((service) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={service.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {service.title}
          </h3>
          
          <ul class="space-y-2">
            {service.features.map((feature) => (
              <li class="flex items-start text-sm text-slate-600">
                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Framework Integration Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.frameworks.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.frameworks.subtitle}
      </p>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {currentContent.frameworks.items.map((framework) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    group">
          
          <div class="flex justify-center mb-3">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6]">
              <Icon name={framework.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-sm font-semibold text-slate-800 group-hover:text-blue-700 transition-colors duration-300">
            {framework.title}
          </h3>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

