---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Policy Development and Governance | Security Policy Library",
  description: "Unified policy library, ownership, and governance that meets ISO 27001, NIS2, SOC 2, and GDPR. Comprehensive policy development services.",
  keywords: "policy development, governance, security policies, ISO 27001, NIS2, SOC 2, GDPR, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Policy Development and Governance",
      subtitle: "Unified Security Policy Library",
      description: "Unified policy library, ownership, and governance that meets ISO 27001, NIS2, SOC 2, and GDPR. Comprehensive policy development services for your organization.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    policies: {
      title: "Core Policies",
      subtitle: "Comprehensive policy library that meets international standards and regulations.",
      items: [
        { title: "Information Security Policy", description: "High-level information security principles and objectives", icon: "document" },
        { title: "Access Control Policy", description: "Access rights management and monitoring", icon: "user" },
        { title: "Cryptography Policy", description: "Encryption requirements and key management", icon: "lock" },
        { title: "Cloud Security Policy", description: "Cloud service security requirements", icon: "cloud" },
        { title: "Supplier Management Policy", description: "Third-party risk management", icon: "building" },
        { title: "Incident Response Policy", description: "Security incident handling", icon: "alert" }
      ]
    },
    governance: {
      title: "Governance Model",
      subtitle: "Clear roles, responsibilities and processes for policy lifecycle management.",
      items: [
        { title: "Roles and Responsibilities", description: "Policy ownership and maintenance responsibility", icon: "users" },
        { title: "Update Cycle", description: "Regular reviews and updates", icon: "calendar" },
        { title: "Training and Communication", description: "Staff training and communication", icon: "book-open" },
        { title: "Compliance Monitoring", description: "Policy compliance monitoring", icon: "shield-check" }
      ]
    },
    categories: {
      title: "Policy Categories",
      subtitle: "Structured approach to comprehensive policy library.",
      items: [
        { title: "Organizational", items: ["Information Security Policy", "Risk Management Policy", "Business Continuity", "Personnel Security Policy"] },
        { title: "Technical Policies", items: ["Access Control Policy", "Cryptography Policy", "Network Security Policy", "Anti-malware Policy"] },
        { title: "Operational Policies", items: ["Incident Response Policy", "Change Management", "Backup Policy", "Monitoring Policy"] }
      ]
    },
    process: {
      title: "Development Process",
      subtitle: "Systematic approach to policy development and maintenance.",
      steps: [
        { step: "1", title: "Framework", description: "Select framework and scope" },
        { step: "2", title: "Drafts", description: "Draft policies and ownership" },
        { step: "3", title: "Approval", description: "Management approval and publishing" },
        { step: "4", title: "Rollout", description: "Training and rollout" },
        { step: "5", title: "Maintenance", description: "Periodic updates" }
      ]
    },
    cta: {
      title: "Need a policy library?",
      subtitle: "Get ready-made templates and rollout – request a demo.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "Policy Development and Governance",
      subtitle: "Yhtenäinen turvallisuuspolitiikkakirjasto",
      description: "Yhtenäinen politiikkakirjasto, omistajuudet ja hallintamalli, joka täyttää standardit (ISO 27001, NIS2, SOC 2, GDPR). Kattavat politiikan kehityspalvelut organisaatiollesi.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    policies: {
      title: "Keskeisimmät politiikat",
      subtitle: "Kattava politiikkakirjasto, joka täyttää kansainväliset standardit ja säädökset.",
      items: [
        { title: "Tietoturvapolitiikka", description: "Ylätason tietoturvaperiaatteet ja tavoitteet", icon: "document" },
        { title: "Käyttöoikeuspolitiikka", description: "Käyttöoikeuksien hallinta ja valvonta", icon: "user" },
        { title: "Salauspolitiikka", description: "Salausvaatimukset ja avainten hallinta", icon: "lock" },
        { title: "Pilvipolitiikka", description: "Pilvipalveluiden turvallisuusvaatimukset", icon: "cloud" },
        { title: "Toimittajahallinnan politiikka", description: "Kolmannen osapuolen riskienhallinta", icon: "building" },
        { title: "Vikatilanteiden hallinta", description: "Tietoturvapoikkeamien käsittely", icon: "alert" }
      ]
    },
    governance: {
      title: "Hallintamalli",
      subtitle: "Selkeät roolit, vastuut ja prosessit politiikkojen elinkaaren hallintaan.",
      items: [
        { title: "Roolit ja vastuut", description: "Politiikkojen omistajuus ja ylläpitovastuu", icon: "users" },
        { title: "Päivityssykli", description: "Säännölliset katselmukset ja päivitykset", icon: "calendar" },
        { title: "Koulutus ja viestintä", description: "Henkilöstön koulutus ja tiedottaminen", icon: "book-open" },
        { title: "Compliance-seuranta", description: "Politiikkojen noudattamisen valvonta", icon: "shield-check" }
      ]
    },
    categories: {
      title: "Politiikkakategoriat",
      subtitle: "Strukturoitu lähestymistapa kattavaan politiikkakirjastoon.",
      items: [
        { title: "Organisaatioon liittyvät", items: ["Tietoturvapolitiikka", "Riskienhallintapolitiikka", "Liiketoiminnan jatkuvuus", "Henkilöstöturvapolitiikka"] },
        { title: "Tekniset politiikat", items: ["Käyttöoikeuspolitiikka", "Salauspolitiikka", "Verkkoturvapolitiikka", "Haittaohjelmien torjunta"] },
        { title: "Operatiiviset politiikat", items: ["Vikatilanteiden hallinta", "Muutoshallinta", "Varmuuskopiointipolitiikka", "Valvontapolitiikka"] }
      ]
    },
    process: {
      title: "Kehitysprosessi",
      subtitle: "Systemaattinen lähestymistapa politiikkojen kehittämiseen ja ylläpitoon.",
      steps: [
        { step: "1", title: "Kehys", description: "Valitaan viitekehys ja laajuus" },
        { step: "2", title: "Luonnokset", description: "Luodaan politiikat ja omistajuudet" },
        { step: "3", title: "Hyväksyntä", description: "Johdon hyväksyntä ja julkaisu" },
        { step: "4", title: "Käyttöönotto", description: "Koulutus ja jalkautus" },
        { step: "5", title: "Ylläpito", description: "Säännölliset päivitykset" }
      ]
    },
    cta: {
      title: "Tarvitsetko politiikkakirjaston?",
      subtitle: "Saat valmiit mallit ja jalkautuksen – pyydä demo.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Policies Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.policies.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.policies.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.policies.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Governance Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.governance.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.governance.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-4 gap-8">
      {currentContent.governance.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-6 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="flex justify-center mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Categories Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.categories.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.categories.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.categories.items.map((cat, index) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-10 h-10 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-lg flex items-center justify-center text-white font-bold mb-4">
            {index + 1}
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors duration-300">
            {cat.title}
          </h3>
          
          <ul class="space-y-2">
            {cat.items.map((item) => (
              <li class="flex items-start text-sm text-slate-600">
                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>