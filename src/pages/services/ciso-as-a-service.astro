---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "CISO-as-a-Service | Fractional Chief Information Security Officer",
  description: "Flexible, senior Fractional CISO to build strategy, governance, and execution for your cybersecurity program. Cost-effective fractional model with rapid maturity uplift.",
  keywords: "CISO as a service, fractional CISO, virtual CISO, security strategy, cybersecurity leadership, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "CISO-as-a-Service",
      subtitle: "Fractional Chief Information Security Officer",
      description: "Flexible, senior Fractional CISO to build strategy, governance, and execution for your cybersecurity program. The impact of a full-time CISO delivered in a flexible, fractional model – strategy, governance and hands-on execution from a single partner.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    offerings: {
      title: "Our Services",
      subtitle: "Comprehensive security leadership coverage",
      items: [
        { title: "Security Strategy", description: "Risk-based security roadmap and prioritization", icon: "shield" },
        { title: "Policies and Governance", description: "Policy library, ownership and approval processes", icon: "document" },
        { title: "Risk Management", description: "ISO 27005/NIST based risk identification and treatment", icon: "chart" },
        { title: "Monitoring and Metrics", description: "KPI/KRI, executive reporting and continuous improvement", icon: "eye" },
        { title: "Regulatory and Audits", description: "NIS2, DORA, GDPR, SOC 2 and ISO 27001 compliance", icon: "building" }
      ]
    },
    process: {
      title: "Engagement Process",
      subtitle: "A clear, iterative model that delivers outcomes from month one.",
      steps: [
        { step: "1", title: "Discovery", description: "Assess current state and objectives" },
        { step: "2", title: "Roadmap", description: "12-18 month program and priorities" },
        { step: "3", title: "Execution", description: "Policies, controls and processes" },
        { step: "4", title: "Metrics", description: "KPIs/KRIs and executive reporting" },
        { step: "5", title: "Continuous Improvement", description: "Quarterly reviews and tuning" }
      ]
    },
    benefits: {
      title: "Benefits",
      items: [
        "Fast access to senior CISO expertise",
        "Cost-effective fractional model",
        "Rapid maturity uplift",
        "Executive visibility and accountability",
        "Meet compliance requirements"
      ]
    },
    cta: {
      title: "Ready to start CISO-as-a-Service?",
      subtitle: "Book a conversation – we will propose a tailored, fast start plan.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "CISO-as-a-Service",
      subtitle: "Osa-aikainen tietoturvapäällikkö",
      description: "Joustava ja kokenut CISO-palvelu (osa-aikainen), joka rakentaa kyberturvan strategian, hallintamallin ja käytännön toteutuksen. Kokopäiväisen CISO:n vaikutus osa-aikaisella ja joustavalla mallilla – strategia, hallintamalli ja käytännön toteutus yhden kumppanin kautta.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    offerings: {
      title: "Palvelumme",
      subtitle: "Kattava tietoturvajohtamisen kattavuus",
      items: [
        { title: "Kyberturvastrategia", description: "Riskiperusteinen kyberturvan tiekartta ja priorisointi", icon: "shield" },
        { title: "Politiikat ja hallintamalli", description: "Politiikkakirjasto, omistajuudet ja hyväksymisprosessit", icon: "document" },
        { title: "Riskienhallinta", description: "ISO 27005/NIST-pohjainen riskien tunnistus ja käsittely", icon: "chart" },
        { title: "Valvonta ja mittarit", description: "KPI/KRI-mittarit, johdon raportointi ja jatkuva parantaminen", icon: "eye" },
        { title: "Sääntely ja auditit", description: "NIS2, DORA, GDPR, SOC 2 ja ISO 27001 -yhteensopivuus", icon: "building" }
      ]
    },
    process: {
      title: "Toimintamalli",
      subtitle: "Selkeä, iteratiivinen malli, joka tuottaa tuloksia ensimmäisestä kuukaudesta alkaen.",
      steps: [
        { step: "1", title: "Alkukartoitus", description: "Nykytilan arviointi ja tavoitteet" },
        { step: "2", title: "Tiekartta", description: "12–18 kk ohjelma ja prioriteetit" },
        { step: "3", title: "Toteutus", description: "Politiikat, kontrollit ja prosessit" },
        { step: "4", title: "Mittarit", description: "KPI/KRI ja johtoryhmäraportointi" },
        { step: "5", title: "Jatkuva kehitys", description: "Kausittaiset katselmoinnit" }
      ]
    },
    benefits: {
      title: "Hyödyt",
      items: [
        "Nopea pääsy kokeneeseen CISO-osaamiseen",
        "Kustannustehokas osa-aikainen malli",
        "Nopea kypsyystason nosto",
        "Johdon läpinäkyvyys ja vastuullisuus",
        "Yhteensopivuusvaatimusten täyttäminen"
      ]
    },
    cta: {
      title: "Aloitetaanko CISO-palvelu?",
      subtitle: "Varaa keskustelu – esitämme ehdotuksen ja nopean etenemissuunnitelman.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Offerings Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.offerings.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.offerings.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.offerings.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {currentContent.benefits.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    flex items-center gap-3">
          <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <span class="text-slate-700 text-sm">{item}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>