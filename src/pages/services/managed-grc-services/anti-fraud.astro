---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Anti-Fraud Services | BEC Protection & Payment Fraud Prevention",
  description: "Reduce fraud losses with pragmatic controls for BEC/invoice fraud, payment controls, and detection and response. Comprehensive fraud prevention for Finnish organizations.",
  keywords: "anti-fraud, BEC protection, invoice fraud prevention, payment fraud detection, fraud prevention Finland, business email compromise",
  type: "service" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Anti-Fraud Services",
    "provider": {
      "@type": "Organization",
      "name": "Cyber Security Finland"
    },
    "description": "Reduce fraud losses with pragmatic controls for BEC/invoice fraud, payment controls, and detection and response.",
    "serviceType": "Fraud Prevention"
  }
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Anti-Fraud Services",
      subtitle: "BEC Protection & Payment Fraud Prevention",
      description: "Reduce fraud losses with pragmatic controls for BEC/invoice fraud, payment controls, and detection and response. Protect your organization from BEC fraud, invoice fraud, and payment fraud with multi-layered controls and real-time detection.",
      primaryCTA: { text: "Assess Risk Level", href: "/contact" },
      secondaryCTA: { text: "Explore Solution", href: "/demo" }
    },
    
    fraudTypes: {
      title: "Key Fraud Types",
      subtitle: "Identify and understand the most common fraud types threatening organizations today",
      items: [
        { title: "Email Fraud (BEC)", description: "Business Email Compromise and CEO fraud", risk: "Average €175k loss", icon: "mail" },
        { title: "Invoice Fraud", description: "Falsification and vendor data manipulation", risk: "Often undetected", icon: "file-text" },
        { title: "Payment Fraud", description: "Payment system manipulation", risk: "Rapid loss accumulation", icon: "credit-card" },
        { title: "Identity Fraud", description: "Identity misuse and impersonation", risk: "Reputation and legal risks", icon: "user-x" }
      ]
    },
    
    defense: {
      title: "Three-Layer Defense Strategy",
      subtitle: "Comprehensive approach to fraud prevention through technology, processes, and people",
      layers: [
        { title: "Technology Controls", icon: "shield", controls: ["Email security", "MFA enforcement", "Payment validation", "Anomaly detection"] },
        { title: "Process Controls", icon: "settings", controls: ["Four-eyes principle", "Approval limits", "Vendor verification", "Change management"] },
        { title: "Human Controls", icon: "users", controls: ["Awareness training", "Phishing simulations", "Reporting channels", "Role definition"] }
      ]
    },
    
    detection: {
      title: "Detection Methods",
      subtitle: "Advanced analytical methods for early detection of fraudulent activities",
      methods: [
        { title: "Real-time Detection", description: "Automated alerts for suspicious activities", icon: "search", items: ["Email analysis", "Payment anomalies", "Behavioral patterns", "Geolocation tracking"] },
        { title: "Trend Analysis", description: "Long-term pattern recognition", icon: "activity", items: ["Vendor analytics", "Payment behavior", "Timing analysis", "Volume changes"] },
        { title: "Forensic Analysis", description: "Deep investigation of fraud cases", icon: "database", items: ["Digital forensics", "Data mining", "Network analysis", "Timeline reconstruction"] }
      ]
    },
    
    response: {
      title: "Response Framework",
      subtitle: "Rapid and systematic response to minimize fraud impact",
      phases: [
        { title: "Detection", time: "0-15 min", actions: ["Automatic alert", "Event classification", "Initial assessment", "Escalation"] },
        { title: "Containment", time: "15-60 min", actions: ["Payment freeze", "Account suspension", "Access blocking", "Evidence preservation"] },
        { title: "Investigation", time: "1-24 h", actions: ["Forensic analysis", "Impact assessment", "Root cause analysis", "Reporting"] },
        { title: "Recovery", time: "1-7 days", actions: ["Operations restore", "Control enhancement", "Process updates", "Lessons learned"] }
      ]
    },
    
    metrics: {
      title: "Target Metrics",
      subtitle: "Measurable outcomes from implementing effective anti-fraud program",
      items: [
        { metric: "Fraud Loss Reduction", target: "-85% annually" },
        { metric: "Detection Time", target: "<15 minutes" },
        { metric: "False Positives", target: "<5% of alerts" },
        { metric: "Staff Awareness", target: "95% trained" }
      ]
    },
    
    cta: {
      title: "Protect Your Organization from Fraud?",
      subtitle: "Start planning and implementing your anti-fraud program with experts.",
      primaryCTA: { text: "Contact Us", href: "/contact" },
      secondaryCTA: { text: "Request Risk Assessment", href: "/contact?assessment=true" }
    }
  },
  
  fi: {
    hero: {
      title: "Petostentorjuntapalvelut",
      subtitle: "BEC-suojaus & maksupetosten torjunta",
      description: "Vähennä petostappioita pragmaattisilla kontrolleilla BEC/laskupetoksiin, maksukontrolleilla ja tunnistuksella. Suojaa organisaatiosi BEC-petoksilta, laskupetoksilta ja maksupetoksilta monipuolisilla kontrolleilla ja reaaliaikaisella tunnistuksella.",
      primaryCTA: { text: "Arvioi riskitaso", href: "/contact" },
      secondaryCTA: { text: "Tutustu ratkaisuun", href: "/demo" }
    },
    
    fraudTypes: {
      title: "Tärkeimmät petostyypit",
      subtitle: "Tunnista ja ymmärrä yleisimmät petostyypit, jotka uhkaavat organisaatioita tänään",
      items: [
        { title: "Sähköpostipetokset (BEC)", description: "Business Email Compromise ja CEO-petokset", risk: "Keskimäärin €175k tappio", icon: "mail" },
        { title: "Laskupetokset", description: "Väärennökset ja toimittajatietojen manipulointi", risk: "Usein huomaamaton", icon: "file-text" },
        { title: "Maksupetokset", description: "Maksujärjestelmien väärinkäyttö", risk: "Nopea tappioiden kertyminen", icon: "credit-card" },
        { title: "Identiteettipetokset", description: "Henkilöllisyyksien väärinkäyttö", risk: "Maine- ja lakihaasteet", icon: "user-x" }
      ]
    },
    
    defense: {
      title: "Kolmikerroksinen puolustusstrategia",
      subtitle: "Kattava lähestymistapa petostentorjuntaan teknologian, prosessien ja ihmisten kautta",
      layers: [
        { title: "Teknologiakontrollit", icon: "shield", controls: ["Email-turvallisuus", "MFA-pakotus", "Maksujen validointi", "Anomalian tunnistus"] },
        { title: "Prosessikontrollit", icon: "settings", controls: ["Nelisilmäperiaate", "Hyväksymisrajat", "Toimittajien verifiointi", "Muutosten hallinta"] },
        { title: "Inhimilliset kontrollit", icon: "users", controls: ["Tietoisuuskoulutus", "Phishing-simulaatiot", "Ilmoituskanavat", "Vastuiden määrittely"] }
      ]
    },
    
    detection: {
      title: "Tunnistusmenetelmät",
      subtitle: "Edistyneet analyysimenetelmät petostoiminnan varhaiseen tunnistamiseen",
      methods: [
        { title: "Reaaliaikainen tunnistus", description: "Automaattiset hälytykset epäilyttävistä tapahtumista", icon: "search", items: ["Sähköpostianalyysi", "Maksupoikkeamat", "Käyttäytymismallit", "Geolokation seuranta"] },
        { title: "Trendianalyysi", description: "Pitkän aikavälin mallien tunnistaminen", icon: "activity", items: ["Toimittaja-analyysit", "Maksukäyttäytyminen", "Ajankohta-analyysi", "Volyymimuutokset"] },
        { title: "Forensinen analyysi", description: "Syvällinen petostapausten tutkinta", icon: "database", items: ["Digitaalinen forensiikka", "Tiedonlouhinta", "Verkostoanalyysi", "Aikajanarekonstruktio"] }
      ]
    },
    
    response: {
      title: "Vastetoimintakehys",
      subtitle: "Nopea ja järjestelmällinen vastetoiminta petostapausten minimoimiseksi",
      phases: [
        { title: "Tunnistaminen", time: "0-15 min", actions: ["Automaattinen hälytys", "Tapahtuman luokittelu", "Alustava arviointi", "Eskalointi"] },
        { title: "Eristäminen", time: "15-60 min", actions: ["Maksun pysäytys", "Tilin sulkeminen", "Pääsyn estäminen", "Evidenssin säilytys"] },
        { title: "Tutkinta", time: "1-24 h", actions: ["Forensinen analyysi", "Vaikutusarvio", "Juurisyyn analyysi", "Raportointi"] },
        { title: "Palautus", time: "1-7 päivää", actions: ["Toiminnan palautus", "Kontrollien vahvistus", "Prosessien päivitys", "Oppimispisteet"] }
      ]
    },
    
    metrics: {
      title: "Tavoitemittarit",
      subtitle: "Mitattavat tulokset tehokkaan petostentorjuntaohjelman käyttöönotosta",
      items: [
        { metric: "Petostappioiden vähennys", target: "-85% vuodessa" },
        { metric: "Tunnistusaika", target: "<15 minuuttia" },
        { metric: "Väärät hälytykset", target: "<5% hälytyksistä" },
        { metric: "Henkilöstön tietoisuus", target: "95% koulutetuista" }
      ]
    },
    
    cta: {
      title: "Suojaa organisaatiosi petoksilta?",
      subtitle: "Aloita petostentorjuntaohjelman suunnittelu ja toteutus asiantuntijoiden kanssa.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Pyydä riskiarvio", href: "/contact?assessment=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered without image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28 relative overflow-hidden">
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-tight">
      <div>Page Title</div>
      <div class="mt-2">
        <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">Page Subtitle</span>
      </div>
    </h1>
    
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed mb-10">
      Page description text here...
    </p>
    
    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href="/contact" class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        Primary Button
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href="/services" class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        Secondary Button
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>


<!-- Trust Bar -->
<section class="py-8 bg-gradient-to-b from-blue-50/30 to-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid md:grid-cols-2 gap-8 items-center">
      
      <!-- Left Side: Text -->
      <div class="text-center md:text-left">
        <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight leading-tight text-slate-800">
          Fraud prevention<br/>through 
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">multi-layer defense</span>.
        </p>
        <p class="text-sm md:text-base text-blue-600 font-medium mt-4">
          Pragmatic controls for real protection
        </p>
      </div>
      
      <!-- Right Side: Key stats -->
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">-85%</div>
          <div class="text-sm text-slate-500">Fraud Loss Reduction</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">&lt;15min</div>
          <div class="text-sm text-slate-500">Detection Time</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">&lt;5%</div>
          <div class="text-sm text-slate-500">False Positives</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">95%</div>
          <div class="text-sm text-slate-500">Staff Awareness</div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<!-- Key Fraud Types Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.fraudTypes.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.fraudTypes.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.fraudTypes.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {item.description}
          </p>
          
          <div class="mt-auto pt-4 border-t border-slate-100">
            <span class="inline-flex items-center px-3 py-1 bg-red-50 text-red-700 text-xs rounded-full">
              {item.risk}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Defense Strategy Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.defense.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.defense.subtitle}
      </p>
    </div>
    
    <div class="grid lg:grid-cols-3 gap-8">
      {currentContent.defense.layers.map((layer, index) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group relative">
          
          <div class="absolute -top-3 left-6">
            <div class="w-8 h-8 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold text-sm">
              {index + 1}
            </div>
          </div>
          
          <div class="p-6 pt-8">
            <div class="flex justify-end mb-4">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
                <Icon name={layer.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-lg font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors duration-300 text-left">
              {layer.title}
            </h3>
            
            <ul class="space-y-2">
              {layer.controls.map((control) => (
                <li class="flex items-center text-sm text-slate-600">
                  <svg class="w-4 h-4 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {control}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Detection Methods Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.detection.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.detection.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.detection.methods.map((method) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
                <Icon name={method.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <div class="flex-1">
              <h3 class="text-md font-semibold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
                {method.title}
              </h3>
              <p class="text-slate-500 text-sm leading-relaxed mb-3">
                {method.description}
              </p>
              <ul class="space-y-1">
                {method.items.map((item) => (
                  <li class="flex items-center text-xs text-slate-500">
                    <svg class="w-3 h-3 text-blue-500 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Response Framework Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.response.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.response.subtitle}
      </p>
    </div>
    
    <div class="space-y-4">
      {currentContent.response.phases.map((phase, index) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-5
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-lg transition-all duration-300
                    group">
          <div class="flex flex-col md:flex-row gap-4 items-start">
            
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {index + 1}
              </div>
            </div>
            
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-700 transition-colors duration-300">
                  {phase.title}
                </h3>
                <span class="inline-flex items-center px-2 py-1 bg-red-100 text-red-700 text-xs rounded-full">
                  {phase.time}
                </span>
              </div>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                {phase.actions.map((action) => (
                  <div class="flex items-center text-xs text-slate-600">
                    <svg class="w-3 h-3 text-green-500 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {action}
                  </div>
                ))}
              </div>
            </div>
            
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Metrics Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.metrics.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.metrics.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {currentContent.metrics.items.map((metric) => (
        <div class="bg-gradient-to-br from-blue-50 to-white rounded-xl p-6 text-center border border-blue-100
                    hover:border-blue-300 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A] mb-2">{metric.target}</div>
          <p class="text-slate-600 text-sm">{metric.metric}</p>
          <div class="mt-4 flex justify-center">
            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
              <Icon name="shield" class="w-5 h-5 text-blue-600" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

