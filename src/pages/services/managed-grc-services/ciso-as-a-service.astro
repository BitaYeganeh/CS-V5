---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "CISO-as-a-Service | Expert Security Leadership on Demand",
  description: "Expert leadership on demand: strategy, roadmap, governance, metrics, and board reporting. Access experienced CISO expertise without full-time recruitment.",
  keywords: "CISO as a service, virtual CISO, security leadership, information security manager, vCISO Finland, security strategy",
  type: "service" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "CISO-as-a-Service",
    "provider": {
      "@type": "Organization",
      "name": "Cyber Security Finland"
    },
    "description": "Expert leadership on demand: strategy, roadmap, governance, metrics, and board reporting.",
    "serviceType": "Security Leadership"
  }
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "CISO-as-a-Service",
      subtitle: "Expert Security Leadership on Demand",
      description: "Access experienced CISO expertise and leadership without full-time recruitment. From strategy to execution. Expert leadership on demand: strategy, roadmap, governance, metrics, and board reporting.",
      primaryCTA: { text: "Discuss Your Needs", href: "/contact" },
      secondaryCTA: { text: "Explore Service", href: "/demo" }
    },
    
    services: {
      title: "Core CISO Service Areas",
      subtitle: "Comprehensive security leadership from strategic planning to daily operational management",
      items: [
        { title: "Strategic Leadership", description: "Security strategy development and execution", icon: "target" },
        { title: "Roadmap Planning", description: "Long-term security planning and roadmaps", icon: "map" },
        { title: "Metrics & Reporting", description: "KPI tracking and executive reporting", icon: "bar-chart" },
        { title: "Stakeholder Management", description: "Board and executive communication", icon: "users" }
      ]
    },
    
    leadership: {
      title: "Leadership Areas",
      subtitle: "Three key areas where CISO service delivers significant value to your organization",
      areas: [
        {
          title: "Governance & Compliance",
          description: "ISMS management and regulatory compliance",
          icon: "shield",
          details: ["ISO 27001 management", "GDPR compliance", "SOC 2 preparation", "Risk management framework"]
        },
        {
          title: "Strategic Development",
          description: "Security architecture and program development",
          icon: "trending-up",
          details: ["Zero Trust architecture", "Cloud security", "DevSecOps integration", "Modernization projects"]
        },
        {
          title: "Team Leadership",
          description: "Security team development and leadership",
          icon: "users",
          details: ["Skill development", "Recruitment strategy", "Team structure", "Performance management"]
        }
      ]
    },
    
    deliverables: {
      title: "Deliverables and Outcomes",
      subtitle: "Concrete deliverables and measurable outcomes from CISO service",
      categories: [
        {
          title: "Strategic Documents",
          items: ["Security strategy", "Annual plan", "Technology roadmap", "Budget and resources"]
        },
        {
          title: "Governance Documents",
          items: ["Policies and processes", "Risk register", "Compliance matrix", "Operating models"]
        },
        {
          title: "Reporting",
          items: ["Monthly reports", "Quarterly reviews", "Board presentations", "Dashboards"]
        },
        {
          title: "Operational Support",
          items: ["Incident coordination", "Vendor management", "Project oversight", "Training programs"]
        }
      ]
    },
    
    engagement: {
      title: "Engagement Models",
      subtitle: "Choose the CISO service model that best fits your organization's needs",
      models: [
        { title: "Full-Service CISO", time: "3-5 days/week", description: "Comprehensive security leadership responsibility", suited: "Mid-size enterprises" },
        { title: "Strategic CISO", time: "1-2 days/week", description: "Strategic guidance and executive leadership", suited: "Mature organizations" },
        { title: "Project CISO", time: "Project-based", description: "Interim leadership for special projects", suited: "Transformation projects" }
      ]
    },
    
    outcomes: {
      title: "Measurable Outcomes",
      subtitle: "Typical improvements in client organizations after CISO service implementation",
      items: [
        { metric: "Cybersecurity Maturity", improvement: "+40% annually" },
        { metric: "Regulatory Compliance", improvement: "99% of requirements" },
        { metric: "Incident Management", improvement: "-60% resolution time" },
        { metric: "Executive Satisfaction", improvement: "9.2/10 rating" }
      ]
    },
    
    cta: {
      title: "Need Expert Security Leadership?",
      subtitle: "Let's discuss your organization's needs and the most suitable CISO service model.",
      primaryCTA: { text: "Contact Us", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  
  fi: {
    hero: {
      title: "CISO-palveluna",
      subtitle: "Asiantuntijajohtoinen tietoturvajohtaminen",
      description: "Saat käyttöösi kokeneen CISO:n osaamisen ja johtajuuden ilman kokoaikaista rekrytointia. Strategiasta toteutukseen. Asiantuntijajohtoinen tietoturvajohtaminen: strategia, roadmap, mittarit ja sidosryhmäraportointi.",
      primaryCTA: { text: "Keskustele tarpeista", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluun", href: "/demo" }
    },
    
    services: {
      title: "CISO-palvelun keskeiset alueet",
      subtitle: "Kattava tietoturvajohtaminen strategisesta suunnittelusta päivittäiseen operatiiviseen johtamiseen",
      items: [
        { title: "Strateginen johtaminen", description: "Tietoturvastrategian kehittäminen ja toimeenpano", icon: "target" },
        { title: "Roadmap-suunnittelu", description: "Pitkän aikavälin tietoturvasuunnitelmien laatiminen", icon: "map" },
        { title: "Mittarit ja raportointi", description: "KPI-seuranta ja johtoryhmäraportointi", icon: "bar-chart" },
        { title: "Sidosryhmähallinta", description: "Hallituksen ja johdon viestintä", icon: "users" }
      ]
    },
    
    leadership: {
      title: "Johtamisen osa-alueet",
      subtitle: "Kolme keskeistä aluetta, joissa CISO-palvelu tuottaa merkittävää lisäarvoa organisaatiollesi",
      areas: [
        {
          title: "Governance & Compliance",
          description: "ISMS-hallinta ja säädösten noudattaminen",
          icon: "shield",
          details: ["ISO 27001 -hallinta", "GDPR-vaatimustenmukaisuus", "SOC 2 -valmistelu", "Riskinhallintakehys"]
        },
        {
          title: "Strateginen kehittäminen",
          description: "Tietoturva-arkkitehtuurin ja -ohjelman kehittäminen",
          icon: "trending-up",
          details: ["Zero Trust -arkkitehtuuri", "Cloud-turvallisuus", "DevSecOps-integraatio", "Modernisointihankkeet"]
        },
        {
          title: "Tiimin johtaminen",
          description: "Tietoturvatiimin kehittäminen ja johtaminen",
          icon: "users",
          details: ["Osaamisen kehittäminen", "Rekrytointi-strategia", "Tiimin rakenne", "Suorituksen johtaminen"]
        }
      ]
    },
    
    deliverables: {
      title: "Toimitukset ja tulokset",
      subtitle: "Konkreettiset toimitukset ja mitattavat tulokset CISO-palvelusta",
      categories: [
        {
          title: "Strategiset dokumentit",
          items: ["Tietoturvastrategia", "Vuosisuunnitelma", "Teknologia-roadmap", "Budjetti ja resurssit"]
        },
        {
          title: "Hallinnolliset dokumentit",
          items: ["Politiikat ja prosessit", "Riskirekisteri", "Compliance-matriisi", "Toimintamallit"]
        },
        {
          title: "Raportointi",
          items: ["Kuukausiraportit", "Neljännesvuosikatsaukset", "Hallitusesitykset", "Mittaristot"]
        },
        {
          title: "Toiminnallinen tuki",
          items: ["Incident-koordinointi", "Toimittajahallinta", "Projektien ohjaus", "Koulutusohjelmat"]
        }
      ]
    },
    
    engagement: {
      title: "Toimeksiantomoodit",
      subtitle: "Valitse organisaatiosi tarpeisiin sopivin CISO-palvelumalli",
      models: [
        { title: "Täyden palvelun CISO", time: "3-5 päivää/viikko", description: "Kokonaisvaltainen tietoturvajohdon vastuu", suited: "Keskisuurille yrityksille" },
        { title: "Strateginen CISO", time: "1-2 päivää/viikko", description: "Strateginen ohjaus ja johtoryhmätyöskentely", suited: "Kypsille organisaatioille" },
        { title: "Projekti-CISO", time: "Projektikohtainen", description: "Määräaikainen johtaminen erityishankkeissa", suited: "Transformaatiohankkeille" }
      ]
    },
    
    outcomes: {
      title: "Mitattavat tulokset",
      subtitle: "Tyypilliset parannukset asiakasorganisaatioissa CISO-palvelun käyttöönoton jälkeen",
      items: [
        { metric: "Kyberturvallisuuskypsyys", improvement: "+40% vuodessa" },
        { metric: "Säädöstenmukaisuus", improvement: "99% vaatimuksista" },
        { metric: "Incidentien hallinta", improvement: "-60% käsittelyajassa" },
        { metric: "Johdon tyytyväisyys", improvement: "9.2/10 arvosana" }
      ]
    },
    
    cta: {
      title: "Tarvitsetko asiantuntijajohtoista tietoturvajohtamista?",
      subtitle: "Keskustellaan organisaatiosi tarpeista ja sopivimmasta CISO-palvelumallista.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered without image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28 relative overflow-hidden">
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-tight">
      <div>{currentContent.hero.title}</div>
      <div class="mt-2">
        <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">{currentContent.hero.subtitle}</span>
      </div>
    </h1>
    
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Trust Bar -->
<section class="py-8 bg-gradient-to-b from-blue-50/30 to-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid md:grid-cols-2 gap-8 items-center">
      
      <!-- Left Side: Text -->
      <div class="text-center md:text-left">
        <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight leading-tight text-slate-800">
          Security leadership<br/>without 
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">full-time commitment</span>.
        </p>
        <p class="text-sm md:text-base text-blue-600 font-medium mt-4">
          Expert CISO on demand
        </p>
      </div>
      
      <!-- Right Side: Key stats -->
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">+40%</div>
          <div class="text-sm text-slate-500">Maturity Improvement</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">99%</div>
          <div class="text-sm text-slate-500">Compliance Rate</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">-60%</div>
          <div class="text-sm text-slate-500">Incident Resolution</div>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A]">9.2</div>
          <div class="text-sm text-slate-500">Client Satisfaction</div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<!-- Core Services Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.services.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.services.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.services.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Leadership Areas Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.leadership.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.leadership.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.leadership.areas.map((area) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
                <Icon name={area.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <div class="flex-1">
              <h3 class="text-md font-semibold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
                {area.title}
              </h3>
              <p class="text-slate-500 text-sm leading-relaxed mb-3">
                {area.description}
              </p>
              <ul class="space-y-1">
                {area.details.map((detail) => (
                  <li class="flex items-center text-xs text-slate-500">
                    <svg class="w-3 h-3 text-green-500 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {detail}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.deliverables.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.deliverables.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 gap-8">
      {currentContent.deliverables.categories.map((category) => (
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <h3 class="text-lg font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors duration-300">
            {category.title}
          </h3>
          
          <ul class="space-y-2">
            {category.items.map((item) => (
              <li class="flex items-center text-sm text-slate-600">
                <svg class="w-4 h-4 text-blue-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Engagement Models Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.engagement.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.engagement.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.engagement.models.map((model) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {model.title}
          </h3>
          
          <div class="text-2xl font-bold text-[#1E2A7A] mb-3">
            {model.time}
          </div>
          
          <p class="text-slate-500 text-sm mb-4">
            {model.description}
          </p>
          
          <div class="bg-blue-50 rounded-lg p-3">
            <p class="text-xs text-blue-800 font-medium">
              {lang === 'fi' ? 'Sopii: ' : 'Suited for: '}{model.suited}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Outcomes Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.outcomes.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.outcomes.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {currentContent.outcomes.items.map((outcome) => (
        <div class="bg-gradient-to-br from-blue-50 to-white rounded-xl p-6 text-center border border-blue-100
                    hover:border-blue-300 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300">
          <div class="text-3xl font-bold text-[#1E2A7A] mb-2">{outcome.improvement}</div>
          <p class="text-slate-600 text-sm">{outcome.metric}</p>
          <div class="mt-4 flex justify-center">
            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
              <Icon name="trending-up" class="w-5 h-5 text-blue-600" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-gradient-to-br from-blue-50 to-white rounded-2xl border border-blue-200 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
