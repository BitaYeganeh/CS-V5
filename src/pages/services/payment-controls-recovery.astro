---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Payment Controls and Recovery Playbooks | Fraud Protection",
  description: "Harden payment processes and prepare recovery – bank contacts, payment stop, police report. Comprehensive payment fraud protection.",
  keywords: "payment controls, recovery playbooks, fraud protection, payment stop, incident response, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Payment Controls and Recovery Playbooks",
      subtitle: "Fraud Protection & Incident Response",
      description: "Harden payment processes and prepare recovery – bank contacts, payment stop, police report. Comprehensive payment fraud protection for your organization.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    tracks: {
      title: "Building Payment Controls",
      subtitle: "Three-dimensional approach to payment fraud risk management.",
      items: [
        { title: "Process and system controls", description: "Four-eyes principle, payment limits and change management", icon: "document" },
        { title: "Training and verification", description: "Staff training and phone verification processes", icon: "user" },
        { title: "Incident playbooks", description: "Ready action models for fraud incident handling", icon: "alert" }
      ]
    },
    recoverySteps: {
      title: "Recovery Playbooks",
      subtitle: "Ready action models for fast and effective payment fraud incident handling.",
      items: [
        { title: "Payment Stop", description: "Immediate payment stop through bank", icon: "stop-circle", actions: ["Call bank contact person", "Provide payment identifiers", "Written confirmation"] },
        { title: "Incident Investigation", description: "Fraud scope and impact assessment", icon: "search", actions: ["Event reconstruction", "Impact assessment", "Evidence collection"] },
        { title: "Authority Notification", description: "Police and other authorities notification", icon: "phone", actions: ["Police report filing", "Bank notification", "Insurance company contact"] },
        { title: "Recovery", description: "Control strengthening and lessons learned", icon: "refresh-cw", actions: ["Vulnerability remediation", "Control updates", "Staff retraining"] }
      ]
    },
    preventiveControls: {
      title: "Preventive Controls",
      subtitle: "Comprehensive control suite for payment fraud risk prevention.",
      items: [
        { title: "Technical Protection", features: ["SPF/DKIM/DMARC configuration", "Anti-spoofing filters", "MFA for all accounts", "ERP integrations"], icon: "shield" },
        { title: "Process Controls", features: ["Four-eyes payment approval", "Vendor data locking", "Payment limit setting", "Change process monitoring"], icon: "clipboard" },
        { title: "Human Controls", features: ["Regular fraud training", "Phone verification processes", "Reporting channels", "Simulations and tests"], icon: "users" }
      ]
    },
    cta: {
      title: "Schedule a payments hardening",
      subtitle: "We'll build controls and recovery playbooks for your organization.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "Maksukontrollit ja palautumisen playbookit",
      subtitle: "Petossuoja & tapahtumien hallinta",
      description: "Vahvista maksuprosessit ja varaudu palautumiseen – pankkikontaktit, STOP-maksu, rikosilmoitukset. Kattava maksupetossuoja organisaatiollesi.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    tracks: {
      title: "Maksukontrollien rakentaminen",
      subtitle: "Kolmiulotteinen lähestymistapa maksupetosriskien hallintaan.",
      items: [
        { title: "Prosessi‑ ja järjestelmäkontrollit", description: "Nelisilmäperiaate, maksulimittien ja muutoshallinta", icon: "document" },
        { title: "Koulutus ja todennus", description: "Henkilöstökoulutus ja puhelinvahvistusprosessit", icon: "user" },
        { title: "Incident‑playbookit", description: "Valmiit toimintamallit petostapausten käsittelyyn", icon: "alert" }
      ]
    },
    recoverySteps: {
      title: "Palautumisplaybookit",
      subtitle: "Valmiit toimintamallit maksupetostapausten nopeaan ja tehokkaaseen käsittelyyn.",
      items: [
        { title: "Maksun pysäytys", description: "Välitön maksun pysäytys pankin kautta", icon: "stop-circle", actions: ["Pankin yhteyshenkilön soitto", "Maksun tunnistetietojen välitys", "Kirjallinen vahvistus"] },
        { title: "Tapauksen selvitys", description: "Petoksen laajuuden ja vaikutusten selvitys", icon: "search", actions: ["Tapahtumien rekonstruointi", "Vaikutusten arviointi", "Todistusaineiston keruu"] },
        { title: "Viranomaisilmoitus", description: "Poliisin ja muiden viranomaisten informointi", icon: "phone", actions: ["Rikosilmoituksen teko", "Pankin ilmoitus", "Vakuutusyhtiön kontakti"] },
        { title: "Palautuminen", description: "Kontrollien vahvistaminen ja oppiminen", icon: "refresh-cw", actions: ["Haavoittuvuuksien korjaus", "Kontrollien päivitys", "Henkilöstön koulutus"] }
      ]
    },
    preventiveControls: {
      title: "Ennaltaehkäisevät kontrollit",
      subtitle: "Kattava kontrollien valikoima maksupetosriskien ennaltaehkäisyyn.",
      items: [
        { title: "Tekninen suojaus", features: ["SPF/DKIM/DMARC konfigurointi", "Anti-spoofing suodattimet", "MFA kaikille tileille", "ERP-integraatiot"], icon: "shield" },
        { title: "Prosessikontrollit", features: ["Nelisilmäperiaate maksuille", "Toimittajatietojen lukitseminen", "Maksulimittien asettaminen", "Muutosprosessien valvonta"], icon: "clipboard" },
        { title: "Henkilöstökontrollit", features: ["Säännöllinen petoskoulutus", "Puhelinvahvistusprosessit", "Raportointikanavat", "Simulaatiot ja testit"], icon: "users" }
      ]
    },
    cta: {
      title: "Tilaa maksuprosessien kovennus",
      subtitle: "Rakennamme kontrollit ja palautumisplaybookit organisaatiollesi.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Tracks Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.tracks.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.tracks.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.tracks.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Recovery Steps Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.recoverySteps.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.recoverySteps.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {currentContent.recoverySteps.items.map((step, index) => (
        <div class="bg-slate-50/50 rounded-xl p-5 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-10 h-10 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-lg flex items-center justify-center text-white font-bold mb-3">
            {index + 1}
          </div>
          
          <div class="flex justify-end mb-3">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6]">
              <Icon name={step.icon} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-base font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs mb-3">
            {step.description}
          </p>
          
          <ul class="space-y-1">
            {step.actions.map((action) => (
              <li class="flex items-start text-xs text-slate-500">
                <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {action}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Preventive Controls Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.preventiveControls.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.preventiveControls.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.preventiveControls.items.map((control, index) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={control.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <div class="w-10 h-10 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-lg flex items-center justify-center text-white font-bold mb-4">
            {index + 1}
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {control.title}
          </h3>
          
          <ul class="space-y-2">
            {control.features.map((feature) => (
              <li class="flex items-start text-sm text-slate-600">
                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>