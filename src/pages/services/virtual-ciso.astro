---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const title = lang === 'fi' ? 'Virtuaalinen CISO' : 'Virtual CISO (V-CISO)';
const description = lang === 'fi' 
  ? 'Kokeneen Chief Information Security Officerin palvelu osaamisella ilman pysyvää rekrytointia. Strategiaa toteutukseen turvallisuuden johtamisessa.' 
  : 'Experienced Chief Information Security Officer expertise without full-time recruitment. From strategy to execution in security leadership.';

const serviceModels = [
  {
    title: lang === 'fi' ? 'Täyspalvelu V-CISO' : 'Full-Service V-CISO',
    description: lang === 'fi' 
      ? 'Kokonaisvaltainen turvallisuuden johtamisratkaisu, joka kattaa kaikki kyberturvan hallinnolliset ja strategiset toiminnot.' 
      : 'Comprehensive security leadership solution covering all aspects of cybersecurity governance and strategy.',
    icon: 'userCircle',
    features: [
      lang === 'fi' ? 'Strateginen suunnittelu' : 'Strategic Planning',
      lang === 'fi' ? 'Hallintamallin rakentaminen' : 'Governance Framework Development',
      lang === 'fi' ? 'Riskinhallintastrategia' : 'Risk Management Strategy',
      lang === 'fi' ? 'Sidosryhmäraportointi' : 'Stakeholder Reporting',
      lang === 'fi' ? 'Kriisinhallinta' : 'Crisis Management',
      lang === 'fi' ? 'Tietosuojan hallinta' : 'Privacy Governance'
    ]
  },
  {
    title: lang === 'fi' ? 'Strateginen V-CISO' : 'Strategic V-CISO',
    description: lang === 'fi' 
      ? 'Keskittyy strategiseen suunnitteluun, hallintamallin kehittämiseen ja pitkän aikavälin turvallisuusvision luomiseen.' 
      : 'Focuses on strategic planning, governance development, and long-term security vision.',
    icon: 'chartBar',
    features: [
      lang === 'fi' ? 'Turvallisuusstrategian kehittäminen' : 'Security Strategy Development',
      lang === 'fi' ? 'Hallintamallin suunnittelu' : 'Governance Model Design',
      lang === 'fi' ? 'Riskien priorisointi' : 'Risk Prioritization',
      lang === 'fi' ? 'Sidosryhmäkoulutus' : 'Stakeholder Training',
      lang === 'fi' ? 'Kokoukset johtokunnan kanssa' : 'Board Meetings',
      lang === 'fi' ? 'Sijoitussuunnitelmat' : 'Investment Plans'
    ]
  },
  {
    title: lang === 'fi' ? 'Projekti-V-CISO' : 'Project V-CISO',
    description: lang === 'fi'
      ? 'Tukee tiettyjä projekteja kuten sertifiointeja, vaarallisten tilanteiden hallintaa tai kriisinhallintaa.'
      : 'Supports specific projects such as certifications, incident response, or crisis management.',
    icon: 'clipboard',
    features: [
      lang === 'fi' ? 'Sertifiointiprojektit' : 'Certification Projects',
      lang === 'fi' ? 'Tietoturvaloukkausten hallinta' : 'Incident Response Management',
      lang === 'fi' ? 'Kriisinhallintasuunnittelu' : 'Crisis Management Planning',
      lang === 'fi' ? 'Tietoturvaa koskevat tarkastukset' : 'Security Audits',
      lang === 'fi' ? 'Toimittajien riskien hallinta' : 'Vendor Risk Management',
      lang === 'fi' ? 'Sopimusneuvottelut' : 'Contract Negotiations'
    ]
  }
];

const benefits = [
  lang === 'fi' ? 'Säästä 60-70% kokopäiväisen CISON palkasta' : 'Save 60-70% compared to full-time CISO salary',
  lang === 'fi' ? 'Pääsy kokeneeseen asiantuntijaosaamiseen' : 'Access to senior expertise',
  lang === 'fi' ? 'Joustava käyttöönotto' : 'Flexible engagement model',
  lang === 'fi' ? 'Nopea käynnistys' : 'Quick deployment',
  lang === 'fi' ? 'Ilman rekrytointikustannuksia' : 'No recruitment costs',
  lang === 'fi' ? 'Skaalautuva tuki tarpeen mukaan' : 'Scalable support as needed'
];

const deliverables = [
  lang === 'fi' ? 'Turvallisuusstrategia ja roadmap' : 'Security strategy and roadmap',
  lang === 'fi' ? 'Hallintamalli ja käytännöt' : 'Governance model and practices',
  lang === 'fi' ? 'Riskinhallintakehys' : 'Risk management framework',
  lang === 'fi' ? 'Sidosryhmäraportointi' : 'Stakeholder reporting',
  lang === 'fi' ? 'Koulutussuunnitelmat' : 'Training programs',
  lang === 'fi' ? 'Kriisinhallintasuunnitelmat' : 'Crisis management plans',
  lang === 'fi' ? 'Tietoturvariskien hallintasuunnitelmat' : 'Cybersecurity risk management plans',
  lang === 'fi' ? 'Sääntelyn noudattamisen takaaminen' : 'Compliance assurance'
];

const caseStudies = [
  {
    title: lang === 'fi' ? 'Finanssialan yritys' : 'Financial Services Company',
    description: lang === 'fi'
      ? 'Keskitetty finanssialan toimija, jolla oli tarve kattavalle kyberturvallisuuden johtamiselle ilman pysyvää CISO-rekisteröintiä.'
      : 'Mid-sized financial services company that needed comprehensive cybersecurity leadership without a full-time CISO hire.',
    challenge: lang === 'fi'
      ? 'Puutteellinen turvallisuusstrategia ja hajanainen hallintamalli, joka johti useisiin pienempiin tietoturvahaaviointeihin.'
      : 'Lacked a cohesive security strategy and fragmented governance model, leading to multiple minor security incidents.',
    solution: lang === 'fi'
      ? 'Toteutimme strategisen V-CISO-palvelun, jossa keskityttiin hallintamallin rakentamiseen, riskienhallintaan ja sidosryhmäraportointiin.'
      : 'Implemented a strategic V-CISO service focusing on governance model development, risk management, and stakeholder reporting.',
    results: [
      lang === 'fi' ? '100% vähennetty tietoturva-incidenttien määrä vuoden sisällä' : '100% reduction in security incidents within one year',
      lang === 'fi' ? 'ISO 27001 sertifiointi 6 kuukaudessa' : 'ISO 27001 certification achieved in 6 months',
      lang === 'fi' ? 'Sidosryhmäluottamus parani 40%' : 'Stakeholder confidence improved by 40%',
      lang === 'fi' ? 'Operatiiviset kustannukset laskivat 25%' : 'Operational costs reduced by 25%'
    ]
  },
  {
    title: lang === 'fi' ? 'Terveydenhuoltosektori' : 'Healthcare Organization',
    description: lang === 'fi'
      ? 'Alueellinen sairaala, jolla oli tarve GDPR- ja HIPAA-yhteensopivuuteen sekä laajempaan tietosuojan hallintaan.'
      : 'Regional hospital that needed GDPR and HIPAA compliance along with broader privacy governance.',
    challenge: lang === 'fi'
      ? 'Monimutkainen sääntelyympäristö ja potilastietojen käsittely vaativat erikoisosaamista, jota ei ollut sisäisesti saatavilla.'
      : 'Complex regulatory environment and patient data handling required specialized expertise not available internally.',
    solution: lang === 'fi'
      ? 'Toteutimme täyspalvelu V-CISO-mallin, jossa keskityttiin sääntelyn noudattamiseen, tietosuojan hallintaan ja henkilöstökoulutukseen.'
      : 'Implemented a full-service V-CISO model focusing on compliance, privacy governance, and staff training.',
    results: [
      lang === 'fi' ? 'Täysi GDPR- ja HIPAA-yhteensopivuus saavutettu 8 kuukaudessa' : 'Full GDPR and HIPAA compliance achieved in 8 months',
      lang === 'fi' ? 'Tietosuojahaaviointien määrä väheni 95%' : 'Privacy incidents reduced by 95%',
      lang === 'fi' ? 'Henkilöstön tietoturvakoulutuksen läpäisyaste nousi 98%' : 'Staff security training pass rate increased to 98%',
      lang === 'fi' ? 'Sääntelytarkastusten arvosana parani A-luokkaan' : 'Regulatory audit score improved to Grade A'
    ]
  }
];
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-teal-50 via-white to-blue-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-6">
          {title}
        </h1>
        <p class="text-xl text-slate-600 mb-8">
          {description}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <Button href="/contact?service=vciso" variant="primary">
            {lang === 'fi' ? 'Ota yhteyttä' : 'Contact Us'}
          </Button>
          <Button href="/contact?consultation=true" variant="secondary">
            {lang === 'fi' ? 'Varaa konsultaatio' : 'Book Consultation'}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-8">
          {lang === 'fi' ? 'Yleiskatsaus palveluun' : 'Service Overview'}
        </h2>
        <div class="bg-gradient-to-r from-teal-50 to-blue-50 rounded-xl p-8 border border-teal-200">
          <p class="text-lg text-slate-700 mb-6">
            {lang === 'fi' 
              ? 'Virtuaalinen CISO -palvelumme tarjoaa kokeneen Chief Information Security Officerin osaamisen ilman pysyvää rekrytointia. Tarjoamme strategista johtajuutta, sääntelyn noudattamista ja riskienhallintaa organisaatiosi tarpeisiin sopivalla mallilla.' 
              : 'Our Virtual CISO service provides experienced Chief Information Security Officer expertise without full-time recruitment. We offer strategic leadership, compliance oversight, and risk management tailored to your organization\'s needs.'}
          </p>
          <p class="text-lg text-slate-700">
            {lang === 'fi' 
              ? 'Rakennamme turvallisuusstrategian, hallintamallin ja käytännön toteutuksen yhden kumppanin kautta.' 
              : 'We build security strategy, governance, and hands-on execution from a single partner.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Models -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          {lang === 'fi' ? 'Palvelumallit' : 'Service Models'}
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto mb-8">
          {lang === 'fi' ? 'Valitse organisaatiosi tarpeisiin sopivin V-CISO-palvelumalli' : 'Choose the V-CISO service model that best fits your organization\'s needs'}
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {serviceModels.map((model) => (
          <div class="bg-white p-8 rounded-xl shadow-lg border border-slate-100">
            <div class="flex items-center mb-4">
              <Icon name={model.icon} class="h-8 w-8 text-teal-600 mr-3" />
              <h3 class="text-xl font-bold text-slate-900">{model.title}</h3>
            </div>
            <p class="text-slate-600 mb-6">{model.description}</p>
            <ul class="space-y-2">
              {model.features.map((feature) => (
                <li class="flex items-center">
                  <Icon name="check" class="h-5 w-5 text-green-600 mr-2" />
                  <span class="text-slate-700">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          {lang === 'fi' ? 'V-CISO:n edut' : 'V-CISO Benefits'}
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto mb-8">
          {lang === 'fi' ? 'Miksi valita virtuaalinen CISO -palvelumme?' : 'Why choose our Virtual CISO service?'}
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map((benefit) => (
          <div class="bg-gradient-to-br from-teal-50 to-blue-50 p-6 rounded-lg border border-teal-200">
            <div class="flex items-start">
              <Icon name="star" class="h-6 w-6 text-teal-600 mr-3 mt-0.5 flex-shrink-0" />
              <p class="text-slate-700 font-medium">{benefit}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables Section -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          {lang === 'fi' ? 'Mitä saat' : 'What You Get'}
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto mb-8">
          {lang === 'fi' ? 'Konkreettiset toimitukset ja mitattavat tulokset V-CISO-palvelusta' : 'Concrete deliverables and measurable outcomes from V-CISO service'}
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-6">
            {lang === 'fi' ? 'Keskeiset toimitukset' : 'Key Deliverables'}
          </h3>
          <ul class="space-y-4">
            {deliverables.map((deliverable) => (
              <li class="flex items-start">
                <Icon name="checkCircle" class="h-6 w-6 text-green-600 mr-3 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">{deliverable}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-6">
            {lang === 'fi' ? 'Mittarit ja tulokset' : 'Metrics & Outcomes'}
          </h3>
          <ul class="space-y-4">
            <li class="flex items-start">
              <Icon name="chartBar" class="h-6 w-6 text-teal-600 mr-3 mt-0.5 flex-shrink-0" />
              <span class="text-slate-700">
                {lang === 'fi' 
                  ? 'Parannettu kyberturvallisuuden asema' 
                  : 'Improved cybersecurity posture'}
              </span>
            </li>
            <li class="flex items-start">
              <Icon name="shieldCheck" class="h-6 w-6 text-teal-600 mr-3 mt-0.5 flex-shrink-0" />
              <span class="text-slate-700">
                {lang === 'fi' 
                  ? 'Sääntelyn noudattamisen varmistus' 
                  : 'Assured compliance with regulations'}
              </span>
            </li>
            <li class="flex items-start">
              <Icon name="documentText" class="h-6 w-6 text-teal-600 mr-3 mt-0.5 flex-shrink-0" />
              <span class="text-slate-700">
                {lang === 'fi' 
                  ? 'Kehittyneet hallintakäytännöt' 
                  : 'Enhanced governance practices'}
              </span>
            </li>
            <li class="flex items-start">
              <Icon name="userGroup" class="h-6 w-6 text-teal-600 mr-3 mt-0.5 flex-shrink-0" />
              <span class="text-slate-700">
                {lang === 'fi' 
                  ? 'Parannettu sidosryhmäluottamus' 
                  : 'Improved stakeholder confidence'}
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Studies Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          {lang === 'fi' ? 'Toteutetut tapaukset' : 'Case Studies'}
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto mb-8">
          {lang === 'fi'
            ? 'Todellisia esimerkkejä siitä, miten V-CISO-palvelumme on auttanut organisaatioita parantamaan kyberturvallisuuttaan.'
            : 'Real examples of how our V-CISO service has helped organizations improve their cybersecurity posture.'}
        </p>
      </div>

      <div class="space-y-12">
        {caseStudies.map((study, index) => (
          <div class={`bg-gradient-to-br ${index % 2 === 0 ? 'from-teal-50 to-blue-50' : 'from-cyan-50 to-teal-50'} rounded-2xl p-8 border border-slate-200`}>
            <div class="flex flex-col md:flex-row gap-8">
              <div class="md:w-1/3 flex items-center justify-center">
                <div class="bg-white p-6 rounded-xl shadow-lg w-16 h-16 flex items-center justify-center">
                  <Icon name="lightBulb" class="h-8 w-8 text-teal-600" />
                </div>
              </div>
              <div class="md:w-2/3">
                <h3 class="text-2xl font-bold text-slate-900 mb-2">{study.title}</h3>
                <p class="text-slate-700 mb-4">{study.description}</p>

                <div class="grid md:grid-cols-3 gap-6 mt-6">
                  <div>
                    <h4 class="font-semibold text-slate-900 mb-2">
                      {lang === 'fi' ? 'Haaste' : 'Challenge'}
                    </h4>
                    <p class="text-slate-600 text-sm">{study.challenge}</p>
                  </div>

                  <div>
                    <h4 class="font-semibold text-slate-900 mb-2">
                      {lang === 'fi' ? 'Ratkaisu' : 'Solution'}
                    </h4>
                    <p class="text-slate-600 text-sm">{study.solution}</p>
                  </div>

                  <div>
                    <h4 class="font-semibold text-slate-900 mb-2">
                      {lang === 'fi' ? 'Tulokset' : 'Results'}
                    </h4>
                    <ul class="space-y-1">
                      {study.results.map((result, idx) => (
                        <li key={idx} class="flex items-start">
                          <Icon name="check" class="h-4 w-4 text-green-600 mt-0.5 mr-2 flex-shrink-0" />
                          <span class="text-slate-600 text-sm">{result}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Success Metrics Section -->
  <section class="py-16 bg-gradient-to-br from-slate-50 to-teal-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          {lang === 'fi' ? 'Menestyksen mittarit ja tulokset' : 'Success Metrics & Outcomes'}
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto mb-8">
          {lang === 'fi'
            ? 'Todisteet siitä, miten V-CISO-palvelumme vaikuttaa asiakkaidemme organisaatioihin.'
            : 'Evidence of how our V-CISO service impacts our clients\' organizations.'}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-white p-6 rounded-xl shadow-lg text-center">
          <div class="text-4xl font-bold text-teal-600 mb-2">95%</div>
          <h3 class="font-semibold text-slate-900 mb-2">
            {lang === 'fi' ? 'Asiakastyytyväisyys' : 'Client Satisfaction'}
          </h3>
          <p class="text-slate-600 text-sm">
            {lang === 'fi'
              ? 'asiakkaistamme kokee, että V-CISO-palvelumme vastaa odotuksiinsa tai ylittää ne'
              : 'of clients report that our V-CISO service meets or exceeds expectations'}
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-lg text-center">
          <div class="text-4xl font-bold text-teal-600 mb-2">87%</div>
          <h3 class="font-semibold text-slate-900 mb-2">
            {lang === 'fi' ? 'Riskeihin vastaaminen' : 'Risk Response Time'}
          </h3>
          <p class="text-slate-600 text-sm">
            {lang === 'fi'
              ? 'nopeampi keskimääräinen reagointiaika riskeihin V-CISO:n ansiosta'
              : 'faster average response time to risks with V-CISO service'}
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-lg text-center">
          <div class="text-4xl font-bold text-teal-600 mb-2">40%</div>
          <h3 class="font-semibold text-slate-900 mb-2">
            {lang === 'fi' ? 'Kustannusten vähentäminen' : 'Cost Reduction'}
          </h3>
          <p class="text-slate-600 text-sm">
            {lang === 'fi'
              ? 'keskimääräinen kustannushyöty verrattuna sisäiseen CISO:n palkkaamiseen'
              : 'average cost savings compared to hiring an internal CISO'}
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-lg text-center">
          <div class="text-4xl font-bold text-teal-600 mb-2">92%</div>
          <h3 class="font-semibold text-slate-900 mb-2">
            {lang === 'fi' ? 'Sääntelyn noudattaminen' : 'Compliance Rate'}
          </h3>
          <p class="text-slate-600 text-sm">
            {lang === 'fi'
              ? 'asiakkaistamme saavuttaa tai ylittää sääntelytavoitteensa V-CISO:n kanssa'
              : 'of clients achieve or exceed regulatory compliance goals with V-CISO'}
          </p>
        </div>
      </div>

      <div class="mt-12 bg-white rounded-2xl p-8 border border-teal-200">
        <h3 class="text-2xl font-bold text-slate-900 mb-4 text-center">
          {lang === 'fi' ? 'Tyypilliset tulokset V-CISO-palvelun käytöstä' : 'Typical Outcomes from V-CISO Service'}
        </h3>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h4 class="font-semibold text-slate-900 mb-3 flex items-center">
              <Icon name="chartBar" class="h-5 w-5 text-teal-600 mr-2" />
              {lang === 'fi' ? 'Strateginen etu' : 'Strategic Advantages'}
            </h4>
            <ul class="space-y-2">
              <li class="flex items-start">
                <Icon name="checkCircle" class="h-5 w-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">{lang === 'fi' ? 'Selkeä turvallisuusstrategia ja roadmap' : 'Clear security strategy and roadmap'}</span>
              </li>
              <li class="flex items-start">
                <Icon name="checkCircle" class="h-5 w-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">{lang === 'fi' ? 'Parannettu hallinto ja valvonta' : 'Enhanced governance and oversight'}</span>
              </li>
              <li class="flex items-start">
                <Icon name="checkCircle" class="h-5 w-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">{lang === 'fi' ? 'Sidosryhmäluottamuksen kasvu' : 'Increased stakeholder confidence'}</span>
              </li>
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-slate-900 mb-3 flex items-center">
              <Icon name="shieldCheck" class="h-5 w-5 text-teal-600 mr-2" />
              {lang === 'fi' ? 'Operaattorinen etu' : 'Operational Benefits'}
            </h4>
            <ul class="space-y-2">
              <li class="flex items-start">
                <Icon name="checkCircle" class="h-5 w-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">{lang === 'fi' ? 'Tietoturva-incidenttien määrän väheneminen' : 'Reduction in security incidents'}</span>
              </li>
              <li class="flex items-start">
                <Icon name="checkCircle" class="h-5 w-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" />
                <span class="text-slate-700">{lang === 'fi' ? 'Nopeampi reagointi uhkiin' : 'Faster response to threats'}</span>
              </li>
              <li class="flex items-start">
