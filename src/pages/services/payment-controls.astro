---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Payment Controls | Fraud Protection & Recovery",
  description: "We harden payment processes against fraud and build recovery readiness. Comprehensive payment fraud protection for your organization.",
  keywords: "payment controls, fraud protection, BEC, invoice fraud, payment fraud, recovery playbooks, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Payment Controls",
      subtitle: "Fraud Protection & Recovery",
      description: "We harden payment processes against fraud and build recovery readiness. Comprehensive payment fraud protection for your organization.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    pillars: {
      title: "Three Pillars of Payment Controls",
      subtitle: "Effective payment fraud protection requires combining technical, process, and human controls.",
      items: [
        { title: "Process Controls", description: "Four‑eyes approvals, payment limits and change control.", icon: "document" },
        { title: "Technical Controls", description: "SPF/DMARC, treasury/ERP integrations, strong authentication.", icon: "lock" },
        { title: "People Controls", description: "Call‑backs, verification, training and simulations.", icon: "user" }
      ]
    },
    threats: {
      title: "Payment Fraud Threats",
      subtitle: "Identify and protect against the most common payment frauds.",
      items: [
        { title: "BEC/CEO Fraud", description: "False payment requests using executive credentials", icon: "alert-triangle" },
        { title: "Vendor Fraud", description: "Vendor banking detail changes and false invoices", icon: "mail" },
        { title: "Payment System Fraud", description: "ERP and payment system abuse", icon: "credit-card" },
        { title: "Social Engineering", description: "Phone fraud and staff manipulation", icon: "phone" }
      ]
    },
    framework: {
      title: "Control Framework",
      subtitle: "Comprehensive approach to payment fraud risk management.",
      items: [
        { title: "Prevention", features: ["Payment limit setting", "Four-eyes principle", "Vendor data locking", "Technical protection"] },
        { title: "Detection", features: ["Anomaly detection", "Transaction monitoring", "Reporting channels", "Regular reviews"] },
        { title: "Response", features: ["Payment stopping", "Bank contacts", "Incident investigation", "Authority reporting"] }
      ]
    },
    playbooks: {
      title: "Recovery Playbooks",
      subtitle: "Ready action models for handling payment fraud incidents and recovery.",
      steps: [
        { step: "1", title: "Payment STOP and bank contacts", description: "Immediate payment stop and bank notification" },
        { step: "2", title: "Incident triage and scoping", description: "Incident scope and impact assessment" },
        { step: "3", title: "Police report and coordination", description: "Authority notification and cooperation" },
        { step: "4", title: "Recovery and improvements", description: "Control strengthening and lessons learned" }
      ]
    },
    cta: {
      title: "Ready to harden your payments?",
      subtitle: "We'll review risks, controls and recovery capability.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "Maksukontrollit",
      subtitle: "Petossuoja & Palautuminen",
      description: "Kovennamme maksuprosessit petoksia vastaan ja rakennamme palautumisvalmiuden. Kattava maksupetossuoja organisaatiollesi.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    pillars: {
      title: "Maksukontrollien kolme pilaria",
      subtitle: "Tehokas maksupetossuojaus vaatii teknisten, prosessuaalisten ja henkilöstöön liittyvien kontrollien yhdistämistä.",
      items: [
        { title: "Prosessikontrollit", description: "Neljän silmän periaate, maksurajojen ja muutosten hallinta.", icon: "document" },
        { title: "Tekniset kontrollit", description: "SPF/DMARC, treasuryn ja ERP‑integraatiot, vahva tunnistus.", icon: "lock" },
        { title: "Ihmiskontrollit", description: "Soittopaluu, todennus, koulutus ja simulaatiot.", icon: "user" }
      ]
    },
    threats: {
      title: "Maksupetosuhkat",
      subtitle: "Tunnista ja suojaudu yleisimmiltä maksupetoksilta.",
      items: [
        { title: "BEC/CEO Fraud", description: "Johdon tunnuksilla tehdyt väärät maksupyynnöt", icon: "alert-triangle" },
        { title: "Toimittajapetokset", description: "Toimittajan pankkitietojen vaihto ja väärät laskut", icon: "mail" },
        { title: "Maksujärjestelmäpetokset", description: "ERP- ja maksujärjestelmien väärinkäyttö", icon: "credit-card" },
        { title: "Sosiaalinen manipulointi", description: "Puhelinpetokset ja henkilöstön manipulointi", icon: "phone" }
      ]
    },
    framework: {
      title: "Kontrollikehikko",
      subtitle: "Kattava lähestymistapa maksupetosriskien hallintaan.",
      items: [
        { title: "Ennaltaehkäisy", features: ["Maksulimiitin asettaminen", "Nelisilmäperiaate", "Toimittajatietojen lukitseminen", "Tekninen suojaus"] },
        { title: "Tunnistaminen", features: ["Anomalianseuranta", "Transaktion valvonta", "Raportointikanavat", "Säännölliset tarkastukset"] },
        { title: "Vastaus", features: ["Maksun pysäytys", "Pankkikontaktit", "Tapauksen selvitys", "Viranomaisilmoitus"] }
      ]
    },
    playbooks: {
      title: "Palautumisplaybookit",
      subtitle: "Valmiit toimintamallit maksupetostapausten käsittelyyn ja palautumiseen.",
      steps: [
        { step: "1", title: "STOP‑maksu ja pankkikontaktit", description: "Välitön maksun pysäytys ja pankin informointi" },
        { step: "2", title: "Tapahtumaselvitys", description: "Tapahtuman laajuuden ja vaikutusten selvitys" },
        { step: "3", title: "Rikosilmoitus ja toimet", description: "Viranomaisten informointi ja yhteistyö" },
        { step: "4", title: "Palautuminen ja parannukset", description: "Kontrollien vahvistaminen ja oppiminen" }
      ]
    },
    cta: {
      title: "Kovennetaanko maksuprosessit?",
      subtitle: "Käydään läpi riskit, kontrollit ja palautumiskyky.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Pillars Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.pillars.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.pillars.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.pillars.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Threats Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.threats.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.threats.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-4 gap-6">
      {currentContent.threats.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-5 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    group">
          
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6]">
                <Icon name={item.icon} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-800 mb-1 group-hover:text-blue-700 transition-colors duration-300">
                {item.title}
              </h3>
              <p class="text-slate-500 text-xs">{item.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Control Framework Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.framework.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.framework.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.framework.items.map((item, index) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name="shield-check" class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <div class="w-10 h-10 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-lg flex items-center justify-center text-white font-bold mb-4">
            {index + 1}
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <ul class="space-y-2">
            {item.features.map((feature) => (
              <li class="flex items-start text-sm text-slate-600">
                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Playbooks Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.playbooks.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.playbooks.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-4 gap-6">
      {currentContent.playbooks.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>