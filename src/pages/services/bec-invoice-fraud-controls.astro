---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "BEC/Invoice Fraud Controls | Business Email Compromise Protection",
  description: "Prevent BEC and invoice fraud with process, technology and people controls. Multi-layered protection against Business Email Compromise and invoice fraud.",
  keywords: "BEC, invoice fraud, email compromise, fraud controls, CEO fraud, vendor impersonation, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "BEC/Invoice Fraud Controls",
      subtitle: "Business Email Compromise Protection",
      description: "Prevent BEC and invoice fraud with process, technology and people controls. Multi-layered protection against Business Email Compromise and invoice fraud.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    controls: {
      title: "BEC/Invoice Fraud Controls",
      subtitle: "Multi-layered protection against Business Email Compromise and invoice fraud.",
      items: [
        { title: "Dual‑control approvals", description: "Four-eyes principle for all payments and vendor detail changes", icon: "user" },
        { title: "Payment communication checks", description: "Email origin and authenticity verification", icon: "mail" },
        { title: "Domain and SPF/DMARC", description: "Technical protection against domain spoofing", icon: "lock" },
        { title: "Call‑back and verification", description: "Phone verification for changes and large payments", icon: "document" }
      ]
    },
    scenarios: {
      title: "Common BEC Scenarios",
      subtitle: "Know the most common attacker tactics and build protection against them.",
      items: [
        { title: "CEO Fraud", description: "False payment requests using executive credentials", icon: "alert-triangle" },
        { title: "Vendor Impersonation", description: "Banking detail changes for existing vendors", icon: "mail" },
        { title: "Fraudulent Invoices", description: "Fake invoices for non-existent orders", icon: "file-text" },
        { title: "Phone Manipulation", description: "Phone fraud supporting payment requests", icon: "phone" }
      ]
    },
    layers: {
      title: "Protection Layers",
      subtitle: "Effective BEC protection requires combining technical, process, and human controls.",
      items: [
        { title: "Technical Protection", features: ["SPF/DKIM/DMARC configuration", "Anti-spoofing filters", "Email scanners", "Anomaly detection"], icon: "shield" },
        { title: "Process Controls", features: ["Four-eyes payment approval", "Vendor data locking", "Change process verification", "Payment limit controls"], icon: "clipboard" },
        { title: "Staff Training", features: ["BEC simulations", "Verification procedures", "Reporting channels", "Regular updates"], icon: "users" }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Systematic approach to building BEC protection.",
      steps: [
        { step: "1", title: "Threat Analysis", description: "BEC scenario mapping" },
        { step: "2", title: "Process Review", description: "Payment process assessment" },
        { step: "3", title: "Technical Testing", description: "Spoofing and phishing tests" },
        { step: "4", title: "Control Design", description: "Multi-layered control design" },
        { step: "5", title: "Implementation", description: "Control implementation and training" }
      ]
    },
    cta: {
      title: "Request a payment process review",
      subtitle: "We'll review BEC/invoice fraud paths and harden your controls.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "BEC/Laskupetosten kontrollit",
      subtitle: "Business Email Compromise -suojaus",
      description: "Estä sähköpostin kaappaukset ja laskupetokset prosessi‑, teknologia‑ ja ihmiskontrolleilla. Monikerroksinen suojaus Business Email Compromise ja laskupetoksia vastaan.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    controls: {
      title: "BEC/Laskupetosten kontrollit",
      subtitle: "Monikerroksinen suojaus Business Email Compromise ja laskupetoksia vastaan.",
      items: [
        { title: "Kaksivaiheinen vahvistus", description: "Nelisilmäperiaate kaikille maksuille ja toimittajatietojen muutoksille", icon: "user" },
        { title: "Maksuviestien tarkistukset", description: "Sähköpostiviestien alkuperän ja aitouden varmistaminen", icon: "mail" },
        { title: "Domain ja SPF/DMARC", description: "Tekninen suojaus domain-väärentämistä vastaan", icon: "lock" },
        { title: "Soittopaluu ja todentaminen", description: "Puhelinvahvistus muutoksille ja suurille maksuille", icon: "document" }
      ]
    },
    scenarios: {
      title: "Yleisimmät BEC-skenaariot",
      subtitle: "Tunne hyökkääjien yleisimmät taktikat ja rakenna suojaus niitä vastaan.",
      items: [
        { title: "CEO Fraud", description: "Johdon tunnuksilla tehdyt väärät maksupyynnöt", icon: "alert-triangle" },
        { title: "Toimittajan kaappaus", description: "Olemassa olevan toimittajan pankkitietojen vaihto", icon: "mail" },
        { title: "Väärät laskut", description: "Väärennetyt laskut olemattomista tilauksista", icon: "file-text" },
        { title: "Puhelinmanipulointi", description: "Puhelinpetokset maksupyyntöjen tueksi", icon: "phone" }
      ]
    },
    layers: {
      title: "Suojauskerrokset",
      subtitle: "Tehokas BEC-suojaus vaatii teknisten, prosessuaalisten ja henkilöstöön liittyvien kontrollien yhdistämistä.",
      items: [
        { title: "Tekninen suojaus", features: ["SPF/DKIM/DMARC konfigurointi", "Anti-spoofing suodattimet", "Sähköpostiskannerit", "Anomalianseuranta"], icon: "shield" },
        { title: "Prosessikontrollit", features: ["Nelisilmäperiaate maksuille", "Toimittajatietojen lukitseminen", "Muutosprosessien vahvistus", "Maksurajojen asettaminen"], icon: "clipboard" },
        { title: "Henkilöstökoulutus", features: ["BEC-simulaatiot", "Varmistusprosessit", "Raportointikanavat", "Säännöllinen päivitys"], icon: "users" }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Systemaattinen lähestymistapa BEC-suojauksen rakentamiseen.",
      steps: [
        { step: "1", title: "Uhka-analyysi", description: "BEC-skenaarioiden kartoitus" },
        { step: "2", title: "Prosessikatsaus", description: "Maksuprosessien arviointi" },
        { step: "3", title: "Tekninen testaus", description: "Spoofing ja phishing-testit" },
        { step: "4", title: "Kontrollisuunnittelu", description: "Monikerroksisten kontrollien suunnittelu" },
        { step: "5", title: "Käyttöönotto", description: "Kontrollien käyttöönotto ja koulutus" }
      ]
    },
    cta: {
      title: "Pyydä maksuprosessien tarkastus",
      subtitle: "Käydään läpi BEC/laskupetosten reitit ja laitetaan kontrollit kuntoon.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Controls Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.controls.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.controls.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.controls.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BEC Scenarios Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.scenarios.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.scenarios.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {currentContent.scenarios.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-5 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    group">
          
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6]">
                <Icon name={item.icon} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-800 mb-1 group-hover:text-blue-700 transition-colors duration-300">
                {item.title}
              </h3>
              <p class="text-slate-500 text-xs">{item.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Protection Layers Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.layers.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.layers.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.layers.items.map((layer, index) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={layer.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <div class="w-10 h-10 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-lg flex items-center justify-center text-white font-bold mb-4">
            {index + 1}
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {layer.title}
          </h3>
          
          <ul class="space-y-2">
            {layer.features.map((feature) => (
              <li class="flex items-start text-sm text-slate-600">
                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>