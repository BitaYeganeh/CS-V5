      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.cookieCategories.subtitle}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {currentContent.cookieCategories.categories.map((category) => (
        <div class="bg-slate-50/50 rounded-xl p-5 border border-slate-100
