---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Common Criteria | Security Evaluation & Certification",
  description: "Professional Common Criteria certification and evaluation services. We help organizations achieve international cybersecurity standards.",
  keywords: "Common Criteria, security evaluation, certification, EAL, security testing, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Common Criteria",
      subtitle: "Security Evaluation & Certification",
      description: "Professional Common Criteria certification and evaluation services. We help organizations achieve international cybersecurity standards. Achieve Common Criteria certification and strengthen your organization's security reliability.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    components: {
      title: "Common Criteria Components",
      subtitle: "Common Criteria is based on four main components that define security evaluation.",
      items: [
        { title: "Security Objectives", description: "Define security objectives and requirements", icon: "target", features: ["Security objectives", "Security requirements", "Threat models"] },
        { title: "Security Measures", description: "Implement security measures and mechanisms", icon: "shield", features: ["Security mechanisms", "Security policies", "Security protocols"] },
        { title: "Security Testing", description: "Conduct comprehensive security testing", icon: "check", features: ["Penetration testing", "Vulnerability testing", "Security analysis"] },
        { title: "Security Documentation", description: "Create comprehensive security documentation", icon: "document", features: ["Security guides", "Security policies", "Security processes"] }
      ]
    },
    levels: {
      title: "Evaluation Levels",
      subtitle: "Common Criteria defines seven evaluation levels (EAL1-EAL7) to determine security assurance.",
      items: [
        { level: "EAL1", title: "Basic Testing", description: "Basic security testing and documentation", icon: "minus", requirements: ["Basic testing", "Documentation", "Overview"] },
        { level: "EAL2", title: "Substantial Testing", description: "Substantial security testing and analysis", icon: "check", requirements: ["Substantial testing", "Security analysis", "Documentation"] },
        { level: "EAL3", title: "High Testing", description: "High level security testing and analysis", icon: "shield", requirements: ["High level testing", "Security analysis", "Documentation"] },
        { level: "EAL4", title: "Substantial Design", description: "Substantial design and testing", icon: "target", requirements: ["Substantial design", "High level testing", "Documentation"] },
        { level: "EAL5", title: "High Design", description: "High level design and testing", icon: "shield", requirements: ["High level design", "High level testing", "Documentation"] },
        { level: "EAL6", title: "Substantial Assurance", description: "Substantial assurance and testing", icon: "check", requirements: ["Substantial assurance", "High level testing", "Documentation"] },
        { level: "EAL7", title: "High Assurance", description: "High level assurance and testing", icon: "shield", requirements: ["High level assurance", "High level testing", "Documentation"] }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Clear and structured process for Common Criteria certification.",
      steps: [
        { step: "1", title: "Common Criteria Assessment", description: "Assess current security posture against Common Criteria requirements" },
        { step: "2", title: "Gap Analysis", description: "Identify gaps and plan remediation measures" },
        { step: "3", title: "Planning", description: "Plan Common Criteria certification program" },
        { step: "4", title: "Implementation", description: "Implement required security measures" },
        { step: "5", title: "Certification", description: "Pass Common Criteria certification" }
      ]
    },
    benefits: {
      title: "Common Criteria Certification Benefits",
      subtitle: "Achieve concrete benefits with Common Criteria certification.",
      items: [
        "Meet international cybersecurity standards",
        "Strengthen security reliability",
        "Improve customer trust",
        "Competitive advantage in markets",
        "Global recognition"
      ]
    },
    cta: {
      title: "Ready to start your Common Criteria certification?",
      subtitle: "Contact us and let's start your Common Criteria certification process.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "Common Criteria",
      subtitle: "Tietoturvan Arviointi & Sertifiointi",
      description: "Ammattimaiset Common Criteria sertifiointi- ja arviointipalvelut. Autamme organisaatioita saavuttamaan kansainvälisen tietoturvastandardin. Saavuta Common Criteria sertifiointi ja vahvista organisaatiosi tietoturvan luotettavuus.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    components: {
      title: "Common Criteria Komponentit",
      subtitle: "Common Criteria perustuu neljään pääkomponenttiin, jotka määrittelevät tietoturvan arviointin.",
      items: [
        { title: "Tietoturva Tavoitteet", description: "Määritellään tietoturvatavoitteet ja -vaatimukset", icon: "target", features: ["Tietoturvatavoitteet", "Tietoturvavaatimukset", "Uhkien mallit"] },
        { title: "Tietoturva Toimenpiteet", description: "Toteutetaan tietoturvatoimenpiteet ja -mekanismit", icon: "shield", features: ["Tietoturvamekanismit", "Tietoturvapolitiikat", "Tietoturvaprotokollat"] },
        { title: "Tietoturva Testaus", description: "Suoritetaan kattavat tietoturvatestit", icon: "check", features: ["Penetraatiotestit", "Haavoittuvuustestit", "Tietoturva-analyysi"] },
        { title: "Tietoturva Dokumentaatio", description: "Luodaan kattava tietoturvadokumentaatio", icon: "document", features: ["Tietoturvaohjeet", "Tietoturvapolitiikat", "Tietoturvaprosessit"] }
      ]
    },
    levels: {
      title: "Arviointitasot",
      subtitle: "Common Criteria määrittelee seitsemän arviointitasoa (EAL1-EAL7) tietoturvan luotettavuuden määrittämiseksi.",
      items: [
        { level: "EAL1", title: "Perustason Testaus", description: "Perustason tietoturvatestaus ja dokumentaatio", icon: "minus", requirements: ["Perustason testaus", "Dokumentaatio", "Yleiskatsaus"] },
        { level: "EAL2", title: "Merkittävä Testaus", description: "Merkittävä tietoturvatestaus ja analyysi", icon: "check", requirements: ["Merkittävä testaus", "Tietoturva-analyysi", "Dokumentaatio"] },
        { level: "EAL3", title: "Korkeatason Testaus", description: "Korkeatason tietoturvatestaus ja analyysi", icon: "shield", requirements: ["Korkeatason testaus", "Tietoturva-analyysi", "Dokumentaatio"] },
        { level: "EAL4", title: "Merkittävä Suunnittelu", description: "Merkittävä suunnittelu ja testaus", icon: "target", requirements: ["Merkittävä suunnittelu", "Korkeatason testaus", "Dokumentaatio"] },
        { level: "EAL5", title: "Korkeatason Suunnittelu", description: "Korkeatason suunnittelu ja testaus", icon: "shield", requirements: ["Korkeatason suunnittelu", "Korkeatason testaus", "Dokumentaatio"] },
        { level: "EAL6", title: "Merkittävä Varmistus", description: "Merkittävä varmistus ja testaus", icon: "check", requirements: ["Merkittävä varmistus", "Korkeatason testaus", "Dokumentaatio"] },
        { level: "EAL7", title: "Korkeatason Varmistus", description: "Korkeatason varmistus ja testaus", icon: "shield", requirements: ["Korkeatason varmistus", "Korkeatason testaus", "Dokumentaatio"] }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi Common Criteria sertifiointiin.",
      steps: [
        { step: "1", title: "Common Criteria Arviointi", description: "Arvioidaan nykyinen tietoturvataso Common Criteria vaatimusten suhteen" },
        { step: "2", title: "Gap Analysis", description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot" },
        { step: "3", title: "Suunnittelu", description: "Suunnitellaan Common Criteria sertifiointiohjelma" },
        { step: "4", title: "Toteutus", description: "Toteutetaan tarvittavat tietoturvatoimenpiteet" },
        { step: "5", title: "Sertifiointi", description: "Läpäistään Common Criteria sertifiointi" }
      ]
    },
    benefits: {
      title: "Common Criteria Sertifioinnin Edut",
      subtitle: "Saavuta konkreettisia hyötyjä Common Criteria sertifioinnin avulla.",
      items: [
        "Täytä kansainväliset tietoturvastandardit",
        "Vahvista tietoturvan luotettavuus",
        "Paranna asiakkaiden luottamusta",
        "Kilpailuetu markkinoilla",
        "Globaali tunnustus"
      ]
    },
    cta: {
      title: "Valmiit aloittamaan Common Criteria sertifioinnin?",
      subtitle: "Ota yhteyttä meihin ja aloitetaan Common Criteria sertifiointiprosessi.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Components Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.components.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.components.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {currentContent.components.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {item.description}
          </p>
          
          <div class="mt-auto">
            <ul class="space-y-1.5">
              {item.features.map((feature) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Evaluation Levels Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.levels.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.levels.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {currentContent.levels.items.map((level) => (
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    text-center">
          
          <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-2">
            <span class="text-sm font-bold text-blue-600">{level.level}</span>
          </div>
          
          <h3 class="text-xs font-bold text-slate-800 mb-1">{level.title}</h3>
          <p class="text-slate-500 text-xs mb-2">{level.description}</p>
          <div class="flex flex-wrap justify-center gap-1">
            {level.requirements.map((req) => (
              <span class="text-xs text-slate-400">• {req}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.benefits.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.benefits.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6">
      {currentContent.benefits.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-6 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    flex items-center justify-center">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <span class="text-slate-700 text-sm font-medium">{item}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>