---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Fraud Risk Assessment | BEC & Payment Fraud Protection",
  description: "Comprehensive fraud risk assessment across TPRM, payment and user processes – BEC, invoice fraud, account takeover. Identify and mitigate fraud risks effectively.",
  keywords: "fraud risk assessment, BEC, invoice fraud, account takeover, payment fraud, fraud controls, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Fraud Risk Assessment",
      subtitle: "BEC & Payment Fraud Protection",
      description: "Comprehensive fraud risk assessment across TPRM, payment and user processes – BEC, invoice fraud, account takeover. Identify and mitigate fraud risks effectively.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    },
    lenses: {
      title: "Fraud Risk Mapping",
      subtitle: "We identify and assess the most critical fraud risks in your organization.",
      items: [
        { title: "Social engineering", description: "Phishing, vishing, pretexting and other manipulation techniques", icon: "user" },
        { title: "BEC and invoice fraud", description: "CEO fraud, vendor impersonation and payment fraud", icon: "mail" },
        { title: "Process and payment controls", description: "Payment process validation and four-eyes principle", icon: "document" },
        { title: "Third‑party risks", description: "Supply chain fraud risks and partner validation", icon: "network" }
      ]
    },
    threats: {
      title: "Common Fraud Threats",
      subtitle: "Fraud threats against organizations continuously evolve – know the risks and build protection.",
      items: [
        { title: "BEC (Business Email Compromise)", description: "CEO fraud, invoice fraud and banking detail changes", icon: "alert" },
        { title: "Vishing and Smishing", description: "Phone-based and SMS-based fraud attacks", icon: "phone" },
        { title: "Account Takeover", description: "User account compromise and abuse", icon: "user-x" },
        { title: "Payment Fraud", description: "Card fraud and bank transfer manipulation", icon: "credit-card" }
      ]
    },
    controls: {
      title: "Fraud Risk Controls",
      subtitle: "Multi-layered approach through technical, process, and human controls.",
      items: [
        { title: "Technical Controls", features: ["SPF/DKIM/DMARC configuration", "Anti-spoofing protection", "MFA for all accounts", "Anomaly detection"], icon: "shield" },
        { title: "Process Controls", features: ["Four-eyes principle for payments", "Vendor information validation", "Change process verification", "Escalation procedures"], icon: "clipboard" },
        { title: "Staff Training", features: ["Fraud risk recognition", "Verification procedures", "Reporting channels", "Simulations and testing"], icon: "users" }
      ]
    },
    process: {
      title: "Assessment Process",
      subtitle: "Systematic approach to identify fraud risks and design controls.",
      steps: [
        { step: "1", title: "Threat Analysis", description: "Industry-specific fraud risks" },
        { step: "2", title: "Process Review", description: "Critical process assessment" },
        { step: "3", title: "Technical Testing", description: "Phishing simulations and tests" },
        { step: "4", title: "Recommendations", description: "Control matrix and actions" },
        { step: "5", title: "Implementation", description: "Controls and training program" }
      ]
    },
    cta: {
      title: "Request a fraud risk review",
      subtitle: "We'll review critical processes and strengthen controls.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "Book Consultation", href: "/contact?consultation=true" }
    }
  },
  fi: {
    hero: {
      title: "Petosriskien arviointi",
      subtitle: "BEC- ja maksupetossuoja",
      description: "TPRM, maksuprosessit ja käyttäjäprosessit läpikäyvää petosriskiarviointia – BEC, laskupetos, tilin kaappaus. Tunnista ja vähennä petosriskejä tehokkaasti.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    },
    lenses: {
      title: "Petosuhkien kartoitus",
      subtitle: "Tunnistamme ja arvioimme keskeisimmät petosriskit organisaatiossanne.",
      items: [
        { title: "Sosiaalinen manipulointi", description: "Phishing, vishing, pretexting ja muut manipulointitekniikat", icon: "user" },
        { title: "BEC ja laskupetos", description: "CEO-fraud, toimittajien tietojen vaihto ja maksupetokset", icon: "mail" },
        { title: "Prosessi- ja maksukontrollit", description: "Maksuprosessien validointi ja nelisilmäperiaate", icon: "document" },
        { title: "Kolmannen osapuolen riskit", description: "Toimittajaketjun petosriskit ja kumppanivalidointi", icon: "network" }
      ]
    },
    threats: {
      title: "Yleisimmät petosuhkat",
      subtitle: "Organisaatioita kohtaavat petosuhkat kehittyvät jatkuvasti – tunnetaan riskit ja rakenteet suojaus.",
      items: [
        { title: "BEC (Business Email Compromise)", description: "CEO-fraud, laskupetokset ja pankkitietojen vaihto", icon: "alert" },
        { title: "Vishing ja Smishing", description: "Puhelinpetokset ja tekstiviestipetokset", icon: "phone" },
        { title: "Tilin kaappaus", description: "Käyttäjätilien haltuunotto ja väärinkäyttö", icon: "user-x" },
        { title: "Maksupetokset", description: "Korttipetokset ja pankkisiirtojen manipulointi", icon: "credit-card" }
      ]
    },
    controls: {
      title: "Petosriskien kontrollit",
      subtitle: "Monikerroksinen lähestymistapa teknisten, prosessuaalisten ja henkilöstöön liittyvien kontrollien avulla.",
      items: [
        { title: "Tekninen suojaus", features: ["SPF/DKIM/DMARC konfigurointi", "Väärennyssuojaus", "MFA kaikille tileille", "Anomalianseuranta"], icon: "shield" },
        { title: "Prosessikontrollit", features: ["Nelisilmäperiaate maksuille", "Toimittajatietojen validointi", "Muutosprosessien vahvistus", "Eskalointiprosessit"], icon: "clipboard" },
        { title: "Henkilöstön koulutus", features: ["Petosriskien tunnistaminen", "Varmistusprosessit", "Raportointikanavat", "Simulaatiot ja testit"], icon: "users" }
      ]
    },
    process: {
      title: "Arviointiprosessi",
      subtitle: "Systemaattinen lähestymistapa petosriskien tunnistamiseen ja kontrollien suunnitteluun.",
      steps: [
        { step: "1", title: "Uhka-analyysi", description: "Toimialakohtaiset petosriskit" },
        { step: "2", title: "Prosessikatsaus", description: "Kriittisten prosessien arviointi" },
        { step: "3", title: "Tekninen testaus", description: "Phishing-simulaatiot ja testit" },
        { step: "4", title: "Suositukset", description: "Kontrollimatriisi ja toimenpiteet" },
        { step: "5", title: "Toteutus", description: "Kontrollit ja koulutusohjelma" }
      ]
    },
    cta: {
      title: "Pyydä petosriskikartoitus",
      subtitle: "Käydään kriittiset prosessit läpi ja vahvistetaan kontrollit.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Fraud Risk Mapping Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.lenses.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.lenses.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {currentContent.lenses.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Common Fraud Threats Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.threats.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.threats.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {currentContent.threats.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-5 border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-md transition-all duration-300
                    group">
          
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6]">
                <Icon name={item.icon} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-800 mb-1 group-hover:text-blue-700 transition-colors duration-300">
                {item.title}
              </h3>
              <p class="text-slate-500 text-xs">{item.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Fraud Risk Controls Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.controls.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.controls.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.controls.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <ul class="space-y-2">
            {item.features.map((feature) => (
              <li class="flex items-start text-sm text-slate-600">
                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Assessment Process Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.process.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.process.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-5 gap-6">
      {currentContent.process.steps.map((step) => (
        <div class="bg-slate-50/50 rounded-xl p-5 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="w-12 h-12 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] rounded-full flex items-center justify-center text-white font-bold mx-auto mb-3">
            {step.step}
          </div>
          
          <h3 class="text-sm font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {step.title}
          </h3>
          
          <p class="text-slate-500 text-xs leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>