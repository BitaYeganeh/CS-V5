---
import Layout from '@/layouts/Layout.astro';
import { t, getLanguageFromPath, getLanguagePrefix } from '@/utils/language';

const currentPath = Astro.url.pathname;
const lang = getLanguageFromPath(currentPath);
const langPrefix = getLanguagePrefix(lang);

const title = t('regulatoryComplianceTitle', lang);
const tagline = t('regulatoryComplianceTagline', lang);
const items = [
  {
    title: t('nis2ComplianceTitle', lang),
    href: `${langPrefix}/services/regulatory-compliance/nis2-compliance`,
    description: t('nis2ComplianceDesc', lang)
  },
  {
    title: t('doraComplianceTitle', lang),
    href: `${langPrefix}/services/regulatory-compliance/dora-compliance`,
    description: t('doraComplianceDesc', lang)
  },
  {
    title: t('gdprPrivacyTitle', lang),
    href: `${langPrefix}/services/regulatory-compliance/gdpr-privacy-services`,
    description: t('gdprPrivacyDesc', lang)
  },
  {
    title: t('eidasDigitalTrustTitle', lang),
    href: `${langPrefix}/services/regulatory-compliance/eidas-digital-trust`,
    description: t('eidasDigitalTrustDesc', lang)
  },
  {
    title: t('eprivacyCookieTitle', lang),
    href: `${langPrefix}/services/regulatory-compliance/eprivacy-cookie-compliance`,
    description: t('eprivacyCookieDesc', lang)
  }
];
---

<Layout title={title} description={tagline}>
  <section class="bg-gradient-to-br from-teal-50 via-white to-blue-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">{title}</h1>
      <p class="mt-3 text-slate-600 text-lg">{tagline}</p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {items.map((s) => (
          <a href={s.href} class="group block rounded-xl border border-gray-200 p-6 bg-white hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900 group-hover:text-gray-700">{s.title}</h3>
            <p class="mt-2 text-gray-600 text-sm">{s.description}</p>
            <span class="inline-flex items-center mt-4 text-gray-900 font-medium">{t('readMore', lang)} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

