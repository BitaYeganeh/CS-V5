---
import Layout from "../layouts/Layout.astro";
import Button from '@/components/ui/Button.astro';

// SEO Configuration (language-aware)
const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const seoConfig = {
  title: lang === 'fi'
    ? 'Kyberturvallisuuspalvelut | ISO 27001, NIS2, GDPR, DORA - Cyber Security Finland'
    : 'Cybersecurity Services | ISO 27001, NIS2, GDPR, DORA Implementation - Cyber Security Finland',
  description: lang === 'fi'
    ? 'Kattavat kyberturvallisuuspalvelut sisältäen ISO 27001 -toteutukset, NIS2-vaatimustenmukaisuuden, GDPR-tietosuojapalvelut, DORA-valmiudet ja riskienhallinnan.'
    : 'Comprehensive cybersecurity services including ISO 27001 implementation, NIS2 compliance, GDPR privacy services, DORA readiness, risk management, and virtual CISO/DPO services.',
  keywords: 'cybersecurity services, ISO 27001 implementation, NIS2 compliance, GDPR services, DORA implementation, risk management, virtual CISO, virtual DPO, information security consulting',
  type: 'website' as const,
  schema: {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: lang === 'fi' ? 'Palvelut' : 'Cybersecurity Services',
    description: lang === 'fi' ? 'Kattavat kyberturvallisuus- ja vaatimustenmukaisuuden palvelut suomalaisille organisaatioille' : 'Comprehensive cybersecurity and compliance services for Finnish businesses',
  }
};
const pageTitle = lang === 'fi' ? 'Palvelut' : 'Services';
---
<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  type={seoConfig.type}
  schema={seoConfig.schema}
>
  <section class="py-20 bg-gradient-to-b from-teal-50 to-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-6">{lang === 'fi' ? 'Täydelliset kyberturvallisuus- ja vaatimustenmukaisuuspavelut' : 'Complete Cybersecurity & Compliance Services'}</h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        {lang === 'fi' ? 'Luotettava kumppanisi monimutkaisten sääntelyvaatimusten navigointiin ja vahvojen suojauskehysten rakentamiseen.' : 'Your trusted partner for navigating complex regulatory requirements and building robust security frameworks.'}
      </p>
      <p class="text-lg text-slate-600 max-w-3xl mx-auto mt-4">
        {lang === 'fi' ? 'Cybersecurity.fi ymmärtää, että jokaisella organisaatiolla on ainutlaatuiset kyberturvahaasteet. Palveluvalikoimamme tarjoaa asiantuntijatukea turvallisuus- ja vaatimustenmukaisuusmatkan jokaisessa vaiheessa.' : 'At Cybersecurity.fi, we understand that every organization faces unique cybersecurity challenges. Our comprehensive service portfolio ensures you have expert support for every aspect of your security and compliance journey.'}
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Compliance Frameworks -->
        <div class="bg-white rounded-lg shadow-lg p-6 border border-slate-200">
          <h2 class="text-xl font-semibold text-slate-900 mb-4">{lang === 'fi' ? 'Säädöskehikot' : 'Compliance Frameworks'}</h2>
          <p class="text-sm text-slate-600 mb-4">{lang === 'fi' ? 'Muunna sääntelyvaatimukset liiketoimintaeduksi' : 'Transform regulatory requirements into business advantages'}</p>
          <p class="text-xs text-slate-500 mb-4">{lang === 'fi' ? 'Nykyaikaisten yritysten on navigoitava yhä monimutkaisemmassa kyberturvallisuuden sääntelyympäristössä. Yhteensopivuuskehyksemme varmistavat, että täytät vaatimukset ja samalla rakennat aitoja turvallisuuskyvykkyyksiä.' : 'Modern businesses must navigate an increasingly complex landscape of cybersecurity regulations. Our compliance framework services ensure you meet all requirements while building genuine security capabilities that protect your organization and create competitive advantages.'}</p>
          <ul class="space-y-2 text-sm text-slate-600">
            <li>• {lang === 'fi' ? 'ISO 27001 -toteutus ja sertifiointituki' : 'ISO 27001 Implementation & Certification Support'}</li>
            <li>• {lang === 'fi' ? 'SOC 2 Type I & Type II valmiusohjelmat' : 'SOC 2 Type I & Type II Readiness Programs'}</li>
            <li>• {lang === 'fi' ? 'GDPR / tietosuojan noudattaminen' : 'GDPR/Privacy Compliance & Data Protection'}</li>
            <li>• {lang === 'fi' ? 'NIS2-direktiivin toimeenpano ja jatkuva vaatimustenmukaisuus' : 'NIS2 Directive Implementation & Ongoing Compliance'}</li>
            <li>• {lang === 'fi' ? 'DORA (Digital Operational Resilience Act) rahoituspalveluille' : 'DORA (Digital Operational Resilience Act) for Financial Services'}</li>
            <li>• {lang === 'fi' ? 'Common Criteria -arviointi ja sertifiointituki' : 'Common Criteria Evaluation & Certification Support'}</li>
          </ul>
        </div>

        <!-- Risk Management -->
        <div class="bg-white rounded-lg shadow-lg p-6 border border-slate-200">
          <h2 class="text-xl font-semibold text-slate-900 mb-4">{lang === 'fi' ? 'Riskienhallinta' : 'Risk Management'}</h2>
          <p class="text-sm text-slate-600 mb-4">{lang === 'fi' ? 'Tunnista, arvioi ja vähennä kyberturvariskejä järjestelmällisesti' : 'Identify, assess, and mitigate cybersecurity risks systematically'}</p>
          <p class="text-xs text-slate-500 mb-4">{lang === 'fi' ? 'Tehokas riskienhallinta muodostaa perustan menestyvälle kyberturvallisuusohjelmalle. Palvelumme auttavat ymmärtämään uhkakenttää, priorisoimaan turvallisuussijoituksia ja rakentamaan resilienssiä.' : 'Effective risk management forms the foundation of any successful cybersecurity program. Our risk management services help you understand your threat landscape, prioritize security investments, and build resilience against evolving cyber threats.'}</p>
          <ul class="space-y-2 text-sm text-slate-600">
            <li>• {lang === 'fi' ? 'Kattavat riskienarvioinnit ja hallintaohjelmat' : 'Comprehensive Risk Assessments & Management Programs'}</li>
            <li>• {lang === 'fi' ? 'Kolmannen osapuolen riskien hallinta (TPRM) ja toimittajaturvallisuus' : 'Third-Party Risk Management (TPRM) & Vendor Security'}</li>
            <li>• {lang === 'fi' ? 'Liiketoiminnan jatkuvuus ja kriisinhallintasuunnittelu' : 'Business Continuity & Crisis Management Planning'}</li>
            <li>• {lang === 'fi' ? 'Uhkamallinnus ja keskeisten riskimittareiden (KRI) kehittäminen' : 'Threat Modeling & Key Risk Indicator (KRI) Development'}</li>
          </ul>
        </div>

        <!-- Governance & Policy -->
        <div class="bg-white rounded-lg shadow-lg p-6 border border-slate-200">
          <h2 class="text-xl font-semibold text-slate-900 mb-4">{lang === 'fi' ? 'Johtaminen & Politiikat' : 'Governance & Policy'}</h2>
          <p class="text-sm text-slate-600 mb-4">{lang === 'fi' ? 'Perusta vahva kyberturvallisuuden johtamiskehys' : 'Establish robust cybersecurity governance frameworks'}</p>
          <p class="text-xs text-slate-500 mb-4">{lang === 'fi' ? 'Vahva johtaminen varmistaa, että kyberturvallisuus on osa liiketoimintastrategiaa. Palvelumme auttavat rakentamaan vastuullisuutta, selkeitä politiikkoja ja tukevat päätöksentekoa kaikilla organisaatiotasoilla.' : 'Strong governance ensures cybersecurity becomes an integral part of your business strategy rather than just a technical concern. Our governance services help you build accountability, establish clear policies, and enable informed decision-making at all organizational levels.'}</p>
          <ul class="space-y-2 text-sm text-slate-600">
            <li>• {lang === 'fi' ? 'Kyberturvallisuuspoliittien kehitys ja toteutus' : 'Cybersecurity Policy Development & Implementation'}</li>
            <li>• {lang === 'fi' ? 'CISO-as-a-Service ja strateginen turvallisuusjohtaminen' : 'CISO-as-a-Service & Strategic Security Leadership'}</li>
            <li>• {lang === 'fi' ? 'Virtuaalinen CISO (V-CISO) -palvelu' : 'Virtual CISO (V-CISO) Services'}</li>
            <li>• {lang === 'fi' ? 'Turvallisuusjohtamisen kehys' : 'Security Governance Framework Design & Implementation'}</li>
            <li>• {lang === 'fi' ? 'Johtotason riskiraportointi ja esitykset' : 'Board-Level Risk Reporting & Executive Briefings'}</li>
          </ul>
        </div>

        <!-- Specialized Services -->
        <div class="bg-white rounded-lg shadow-lg p-6 border border-slate-200">
          <h2 class="text-xl font-semibold text-slate-900 mb-4">{lang === 'fi' ? 'Erikoistuneet palvelut' : 'Specialized Services'}</h2>
          <p class="text-sm text-slate-600 mb-4">{lang === 'fi' ? 'Asiantuntijapalvelut erityistarpeisiin' : 'Expert services for specific cybersecurity needs'}</p>
          <p class="text-xs text-slate-500 mb-4">{lang === 'fi' ? 'Joihinkin turvallisuushaasteisiin tarvitaan erityisosaamista ja kohdennettuja ratkaisuja. Erikoistuneet palvelumme vastaavat näihin tarpeisiin.' : 'Some security challenges require specialized expertise and focused solutions. Our specialized services address unique requirements that don\\'t fit standard frameworks but are critical for comprehensive protection.'}</p>
          <ul class="space-y-2 text-sm text-slate-600">
            <li>• {lang === 'fi' ? 'Anti-fraud -palvelut ja talousrikosten ehkäisy' : 'Anti-Fraud Services & Financial Crime Prevention'}</li>
            <li>• {lang === 'fi' ? 'eIDAS / digitaalinen luottamus -neuvonta ja toteutus' : 'eIDAS/Digital Trust Advisory & Implementation'}</li>
            <li>• {lang === 'fi' ? 'Auditointivalmistelu ja tukipalvelut' : 'Audit Preparation & Support Services'}</li>
            <li>• {lang === 'fi' ? 'Lead Auditor -palvelut ja riippumattomat arvioinnit' : 'Lead Auditor Services & Independent Assessments'}</li>
            <li>• {lang === 'fi' ? 'Tietosuojavastaavan (DPO) palvelut' : 'Data Protection Officer (DPO) Services'}</li>
            <li>• {lang === 'fi' ? 'Virtuaalinen DPO (V-DPO) -palvelu' : 'Virtual DPO (V-DPO) Services'}</li>
          </ul>
        </div>
      </div>

      <div class="mt-16 text-center">
        <Button href="/contact" variant="primary">
          {lang === 'fi' ? 'Hanki ilmainen arviointi' : 'Get a Free Assessment'}
        </Button>
      </div>
    </div>
  </section>
</Layout>

