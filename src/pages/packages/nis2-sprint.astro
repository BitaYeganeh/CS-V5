  subtitle: lang === 'fi'
    ? (isHomepage ? "Nopeutettu 12 viikon ohjelma, jolla varmistetaan täysi NIS2-direktiivin vaatimustenmukaisuus kriittiselle infrastruktuurille ja keskeisille palveluntarjoajille" : "Nopeutettu 12 viikon ohjelma NIS2-direktiivin vaatimustenmukaisuuteen")
    : (isHomepage ? "Accelerated 12-week program ensuring full NIS2 Directive compliance for critical infrastructure and essential service providers" : "Accelerated 12-week program for NIS2 Directive compliance"),
  description: lang === 'fi'
    ? (isHomepage ? "Cybersecurity.fi:n NIS2 Sprint -ohjelma toimittaa kattavan kyberturvallisuuden hallinnon, riskienhallinnan ja häiriönhallintakyvykkyydet, jotka vaaditaan EU:n NIS2-direktiivissä. Nopeuta vaatimustenmukaisuuttasi rakentamalla samalla kestävän kyberturvallisuuden perustan, joka suojaa kriittisiä toimintoja ja varmistaa sääntelyn noudattamisen." : "NIS2 Sprint -ohjelma tarjoaa kattavat kyberturvallisuuden hallinnon, riskienhallinnan ja häiriönhallintakyvykkyydet, jotka vaaditaan EU:n NIS2-direktiivissä.")
