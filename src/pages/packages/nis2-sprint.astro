    : "NIS2 finland, NIS2 directive, NIS2 compliance, NIS2 implementation, cybersecurity finland, NIS2 consulting",
  type: "product" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "NIS2 Sprint Program",
    "description": "Rapid NIS2 directive compliance implementation for essential and important entities in Finland",
    "provider": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "url": "https://cybersecurity.fi"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Finland"
    },
    "offers": {
      "@type": "Offer",
      "price": "Contact for pricing",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Organization",
        "name": "Cyber Security Finland"
      }
    },
    "serviceType": "NIS2 Directive Implementation and Compliance",
    "availableLanguage": ["English", "Finnish"]
  }
};

// Check if this is the homepage to show promotional content
