---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import CTA from '@/components/sections/CTA.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

// SEO Configuration
const seoConfig = {
  title: lang === 'fi' ? "ISO 27001 Fast-Track (90–120 päivää) | Cyber Security Finland" : "ISO 27001 Fast‑Track (90–120 days) | Cyber Security Finland",
  description: lang === 'fi'
    ? "Nopea ISO 27001 -toteutus 90-120 päivässä. Kattava tietoturvajärjestelmän toteutus, dokumentointi, koulutus ja sertifiointituki mukana."
    : "Fast-track ISO 27001 implementation in 90-120 days. Complete ISMS implementation, documentation, training, and certification support included.",
  keywords: lang === 'fi'
    ? "ISO 27001 Suomi, ISO 27001 nopea toteutus, ISO 27001 sertifiointi, tietoturvajärjestelmä Suomi, ISO 27001 konsultointi"
    : "ISO 27001 finland, ISO 27001 fast track, ISO 27001 certification, information security management system, ISO 27001 consulting",
  type: "product" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "ISO 27001 Fast-Track Package",
    "description": "Complete ISO 27001 Information Security Management System implementation in 90-120 days with expert guidance and ongoing support",
    "provider": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "url": "https://cybersecurity.fi"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Finland"
    },
    "offers": {
      "@type": "Offer",
      "price": "Contact for pricing",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Organization",
        "name": "Cyber Security Finland"
      }
    },
    "serviceType": "ISO 27001 Implementation and Certification",
    "availableLanguage": ["English", "Finnish"]
  }
};

const heroContent = {
  title: lang === 'fi' ? "ISO 27001 Fast-Track: Täydellinen toteutus 90-120 päivässä" : "ISO 27001 Fast-Track: Complete Implementation in 90-120 Days",
  subtitle: lang === 'fi' ? "Arvioinnista sertifiointiin ennätysajassa" : "From assessment to certification in record time",
  description: lang === 'fi' 
    ? "Muuta tietoturvasi hallinta vain 3-4 kuukaudessa todistetulla fast-track -menetelmällämme. Tämä kattava ohjelma vie sinut alkukartoituksesta ISO 27001 -sertifiointiin sisältäen kaiken tarvittavan."
    : "Transform your information security management in just 3-4 months with our proven fast-track methodology. This all-inclusive program takes you from initial assessment to ISO 27001 certification with everything you need included.",
  primaryCTA: { text: lang === 'fi' ? "Aloita nyt" : "Get Started", href: "/contact?package=iso-27001-fast-track" },
  secondaryCTA: { text: lang === 'fi' ? "Lue lisää" : "Learn More", href: lang === 'fi' ? "/fi/services/iso-27001-services" : "/services/iso-27001" }
};

const packageFeatures = [
  {
    title: lang === 'fi' ? "Arviointi & Suunnittelu" : "Assessment & Planning",
    description: lang === 'fi'
      ? "Kattava tietoturvan tilan arviointi ja puuteanalyysi (gap analysis), riskien arviointi kattaen kaikki organisaation varat ja prosessit, toteutussuunnitelma yksityiskohtaisella aikataululla ja virstanpylväillä."
      : "Comprehensive security posture assessment and gap analysis, risk assessment covering all organizational assets and processes, implementation roadmap with detailed timeline and milestones.",
    duration: lang === 'fi' ? "Viikot 1-2" : "Weeks 1-2"
  },
  {
    title: lang === 'fi' ? "Toteutuspalvelut" : "Implementation Services",
    description: lang === 'fi'
      ? "Tietoturvallisuuden hallintajärjestelmän (ISMS) suunnittelu, politiikkakirjaston kehittäminen (50+ käytäntöä ja menettelytapaa), riskien käsittelysuunnitelman toteutus ja hallintakeinojen käyttöönotto."
      : "Information Security Management System (ISMS) design, policy library development (50+ policies and procedures), risk treatment plan implementation and control deployment.",
    duration: lang === 'fi' ? "Viikot 3-8" : "Weeks 3-8"
  },
  {
    title: lang === 'fi' ? "Koulutus & Dokumentaatio" : "Training & Documentation",
    description: lang === 'fi'
      ? "Kattavat henkilöstön koulutusohjelmat kaikille tasoille, täydellinen dokumentaatiopaketti ammattimaisella ISMS-dokumentaatiolla, toteutustyökalut ja järjestelmät."
      : "Comprehensive staff training programs across all levels, complete documentation package with professional ISMS documentation, implementation tools & systems.",
    duration: lang === 'fi' ? "Viikot 9-10" : "Weeks 9-10"
  },
  {
    title: lang === 'fi' ? "Sertifiointi & Tuki" : "Certification & Support",
    description: lang === 'fi'
      ? "Vaiheen 1 ja 2 auditointivalmistelu ja tuki, yhteistyö sertifiointielimen kanssa, 12 kuukauden tuki ja ohjaus sertifioinnin jälkeen."
      : "Stage 1 and Stage 2 audit preparation and support, certification body liaison, 12-month post-certification support and guidance.",
    duration: lang === 'fi' ? "Viikot 11-12" : "Weeks 11-12"
  }
];

const benefits = [
  lang === 'fi' ? "Saavuta sertifiointi 3x nopeammin kuin perinteisillä tavoilla" : "Achieve certification 3x faster than traditional approaches",
  lang === 'fi' ? "Kattava dokumentaatiopaketti sisältyy hintaan" : "Comprehensive documentation package included",
  lang === 'fi' ? "Oma nimetty projektipäällikkö" : "Dedicated project manager assigned",
  lang === 'fi' ? "Viikoittaiset edistymiskatsaukset ja raportointi" : "Weekly progress reviews and reporting",
  lang === 'fi' ? "Sertifioinnin jälkeinen ylläpitotuki" : "Post-certification maintenance support",
  lang === 'fi' ? "Riskirekisteri ja käsittelysuunnitelma" : "Risk register and treatment plan",
  lang === 'fi' ? "Henkilöstön koulutus- ja tietoisuusohjelma" : "Employee training and awareness program",
  lang === 'fi' ? "Häiriönhallintamenettelyt" : "Incident response procedures"
];

const packageIncludes = [
  lang === 'fi' ? "Täydellinen ISO 27001 -toteutus" : "Complete ISO 27001 implementation",
  lang === 'fi' ? "Kaikki vaadittu dokumentaatio" : "All required documentation",
  lang === 'fi' ? "Henkilöstökoulutus (jopa 20 työntekijää)" : "Staff training (up to 20 employees)",
  lang === 'fi' ? "Sisäinen auditointi ja puuteanalyysi" : "Internal audit and gap analysis",
  lang === 'fi' ? "Sertifiointiauditoinnin tuki" : "Certification audit support",
  lang === 'fi' ? "3 kuukauden tuki sertifioinnin jälkeen" : "3 months post-certification support"
];
---

<Layout seoConfig={seoConfig}>
  <HeroSection content={heroContent} variant="simple" />
  
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{lang === 'fi' ? "Fast-Track -toteutusprosessi" : "Fast-Track Implementation Process"}</h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          {lang === 'fi' 
            ? "Todistettu 16 viikon menetelmämme vie sinut alusta sertifiointiin tehokkaasti ja tuloksellisesti."
            : "Our proven 16-week methodology gets you from start to certification efficiently and effectively."}
        </p>
      </div>
      
      <div class="space-y-8">
        {packageFeatures.map((feature, index) => (
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center mr-6">
              <span class="text-teal-600 font-semibold">{index + 1}</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-xl font-semibold text-slate-900">{feature.title}</h3>
                <span class="text-sm bg-slate-100 text-slate-700 px-3 py-1 rounded-full">{feature.duration}</span>
              </div>
              <p class="text-slate-600">{feature.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-6">{lang === 'fi' ? "Mitä paketti sisältää" : "What's Included"}</h2>
          <ul class="space-y-3">
            {benefits.map(benefit => (
              <li class="flex items-start">
                <svg class="w-5 h-5 text-teal-600 mr-3 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-slate-700">{benefit}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="bg-white rounded-lg shadow-lg p-8">
          <h3 class="text-2xl font-bold text-slate-900 mb-4">Package Includes</h3>
          
          <ul class="space-y-2 mb-6">
            {packageIncludes.map(item => (
              <li class="flex items-start">
                <svg class="w-4 h-4 text-teal-600 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-slate-700">{item}</span>
              </li>
            ))}
          </ul>
          
          <Button
            href="/contact?package=iso-27001-fast-track"
            variant="primary"
            className="w-full py-3 px-6 font-semibold"
          >
            Get Started Today
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Why Choose Fast-Track?</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="bg-teal-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-slate-900 mb-2">Time to Market</h3>
          <p class="text-slate-600">Get certified quickly to meet customer requirements and win new business opportunities.</p>
        </div>
        
        <div class="text-center">
          <div class="bg-teal-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-slate-900 mb-2">Proven Success</h3>
          <p class="text-slate-600">95% first-time certification success rate with our fast-track methodology.</p>
        </div>
        
        <div class="text-center">
          <div class="bg-teal-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-slate-900 mb-2">Cost Effective</h3>
          <p class="text-slate-600">Fixed-price package with no hidden costs or scope creep concerns.</p>
        </div>
      </div>
    </div>
  </section>

  <CTA 
    title="Ready to Fast-Track Your ISO 27001 Certification?"
    description="Join over 50 organizations that have achieved ISO 27001 certification with our fast-track program."
    primaryCTA={{ text: "Schedule Consultation", href: "/contact?package=iso-27001-fast-track" }}
    secondaryCTA={{ text: "View All Packages", href: "/packages" }}
  />
</Layout>

