---
import Layout from '@/layouts/Layout.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? "Evästekäytäntö" : "Cookie Policy",
  description: lang === 'fi'
    ? "Cyber Security Finlandin evästekäytäntö. Lue kuinka käytämme evästeitä verkkosivustollamme."
    : "Cookie Policy of Cyber Security Finland. Learn how we use cookies on our website.",
  type: "website" as const
};

const content = {
  en: {
    title: "Cookie Policy",
    lastUpdated: "Last updated: January 2025",
    intro: "This policy explains how Cyber Security Finland uses cookies and similar technologies on our website.",
    sections: [
      {
        title: "1. What Are Cookies",
        content: "Cookies are small text files stored on your device when you visit a website. They help websites remember your preferences and improve your browsing experience."
      },
      {
        title: "2. Cookies We Use",
        content: "We use the following types of cookies: Essential cookies (necessary for website functionality), Analytics cookies (Google Analytics to understand how visitors use our site), and Performance cookies (to improve website performance)."
      },
      {
        title: "3. Essential Cookies",
        content: "These cookies are necessary for the website to function properly. They enable basic functions like page navigation and access to secure areas. The website cannot function properly without these cookies."
      },
      {
        title: "4. Analytics Cookies",
        content: "We use Google Analytics to collect information about how visitors use our website. This helps us improve our services and user experience. These cookies collect information in an anonymous form."
      },
      {
        title: "5. Managing Cookies",
        content: "You can control and manage cookies through your browser settings. Note that disabling certain cookies may affect website functionality. Most browsers allow you to block or delete cookies."
      },
      {
        title: "6. Third-Party Cookies",
        content: "Some of our pages may contain content from third-party services that may set their own cookies. We do not control these cookies. Please refer to the respective third-party privacy policies."
      },
      {
        title: "7. Updates to This Policy",
        content: "We may update this cookie policy from time to time. Any changes will be posted on this page with an updated revision date."
      },
      {
        title: "8. Contact Us",
        content: "If you have questions about our use of cookies, please contact us at info@cybersecurity.fi."
      }
    ]
  },
  fi: {
    title: "Evästekäytäntö",
    lastUpdated: "Päivitetty viimeksi: Tammikuu 2025",
    intro: "Tämä käytäntö selittää, kuinka Cyber Security Finland käyttää evästeitä ja vastaavia teknologioita verkkosivustollamme.",
    sections: [
      {
        title: "1. Mitä evästeet ovat",
        content: "Evästeet ovat pieniä tekstitiedostoja, jotka tallennetaan laitteellesi, kun vierailet verkkosivustolla. Ne auttavat verkkosivustoja muistamaan asetuksesi ja parantamaan selauskokemustasi."
      },
      {
        title: "2. Käyttämämme evästeet",
        content: "Käytämme seuraavan tyyppisiä evästeitä: Välttämättömät evästeet (verkkosivuston toiminnallisuudelle välttämättömät), Analytiikkaevästeet (Google Analytics ymmärtääksemme, kuinka kävijät käyttävät sivustoamme) ja Suorituskykyevästeet (sivuston suorituskyvyn parantamiseksi)."
      },
      {
        title: "3. Välttämättömät evästeet",
        content: "Nämä evästeet ovat välttämättömiä verkkosivuston toimivuuden kannalta. Ne mahdollistavat perustoiminnot, kuten sivunavigaation ja pääsyn suojatuille alueille. Verkkosivusto ei voi toimia kunnolla ilman näitä evästeitä."
      },
      {
        title: "4. Analytiikkaevästeet",
        content: "Käytämme Google Analyticsia kerätäksemme tietoja siitä, miten kävijät käyttävät verkkosivustoamme. Tämä auttaa meitä parantamaan palveluitamme ja käyttökokemusta. Nämä evästeet keräävät tietoja nimettömässä muodossa."
      },
      {
        title: "5. Evästeiden hallinta",
        content: "Voit hallita evästeitä selaimesi asetuksista. Huomaa, että tiettyjen evästeiden poistaminen käytöstä voi vaikuttaa verkkosivuston toiminnallisuuteen. Useimmat selaimet sallivat evästeiden estämisen tai poistamisen."
      },
      {
        title: "6. Kolmannen osapuolen evästeet",
        content: "Jotkut sivuistamme voivat sisältää kolmannen osapuolen palveluiden sisältöä, jotka voivat asettaa omia evästeitään. Emme hallitse näitä evästeitä. Tutustu kyseisten kolmansien osapuolten tietosuojakäytäntöihin."
      },
      {
        title: "7. Päivitykset tähän käytäntöön",
        content: "Voimme päivittää tätä evästekäytäntöä aika ajoin. Kaikki muutokset julkaistaan tällä sivulla päivitetyllä muokkauspäivämäärällä."
      },
      {
        title: "8. Ota yhteyttä",
        content: "Jos sinulla on kysyttävää evästeistämme, ota yhteyttä osoitteeseen info@cybersecurity.fi."
      }
    ]
  }
};

const c = content[lang];
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#1E2A7A]">{c.title}</span>
        </h1>
        <p class="text-sm text-slate-500 mt-2">{c.lastUpdated}</p>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed mt-6">
          {c.intro}
        </p>
      </div>
      
    </div>
  </section>

  <!-- Content Sections -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="space-y-6">
        {c.sections.map((section, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-md transition-all duration-300">
            <h2 class="text-xl md:text-2xl font-bold text-[#1E2A7A] mb-3">
              {section.title}
            </h2>
            <p class="text-slate-500 leading-relaxed">
              {section.content}
            </p>
          </div>
        ))}
      </div>
      
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
          {lang === 'fi' ? 'Kysyttävää evästeistä?' : 'Questions About Cookies?'}
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          {lang === 'fi' 
            ? 'Jos sinulla on kysyttävää evästekäytännöstämme, ota meihin yhteyttä.' 
            : 'If you have any questions about our cookie policy, please contact us.'}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            {lang === 'fi' ? 'Ota yhteyttä' : 'Contact Us'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
          <a href="/" class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base gap-2">
            {lang === 'fi' ? 'Takaisin etusivulle' : 'Back to Home'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>