---
import Layout from '@/layouts/Layout.astro';

const title = 'Trust Center - Cyber Security Finland';
const description = 'Our Trust Center provides comprehensive information about security, compliance, and operational practices at Cyber Security Finland.';
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-white">
    <!-- Hero Section -->
    <section class="w-full text-white py-8 sm:py-12" style="background-color: #2563eb;">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl sm:text-4xl font-bold mb-3">🛡️ Trust Center</h1>
        <p class="text-base sm:text-lg mb-4 font-semibold">
          Comprehensive information about our security practices, compliance, and commitment to protecting your data
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <!-- Security & Compliance -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">🔒 Security & Compliance</h2>
        <div class="space-y-4">
          <div class="bg-blue-50 p-4 rounded-lg border-l-4 border-blue-500">
            <h3 class="font-bold text-slate-900 mb-2">ISO 27001 Certified</h3>
            <p class="text-slate-700 text-sm">
              Cyber Security Finland maintains ISO 27001 certification, demonstrating our commitment to information security management and best practices in protecting client data.
            </p>
          </div>

          <div class="bg-blue-50 p-4 rounded-lg border-l-4 border-blue-500">
            <h3 class="font-bold text-slate-900 mb-2">GDPR Compliant</h3>
            <p class="text-slate-700 text-sm">
              We fully comply with the General Data Protection Regulation (GDPR) and maintain robust data protection policies. All personal data is processed lawfully and securely.
            </p>
          </div>

          <div class="bg-blue-50 p-4 rounded-lg border-l-4 border-blue-500">
            <h3 class="font-bold text-slate-900 mb-2">NIS2 Directive Aligned</h3>
            <p class="text-slate-700 text-sm">
              Our operations and security practices align with the Network and Information Systems Security (NIS2) Directive, ensuring operational resilience and incident management capabilities.
            </p>
          </div>
        </div>
      </div>

      <!-- Data Protection -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">📋 Data Protection Practices</h2>
        <div class="space-y-3 text-slate-700">
          <div class="flex items-start gap-3">
            <span class="text-green-600 font-bold">✓</span>
            <div>
              <p class="font-semibold">Data Minimization</p>
              <p class="text-sm text-slate-600">We collect only the minimum data necessary to provide our services.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-green-600 font-bold">✓</span>
            <div>
              <p class="font-semibold">Encryption in Transit and at Rest</p>
              <p class="text-sm text-slate-600">All data communications use TLS/SSL encryption, and stored data is encrypted.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-green-600 font-bold">✓</span>
            <div>
              <p class="font-semibold">Access Controls</p>
              <p class="text-sm text-slate-600">Strict access controls ensure only authorized personnel can access client data.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-green-600 font-bold">✓</span>
            <div>
              <p class="font-semibold">Regular Backups</p>
              <p class="text-sm text-slate-600">We maintain regular encrypted backups to ensure business continuity and data recovery.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-green-600 font-bold">✓</span>
            <div>
              <p class="font-semibold">Incident Response</p>
              <p class="text-sm text-slate-600">We have documented incident response procedures and notification protocols.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Infrastructure Security -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">🏢 Infrastructure Security</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="bg-slate-50 p-4 rounded-lg border-l-4 border-slate-500">
            <h3 class="font-bold text-slate-900 mb-2">Cloud Infrastructure</h3>
            <p class="text-slate-700 text-sm">
              Our cloud infrastructure is hosted with leading providers that maintain SOC 2 Type II compliance and advanced security measures.
            </p>
          </div>

          <div class="bg-slate-50 p-4 rounded-lg border-l-4 border-slate-500">
            <h3 class="font-bold text-slate-900 mb-2">Network Security</h3>
            <p class="text-slate-700 text-sm">
              Advanced firewalls, DDoS protection, and intrusion detection systems protect our infrastructure from threats.
            </p>
          </div>

          <div class="bg-slate-50 p-4 rounded-lg border-l-4 border-slate-500">
            <h3 class="font-bold text-slate-900 mb-2">Vulnerability Management</h3>
            <p class="text-slate-700 text-sm">
              Regular security assessments and penetration testing identify and remediate vulnerabilities promptly.
            </p>
          </div>

          <div class="bg-slate-50 p-4 rounded-lg border-l-4 border-slate-500">
            <h3 class="font-bold text-slate-900 mb-2">Monitoring & Logging</h3>
            <p class="text-slate-700 text-sm">
              Continuous monitoring and comprehensive logging ensure we can detect and respond to security incidents.
            </p>
          </div>
        </div>
      </div>

      <!-- Certifications & Standards -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">📜 Certifications & Standards</h2>
        <div class="space-y-2 text-slate-700">
          <div class="flex items-center gap-2">
            <span class="text-blue-600 text-lg">★</span>
            <span>ISO 27001 - Information Security Management</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-blue-600 text-lg">★</span>
            <span>GDPR - General Data Protection Regulation</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-blue-600 text-lg">★</span>
            <span>NIS2 - Network and Information Systems Security Directive</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-blue-600 text-lg">★</span>
            <span>SOC 2 Type II - Service Organization Control</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-blue-600 text-lg">★</span>
            <span>OWASP - Web Application Security Practices</span>
          </div>
        </div>
      </div>

      <!-- Business Continuity -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">🔄 Business Continuity & Disaster Recovery</h2>
        <div class="bg-green-50 p-6 rounded-lg border-l-4 border-green-500">
          <p class="text-slate-700 mb-3">
            We maintain comprehensive business continuity and disaster recovery plans to ensure service availability:
          </p>
          <ul class="space-y-2 text-slate-700 text-sm">
            <li>• <strong>Recovery Time Objective (RTO):</strong> Committed to restoring services within defined timeframes</li>
            <li>• <strong>Recovery Point Objective (RPO):</strong> Minimal data loss through frequent backups</li>
            <li>• <strong>Regular Testing:</strong> DR procedures are tested regularly to ensure effectiveness</li>
            <li>• <strong>Redundancy:</strong> Geographically distributed infrastructure provides failover capabilities</li>
          </ul>
        </div>
      </div>

      <!-- Privacy & Transparency -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">🔐 Privacy & Transparency</h2>
        <div class="space-y-4">
          <div class="bg-purple-50 p-4 rounded-lg border-l-4 border-purple-500">
            <h3 class="font-bold text-slate-900 mb-2">Privacy Policy</h3>
            <p class="text-slate-700 text-sm mb-3">
              Our comprehensive privacy policy outlines how we collect, use, and protect personal data in compliance with GDPR and other regulations.
            </p>
            <a href="/about" class="text-purple-600 hover:text-purple-700 font-semibold text-sm">Read our Privacy Policy →</a>
          </div>

          <div class="bg-purple-50 p-4 rounded-lg border-l-4 border-purple-500">
            <h3 class="font-bold text-slate-900 mb-2">Data Processing Agreement (DPA)</h3>
            <p class="text-slate-700 text-sm mb-3">
              We provide Data Processing Agreements for clients requiring formal documentation of our data handling practices.
            </p>
            <a href="/about" class="text-purple-600 hover:text-purple-700 font-semibold text-sm">Request a DPA →</a>
          </div>

          <div class="bg-purple-50 p-4 rounded-lg border-l-4 border-purple-500">
            <h3 class="font-bold text-slate-900 mb-2">Transparency Reports</h3>
            <p class="text-slate-700 text-sm mb-3">
              We are committed to transparency in our operations and security practices. For questions, please contact us.
            </p>
            <a href="mailto:info@cybersecurity.fi" class="text-purple-600 hover:text-purple-700 font-semibold text-sm">Contact Us →</a>
          </div>
        </div>
      </div>

      <!-- Contact for Trust Issues -->
      <div class="mb-8 bg-black text-white p-6 rounded-lg">
        <h3 class="text-xl font-bold mb-3">❓ Questions About Security & Trust?</h3>
        <p class="mb-4 text-sm">
          If you have concerns about our security practices or need detailed information about compliance certifications:
        </p>
        <a 
          href="mailto:info@cybersecurity.fi" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg transition-all duration-200"
        >
          📧 Contact Our Security Team
        </a>
      </div>

      <!-- Related Resources -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">📚 Related Resources</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <a 
            href="/resources/scam-awareness" 
            class="p-4 rounded-lg border-2 border-slate-200 hover:border-red-500 hover:bg-red-50 transition-all duration-200"
          >
            <h3 class="font-bold text-slate-900 mb-2">🛡️ Scam Awareness</h3>
            <p class="text-sm text-slate-700">Learn about common scams and how to protect yourself.</p>
          </a>

          <a 
            href="/resources/dora-compliance" 
            class="p-4 rounded-lg border-2 border-slate-200 hover:border-purple-500 hover:bg-purple-50 transition-all duration-200"
          >
            <h3 class="font-bold text-slate-900 mb-2">📋 DORA Compliance</h3>
            <p class="text-sm text-slate-700">Understanding Digital Operational Resilience Act requirements.</p>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
