---
import Layout from '@/layouts/Layout.astro';

const title = 'Scam Awareness - Cyber Security Finland';
const description = 'Learn about scams impersonating Cyber Security Finland Oy. Protect yourself from fraudulent messages, calls, and crypto scams.';

const path = Astro.url.pathname;
const currentLang = path.startsWith('/it') ? 'it' : path.startsWith('/de') ? 'de' : 'en';

const translations = {
  en: {
    title: '⚠️ Scam Alert: Cyber Security Finland Impersonation',
    subtitle: 'Important information about fraudulent schemes targeting our clients and impersonating Cyber Security Finland Oy',
    warning: '🚨 If you receive suspicious messages: Do NOT share personal information, Trust Wallet details, or send money. Contact local police immediately.',
    whatHappening: 'What is Happening?',
    whatHappeningText: 'Scammers are impersonating Cyber Security Finland Oy through WhatsApp, email, and phone calls. They ask for money and personal information.',
    weHaveNothing: '⚠️ We have NOTHING to do with these scams.',
    ourContact: '✅ Our REAL Contact Information',
    onlyTrust: 'Only trust these official channels:',
    email: 'Email:',
    website: 'Website:',
    neverUse: '❌ We NEVER use fake emails like: support@cyber-agency.cc',
    commonScams: 'Common Scam Methods',
    realExamples: 'Real Examples We\'ve Seen',
