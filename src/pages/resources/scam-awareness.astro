    realExamples: 'Esempi Reali che Abbiamo Visto',
    protect: 'Come Proteggersi',
    doThis: '✅ FAI QUESTO',
    neverDo: '❌ NON FARE MAI QUESTO',
    ifScammed: '😰 Se Sei Stato Truffato',
    contactUs: '📞 Contattaci',
    questionsContact: '❓ Domande sulla Sicurezza e Fiducia?',
    whatWeDontDo: '📋 Cosa Cyber Security Finland NON Fa',
    strengthenSecurity: '🛡️ Rafforza la Tua Sicurezza Informatica',
    learnMore: 'Scopri di più su DORA',
    languages: 'Lingue Disponibili',
  },
  de: {
    title: '⚠️ Betrugwarnung: Betrügerische Darstellung von Cyber Security Finland',
    subtitle: 'Wichtige Informationen über betrügerische Machenschaften, die auf unsere Kunden abzielen und Cyber Security Finland Oy darstellen',
    warning: '🚨 Wenn Sie verdächtige Nachrichten erhalten: Geben Sie KEINE persönlichen Daten, Trust Wallet-Details oder Geld weiter. Wenden Sie sich sofort an die örtliche Polizei.',
    whatHappening: 'Was Passiert Hier?',
    whatHappeningText: 'Betrüger geben sich als Cyber Security Finland Oy aus, über WhatsApp, E-Mail und Telefon. Sie fordern Geld und persönliche Daten.',
    weHaveNothing: '⚠️ Wir haben NICHTS mit diesen Betrügereien zu tun.',
    ourContact: '✅ Unsere ECHTEN Kontaktdaten',
    onlyTrust: 'Vertrauen Sie nur diesen offiziellen Kanälen:',
    email: 'E-Mail:',
    website: 'Website:',
    neverUse: '❌ Wir verwenden NIEMALS gefälschte E-Mails wie: support@cyber-agency.cc',
    commonScams: 'Häufige Betrugsmethoden',
    realExamples: 'Echte Beispiele, die wir gesehen haben',
    protect: 'So Schützen Sie Sich',
    doThis: '✅ TUN SIE DIES',
    neverDo: '❌ TUN SIE NIEMALS DIES',
    ifScammed: '😰 Wenn Sie Betrogen Wurden',
    contactUs: '📞 Kontaktieren Sie Uns',
    questionsContact: '❓ Fragen zu Sicherheit und Vertrauen?',
    whatWeDontDo: '📋 Was Cyber Security Finland NICHT Tut',
    strengthenSecurity: '🛡️ Stärken Sie Ihre Cybersicherheit',
