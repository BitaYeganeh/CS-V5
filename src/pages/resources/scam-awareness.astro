    strengthenSecurity: '🛡️ Strengthen Your Cybersecurity',
    learnMore: 'Learn More About DORA',
    languages: 'Available Languages',
  },
  it: {
    title: '⚠️ Avviso di Truffa: Rappresentazione Fraudolenta di Cyber Security Finland',
    subtitle: 'Informazioni importanti sui sistemi fraudolenti che mirano ai nostri clienti e rappresentano Cyber Security Finland Oy',
    warning: '🚨 Se ricevi messaggi sospetti: NON condividere informazioni personali, dettagli di Trust Wallet o denaro. Contatta immediatamente la polizia locale.',
    whatHappening: 'Cosa Sta Succedendo?',
    whatHappeningText: 'I truffatori si stanno facendo passare per Cyber Security Finland Oy tramite WhatsApp, email e telefono. Chiedono denaro e informazioni personali.',
    weHaveNothing: '⚠️ NON abbiamo NULLA a che fare con queste truffe.',
    ourContact: '✅ Le Nostre VERE Informazioni di Contatto',
    onlyTrust: 'Fidati solo di questi canali ufficiali:',
    email: 'Email:',
    website: 'Sito Web:',
    neverUse: '❌ Non usiamo MAI email false come: support@cyber-agency.cc',
