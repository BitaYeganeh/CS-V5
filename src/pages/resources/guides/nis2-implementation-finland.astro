---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? 'NIS2‑toteutusopas suomalaisille organisaatioille' : 'NIS2 Implementation Guide for Finnish Organizations',
  description: lang === 'fi'
    ? 'Täydellinen tiekartta NIS2‑yhteensopivuuden saavuttamiseksi Suomen sääntely‑ympäristössä.'
    : 'Complete roadmap for achieving NIS2 compliance in the Finnish regulatory context.',
  type: "page" as const,
};

const content = {
  en: {
    hero: {
      title: "NIS2 Implementation Guide",
      subtitle: "Complete roadmap for achieving NIS2 compliance in the Finnish regulatory context",
      description: "A comprehensive step-by-step guide for Finnish organizations to achieve NIS2 compliance, covering everything from applicability assessment to ongoing monitoring and reporting."
    },
    steps: [
      { n: '01', title: 'Applicability and classification', description: 'Determine essential/important entity status per Traficom guidance and sector rules.' },
      { n: '02', title: 'Risk management framework', description: 'Adopt ISO 27005/NIST risk management and define risk treatment.' },
      { n: '03', title: 'Governance and policies', description: 'Establish policy library, ownership, and approvals (board/executive).' },
      { n: '04', title: 'Controls and operational maturity', description: 'Build technical/process controls: identity, network, resilience, training.' },
      { n: '05', title: 'Third‑party risk (TPRM)', description: 'Assess critical suppliers, add contractual clauses and continuous monitoring.' },
      { n: '06', title: 'Incident handling and reporting', description: 'Define CSIRT processes and 24/72h notification paths to Traficom and regulators.' },
      { n: '07', title: 'Continuity and recovery', description: 'ISO 22301 aligned BCP/DR, testing and preparedness.' },
      { n: '08', title: 'Metrics and reporting', description: 'KPIs/KRIs, executive reporting, continuous improvement.' }
    ],
    cta: {
      title: "Ready to start your NIS2 implementation?",
      subtitle: "Book a call – get a quick readiness check and roadmap.",
      primaryCTA: { text: "Get in Touch", href: "/contact" },
      secondaryCTA: { text: "NIS2 Readiness Check", href: "/contact?assessment=true" }
    }
  },
  fi: {
    hero: {
      title: "NIS2-toteutusopas",
      subtitle: "Täydellinen tiekartta NIS2-yhteensopivuuden saavuttamiseksi Suomen sääntely-ympäristössä",
      description: "Kattava vaiheittainen opas suomalaisille organisaatioille NIS2-vaatimustenmukaisuuden saavuttamiseksi, kattaen kaiken sovellettavuuden arvioinnista jatkuvaan seurantaan ja raportointiin."
    },
    steps: [
      { n: '01', title: 'Soveltuvuuden arviointi ja luokittelu', description: 'Tunnista olennaiset ja tärkeät toimijat (essential / important) Traficomin ja toimialasääntelyn perusteella.' },
      { n: '02', title: 'Riskienhallintakehys', description: 'Ota käyttöön ISO 27005/NIST-pohjainen riskienhallinta ja määritä riskinkäsittely.' },
      { n: '03', title: 'Hallintamalli ja politiikat', description: 'Perusta tieturvapolitiikat, omistajuudet ja hyväksymiset (hallitus/johto).' },
      { n: '04', title: 'Turvatoimet ja operatiivinen kypsyys', description: 'Rakennetaan tekniset ja prosessikontrollit: identiteetti, verkko, varautuminen, koulutus.' },
      { n: '05', title: 'Toimittajahallinta (TPRM)', description: 'Arvioi kriittiset toimittajat, lisää sopimusvaatimukset ja jatkuva seuranta.' },
      { n: '06', title: 'Vikatilanteiden hallinta ja ilmoitus', description: 'Määritä CSIRT-prosessit ja 24/72h-ilmoituspolut Traficomille ja valvojille.' },
      { n: '07', title: 'Jatkuvuus ja toipuminen', description: 'ISO 22301 mukainen jatkuvuussuunnittelu, testaus ja varautuminen.' },
      { n: '08', title: 'Mittarit ja raportointi', description: 'KPI/KRI, johdon raportointi ja jatkuva parantaminen.' }
    ],
    cta: {
      title: "Valmis aloittamaan NIS2-toteutuksen?",
      subtitle: "Varaa keskustelu – saat nopean valmiuskartoituksen ja tiekartan.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "NIS2-valmiuskartoitus", href: "/contact?assessment=true" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.hero.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.hero.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Steps Grid -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.steps.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-lg">
                {step.n}
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-center relative z-10">
              {step.title}
            </h3>
            
            <p class="text-sm text-slate-500 leading-relaxed text-center group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
      
      <!-- Action Buttons -->
      <div class="flex flex-wrap justify-center gap-3 mt-10">
        <a href="/services/nis2" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm">
          {isFi ? 'NIS2-palvelut' : 'NIS2 Services'}
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a href="/services/risk-management" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm">
          {isFi ? 'Riskienhallinta' : 'Risk Management'}
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a href="/services/business-continuity-iso-22301" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm">
          {isFi ? 'Jatkuvuus' : 'Business Continuity'}
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>


</Layout>