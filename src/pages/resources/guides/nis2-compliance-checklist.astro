---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const title = "NIS2 Compliance Checklist";
const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? "NIS2 Vaatimustarkistuslista" : "NIS2 Compliance Checklist",
  description: lang === 'fi'
    ? "Kattava tarkistuslista NIS2-direktiivin vaatimusten noudattamiseksi. Arvioi organisaatiosi vaatimustenmukaisuus ja valmistaudu tulevaan määräaikaan."
    : "Comprehensive checklist covering all NIS2 directive requirements. Assess your organization's compliance status and prepare for the upcoming deadline.",
  type: "page" as const,
};

const heroContent = {
  title: lang === 'fi' ? "NIS2 Vaatimustarkistuslista" : "NIS2 Compliance Checklist",
  subtitle: lang === 'fi' ? "Täydellinen vaatimusanalyysityökalu" : "Complete requirement assessment tool",
  description: lang === 'fi'
    ? "Kattava tarkistuslista, joka kattaa kaikki NIS2-direktiivin vaatimukset. Käytä tätä olennaista työkalua organisaatiosi vaatimustenmukaisuuden arviointiin ja valmistautumiseen tulevaan määräaikaan."
    : "Comprehensive checklist covering all NIS2 directive requirements. Use this essential tool to assess your organization's compliance status and prepare for the upcoming deadline.",
};

const isFi = lang === 'fi';

const checklistSections = [
  { label: "Governance and Risk Management", icon: "shield" },
  { label: "Cybersecurity Measures", icon: "lock" },
  { label: "Business Continuity", icon: "refresh" },
  { label: "Supply Chain Security", icon: "link" },
  { label: "Incident Handling", icon: "alert" },
  { label: "Crisis Management", icon: "users" },
  { label: "Network Security Monitoring", icon: "eye" },
  { label: "Information Sharing", icon: "share" },
  { label: "Reporting Requirements", icon: "document" },
  { label: "Supervision and Enforcement", icon: "gavel" }
];
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {heroContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {heroContent.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Checklist Overview -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-start max-w-5xl mx-auto">
        
        <!-- Left Column: Why You Need This Checklist -->
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">
            {isFi ? 'Miksi tarvitset tämän tarkistuslistan' : 'Why You Need This Checklist'}
          </h2>
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-[#3B82F6]/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-[#3B82F6]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900">{isFi ? 'Kattava kattavuus' : 'Complete Coverage'}</h3>
                <p class="text-sm text-slate-600">{isFi ? 'Kaikki NIS2-vaatimukset yhdessä kattavassa tarkistuslistassa' : 'All NIS2 requirements in one comprehensive checklist'}</p>
              </div>
            </div>
            
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-blue-100/50 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900">{isFi ? 'Aukkoanalyysi' : 'Gap Analysis'}</h3>
                <p class="text-sm text-slate-600">{isFi ? 'Tunnista vaatimustenmukaisuuspuutteet nykyisessä turvallisuustilassasi' : 'Identify compliance gaps in your current security posture'}</p>
              </div>
            </div>
            
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-purple-100/50 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v6a2 2 0 002 2h6a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900">{isFi ? 'Toimintasuunnittelu' : 'Action Planning'}</h3>
                <p class="text-sm text-slate-600">{isFi ? 'Selkeät toimenpiteet ja toteutusohjeet' : 'Clear action items and implementation guidance'}</p>
              </div>
            </div>
            
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-orange-100/50 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-900">{isFi ? 'Aikatauluseuranta' : 'Timeline Tracking'}</h3>
                <p class="text-sm text-slate-600">{isFi ? 'Seuraa edistymistä kohti vaatimustenmukaisuuden määräaikaa' : 'Monitor progress towards compliance deadline'}</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Right Column: Checklist Sections -->
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-6">
            {isFi ? 'Tarkistuslistan osiot' : 'Checklist Sections'}
          </h2>
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6">
            <ul class="space-y-2.5">
              {checklistSections.map((section) => (
                <li class="flex items-center gap-3 text-sm text-slate-700">
                  <svg class="w-4 h-4 text-[#3B82F6] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {isFi ? section.label : section.label}
                </li>
              ))}
            </ul>
          </div>
          
          <!-- Deadline Notice -->
        </div>
        
      </div>
    </div>
  </section>
  

</Layout>