---
import Layout from '@/layouts/Layout.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    title: "Webinars",
    description: "This page has moved to the new webinars hub. Find all our recorded and upcoming webinars there.",
    buttonText: "Back to Resources",
    buttonHref: "/resources"
  },
  fi: {
    title: "Webinaarit",
    description: "Tämä sivu on siirretty uuteen webinaarikeskukseen. Löydät kaikki tallennetut ja tulevat webinaarit sieltä.",
    buttonText: "Takaisin resursseihin",
    buttonHref: "/fi/resources"
  }
};

const currentContent = content[lang];
---

<Layout title={currentContent.title} description={currentContent.description}>
  <!-- Hero Section - Centered, NO image -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-28 md:py-36">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <div class="flex justify-center mb-4">
        <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
          <svg class="w-8 h-8 text-[#1E2A7A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
      </div>
      
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 text-[#1E2A7A]">
        {currentContent.title}
      </h1>
      
      <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
        {currentContent.description}
      </p>
      
      <a 
        href={currentContent.buttonHref} 
        class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2"
      >
        {currentContent.buttonText}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      
    </div>
  </section>
</Layout>