---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const resources = [
  {
    title: lang === 'fi' ? 'ISO 27001 Pika-aloitusopas' : 'ISO 27001 Quick Start Guide',
    description: lang === 'fi' 
      ? '25-sivuinen toteutusroadmap organisaatiollesi' 
      : '25-page implementation roadmap for your organization',
    category: 'Guide',
    framework: 'ISO 27001',
    type: 'download',
    url: '/resources/guides/iso-27001-quick-start',
    date: '2024-01-15',
    readTime: '5 min'
  },
  {
    title: lang === 'fi' ? 'NIS2 Vaatimustarkistuslista' : 'NIS2 Compliance Checklist',
    description: lang === 'fi' 
      ? 'Täydellinen vaatimusanalyysityökalu' 
      : 'Complete requirement assessment tool',
    category: 'Checklist',
    framework: 'NIS2',
    type: 'download',
    url: '/resources/guides/nis2-compliance-checklist',
    date: '2024-02-20',
    readTime: '3 min'
  },
  {
    title: lang === 'fi' ? 'GDPR Tietosuojavaikutusten Arviointi -Malli' : 'GDPR Privacy Impact Assessment Template',
    description: lang === 'fi' 
      ? 'Valmiiksi määritelty PIA-kehys' 
      : 'Ready-to-use PIA framework',
    category: 'Template',
    framework: 'GDPR',
    type: 'download',
    url: '/resources/guides/gdpr-pia-template',
    date: '2024-01-30',
    readTime: '8 min'
  },
  {
    title: lang === 'fi' ? 'DORA Vaatimustenmukaisuus -Tarkistuslista' : 'DORA Compliance Checklist',
    description: lang === 'fi' 
      ? 'Digitaalisen toiminnan resilierenssin arviointi' 
      : 'Digital operational resilience assessment',
    category: 'Checklist',
    framework: 'DORA',
    type: 'download',
    url: '/resources/guides/dora-compliance-checklist',
    date: '2024-03-10',
    readTime: '4 min'
  },
  {
    title: lang === 'fi' ? 'Riskienhallinnan Paraslähestymistapa' : 'Risk Management Best Practices',
    description: lang === 'fi' 
      ? 'ISO 27005 ja ISO 31000 -standardien mukainen' 
      : 'Based on ISO 27005 and ISO 31000 standards',
    category: 'Guide',
    framework: 'Risk Management',
    type: 'read',
    url: '/resources/guides/risk-management-best-practices',
    date: '2024-02-05',
    readTime: '12 min'
  },
  {
    title: lang === 'fi' ? 'Tietosuojarikkomusten Ilmoittamisen Malli' : 'Data Breach Notification Template',
    description: lang === 'fi' 
      ? 'GDPR-yhteensopiva ilmoituspohja viranomaisille' 
      : 'GDPR-compliant notification template for authorities',
    category: 'Template',
    framework: 'GDPR',
    type: 'download',
    url: '/resources/templates/data-breach-notification',
    date: '2024-01-25',
    readTime: '6 min'
  }
];

const categories = [
  { id: 'all', label: lang === 'fi' ? 'Kaikki' : 'All', count: 6 },
  { id: 'guide', label: lang === 'fi' ? 'Oppaat' : 'Guides', count: 3 },
  { id: 'template', label: lang === 'fi' ? 'Mallit' : 'Templates', count: 2 },
  { id: 'checklist', label: lang === 'fi' ? 'Tarkistuslistat' : 'Checklists', count: 2 }
];

const frameworks = [
  { id: 'all', label: lang === 'fi' ? 'Kaikki' : 'All', count: 6 },
  { id: 'iso-27001', label: 'ISO 27001', count: 1 },
  { id: 'nis2', label: 'NIS2', count: 1 },
  { id: 'gdpr', label: 'GDPR', count: 3 },
  { id: 'dora', label: 'DORA', count: 1 }
];
---

<Layout 
  title={lang === 'fi' ? 'Resurssikirjasto' : 'Resource Library'} 
  description={lang === 'fi' 
    ? 'Lataa oppaita, malleja ja tarkistuslistoja kyberturvallisuuden ja sääntelyn noudattamiseksi.' 
    : 'Download guides, templates, and checklists for cybersecurity and compliance.'}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-slate-50 via-white to-teal-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl font-bold text-slate-900 mb-6">
          {lang === 'fi' ? 'Resurssikirjasto' : 'Resource Library'}
        </h1>
        <p class="text-xl text-slate-600 mb-8">
          {lang === 'fi' 
            ? 'Lataa oppaita, malleja ja tarkistuslistoja kyberturvallisuuden ja sääntelyn noudattamiseksi.' 
            : 'Download guides, templates, and checklists for cybersecurity and compliance.'}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/contact" variant="primary">
            {lang === 'fi' ? 'Pyydä konsultaatio' : 'Request Consultation'}
          </Button>
          <Button href="/services" variant="secondary">
            {lang === 'fi' ? 'Tutustu palveluihimme' : 'Explore Our Services'}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Filters Section -->
  <section class="py-8 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row gap-6">
        <!-- Category Filter -->
        <div class="flex-1">
          <h3 class="text-sm font-medium text-slate-900 mb-3">
            {lang === 'fi' ? 'Kategoria' : 'Category'}
          </h3>
          <div class="flex flex-wrap gap-2">
            {categories.map(cat => (
              <button
                class={`px-3 py-1.5 text-sm rounded-full ${
                  cat.id === 'all' 
                    ? 'bg-teal-100 text-teal-800 border border-teal-300' 
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                }`}
              >
                {cat.label} ({cat.count})
              </button>
            ))}
          </div>
        </div>

        <!-- Framework Filter -->
        <div class="flex-1">
          <h3 class="text-sm font-medium text-slate-900 mb-3">
            {lang === 'fi' ? 'Standardi' : 'Framework'}
          </h3>
          <div class="flex flex-wrap gap-2">
            {frameworks.map(framework => (
              <button
                class={`px-3 py-1.5 text-sm rounded-full ${
                  framework.id === 'all' 
                    ? 'bg-cyan-100 text-cyan-800 border border-cyan-300' 
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                }`}
              >
                {framework.label} ({framework.count})
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Resources Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {resources.map(resource => (
          <div class="bg-gradient-to-br from-white to-slate-50 rounded-xl border border-slate-200 overflow-hidden hover:shadow-lg transition-shadow duration-300">
            <div class="p-6">
              <div class="flex justify-between items-start mb-4">
                <div>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-100 text-teal-800">
                    {resource.category}
                  </span>
                  {resource.framework && (
                    <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cyan-100 text-cyan-800">
                      {resource.framework}
                    </span>
                  )}
                </div>
                <div class="flex-shrink-0">
                  {resource.type === 'download' ? (
                    <Icon name="arrowDownTray" class="h-5 w-5 text-slate-400" />
                  ) : (
                    <Icon name="eye" class="h-5 w-5 text-slate-400" />
                  )}
                </div>
              </div>
              
              <h3 class="text-lg font-semibold text-slate-900 mb-2">
                {resource.title}
              </h3>
              <p class="text-slate-600 text-sm mb-4">
                {resource.description}
              </p>
              
              <div class="flex items-center justify-between text-xs text-slate-500 mb-4">
                <span>{resource.date}</span>
                <span>{resource.readTime}</span>
              </div>
              
              <a 
                href={resource.url}
                class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 hover:to-cyan-700"
              >
                {resource.type === 'download' 
                  ? (lang === 'fi' ? 'Lataa nyt' : 'Download Now') 
                  : (lang === 'fi' ? 'Lue lisää' : 'Read More')}
                <Icon name={resource.type === 'download' ? 'arrowDownTray' : 'arrowRight'} class="ml-2 -mr-1 h-4 w-4" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-r from-teal-600 to-cyan-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">
        {lang === 'fi' ? 'Tarvitsetko apua resurssien käytössä?' : 'Need help using these resources?'}
      </h2>
      <p class="text-xl mb-8 opacity-90">
        {lang === 'fi' 
          ? 'Asiantuntijatietoomme auttaa sinua hyödyntämään näitä resursseja tehokkaasti organisaatiossaasi.' 
          : 'Our expertise can help you leverage these resources effectively in your organization.'}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/contact" variant="white">
          {lang === 'fi' ? 'Ota yhteyttä' : 'Contact Us'}
        </Button>
        <Button href="/services" variant="outline-white">
          {lang === 'fi' ? 'Tutustu palveluihimme' : 'View Our Services'}
        </Button>
      </div>
    </div>
  </section>
</Layout>