---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Resource Library | Cybersecurity Guides, Templates & Checklists",
  description: "Download guides, templates, and checklists for cybersecurity and compliance. ISO 27001, NIS2, GDPR, DORA resources available.",
  keywords: "cybersecurity resources, compliance guides, templates, checklists, ISO 27001, NIS2, GDPR, DORA",
  type: "library" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const resources = [
  {
    title: lang === 'fi' ? 'ISO 27001 Pika-aloitusopas' : 'ISO 27001 Quick Start Guide',
    description: lang === 'fi' 
      ? '25-sivuinen toteutusroadmap organisaatiollesi' 
      : '25-page implementation roadmap for your organization',
    category: 'Guide',
    framework: 'ISO 27001',
    type: 'download',
    url: '/resources/guides/iso-27001-quick-start',
    date: '2024-01-15',
    readTime: '5 min'
  },
  {
    title: lang === 'fi' ? 'NIS2 Vaatimustarkistuslista' : 'NIS2 Compliance Checklist',
    description: lang === 'fi' 
      ? 'Täydellinen vaatimusanalyysityökalu' 
      : 'Complete requirement assessment tool',
    category: 'Checklist',
    framework: 'NIS2',
    type: 'download',
    url: '/resources/guides/nis2-compliance-checklist',
    date: '2024-02-20',
    readTime: '3 min'
  },
  {
    title: lang === 'fi' ? 'GDPR Tietosuojavaikutusten Arviointi -Malli' : 'GDPR Privacy Impact Assessment Template',
    description: lang === 'fi' 
      ? 'Valmiiksi määritelty PIA-kehys' 
      : 'Ready-to-use PIA framework',
    category: 'Template',
    framework: 'GDPR',
    type: 'download',
    url: '/resources/guides/gdpr-pia-template',
    date: '2024-01-30',
    readTime: '8 min'
  },
  {
    title: lang === 'fi' ? 'DORA Vaatimustenmukaisuus -Tarkistuslista' : 'DORA Compliance Checklist',
    description: lang === 'fi' 
      ? 'Digitaalisen toiminnan resilierenssin arviointi' 
      : 'Digital operational resilience assessment',
    category: 'Checklist',
    framework: 'DORA',
    type: 'download',
    url: '/resources/guides/dora-compliance-checklist',
    date: '2024-03-10',
    readTime: '4 min'
  },
  {
    title: lang === 'fi' ? 'Riskienhallinnan Paraslähestymistapa' : 'Risk Management Best Practices',
    description: lang === 'fi' 
      ? 'ISO 27005 ja ISO 31000 -standardien mukainen' 
      : 'Based on ISO 27005 and ISO 31000 standards',
    category: 'Guide',
    framework: 'Risk Management',
    type: 'read',
    url: '/resources/guides/risk-management-best-practices',
    date: '2024-02-05',
    readTime: '12 min'
  },
  {
    title: lang === 'fi' ? 'Tietosuojarikkomusten Ilmoittamisen Malli' : 'Data Breach Notification Template',
    description: lang === 'fi' 
      ? 'GDPR-yhteensopiva ilmoituspohja viranomaisille' 
      : 'GDPR-compliant notification template for authorities',
    category: 'Template',
    framework: 'GDPR',
    type: 'download',
    url: '/resources/templates/data-breach-notification',
    date: '2024-01-25',
    readTime: '6 min'
  }
];

const categories = [
  { id: 'all', label: lang === 'fi' ? 'Kaikki' : 'All', count: 6 },
  { id: 'guide', label: lang === 'fi' ? 'Oppaat' : 'Guides', count: 3 },
  { id: 'template', label: lang === 'fi' ? 'Mallit' : 'Templates', count: 2 },
  { id: 'checklist', label: lang === 'fi' ? 'Tarkistuslistat' : 'Checklists', count: 2 }
];

const frameworks = [
  { id: 'all', label: lang === 'fi' ? 'Kaikki' : 'All', count: 6 },
  { id: 'iso-27001', label: 'ISO 27001', count: 1 },
  { id: 'nis2', label: 'NIS2', count: 1 },
  { id: 'gdpr', label: 'GDPR', count: 3 },
  { id: 'dora', label: 'DORA', count: 1 }
];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="document-check" class="w-8 h-8 text-[#1E2A7A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 text-[#1E2A7A]">
      {lang === 'fi' ? 'Resurssikirjasto' : 'Resource Library'}
    </h1>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {lang === 'fi' 
        ? 'Lataa oppaita, malleja ja tarkistuslistoja kyberturvallisuuden ja sääntelyn noudattamiseksi.' 
        : 'Download guides, templates, and checklists for cybersecurity and compliance.'}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href="/contact" class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {lang === 'fi' ? 'Pyydä konsultaatio' : 'Request Consultation'}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href="/services" class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {lang === 'fi' ? 'Tutustu palveluihimme' : 'Explore Our Services'}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Filters Section -->
<section class="py-8 bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row gap-6">
      
      <!-- Category Filter -->
      <div class="flex-1">
        <h3 class="text-sm font-semibold text-slate-700 mb-3">
          {lang === 'fi' ? 'Kategoria' : 'Category'}
        </h3>
        <div class="flex flex-wrap gap-2">
          {categories.map(cat => (
            <button
              class={`px-3 py-1.5 text-sm rounded-full transition-all duration-200 ${
                cat.id === 'all' 
                  ? 'bg-[#1E2A7A] text-white' 
                  : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
              }`}
            >
              {cat.label} ({cat.count})
            </button>
          ))}
        </div>
      </div>

      <!-- Framework Filter -->
      <div class="flex-1">
        <h3 class="text-sm font-semibold text-slate-700 mb-3">
          {lang === 'fi' ? 'Standardi' : 'Framework'}
        </h3>
        <div class="flex flex-wrap gap-2">
          {frameworks.map(framework => (
            <button
              class={`px-3 py-1.5 text-sm rounded-full transition-all duration-200 ${
                framework.id === 'all' 
                  ? 'bg-[#1E2A7A] text-white' 
                  : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
              }`}
            >
              {framework.label} ({framework.count})
            </button>
          ))}
        </div>
      </div>
      
    </div>
  </div>
</section>

<!-- Resources Grid -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {resources.map(resource => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full group">
          
          <div class="p-6 flex flex-col h-full">
            
            <div class="flex justify-between items-start mb-4">
              <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                  {resource.category}
                </span>
                {resource.framework && (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-700">
                    {resource.framework}
                  </span>
                )}
              </div>
              <div class="flex-shrink-0">
                <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center
                            transition-all duration-300
                            group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6]">
                  <Icon name={resource.type === 'download' ? 'arrowDownTray' : 'eye'} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
            </div>
            
            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
              {resource.title}
            </h3>
            
            <p class="text-slate-500 text-sm mb-4 flex-1">
              {resource.description}
            </p>
            
            <div class="flex items-center justify-between text-xs text-slate-400 mb-5">
              <span>{resource.date}</span>
              <span>{resource.readTime}</span>
            </div>
            
            <a 
              href={resource.url}
              class="inline-flex items-center justify-center w-full px-4 py-2.5 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm gap-2"
            >
              {resource.type === 'download' 
                ? (lang === 'fi' ? 'Lataa nyt' : 'Download Now') 
                : (lang === 'fi' ? 'Lue lisää' : 'Read More')}
              <Icon name={resource.type === 'download' ? 'arrowDownTray' : 'arrowRight'} class="w-4 h-4" />
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {lang === 'fi' ? 'Tarvitsetko apua resurssien käytössä?' : 'Need help using these resources?'}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {lang === 'fi' 
          ? 'Asiantuntijamme voivat auttaa sinua hyödyntämään näitä resursseja tehokkaasti organisaatiossasi.' 
          : 'Our experts can help you leverage these resources effectively in your organization.'}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href="/contact" 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {lang === 'fi' ? 'Ota yhteyttä' : 'Contact Us'}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href="/services" 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {lang === 'fi' ? 'Tutustu palveluihimme' : 'View Our Services'}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>