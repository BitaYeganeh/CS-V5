---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import CTA from '@/components/sections/CTA.astro';

const title = "Regulatory Center";
const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const heroContent = {
  title: "Cybersecurity Regulatory Center",
  subtitle: "Stay informed about the latest cybersecurity regulations, compliance requirements, and industry standards.",
  description: "Navigate the complex landscape of cybersecurity regulations with our comprehensive regulatory center. Get expert insights, compliance guides, and implementation resources.",
  primaryCTA: { text: "Explore Regulations", href: "#regulations" },
  secondaryCTA: { text: "Get Compliance Help", href: "/contact?compliance=true" }
};

const regulations = [
  {
    title: "NIS2 in Finland",
    description: "Comprehensive guide to the NIS2 Directive implementation in Finland, requirements, and compliance timeline.",
    status: "Active",
    statusColor: "bg-green-100 text-green-800",
    href: "/regulatory/nis2-finland",
    lastUpdated: "Updated: March 2024",
    keyPoints: [
      "Applies to essential and important entities",
      "Mandatory incident reporting within 24 hours",
      "Risk management measures required",
      "Penalties up to 2% of annual turnover"
    ]
  },
  {
    title: "DORA for Financial Services",
    description: "Digital Operational Resilience Act requirements for financial institutions and their ICT service providers.",
    status: "Active",
    statusColor: "bg-green-100 text-green-800",
    href: "/regulatory/dora",
    lastUpdated: "Updated: January 2024",
    keyPoints: [
      "Applies to all financial entities in EU",
      "ICT risk management framework required",
      "Incident reporting obligations",
      "Third-party risk management"
    ]
  },
  {
    title: "GDPR and Privacy",
    description: "General Data Protection Regulation compliance guide with practical implementation steps.",
    status: "Active",
    statusColor: "bg-green-100 text-green-800",
    href: "/regulatory/gdpr",
    lastUpdated: "Updated: December 2023",
    keyPoints: [
      "Data protection by design and default",
      "Consent management requirements",
      "Data breach notification rules",
      "Individual privacy rights"
    ]
  },
  {
    title: "ISO 27001 and NIS2 Alignment",
    description: "How to align ISO 27001 implementation with NIS2 compliance requirements for maximum efficiency.",
    status: "Guide",
    statusColor: "bg-blue-100 text-blue-800",
    href: "/regulatory/iso-to-nis2-mapping",
    lastUpdated: "Updated: February 2024",
    keyPoints: [
      "Control mapping between standards",
      "Gap analysis methodology",
      "Integrated implementation approach",
      "Audit efficiency strategies"
    ]
  },
  {
    title: "eIDAS and Digital Trust",
    description: "Electronic identification and trust services regulation for digital identity and signatures.",
    status: "Active",
    statusColor: "bg-green-100 text-green-800",
    href: "/services/regulatory-compliance/eidas-digital-trust",
    lastUpdated: "Updated: November 2023",
    keyPoints: [
      "Digital identity requirements",
      "Qualified electronic signatures",
      "Trust service providers",
      "Cross-border recognition"
    ]
  },
];
---

<Layout title={title}>

  <!-- Hero Section - Centered (no image) -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#1E2A7A]">{heroContent.title}</span>
        </h1>
        <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
          {heroContent.subtitle}
        </p>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {heroContent.description}
        </p>
        
        <!-- Hero Buttons - Centered -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
          <a href={heroContent.primaryCTA.href} class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base">
            {heroContent.primaryCTA.text}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={heroContent.secondaryCTA.href} class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base">
            {heroContent.secondaryCTA.text}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
      
    </div>
  </section>

  <!-- Regulations Section - Matching homepage card styling -->
  <section id="regulations" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          Regulatory Landscape
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          Stay up-to-date with the evolving cybersecurity regulatory environment. 
          Our experts monitor changes and provide actionable compliance guidance.
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {regulations.map(regulation => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
            
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">{regulation.title}</h3>
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${regulation.statusColor}`}>
                    {regulation.status}
                  </span>
                  <span class="text-xs text-slate-500">{regulation.lastUpdated}</span>
                </div>
              </div>
            </div>
            
            <p class="text-sm text-slate-500 mb-4 leading-relaxed">{regulation.description}</p>
            
            <div class="mb-6">
              <h4 class="text-sm font-semibold text-slate-700 mb-2">Key Points:</h4>
              <ul class="space-y-1.5">
                {regulation.keyPoints.map(point => (
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <svg class="w-4 h-4 text-blue-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {point}
                  </li>
                ))}
              </ul>
            </div>
            
            <a href={regulation.href} class="inline-flex items-center justify-center w-full px-4 py-2.5 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5">
              Read Full Guide
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Regulatory Services Section - Matching card styling with blue icons -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          Regulatory Services
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          We help organizations navigate complex regulatory requirements with expert guidance and practical solutions.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Service 1 -->
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#1E2A7A] transition-colors duration-300">Compliance Assessment</h3>
          <p class="text-sm text-slate-500 mb-4 leading-relaxed">
            Comprehensive assessment of your current compliance status against applicable regulations.
          </p>
          <ul class="text-sm text-slate-600 space-y-2 text-left">
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Gap analysis and risk assessment</li>
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Compliance roadmap development</li>
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Regulatory impact analysis</li>
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Implementation planning</li>
          </ul>
        </div>
        
        <!-- Service 2 -->
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#1E2A7A] transition-colors duration-300">Implementation Support</h3>
          <p class="text-sm text-slate-500 mb-4 leading-relaxed">
            Hands-on support to implement compliance measures and meet regulatory requirements.
          </p>
          <ul class="text-sm text-slate-600 space-y-2 text-left">
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Policy and procedure development</li>
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Control implementation</li>
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Staff training and awareness</li>
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Documentation and evidence</li>
          </ul>
        </div>
        
        <!-- Service 3 -->
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#1E2A7A] transition-colors duration-300">Ongoing Monitoring</h3>
          <p class="text-sm text-slate-500 mb-4 leading-relaxed">
            Continuous monitoring and updates to maintain compliance as regulations evolve.
          </p>
          <ul class="text-sm text-slate-600 space-y-2 text-left">
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Regulatory change monitoring</li>
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Compliance health checks</li>
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Incident response support</li>
            <li class="flex items-start gap-2"><span class="text-blue-500">✓</span> Audit preparation and support</li>
          </ul>
        </div>
        
      </div>
    </div>
  </section>

  <!-- CTA Section - Matching homepage style -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
          Need Regulatory Compliance Help?
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          Our regulatory experts can help you navigate complex compliance requirements and implement effective solutions.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact?compliance=true" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            Schedule Consultation
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href="/resources/guides" class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base gap-2">
            View Resources
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>