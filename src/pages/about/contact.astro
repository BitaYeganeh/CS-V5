---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Contact";

const content = {
  en: {
    title: "Get in Touch",
    subtitle: "Ready to Transform Your Business?",
    heroDescription: "Connect with our team of cybersecurity experts and discover how we can help you achieve compliance, enhance security, and drive business growth.",
    contactInfo: {
      title: "Contact Information",
      description: "We're here to help you navigate the complex world of cybersecurity and compliance. Reach out to us through any of these channels:",
      phone: "Phone",
      email: "Email",
      address: "Address",
      hours: "Business Hours",
      response: "Response Time"
    },
    locations: {
      title: "Our Locations",
      description: "Serving clients across Finland and internationally with local expertise and global standards.",
      tampere: {
        city: "Tampere",
        country: "Finland",
        address: "Hämeenkatu 10, 33100 Tampere",
        phone: "+358 44 5040308",
        email: "tampere@cybersecurity.fi"
      }
    },
    form: {
      title: "Send Us a Message",
      description: "Fill out the form below and we'll get back to you within 24 hours.",
      name: "Full Name",
      email: "Email Address",
      company: "Company Name",
      phone: "Phone Number",
      service: "Service of Interest",
      message: "Your Message",
      submit: "Send Message",
      required: "Required fields"
    },
    cta: {
      title: "Ready to Get Started?",
      subtitle: "Join hundreds of organizations that trust us with their cybersecurity and compliance needs.",
      button: "Schedule a Consultation",
      link: "/contact"
    }
  },
  fi: {
    title: "Ota yhteyttä",
    subtitle: "Valmiit muuttamaan liiketoimintasi?",
    heroDescription: "Yhdistä meidän kyberturvallisuusasiantuntijoiden tiimiin ja löydä, miten voimme auttaa sinua saavuttamaan yhteensopivuuden, parantamaan turvallisuutta ja edistämään liiketoiminnan kasvua.",
    contactInfo: {
      title: "Yhteystiedot",
      description: "Olemme täällä auttaaksemme sinua navigoimaan kyberturvallisuuden ja yhteensopivuuden monimutkaisessa maailmassa. Ota meihin yhteyttä millä tahansa näistä kanavista:",
      phone: "Puhelin",
      email: "Sähköposti",
      address: "Osoite",
      hours: "Aukioloajat",
      response: "Vastausaika"
    },
    form: {
      title: "Lähetä meille viesti",
      description: "Täytä alla oleva lomake ja vastaamme sinulle 24 tunnin sisällä.",
      name: "Koko nimi",
      email: "Sähköpostiosoite",
      company: "Yrityksen nimi",
      phone: "Puhelinnumero",
      service: "Kiinnostava palvelu",
      message: "Viestisi",
      submit: "Lähetä viesti",
      required: "Pakolliset kentät"
    },
    cta: {
      title: "Valmiit aloittamaan?",
      subtitle: "Liity satoihin organisaatioihin, jotka luottavat meihin kyberturvallisuus- ja yhteensopivuustarpeissaan.",
      button: "Aikatauluta konsultaatio",
      link: "/contact"
    }
  }
};

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- Hero Section - Matching homepage -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#1E2A7A]">{currentContent.title}</span>
        </h1>
        <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
          {currentContent.subtitle}
        </p>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.heroDescription}
        </p>
      </div>
      
    </div>
  </section>

  <!-- Contact Information Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.contactInfo.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.contactInfo.description}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">{currentContent.contactInfo.phone}</h3>
          <p class="text-sm text-slate-600">+358 44 5040308</p>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">{currentContent.contactInfo.email}</h3>
          <p class="text-sm text-slate-600">info@cybersecurity.fi</p>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">{currentContent.contactInfo.address}</h3>
          <p class="text-sm text-slate-600">Helsinki, Finland</p>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">{currentContent.contactInfo.hours}</h3>
          <p class="text-sm text-slate-600">Mon-Fri 9:00-17:00</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.form.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.form.description}
        </p>
      </div>
      
      <form class="bg-slate-50/50 rounded-xl border border-slate-100 p-8 shadow-sm hover:shadow-md transition-all duration-300">
        <div class="grid md:grid-cols-2 gap-6 mb-6">
          <div>
            <label for="name" class="block text-sm font-medium text-slate-700 mb-2">{currentContent.form.name} *</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#1E40AF] focus:border-[#1E40AF] transition-all duration-200 bg-white">
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-slate-700 mb-2">{currentContent.form.email} *</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#1E40AF] focus:border-[#1E40AF] transition-all duration-200 bg-white">
          </div>
        </div>
        
        <div class="grid md:grid-cols-2 gap-6 mb-6">
          <div>
            <label for="company" class="block text-sm font-medium text-slate-700 mb-2">{currentContent.form.company}</label>
            <input type="text" id="company" name="company" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#1E40AF] focus:border-[#1E40AF] transition-all duration-200 bg-white">
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-slate-700 mb-2">{currentContent.form.phone}</label>
            <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#1E40AF] focus:border-[#1E40AF] transition-all duration-200 bg-white">
          </div>
        </div>
        
        <div class="mb-6">
          <label for="service" class="block text-sm font-medium text-slate-700 mb-2">{currentContent.form.service}</label>
          <select id="service" name="service" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#1E40AF] focus:border-[#1E40AF] transition-all duration-200 bg-white">
            <option value="">{lang === 'en' ? 'Select a service' : 'Valitse palvelu'}</option>
            <option value="iso-27001">{lang === 'en' ? 'ISO 27001 Certification' : 'ISO 27001 -sertifiointi'}</option>
            <option value="soc-2">{lang === 'en' ? 'SOC 2 Compliance' : 'SOC 2 -yhteensopivuus'}</option>
            <option value="gdpr">{lang === 'en' ? 'GDPR Compliance' : 'GDPR -yhteensopivuus'}</option>
            <option value="dora">{lang === 'en' ? 'DORA Compliance' : 'DORA -yhteensopivuus'}</option>
            <option value="nis2">{lang === 'en' ? 'NIS2 Compliance' : 'NIS2 -yhteensopivuus'}</option>
            <option value="other">{lang === 'en' ? 'Other' : 'Muu'}</option>
          </select>
        </div>
        
        <div class="mb-6">
          <label for="message" class="block text-sm font-medium text-slate-700 mb-2">{currentContent.form.message} *</label>
          <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-[#1E40AF] focus:border-[#1E40AF] transition-all duration-200 bg-white"></textarea>
        </div>
        
        <div class="text-sm text-slate-500 mb-6">* {currentContent.form.required}</div>
        
        <div class="text-center">
          <button type="submit" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            {currentContent.form.submit}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- CTA Section - Matching homepage -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
          {currentContent.cta.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          {currentContent.cta.subtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={currentContent.cta.link} class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            {currentContent.cta.button}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>