---
import Layout from '@/layouts/Layout.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Team and Certifications";

const content = {
  en: {
    title: "Team and Certifications",
    subtitle: "Meet Our Expert Cybersecurity Professionals",
    heroDescription: "Our team of certified cybersecurity experts brings decades of combined experience in compliance, risk management, and technical security to help your organization build resilient security programs.",
    team: {
      title: "Leadership Team",
      subtitle: "Experienced professionals leading our mission"
    },
    certifications: {
      title: "Professional Certifications",
      subtitle: "Our team maintains the highest industry standards"
    },
    expertise: {
      title: "Areas of Expertise",
      subtitle: "Comprehensive cybersecurity knowledge across multiple domains"
    }
  },
  fi: {
    title: "Tiimi ja Sertifikaatit",
    subtitle: "Tutustu Asiantuntijaamme Kyberturvallisuusprofessinaaleihin",
    heroDescription: "Sertifioitujen kyberturvallisuusasiantuntijoiden tiimimme tuo vuosikymmeniä yhdistettyä kokemusta noudattamisesta, riskien hallinnasta ja teknisestä turvallisuudesta auttaakseen organisaatiosi rakentamaan kestäviä turvallisuusohjelmia.",
    team: {
      title: "Johtotimi",
      subtitle: "Kokeneet ammattilaiset johtamassa tehtäväämme"
    },
    certifications: {
      title: "Ammattisertifikaatit",
      subtitle: "Tiimimme ylläpitää korkeimpia alan standardeja"
    },
    expertise: {
      title: "Asiantuntemuksen Alueet",
      subtitle: "Kattava kyberturvallisuustieto useilla alueilla"
    }
  }
};

const teamMembers = [
  {
    role: "Chief Executive Officer & Founder",
    description: "Our Chief Executive Officer brings over 15 years of cybersecurity expertise with deep knowledge in compliance frameworks and risk management. Having served as CISO at major financial institutions, they lead our organization with strategic vision in ISO 27001 implementation, enterprise risk management, and cybersecurity strategy development. Their certifications include CISSP, CISA, ISO 27001 Lead Auditor, and CRISC, ensuring our clients receive guidance from proven industry expertise."
  },
  {
    role: "Chief Technology Officer",
    description: "Our Chief Technology Officer is a former CISO with exceptional technical expertise in security architecture and threat assessment. They specialize in cloud security, incident response, and penetration testing methodologies. With certifications including CISSP, CEH, OSCP, and CCSP, they ensure our technical solutions remain at the forefront of cybersecurity innovation."
  },
  {
    role: "Compliance Director",
    description: "Our Compliance Director is a legal and compliance expert specializing in EU cybersecurity regulations. Having served as legal counsel at European cybersecurity agencies, they bring invaluable expertise in NIS2, GDPR, and DORA compliance frameworks. Their certifications include CIPP/E, CIPM, ISO 27001 Lead Implementer, and NIS2 Expert, ensuring comprehensive regulatory compliance guidance."
  },
  {
    role: "Senior Security Consultant",
    description: "Our Senior Security Consultant is a former Big 4 auditor with extensive experience in security assessments and compliance audits across multiple industries. They specialize in SOC 2 preparations and audit readiness, bringing certifications including CISA, CRISC, SOC 2 Practitioner, and ISO 27001 Lead Auditor to deliver thorough and reliable audit support."
  },
  {
    role: "Head of Risk Management",
    description: "Our Head of Risk Management specializes in enterprise risk management and business continuity planning. As an expert in ISO 31000 and ISO 22301 frameworks, they provide comprehensive risk assessment and business continuity solutions. Their certifications include CRISC, ISO 31000 Risk Manager, and ISO 22301 Lead Implementer, ensuring robust risk management strategies."
  },
  {
    role: "Technical Security Lead",
    description: "Our Technical Security Lead is a cloud security specialist with multi-cloud platform expertise. Having served as a senior security engineer at major technology companies, they bring deep knowledge in DevSecOps and cloud security architectures. Their certifications include CCSP and other advanced cloud security credentials, ensuring comprehensive cloud security solutions."
  }
];

const certificationCategories = [
  {
    category: "Information Security",
    certifications: ["CISSP", "CISM", "CISA", "CCSP", "SSCP"]
  },
  {
    category: "Risk Management",
    certifications: ["CRISC", "ISO 31000 Risk Manager", "ISO 27005 Risk Manager"]
  },
  {
    category: "Compliance & Audit",
    certifications: ["ISO 27001 Lead Auditor", "ISO 27001 Lead Implementer", "SOC 2 Practitioner"]
  },
  {
    category: "Privacy & Data Protection",
    certifications: ["CIPP/E", "CIPM", "CIPT", "GDPR Practitioner"]
  },
  {
    category: "Technical Security",
    certifications: ["CEH", "OSCP", "OSCE", "GPEN", "GXPN"]
  },
  {
    category: "Cloud Security",
    certifications: ["CCSP - Certified Cloud Security Professional"]
  }
];

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- Hero Section - Matching homepage -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#1E2A7A]">{currentContent.title}</span>
        </h1>
        <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
          {currentContent.subtitle}
        </p>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.heroDescription}
        </p>
      </div>
      
    </div>
  </section>

<!-- Team Section - Fixed (no gradient background, only blue icon) -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        {currentContent.team.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.team.subtitle}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {teamMembers.map((member, index) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group overflow-hidden">
          <div class="p-6">
            <div class="flex flex-col items-center mb-4">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
                <svg class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#1E2A7A] transition-colors duration-300">{member.role}</h3>
            </div>
            <p class="text-sm text-slate-500 leading-relaxed">{member.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


  <!-- Certifications Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.certifications.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.certifications.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certificationCategories.map((category) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-md transition-all duration-300">
            <h3 class="text-xl font-bold text-[#1E2A7A] mb-4">{category.category}</h3>
            <div class="grid grid-cols-2 gap-4">
              {category.certifications.map((cert) => (
                <div class="flex flex-col items-center text-center p-2">
                  <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-2">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <span class="text-xs font-medium text-slate-700 text-center">{cert}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Expertise Areas Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          {currentContent.expertise.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.expertise.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">Compliance</h3>
          <p class="text-sm text-slate-500">ISO 27001, NIS2, DORA, GDPR, SOC 2</p>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">Risk Management</h3>
          <p class="text-sm text-slate-500">Assessment, mitigation, and monitoring</p>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">Technical Security</h3>
          <p class="text-sm text-slate-500">Architecture, testing, and implementation</p>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">Consulting</h3>
          <p class="text-sm text-slate-500">Strategic guidance and implementation</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section - Matching homepage -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
          Ready to Work with Our Expert Team?
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          Let's discuss how our certified professionals can help secure your organization.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            Get Started
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href="/about/methodology" class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base gap-2">
            Learn About Our Methodology
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>