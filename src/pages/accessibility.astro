---
import Layout from '@/layouts/Layout.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? "Saavutettavuusseloste" : "Accessibility Statement",
  description: lang === 'fi'
    ? "Cyber Security Finlandin saavutettavuusseloste. Sitoudumme tekemään verkkosivustostamme kaikkien saavutettavan."
    : "Accessibility Statement for Cyber Security Finland. We are committed to making our website accessible to everyone.",
  type: "website" as const
};

const content = {
  en: {
    title: "Accessibility Statement",
    lastUpdated: "Last updated: January 2025",
    intro: "Cyber Security Finland is committed to ensuring digital accessibility for people with disabilities. We continually improve the user experience for everyone.",
    sections: [
      {
        title: "1. Our Commitment",
        content: "We strive to ensure that our website meets WCAG 2.1 Level AA standards. We are continually working to improve the accessibility of our website and services."
      },
      {
        title: "2. Accessibility Features",
        content: "Our website includes the following accessibility features: keyboard navigation support, skip-to-content links, semantic HTML structure, descriptive link text, sufficient color contrast, resizable text support, and alt text for images."
      },
      {
        title: "3. Assistive Technologies",
        content: "Our website is designed to be compatible with assistive technologies including screen readers, speech recognition software, and keyboard-only navigation."
      },
      {
        title: "4. Known Limitations",
        content: "While we strive for full accessibility, some older content or third-party components may not meet all accessibility standards. We are working to address these limitations."
      },
      {
        title: "5. Browser Compatibility",
        content: "Our website is designed to work with modern browsers. For the best experience, we recommend using the latest versions of Chrome, Firefox, Safari, or Edge."
      },
      {
        title: "6. Feedback",
        content: "We welcome your feedback on the accessibility of our website. If you encounter any barriers or have suggestions for improvement, please contact us."
      },
      {
        title: "7. Third-Party Content",
        content: "Some content on our website may be provided by third parties. While we encourage our partners to follow accessibility best practices, we cannot guarantee the accessibility of external content."
      },
      {
        title: "8. Contact Us",
        content: "If you have questions about accessibility or need assistance using our website, please contact us at info@cybersecurity.fi or call +358 44 5040308."
      }
    ]
  },
  fi: {
    title: "Saavutettavuusseloste",
    lastUpdated: "Päivitetty viimeksi: Tammikuu 2025",
    intro: "Cyber Security Finland on sitoutunut varmistamaan verkkosivuston saavutettavuuden vammaisille henkilöille. Parannamme jatkuvasti käyttökokemusta kaikille.",
    sections: [
      {
        title: "1. Sitoumuksemme",
        content: "Pyrimme varmistamaan, että verkkosivustomme täyttää WCAG 2.1 AA-tason standardit. Työskentelemme jatkuvasti parantaaksemme verkkosivustomme ja palveluidemme saavutettavuutta."
      },
      {
        title: "2. Saavutettavuusominaisuudet",
        content: "Verkkosivustomme sisältää seuraavat saavutettavuusominaisuudet: näppäimistönavigaation tuki, hyppää sisältöön -linkit, semanttinen HTML-rakenne, kuvailevat linkkitekstit, riittävä värikontrasti, muutettavan tekstikoon tuki ja kuvien alt-tekstit."
      },
      {
        title: "3. Avustavat teknologiat",
        content: "Verkkosivustomme on suunniteltu yhteensopivaksi avustavien teknologioiden kanssa, mukaan lukien ruudunlukijat, puheentunnistusohjelmistot ja pelkästään näppäimistöllä tapahtuva navigointi."
      },
      {
        title: "4. Tunnetut rajoitukset",
        content: "Vaikka pyrimme täyteen saavutettavuuteen, jotkin vanhemmat sisällöt tai kolmannen osapuolen komponentit eivät välttämättä täytä kaikkia saavutettavuusstandardeja. Työskentelemme näiden rajoitusten korjaamiseksi."
      },
      {
        title: "5. Selainyhteensopivuus",
        content: "Verkkosivustomme on suunniteltu toimimaan nykyaikaisilla selaimilla. Parhaan kokemuksen saamiseksi suosittelemme käyttämään Chromen, Firefoxin, Safarin tai Edgen uusimpia versioita."
      },
      {
        title: "6. Palaute",
        content: "Otamme mielellämme vastaan palautetta verkkosivustomme saavutettavuudesta. Jos kohtaat esteitä tai sinulla on parannusehdotuksia, ota meihin yhteyttä."
      },
      {
        title: "7. Kolmannen osapuolen sisältö",
        content: "Osa verkkosivustomme sisällöstä voi olla kolmansien osapuolten tarjoamaa. Vaikka kannustamme kumppaneitamme noudattamaan saavutettavuuden parhaita käytäntöjä, emme voi taata ulkoisen sisällön saavutettavuutta."
      },
      {
        title: "8. Ota yhteyttä",
        content: "Jos sinulla on kysyttävää saavutettavuudesta tai tarvitset apua verkkosivustomme käytössä, ota yhteyttä osoitteeseen info@cybersecurity.fi tai soita +358 44 5040308."
      }
    ]
  }
};

const c = content[lang];
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#1E2A7A]">{c.title}</span>
        </h1>
        <p class="text-sm text-slate-500 mt-2">{c.lastUpdated}</p>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed mt-6">
          {c.intro}
        </p>
      </div>
      
    </div>
  </section>

  <!-- Content Sections -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="space-y-6">
        {c.sections.map((section, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-md transition-all duration-300">
            <h2 class="text-xl md:text-2xl font-bold text-[#1E2A7A] mb-3">
              {section.title}
            </h2>
            <p class="text-slate-500 leading-relaxed">
              {section.content}
            </p>
          </div>
        ))}
      </div>
      
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
          Need Assistance?
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          If you need help accessing any part of our website or have accessibility questions, please contact us.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            Contact Us
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
          <a href="/" class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base gap-2">
            Back to Home
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>