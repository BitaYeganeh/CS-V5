---

<Layout {...seoConfig}>

<!-- Hero Section - Light blue background with responsive improvements -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 min-h-[90vh] md:min-h-screen flex items-center relative overflow-hidden">  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
    
    <div class="grid md:grid-cols-2 gap-8 lg:gap-12 items-center">
      
      <!-- Left Side: Content - Responsive text sizes -->
      <div class="text-left">
        
        <!-- Responsive heading: smaller on mobile, larger on desktop -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4 leading-tight">
          <div>Enterprise Cybersecurity</div>
          <div class="pl-6 sm:pl-8 md:pl-10">
            <span class="text-2xl sm:text-3xl md:text-4xl">&</span>
          </div>
          <div>
            <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">Compliance Advisory</span>
          </div>
        </h1>

        <!-- Responsive buttons: full width on mobile, auto on desktop -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center sm:justify-start mt-8 md:mt-12">
          <!-- Primary button -->
          <a href="/contact" class="inline-flex items-center justify-center px-5 py-2.5 sm:px-6 sm:py-3 bg-gradient-to-r from-[#1E2A7A] to-[#2563EB] text-white rounded-full hover:from-[#2563EB] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base">
            Request Consultation
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          
          <!-- Secondary button -->
          <a href="/services" class="inline-flex items-center justify-center px-5 py-2.5 sm:px-6 sm:py-3 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#2563EB] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
            Explore Services
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
        
      </div>
      
      <!-- Right Side: Chess Image - Hidden on mobile, visible on tablet+ -->
      <div class="hidden md:block relative">
        <img 
          src="/images/1.webp"
          alt="cybersecurity concept"
          class="w-full max-w-md lg:max-w-full mx-auto rounded-2xl shadow-2xl object-cover"
          loading="eager"
        />      
      </div>
      
    </div>
  </div>
</section>


<!-- Trust Bar - Seamless with Hero -->
<section class="py-8 bg-gradient-to-b from-blue-50/30 to-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid md:grid-cols-2 gap-8 items-center">
      
      <!-- Left Side: Text - Responsive -->
      <div class="text-left">
        <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold tracking-tight leading-tight text-slate-800">
          From compliance<br/>to 
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">competitive advantage</span>.
        </p>
        <p class="text-xs sm:text-sm md:text-base text-blue-600 font-medium mt-3 md:mt-4">
          Trusted by industry leaders
        </p>
      </div>
      
      <!-- Right Side: Horizontal Scroll Logos -->
      <div class="relative -ml-4 md:-ml-8 lg:-ml-12">
        <div id="logo-scroll-container" class="overflow-x-auto scrollbar-hide" style="scrollbar-width: none; -ms-overflow-style: none;">
          <div class="flex gap-4 md:gap-6 lg:gap-8 pb-4 min-w-max">
            
            {[
              { src: '/images/nis2.webp', alt: 'NIS2' },
              { src: '/images/dora.webp', alt: 'DORA' },
              { src: '/images/logo-client-1.webp', alt: 'Client 3' },
              { src: '/images/CRA.jpg', alt: 'CRA' },
              { src: '/images/SOC-2-logo.jpg', alt: 'SOC2' },
              { src: '/images/gdpr.webp', alt: 'GDPR' },
            ].map((logo) => (
              <div class="flex-shrink-0 flex items-center justify-center h-16 md:h-20 lg:h-28 w-24 md:w-32 lg:w-40 rounded-xl p-2 md:p-3 hover:scale-105 transition-all duration-300">
                <img 
                  src={logo.src}
                  alt={logo.alt}
                  class="w-full h-full object-contain"
                  loading="lazy"
                />
              </div>
            ))}
            
          </div>
        </div>
        
        <div id="logo-dots" class="flex justify-center gap-2 mt-4"></div>
        
      </div>
      
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const container = document.getElementById('logo-scroll-container');
  const dotsContainer = document.getElementById('logo-dots');
  
  if (container && dotsContainer) {
    const scrollWidth = container.scrollWidth;
    const clientWidth = container.clientWidth;
    const numberOfDots = Math.ceil(scrollWidth / clientWidth);
    
    for (let i = 0; i < numberOfDots; i++) {
      const dot = document.createElement('button');
      dot.className = 'w-2 h-2 rounded-full transition-all duration-300 ' + (i === 0 ? 'bg-blue-600' : 'bg-blue-300 hover:bg-blue-400');
      dot.addEventListener('click', () => {
        container.scrollTo({ left: i * clientWidth, behavior: 'smooth' });
      });
      dotsContainer.appendChild(dot);
    }
    
    container.addEventListener('scroll', () => {
      const scrollPosition = container.scrollLeft;
      const activeIndex = Math.round(scrollPosition / clientWidth);
      const dots = dotsContainer.querySelectorAll('button');
      dots.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.className = 'w-2 h-2 rounded-full bg-blue-600 transition-all duration-300';
        } else {
          dot.className = 'w-2 h-2 rounded-full bg-blue-300 hover:bg-blue-400 transition-all duration-300';
        }
      });
    });
  }
</script>

<!-- Rest of your sections remain the same -->
<!-- Featured Packages Section, Key Services Section, Compliance Frameworks Section, Industries Section, Testimonials Section, Latest Resources Section, Webinars Section, CTA Section -->
<!-- (keep all your existing code from here onward) -->

</Layout>