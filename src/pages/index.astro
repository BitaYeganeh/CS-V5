---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Cyber Security Finland | Enterprise Cybersecurity & Compliance Advisory",
  description: "Global cybersecurity and compliance advisory firm. Specialized in ISO 27001, NIS2, GDPR, and DORA compliance across regulated industries. Proven methodologies trusted by enterprises worldwide.",
  keywords: "cybersecurity consulting, ISO 27001 compliance, NIS2 directive, GDPR expert, DORA implementation, information security consulting, enterprise security, compliance advisory, risk management, governance risk compliance",
  type: "website" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Cyber Security Finland",
    "url": "https://cybersecurity.fi",
    "description": "Enterprise cybersecurity and compliance advisory services. ISO 27001, NIS2, GDPR, and DORA implementation with proven methodologies for global organizations.",
    "publisher": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "logo": {
        "@type": "ImageObject",
        "url": "https://cybersecurity.fi/logo-2025.jpg",
        "width": 300,
        "height": 300
      }
    },
    "potentialAction": {
      "@type": "ContactAction",
      "target": "https://cybersecurity.fi/contact",
      "name": "Contact Us"
    }
  }
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Enterprise Cybersecurity & Compliance Advisory",
      subtitle: "Strategic guidance for complex regulatory environments. ISO 27001, NIS2, GDPR, and DORA implementation with proven methodologies trusted by global organizations.",
      primaryCTA: { text: "Request Consultation", href: "/contact" },
      secondaryCTA: { text: "Explore Capabilities", href: "/services" }
    },
    services: {
      title: "Core Capabilities",
      description: "Comprehensive cybersecurity and regulatory compliance solutions for enterprises across regulated industries",
      items: [
        {
          title: "Information Security Management",
          description: "ISO 27001 implementation and certification readiness programs",
          icon: "shield-check",
          href: "/packages/iso-27001-fast-track"
        },
        {
          title: "Regulatory Compliance",
          description: "NIS2 directive compliance and cybersecurity resilience frameworks",
          icon: "globe-alt",
          href: "/services/nis2-compliance"
        },
        {
          title: "Data Protection & Privacy",
          description: "GDPR compliance programs and privacy governance frameworks",
          icon: "lock-closed",
          href: "/services/gdpr-privacy-services"
        },
        {
          title: "Digital Operational Resilience",
          description: "DORA compliance for financial institutions and critical infrastructure",
          icon: "building-library",
          href: "/services/dora-compliance"
        }
      ]
    },
    cta: {
      title: "Transform Your Security Posture",
      subtitle: "Partner with experienced advisors trusted by enterprises in highly regulated industries worldwide.",
      primaryCTA: { text: "Schedule Consultation", href: "/contact" },
      secondaryCTA: { text: "View Services", href: "/services" }
    }
  },
  fi: {
    hero: {
      title: "Kyberturvallisuus- ja vaatimustenmukaisuusneuvonta",
      subtitle: "Strateginen ohjaus monimutkaisissa sääntelyympäristöissä. ISO 27001, NIS2, GDPR ja DORA toteutus todistetuin menetelmin, joihin maailmanlaajuiset organisaatiot luottavat.",
      primaryCTA: { text: "Pyydä konsultaatio", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihin", href: "/services" }
    },
    services: {
      title: "Ydinosaamisalueet",
      description: "Kattavat kyberturvallisuus- ja sääntelyvaatimustenmukaisuusratkaisut yrityksille säännellyillä toimialoilla",
      items: [
        {
          title: "Tietoturvallisuuden hallinta",
          description: "ISO 27001 -toteutus ja sertifiointivalmius-ohjelmat",
          icon: "shield-check",
          href: "/packages/iso-27001-fast-track"
        },
        {
          title: "Sääntelyvaatimustenmukaisuus",
          description: "NIS2-direktiivin vaatimustenmukaisuus ja kyberturvallisuuden resilienssi",
          icon: "globe-alt",
          href: "/services/nis2-compliance"
        },
        {
          title: "Tietosuoja ja yksityisyys",
          description: "GDPR-vaatimustenmukaisuusohjelmat ja tietosuojan hallintakehykset",
          icon: "lock-closed",
          href: "/services/gdpr-privacy-services"
        },
        {
          title: "Digitaalinen toimintakyky",
          description: "DORA-vaatimustenmukaisuus rahoituslaitoksille ja kriittiselle infrastruktuurille",
          icon: "building-library",
          href: "/services/dora-compliance"
        }
      ]
    },
    cta: {
      title: "Muuta turvallisuusasemaasi",
      subtitle: "Kumppani kokeneiden neuvonantajien kanssa, joihin luottavat yritykset erittäin säännellyillä toimialoilla maailmanlaajuisesti.",
      primaryCTA: { text: "Varaa konsultaatio", href: "/contact" },
      secondaryCTA: { text: "Näytä palvelut", href: "/services" }
    }
  }
};

const currentContent = content[lang];

const keyServices = [
  {
    title: "Compliance Frameworks",
    description: "Transform regulatory requirements into competitive advantages. Expert implementation of ISO 27001, SOC 2, GDPR, NIS2, and DORA frameworks with proven fast-track methodologies.",
    icon: "shield-check",
    href: "/services"
  },
  {
    title: "Risk Management",
    description: "Identify, assess, and mitigate cybersecurity risks effectively. Comprehensive risk assessments, third-party risk management, and business continuity planning tailored to your organization.",
    icon: "chart-line",
    href: "/services"
  },
  {
    title: "Governance & Policy",
    description: "Establish robust cybersecurity governance structures. Strategic policy development, CISO-as-a-Service, Virtual CISO (V-CISO), and board-level risk reporting to ensure organizational security maturity.",
    icon: "building-library",
    href: "/services"
  },
  {
    title: "Specialized Services",
    description: "Expert services for unique cybersecurity challenges. Anti-fraud services, digital trust solutions, audit preparation, and specialized compliance support for complex requirements.",
    icon: "star",
    href: "/services"
  }
];

const complianceFrameworks = [
  {
    title: "ISO 27001",
    description: "Information Security Management System - the international standard for cybersecurity management.",
    icon: "shield-check",
    href: "/frameworks/iso-27001"
  },
  {
    title: "NIS2 Directive",
    description: "Network and Information Security Directive - EU cybersecurity legislation for essential and important entities.",
    icon: "globe-alt",
    href: "/frameworks/nis2"
  },
  {
    title: "GDPR",
    description: "General Data Protection Regulation - EU privacy regulation for personal data protection and privacy.",
    icon: "lock-closed",
    href: "/regulatory/gdpr"
  },
  {
    title: "DORA",
    description: "Digital Operational Resilience Act - EU regulation for digital operational resilience in financial services.",
    icon: "building-library",
    href: "/regulatory/dora"
  },
  {
    title: "SOC 2",
    description: "Service Organization Control 2 - auditing procedure that ensures service providers securely manage data.",
    icon: "document-check",
    href: "/frameworks/soc-2"
  },
  {
    title: "Common Criteria",
    description: "International standard for computer security certification - evaluation criteria for IT security products.",
    icon: "star",
    href: "/frameworks/common-criteria"
  }
];

const industries = [
  { 
    name: "Financial Services & Fintech", 
    icon: "bank", 
    href: "/industries/financial-services-fintech",
    image: "/images/industries/financial-services.svg",
    description: "Specialized DORA, PCI DSS, and operational resilience expertise for banks, payment processors, and fintech companies."
  },
  { 
    name: "SaaS & Technology", 
    icon: "code", 
    href: "/industries/saas-technology",
    image: "/images/industries/saas-technology.svg",
    description: "ISO 27001, SOC 2, and cloud security frameworks tailored for software companies and technology service providers."
  },
  { 
    name: "Healthcare & Life Sciences", 
    icon: "heart", 
    href: "/industries/healthcare-life-sciences",
    image: "/images/industries/healthcare.svg",
    description: "GDPR, Virtual DPO (V-DPO), medical device regulations, and patient data protection compliance for healthcare organizations and life sciences companies."
  },
  { 
    name: "Critical Infrastructure", 
    icon: "bolt", 
    href: "/industries/critical-infrastructure-energy",
    image: "/images/industries/critical-infrastructure.svg",
    description: "NIS2 directive implementation, operational technology security, and resilience planning for essential service providers."
  },
  { 
    name: "Public Sector", 
    icon: "building", 
    href: "/industries/public-sector-finland",
    image: "/images/industries/public-sector.svg",
    description: "Government-specific compliance frameworks, public procurement requirements, and citizen data protection standards."
  },
  { 
    name: "Manufacturing & Industrial", 
    icon: "cog", 
    href: "/industries/manufacturing-industrial",
    image: "/images/industries/manufacturing.svg",
    description: "Industrial IoT security, supply chain protection, and operational continuity for manufacturing and industrial organizations."
  }
];

const latestResources = [
  {
    title: "ISO 27001 Quick Start Guide",
    excerpt: "25-page implementation roadmap",
    href: "/resources/guides/iso-27001-quick-start",
    category: "Guide"
  },
  {
    title: "NIS2 Compliance Checklist",
    excerpt: "Complete requirement assessment tool",
    href: "/resources/guides/nis2-compliance-checklist",
    category: "Checklist"
  },
  {
    title: "GDPR Privacy Impact Assessment Template",
    excerpt: "Ready-to-use PIA framework",
    href: "/resources/guides/gdpr-pia-template",
    category: "Template"
  }
];
---

<Layout {...seoConfig}>

<!-- Hero Section -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 md:min-h-screen flex items-center relative overflow-hidden">
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16 -mt-4 md:mt-0">
    
    <!-- Mobile layout (stacked vertically) -->
    <div class="flex flex-col items-center justify-center gap-6 mb-12 md:hidden">
      <!-- Mobile: image -->
      <img 
        src="/images/Frame 1-2.png"
        alt="cybersecurity concept"
        class="w-full max-w-md object-cover"
        loading="eager"
      />
    </div>
    
    <!-- Wrapper to center buttons across both columns -->
    <div class="text-center">
      
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        <!-- Left Side: Content -->
        <div class="text-center">
          
          <!-- Title with Montserrat font, 35px size on desktop -->
          <h1 class="font-bold tracking-tight mb-6 leading-tight text-center md:-mt-16"
              style="font-family: 'Montserrat', sans-serif; font-size: 35px;">
            <div>Enterprise Cybersecurity &</div>
            <div class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">
              Compliance Advisory
            </div>
          </h1>
          
          <!-- Subtitle text with 15px size -->
          <p class="text-slate-600 max-w-md mx-auto leading-relaxed"
             style="font-family: 'Montserrat', sans-serif; font-size: 15px;">
            Strategic guidance for complex regulatory environments. ISO 27001, NIS2, GDPR, and DORA implementation with proven methodologies trusted by global organizations.
          </p>

        </div>
        
        <!-- Right Side: Frame 1-2.png image -->
        <div class="hidden md:block">
          <img 
            src="/images/Frame 1-2.png"
            alt="Cybersecurity strategy concept"
            class="w-full max-w-2xl lg:max-w-3xl mx-auto object-cover -mt-20 -ml-20"
            loading="eager"
          />
        </div>
        
      </div>
      
      <!-- Buttons with consistent font -->
      <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center mt-10 md:mt-14"
           style="font-family: 'Montserrat', sans-serif;">
        
        <a href="/contact" 
           class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white rounded-full hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base"
           style="font-size: 15px;">
          Request Consultation
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
        
        <a href="/services" 
           class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E40AF] text-[#1E40AF] rounded-full hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base"
           style="font-size: 15px;">
          Explore Services
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
      
    </div>
  </div>
</section>


<!-- Trust Bar -->
<section class="py-8 bg-gradient-to-b from-blue-50/30 to-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid md:grid-cols-2 gap-8 items-center">
      
      <!-- Left Side: Text -->
<div class="text-center md:text-left">
        <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight leading-tight text-slate-800">
          From compliance<br/>to 
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#60A5FA] bg-clip-text text-transparent">competitive advantage</span>.
        </p>
        <p class="text-sm md:text-base text-blue-600 font-medium mt-4">
          Trusted by industry leaders
        </p>
      </div>
      
      <!-- Right Side: Auto-scrolling Logos Carousel -->
      <div class="relative overflow-hidden">
        
        <!-- Marquee / Auto-scrolling container -->
        <div class="overflow-hidden">
          <div class="flex animate-scroll gap-6 md:gap-8 py-2">
            
            {/* Duplicate logos twice for seamless loop */}
            {[
              { src: '/images/nis2.webp', alt: 'NIS2' },
              { src: '/images/dora.webp', alt: 'DORA' },
              { src: '/images/logo-client-1.webp', alt: 'Client 3' },
              { src: '/images/CRA.jpg', alt: 'CRA' },
              { src: '/images/SOC-2-logo.jpg', alt: 'SOC2' },
              { src: '/images/gdpr.webp', alt: 'GDPR' },
              // Duplicate for seamless loop
              { src: '/images/nis2.webp', alt: 'NIS2' },
              { src: '/images/dora.webp', alt: 'DORA' },
              { src: '/images/logo-client-1.webp', alt: 'Client 3' },
              { src: '/images/CRA.jpg', alt: 'CRA' },
              { src: '/images/SOC-2-logo.jpg', alt: 'SOC2' },
              { src: '/images/gdpr.webp', alt: 'GDPR' },
            ].map((logo, idx) => (
              <div class="flex-shrink-0 flex items-center justify-center h-16 md:h-20 w-24 md:w-32 rounded-xl p-2 md:p-3 hover:scale-105 transition-all duration-300">
                <img 
                  src={logo.src}
                  alt={logo.alt}
                  class="w-full h-full object-contain"
                  loading="lazy"
                />
              </div>
            ))}
            
          </div>
        </div>
        
      </div>
      
    </div>
  </div>
</section>

<style>
  /* Auto-scroll animation */
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  
  .animate-scroll {
    animation: scroll 20s linear infinite;
    width: fit-content;
  }
  
  .animate-scroll:hover {
    animation-play-state: paused;
  }
  
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<!-- Featured Packages Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
        Featured Compliance Programs
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
        Fast-track solutions designed for regulated organizations
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- ISO 27001 Card -->
      <div class="bg-slate-50/50 rounded-xl border border-slate-100
                  hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                  transition-all duration-300
                  flex flex-col p-6 group">
        
        <div class="flex justify-end mb-3">
          <div class="flex items-center gap-1.5 bg-blue-50 px-3 py-1 rounded-full">
            <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs font-medium text-blue-600">90–120 days</span>
          </div>
        </div>
        
        <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
          ISO 27001 Fast-Track
        </h3>
        
        <p class="text-sm text-slate-500 mb-4 leading-relaxed text-left">
          Build and implement a complete ISMS with expert guidance.
        </p>
        
        <ul class="text-sm text-slate-600 space-y-2 mb-6 text-left">
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Complete ISMS implementation</li>
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Policy library with 50+ documents</li>
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Risk assessment & gap analysis</li>
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Audit prep & certification support</li>
        </ul>
        
        <a href="/packages/iso-27001-fast-track" class="mt-auto inline-flex items-center justify-center px-3 py-2 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] bg-transparent hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5 w-auto">
          Start program
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      
      <!-- NIS2 Card -->
      <div class="bg-slate-50/50 rounded-xl border border-slate-100
                  hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                  transition-all duration-300
                  flex flex-col p-6 group">
        
        <div class="flex justify-end mb-3">
          <div class="flex items-center gap-1.5 bg-blue-50 px-3 py-1 rounded-full">
            <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs font-medium text-blue-600">60–90 days</span>
          </div>
        </div>
        
        <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
          NIS2 Sprint Program
        </h3>
        
        <p class="text-sm text-slate-500 mb-4 leading-relaxed text-left">
          Prepare for NIS2 requirements with expert support.
        </p>
        
        <ul class="text-sm text-slate-600 space-y-2 mb-6 text-left">
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> NIS2 gap analysis & roadmap</li>
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Risk management framework</li>
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Incident response framework</li>
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Regulatory reporting setup</li>
        </ul>
        
        <a href="/packages/nis2-sprint" class="mt-auto inline-flex items-center justify-center px-3 py-2 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] bg-transparent hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5 w-auto">
          Start program
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      
      <!-- SOC 2 Card -->
      <div class="bg-slate-50/50 rounded-xl border border-slate-100
                  hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                  transition-all duration-300
                  flex flex-col p-6 group">
        
        <div class="flex justify-end mb-3">
          <div class="flex items-center gap-1.5 bg-blue-50 px-3 py-1 rounded-full">
            <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs font-medium text-blue-600">12 weeks</span>
          </div>
        </div>
        
        <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
          SOC 2 Readiness
        </h3>
        
        <p class="text-sm text-slate-500 mb-4 leading-relaxed text-left">
          Prepare for SOC 2 Type I and Type II audits.
        </p>
        
        <ul class="text-sm text-slate-600 space-y-2 mb-6 text-left">
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Type I & Type II prep</li>
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Control implementation & testing</li>
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Evidence collection framework</li>
          <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Continuous monitoring setup</li>
        </ul>
        
        <a href="/packages/soc2-readiness-12-weeks" class="mt-auto inline-flex items-center justify-center px-3 py-2 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] bg-transparent hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5 w-auto">
          Start program
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      
    </div>
    
    <!-- View All Button -->
    <div class="text-center mt-12">
      <a href="/packages" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm gap-2">
        View All Programs
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
