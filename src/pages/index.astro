        </div>
        
        <div id="logo-dots" class="flex justify-center gap-2 mt-4"></div>
        
      </div>
      
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const container = document.getElementById('logo-scroll-container');
  const dotsContainer = document.getElementById('logo-dots');
  
  if (container && dotsContainer) {
    const scrollWidth = container.scrollWidth;
    const clientWidth = container.clientWidth;
    const numberOfDots = Math.ceil(scrollWidth / clientWidth);
    
    for (let i = 0; i < numberOfDots; i++) {
      const dot = document.createElement('button');
      dot.className = 'w-2 h-2 rounded-full transition-all duration-300 ' + (i === 0 ? 'bg-blue-600' : 'bg-blue-300 hover:bg-blue-400');
      dot.addEventListener('click', () => {
        container.scrollTo({ left: i * clientWidth, behavior: 'smooth' });
      });
      dotsContainer.appendChild(dot);
    }
    
    container.addEventListener('scroll', () => {
      const scrollPosition = container.scrollLeft;
      const activeIndex = Math.round(scrollPosition / clientWidth);
      const dots = dotsContainer.querySelectorAll('button');
      dots.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.className = 'w-2 h-2 rounded-full bg-blue-600 transition-all duration-300';
        } else {
          dot.className = 'w-2 h-2 rounded-full bg-blue-300 hover:bg-blue-400 transition-all duration-300';
        }
      });
    });
  }
</script>


