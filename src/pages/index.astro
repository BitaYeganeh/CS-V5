            </div>
            <div class="mt-4">
              <a
                href={framework.href}
                class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800 font-medium group"
              >
                {lang === 'fi' ? 'Lue lisää' : 'Learn more'}
                <Icon name="arrowRight" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" />
