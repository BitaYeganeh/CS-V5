            : 'Full compliance with key regulatory requirements'}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {complianceFrameworks.map((framework, index) => (
          <div class="bg-white rounded-xl shadow-sm p-6 border border-slate-200 hover:shadow-md transition-shadow duration-200">
            <div class="flex items-start">
              <div class="flex-shrink-0 mt-1">
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                  <Icon name={framework.icon} class="w-6 h-6 text-blue-600" />
                </div>
              </div>
              <div class="ml-4">
