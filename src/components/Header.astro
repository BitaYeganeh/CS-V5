---
import { getMenu } from '@data/menu.js';
import Icon from '@ui/icons/Icon.astro';
import ScamWarningBanner from './common/ScamWarningBanner.astro';
import LanguageSelector from '@/components/ui/LanguageSelector.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const menu = getMenu(lang);
---

<style>
  /* CSS-only mobile menu - no JavaScript required */
  #mobile-menu-toggle {
    display: none;
  }

  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-menu-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: 300px;
    max-width: 85vw;
    height: 100vh;
    background: white;
    z-index: 999;
    overflow-y: auto;
    box-shadow: -4px 0 15px rgba(0, 0, 0, 0.1);
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  #mobile-menu-toggle:checked ~ .mobile-menu-overlay {
    opacity: 1;
    visibility: visible;
  }

  #mobile-menu-toggle:checked ~ .mobile-menu-panel {
    transform: translateX(0);
  }

  .menu-trigger-label {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    color: #64748b;
    transition: color 0.2s;
  }

  .menu-trigger-label:hover {
    color: #1E40AF;
  }

  .close-menu-label {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    color: #64748b;
    transition: color 0.2s;
  }

  .close-menu-label:hover {
    color: #1E40AF;
  }
</style>

<div data-scam-banner>
  <ScamWarningBanner />
</div>

<header class="sticky top-0 z-50">
  
  <!-- Blue Top Bar -->
<div class="bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white text-sm py-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-2 sm:gap-0">
        
        <!-- Left side -->
        <div class="flex items-center gap-6">
          <span class="inline-flex items-center gap-1 text-xs sm:text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            ISO 27001 Certified
          </span>
          <span class="hidden md:inline-flex items-center gap-1 text-xs sm:text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            info@cybersecurity.fi
          </span>
        </div>
        
        <!-- Right side -->
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1 text-xs sm:text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            +358 44 5040308
          </span>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Main Navigation -->
  <div class="bg-white border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="h-20 flex items-center justify-between">
        
        <!-- Logo -->
        <a
          href={lang === 'fi' ? '/fi' : '/'}
          class="flex-shrink-0 transition-opacity duration-300 hover:opacity-80"
        >
          <img
            src="/logo-2025.jpg"
            alt="Cyber Security Finland"
            loading="eager"
            class="h-14 w-auto object-contain"
          />
        </a>

<!-- Desktop Navigation with dropdown support -->
<div class="hidden lg:flex items-center gap-8">
  {menu && menu.map(item => {
    const href = item.href;
    const isActive = href !== '/' && (currentPath === href || currentPath.startsWith(href + '/'));
    const hasChildren = item.children && item.children.length > 0;
    const label = item.label;

    if (hasChildren) {
      return (
        <div class="relative group">
          <button class="flex items-center gap-1 text-sm font-medium transition-colors duration-200 text-slate-600 hover:text-[#1E40AF] group-hover:text-[#1E40AF]">
            {label}
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-slate-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="py-2">
              {item.children.map(child => {
                const childHref = child.href;
                const childLabel = child.label;
                const isChildActive = currentPath === childHref || currentPath.startsWith(childHref + '/');
                return (
                  <a 
                    href={childHref} 
                    class={`block px-4 py-2 text-sm transition-colors duration-200 ${isChildActive ? 'text-[#1E40AF] bg-slate-50' : 'text-slate-600 hover:bg-slate-50 hover:text-[#1E40AF]'}`}
                  >
                    {childLabel}
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      );
    } else {
      return (
        <a 
          href={href} 
          class={`text-sm font-medium transition-colors duration-200 ${isActive ? 'text-[#1E40AF]' : 'text-slate-600 hover:text-[#1E40AF]'}`}
        >
          {label}
        </a>
      );
    }
  })}
</div>

        <!-- Desktop Right Side -->
        <div class="hidden lg:flex items-center gap-4">
          <LanguageSelector />
          <a
            href={lang === 'fi' ? '/fi/contact' : '/contact'}
            class="px-5 py-2 text-sm font-medium text-white bg-gradient-to-r from-[#1E2A7A] to-[#2563EB] text-white rounded-3xl hover:from-[#2563EB] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-md"
          >
            {lang === 'fi' ? 'Ota yhteyttä' : 'Contact'}
          </a>
        </div>

        <!-- Mobile Controls -->
        <div class="lg:hidden flex items-center gap-3">
          <LanguageSelector />
          <label for="mobile-menu-toggle" class="menu-trigger-label" aria-label="Open navigation menu">
            <Icon name="bars" class="w-6 h-6" />
          </label>
        </div>
      </nav>
    </div>
  </div>
</header>

<!-- CSS-only Mobile Menu System -->
<input type="checkbox" id="mobile-menu-toggle" aria-hidden="true" />

<label for="mobile-menu-toggle" class="mobile-menu-overlay lg:hidden" aria-hidden="true"></label>

<nav class="mobile-menu-panel lg:hidden" aria-label="Mobile navigation">
  <div class="flex items-center justify-between p-4 border-b border-slate-100">
    <span class="text-lg font-semibold text-slate-900">Menu</span>
    <label for="mobile-menu-toggle" class="close-menu-label" aria-label="Close navigation menu">
      <Icon name="x" class="w-5 h-5" />
    </label>
  </div>

  <!-- Mobile Menu with dropdown support -->
  <div class="p-4">
    {menu && menu.map((item) => {
      const href = item.href;
      const isActive = href !== '/' && (currentPath === href || currentPath.startsWith(href + '/'));
      const hasChildren = item.children && item.children.length > 0;
      const label = item.label;

      if (hasChildren) {
        return (
          <details class="mb-2" open={isActive}>
            <summary class={`block p-3 rounded-lg cursor-pointer ${isActive ? 'bg-slate-50 text-[#1E40AF]' : 'text-slate-700 hover:bg-slate-50'}`}>
              <span class="font-medium text-sm">{label}</span>
            </summary>
            <div class="ml-4 mt-1 space-y-1">
              {item.children.map(child => {
                const childHref = child.href;
                const childLabel = child.label;
                const isChildActive = currentPath === childHref || currentPath.startsWith(childHref + '/');
                return (
                  <a
                    href={childHref}
                    class={`block p-2 rounded-lg text-sm transition-colors duration-200 ${isChildActive ? 'text-[#1E40AF] bg-slate-50' : 'text-slate-600 hover:bg-slate-50 hover:text-[#1E40AF]'}`}
                  >
                    {childLabel}
                  </a>
                );
              })}
            </div>
          </details>
        );
      } else {
        return (
          <a
            href={href}
            class={`block p-3 mb-2 rounded-lg ${isActive ? 'bg-slate-50 text-[#1E40AF]' : 'text-slate-700 hover:bg-slate-50 hover:text-[#1E40AF]'}`}
          >
            <span class="font-medium text-sm">{label}</span>
          </a>
        );
      }
    })}

    <a
      href={lang === 'fi' ? '/fi/contact' : '/contact'}
      class="block w-full mt-4 px-4 py-3 text-center text-white bg-gradient-to-r from-[#1E2A7A] to-[#1E40AF] rounded-full hover:from-[#2563EB] hover:to-[#1E2A7A] transition-all duration-300 text-sm font-medium"
    >
      {lang === 'fi' ? 'Ota yhteyttä' : 'Contact Us'}
    </a>
  </div>
</nav>