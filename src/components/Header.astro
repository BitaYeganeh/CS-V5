---
import { getMenu } from '@data/menu.js';
import Icon from '@ui/icons/Icon.astro';
import ScamWarningBanner from './common/ScamWarningBanner.astro';
import LanguageSelector from '@/components/ui/LanguageSelector.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const menu = getMenu(lang);
---

<style>
  /* CSS-only mobile menu - no JavaScript required */
  #mobile-menu-toggle {
    display: none;
  }

  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-menu-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: 300px;
    max-width: 85vw;
    height: 100vh;
    background: white;
    z-index: 999;
    overflow-y: auto;
    box-shadow: -4px 0 15px rgba(0, 0, 0, 0.1);
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  #mobile-menu-toggle:checked ~ .mobile-menu-overlay {
    opacity: 1;
    visibility: visible;
  }

  #mobile-menu-toggle:checked ~ .mobile-menu-panel {
    transform: translateX(0);
  }

  .menu-trigger-label {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    color: #1e293b;
    transition: color 0.2s;
  }

  .menu-trigger-label:hover {
    color: #2563eb;
  }

  .close-menu-label {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    color: #1e293b;
    transition: color 0.2s;
  }

  .close-menu-label:hover {
    color: #2563eb;
  }
</style>

<div data-scam-banner>
  <ScamWarningBanner />
</div>

<!-- Simplified Header - Matching modern design -->
<header class="bg-white border-b border-slate-100 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="h-16 flex items-center justify-between">
      
      <!-- Logo -->
      <a
        href={lang === 'fi' ? '/fi' : '/'}
        class="flex items-center transition-opacity duration-300 hover:opacity-80"
        aria-label={lang === 'fi' ? "Etusivulle - Cyber Security Finland" : "Go to homepage - Cybersecurity Finland"}
      >
        <img
          src="/logo-2025.jpg"
          alt="Cybersecurity Finland"
          width="120"
          height="48"
          loading="eager"
          class="h-10 w-auto object-contain"
        />
      </a>

      <!-- Desktop Navigation - Clean & Minimal -->
      <div class="hidden lg:flex items-center gap-6">
        {menu && menu.map(item => {
          const href = item.href;
          const isActive = currentPath === href || currentPath.startsWith(href + '/') || (href !== '/' && currentPath.startsWith(href));
          const hasChildren = item.children && item.children.length > 0;
          const label = item.label;

          return <div class="relative group">
            {hasChildren ? (
              <>
                <button class={`flex items-center px-3 py-2 text-sm font-medium transition-colors duration-200 ${isActive ? 'text-slate-900' : 'text-slate-600 hover:text-slate-900'}`}>
                  <span>{label}</span>
                  <Icon name="chevronDown" class="w-4 h-4 ml-1 text-slate-400 group-hover:text-slate-600 transition-colors" />
                </button>

                <div class="absolute left-0 top-full min-w-48 bg-white rounded-lg border border-slate-100 shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  <div class="py-2">
                    {item.children && item.children.map(sub => {
                      const subHref = sub.href;
                      const subLabel = sub.label;
                      return <a href={subHref} class="block px-4 py-2 text-sm text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-colors">
                        {subLabel}
                      </a>;
                    })}
                  </div>
                </div>
              </>
            ) : (
              <a href={href} class={`text-sm font-medium transition-colors duration-200 ${isActive ? 'text-slate-900' : 'text-slate-600 hover:text-slate-900'}`}>
                {label}
              </a>
            )}
          </div>;
        })}
      </div>

      <!-- Desktop Right Side -->
      <div class="hidden lg:flex items-center gap-4">
        <LanguageSelector />
        <a
          href={lang === 'fi' ? '/fi/contact' : '/contact'}
          class="px-5 py-2 text-sm font-medium text-white bg-slate-900 rounded-lg hover:bg-blue-600 transition-all duration-300 hover:shadow-md"
        >
          {lang === 'fi' ? 'Ota yhteyttä' : 'Contact'}
        </a>
      </div>

      <!-- Mobile Controls -->
      <div class="lg:hidden flex items-center gap-3">
        <LanguageSelector />
        <label for="mobile-menu-toggle" class="menu-trigger-label" aria-label="Open navigation menu">
          <span class="sr-only">Open menu</span>
          <Icon name="bars" class="w-6 h-6" />
        </label>
      </div>
    </nav>
  </div>
</header>

<!-- CSS-only Mobile Menu System -->
<input type="checkbox" id="mobile-menu-toggle" aria-hidden="true" />

<label for="mobile-menu-toggle" class="mobile-menu-overlay lg:hidden" aria-hidden="true"></label>

<nav class="mobile-menu-panel lg:hidden" aria-label="Mobile navigation">
  <div class="flex items-center justify-between p-4 border-b border-slate-100">
    <span class="text-lg font-semibold text-slate-900">Menu</span>
    <label for="mobile-menu-toggle" class="close-menu-label" aria-label="Close navigation menu">
      <Icon name="x" class="w-5 h-5" />
    </label>
  </div>

  <div class="p-4">
    {menu && menu.map((item) => {
      const href = item.href;
      const isActive = currentPath === href || currentPath.startsWith(href + '/') || (href !== '/' && currentPath.startsWith(href));
      const hasChildren = item.children && item.children.length > 0;
      const label = item.label;

      if (hasChildren) {
        return (
          <details class="group mb-2">
            <summary class={`flex items-center justify-between p-3 rounded-lg cursor-pointer ${isActive ? 'bg-slate-50 text-slate-900' : 'text-slate-700 hover:bg-slate-50'}`}>
              <span class="font-medium text-sm">{label}</span>
              <Icon name="chevronDown" class="w-4 h-4 text-slate-400 transition-transform duration-200 group-open:rotate-180" />
            </summary>
            <div class="mt-2 ml-4 space-y-1">
              {item.children && item.children.map((sub: any) => {
                const subHref = sub.href;
                const subLabel = sub.label;
                return (
                  <a
                    href={subHref}
                    class="block p-2 text-sm text-slate-600 rounded-lg hover:bg-slate-50 hover:text-slate-900 transition-colors"
                  >
                    {subLabel}
                  </a>
                );
              })}
            </div>
          </details>
        );
      } else {
        return (
          <a
            href={href}
            class={`block p-3 mb-2 rounded-lg ${isActive ? 'bg-slate-50 text-slate-900' : 'text-slate-700 hover:bg-slate-50'}`}
          >
            <span class="font-medium text-sm">{label}</span>
          </a>
        );
      }
    })}

    <a
      href={lang === 'fi' ? '/fi/contact' : '/contact'}
      class="block w-full mt-4 px-4 py-3 text-center text-white bg-slate-900 rounded-lg hover:bg-blue-600 transition-all duration-300 text-sm font-medium"
    >
      {lang === 'fi' ? 'Ota yhteyttä' : 'Contact Us'}
    </a>
  </div>
</nav>