---
import { getMenu } from '@data/menu.js';
import Icon from '@ui/icons/Icon.astro';
import ScamWarningBanner from './common/ScamWarningBanner.astro';
import LanguageSelector from '@/components/ui/LanguageSelector.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const menu = getMenu(lang);
---

<div data-scam-banner>
  <ScamWarningBanner />
</div>

<header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm backdrop-blur-sm bg-white/95">
  <!-- Main navigation - enhanced mobile layout -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="h-16 flex items-center justify-between" aria-label="Main navigation" role="navigation">
      <!-- Logo with enhanced mobile sizing -->
      <a
        href={lang === 'fi' ? '/fi' : '/'}
        class="flex items-center rounded-md transition-all duration-300 hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
        aria-label={lang === 'fi' ? "Etusivulle - Cyber Security Finland" : "Go to homepage - Cybersecurity Finland"}
      >
        <img
          src="/logo-2025.jpg"
          alt="Cybersecurity Finland"
          class="h-12 w-auto object-contain"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-6 flex-1 justify-center">
        {menu && menu.map(item => {
          const href = item.href;
          const isActive = currentPath === href || currentPath.startsWith(href + '/') || (href !== '/' && currentPath.startsWith(href));
          const hasChildren = item.children && item.children.length > 0;
          const label = item.label; // Use translated label based on language

          return <div class="relative group">
            {hasChildren ? (
              <>
                <button class={`flex items-center px-3 py-2 text-sm font-medium transition-colors duration-200 ${isActive ? 'text-gray-900' : 'text-gray-700 hover:text-gray-900'}`} aria-haspopup="true" aria-expanded="false">
                  <span>{label}</span>
                  <Icon name="chevronDown" class="w-4 h-4 ml-1 text-gray-500" />
                </button>

                <div class="absolute left-0 top-full min-w-56 bg-white shadow-xl rounded-sm border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 group-focus-within:translate-y-0 z-50">
                  <div class="py-2">
                    {item.children && item.children.map(sub => {
                      const subHref = sub.href;
                      const subLabel = sub.label;
                      return <a href={subHref} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 transition-colors duration-150">
                        {subLabel}
                      </a>;
                    })}
                  </div>
                </div>
              </>
            ) : (
              <a href={href} class={`px-3 py-2 text-sm font-medium transition-colors duration-200 ${isActive ? 'text-gray-900' : 'text-gray-700 hover:text-gray-900'}`}>
                {label}
              </a>
            )}
          </div>;
        })}
      </div>

      <!-- Desktop Header Utility -->
      <div class="hidden lg:flex items-center space-x-4">
        <a
          href={lang === 'fi' ? '/fi/contact' : '/contact'}
          class="px-5 py-2.5 text-sm font-medium text-white bg-gray-900 hover:bg-black transition-all duration-200 border border-gray-900 hover:border-black"
        >
          {lang === 'fi' ? 'Ota yhteyttä' : 'Contact'}
        </a>

        <!-- Language Selector -->
        <LanguageSelector />
      </div>

      <!-- Mobile Controls -->
      <div class="lg:hidden ml-auto flex items-center gap-3">
        <!-- Language Selector for Mobile -->
        <LanguageSelector />

        <button
          id="mobile-trigger"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open navigation menu"
          class="p-2 text-gray-700 hover:text-gray-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 transition-colors"
          type="button"
        >
          <span class="sr-only">Open menu</span>
          <Icon name="bars" class="w-6 h-6" />
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- Mobile Menu -->
<div
  id="mobile-menu-backdrop"
  class="lg:hidden fixed inset-0 bg-black/20 z-[60] opacity-0 invisible transition-opacity duration-300"
  aria-hidden="true"
></div>

<div
  id="mobile-menu"
  class="lg:hidden fixed top-0 right-0 w-80 max-w-full h-screen bg-white z-[65] transform translate-x-full transition-transform duration-300 overflow-y-auto"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-menu-title"
>
  <!-- Mobile menu header -->
  <div class="flex items-center justify-between p-4 border-b border-gray-200">
    <h2 id="mobile-menu-title" class="text-lg font-semibold text-gray-900">Menu</h2>
    <button
      data-close
      aria-label="Close navigation menu"
      class="p-2 text-gray-700 hover:text-gray-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900"
      type="button"
    >
      <Icon name="x" class="w-5 h-5" />
    </button>
  </div>


  <div class="p-4">
    {menu && menu.map((item, index) => {
      const href = item.href;
      const isActive = currentPath === href || currentPath.startsWith(href + '/') || (href !== '/' && currentPath.startsWith(href));
      const hasChildren = item.children && item.children.length > 0;
      const label = item.label; // Use translated label based on language

      if (hasChildren) {
        return (
          <details class="group mb-2">
            <summary class={`flex items-center justify-between p-3 cursor-pointer ${isActive ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900'}`}>
              <span class="font-medium">{label}</span>
              <Icon name="chevronDown" class="w-4 h-4 text-gray-500 transition-transform duration-200 group-open:rotate-180" />
            </summary>
            <div class="mt-2 ml-4 space-y-1">
              {item.children && item.children.map((sub: any, subIndex: number) => {
                const subHref = sub.href;
                const subLabel = sub.label;
                return (
                  <a
                    href={subHref}
                    class="block p-2 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors duration-150"
                  >
                    {subLabel}
                  </a>
                );
              })}
            </div>
          </details>
        );
      } else {
        // Simple menu items without children
        return (
          <a
            href={href}
            class={`block p-3 mb-2 ${isActive ? 'bg-gray-50 text-gray-900' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900'}`}
          >
            <span class="font-medium">{label}</span>
          </a>
        );
      }
    })}
    
    <a
      href={lang === 'fi' ? '/fi/contact' : '/contact'}
      class="block w-full mt-4 px-4 py-3 text-center text-white bg-gray-900 hover:bg-black transition-all duration-200"
    >
      {lang === 'fi' ? 'Ota yhteyttä' : 'Contact Us'}
    </a>
  </div>
</div>

<script is:inline>
  (function() {
    function initMobileMenu() {
      var trigger = document.getElementById('mobile-trigger');
      var menuRoot = document.getElementById('mobile-menu');
      var backdrop = document.getElementById('mobile-menu-backdrop');

      if (!trigger || !menuRoot || !backdrop) {
        return;
      }

      // Prevent duplicate initialization
      if (trigger.getAttribute('data-initialized') === 'true') return;
      trigger.setAttribute('data-initialized', 'true');

      var lastFocus = null;

      function openMenu() {
        lastFocus = document.activeElement;

        menuRoot.classList.remove('translate-x-full');
        backdrop.classList.remove('invisible', 'opacity-0');
        backdrop.classList.add('opacity-100', 'visible');

        trigger.setAttribute('aria-expanded', 'true');
        menuRoot.removeAttribute('aria-hidden');
        document.documentElement.classList.add('overflow-hidden');
        document.body.classList.add('overflow-hidden');
      }

      function closeMenu() {
        menuRoot.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100', 'visible');
        backdrop.classList.add('opacity-0', 'invisible');

        trigger.setAttribute('aria-expanded', 'false');
        menuRoot.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('overflow-hidden');
        document.body.classList.remove('overflow-hidden');

        if (lastFocus && lastFocus.focus) {
          lastFocus.focus();
        }
      }

      trigger.onclick = function(e) {
        e.preventDefault();
        e.stopPropagation();
        var isOpen = trigger.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      };

      backdrop.onclick = function() {
        closeMenu();
      };

      menuRoot.onclick = function(e) {
        var target = e.target;
        if (!target) return;

        // Close button
        if (target.closest('[data-close]')) {
          closeMenu();
          return;
        }

        // Link clicked (but not inside details/accordion)
        if (target.closest('a') && !target.closest('details')) {
          closeMenu();
          return;
        }
      };

      // Close on escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
          closeMenu();
        }
      });

      // Close on resize to desktop
      window.addEventListener('resize', function() {
        if (window.innerWidth >= 1024 && trigger.getAttribute('aria-expanded') === 'true') {
          closeMenu();
        }
      });
    }

    // Run immediately if DOM is ready
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initMobileMenu();
    } else {
      document.addEventListener('DOMContentLoaded', initMobileMenu);
    }

    // Also handle Astro view transitions
    document.addEventListener('astro:page-load', initMobileMenu);
  })();
</script>