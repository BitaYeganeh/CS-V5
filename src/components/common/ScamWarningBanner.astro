---
import Icon from "@ui/icons/Icon.astro";

// Scam warning banner for Cyber Security Finland scams
const warningTitle = "⚠️ SCAM ALERT";
const warningMessage = "Scam messages have been sent in the name of Cyber Security Finland.";
const linkText = "Read more about the scams";
const linkHref = "/resources/scam-awareness"; // You can update this to your actual scams resource page
---

<div class="w-full border-b shadow-sm" style="background-color: #fbbf24; border-color: #f59e0b;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-2 py-1.5 sm:py-1.5">
      <!-- Left section: Warning icon and message -->
      <div class="flex items-center gap-2 flex-1 min-w-0">
        <div class="flex-shrink-0 flex items-center">
          <Icon 
            name="alert" 
            class="w-4 h-4 flex-shrink-0 animate-pulse" 
            style="color: #dc2626;"
            aria-hidden="true"
          />
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold" style="color: #dc2626;">
            {warningMessage}
          </p>
        </div>
      </div>

      <!-- Right section: Action button -->
      <a
        href={linkHref}
        class="flex-shrink-0 inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-semibold transition-all duration-200 hover:shadow-md active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 whitespace-nowrap"
        style="background-color: #dc2626; color: white;"
        onmouseover="this.style.backgroundColor='#b91c1c'"
        onmouseout="this.style.backgroundColor='#dc2626'"
        aria-label={linkText}
      >
        <span>{linkText}</span>
        <Icon name="chevronRight" class="w-3 h-3 flex-shrink-0" aria-hidden="true" />
      </a>

      <!-- Close button -->
      <button
        class="flex-shrink-0 p-0.5 rounded transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1"
        style="color: #dc2626;"
        onmouseover="this.style.backgroundColor='#fef3c7'"
        onmouseout="this.style.backgroundColor='transparent'"
        aria-label="Dismiss scam warning"
        onclick="this.closest('[data-scam-banner]').remove(); localStorage.setItem('scamBannerDismissed', 'true');"
      >
        <Icon name="x" class="w-4 h-4" aria-hidden="true" />
      </button>
    </div>
  </div>
</div>

<script define:vars={{ isDismissed: typeof localStorage !== 'undefined' && localStorage.getItem('scamBannerDismissed') === 'true' }}>
  // Hide banner on page load if dismissed by user
  if (isDismissed) {
    const banner = document.querySelector('[data-scam-banner]');
    if (banner) {
      banner.style.display = 'none';
    }
  }

  // Re-show banner on specific pages or after 1 day
  if (typeof localStorage !== 'undefined') {
    const dismissDate = localStorage.getItem('scamBannerDismissDate');
    const now = new Date().getTime();
    const dayInMs = 24 * 60 * 60 * 1000;
    
    // Show banner again after 24 hours
    if (dismissDate && (now - parseInt(dismissDate)) > dayInMs) {
      localStorage.removeItem('scamBannerDismissed');
      localStorage.removeItem('scamBannerDismissDate');
    }
  }
</script>

<style>
  @keyframes pulse-gentle {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  :global([data-scam-banner] .animate-pulse) {
    animation: pulse-gentle 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
