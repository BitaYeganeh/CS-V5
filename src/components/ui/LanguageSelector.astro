---
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const languages = {
  en: { code: 'en', name: 'English', flag: '🇺🇸' },
  fi: { code: 'fi', name: 'Suomi', flag: '🇫🇮' }
};

const getLocalizedUrl = (path: string, targetLang: string) => {
  // First clean the path of any existing language prefix
  const cleanPath = path.startsWith('/fi') ? path.replace('/fi', '') || '/' : path;
  
  if (targetLang === 'fi') {
    return cleanPath === '/' ? '/fi' : `/fi${cleanPath}`;
  } else {
    // target is 'en'
    return cleanPath;
  }
};
---

<div class="relative language-selector-wrapper">
  <button
    aria-label="Change language"
    class="language-selector-button flex items-center space-x-2 px-3 py-2 rounded-md text-sm font-medium text-slate-700 hover:bg-slate-100 transition-colors duration-200"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span class="w-5 h-5 flex items-center justify-center text-base">
      {currentLang === 'fi' ? '🇫🇮' : '🇺🇸'}
    </span>
    <span class="hidden sm:inline">{currentLang.toUpperCase()}</span>
    <svg xmlns="http://www.w3.org/2000/svg"
      class="language-chevron w-4 h-4 ml-1 transition-transform duration-200"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    class="language-dropdown absolute right-0 mt-2 w-40 bg-white shadow-lg rounded-md border border-slate-200 opacity-0 invisible scale-95 transform translate-y-1 transition-all duration-200 z-50 origin-top-right"
  >
    <div class="py-1">

      {Object.entries(languages).map(([code, lang]) => {
        // Render all languages so user can see which one is selected or choose another
        const localizedUrl = getLocalizedUrl(currentPath, code);
        const isCurrent = code === currentLang;
        return (
          <a
            href={localizedUrl}
            class={`flex items-center px-4 py-2 text-sm transition-colors duration-200 block ${isCurrent ? 'bg-slate-50 text-blue-600 font-medium' : 'text-slate-700 hover:bg-slate-100'}`}
            data-lang-code={code}
            data-is-current={isCurrent}
          >
            <span class="w-5 h-5 mr-2 flex items-center justify-center text-base">
              {lang.flag}
            </span>
            <span>{lang.name}</span>
            {isCurrent && (
              <svg class="w-4 h-4 ml-auto text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            )}
          </a>
        );
      })}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrappers = document.querySelectorAll('.language-selector-wrapper');

    wrappers.forEach(wrapper => {
      const button = wrapper.querySelector('.language-selector-button');
      const dropdown = wrapper.querySelector('.language-dropdown');
      const chevron = wrapper.querySelector('.language-chevron');

      if (!button || !dropdown) return;

      // Toggle dropdown visibility
      button.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const isExpanded = button.getAttribute('aria-expanded') === 'true';

        // Toggle expanded state
        button.setAttribute('aria-expanded', String(!isExpanded));

        // Toggle dropdown visibility
        if (!isExpanded) {
          dropdown.classList.remove('opacity-0', 'invisible', 'scale-95', 'translate-y-1');
          dropdown.classList.add('opacity-100', 'visible', 'scale-100', 'translate-y-0');
          if (chevron) chevron.classList.add('rotate-180');
        } else {
          dropdown.classList.add('opacity-0', 'invisible', 'scale-95', 'translate-y-1');
          dropdown.classList.remove('opacity-100', 'visible', 'scale-100', 'translate-y-0');
          if (chevron) chevron.classList.remove('rotate-180');
        }
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target)) {
          button.setAttribute('aria-expanded', 'false');
          dropdown.classList.add('opacity-0', 'invisible', 'scale-95', 'translate-y-1');
          dropdown.classList.remove('opacity-100', 'visible', 'scale-100', 'translate-y-0');
          if (chevron) chevron.classList.remove('rotate-180');
        }
      });

      // Handle keyboard navigation
      button.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          button.click();
        } else if (e.key === 'Escape') {
          button.setAttribute('aria-expanded', 'false');
          dropdown.classList.add('opacity-0', 'invisible', 'scale-95', 'translate-y-1');
          dropdown.classList.remove('opacity-100', 'visible', 'scale-100', 'translate-y-0');
          if (chevron) chevron.classList.remove('rotate-180');
          button.focus();
        }
      });
    });
  });
</script>